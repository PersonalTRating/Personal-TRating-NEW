---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import ForTrainersTrustBar from '../components/ForTrainersTrustBar.astro';

const { count: totalTrainers } = await supabase
  .from('trainers')
  .select('*', { count: 'exact', head: true })
  .eq('is_active', true);

const { count: totalReviews } = await supabase
  .from('reviews')
  .select('*', { count: 'exact', head: true })
  .eq('is_verified', true);
---

<Layout
  title="For Personal Trainers · CoachCards"
  description="List your profile free on the UK personal trainer review and ranking platform. Collect verified client reviews, earn your BMP score and grow your reputation."
>

<style is:global>
  @keyframes fadeUp {
    from { opacity:0; transform:translateY(20px); }
    to   { opacity:1; transform:translateY(0); }
  }
  .ft-anim-1 { animation:fadeUp 0.6s 0.00s ease both; }
  .ft-anim-2 { animation:fadeUp 0.6s 0.10s ease both; }
  .ft-anim-3 { animation:fadeUp 0.6s 0.20s ease both; }
  .ft-anim-4 { animation:fadeUp 0.6s 0.30s ease both; }

  .ft-step-grid    { display:grid; grid-template-columns:repeat(3,1fr); gap:2rem; }
  .ft-feature-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; }
  .ft-proof-grid   { display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; }

  .ft-step {
    background:white; border:1px solid #e0e8e1; border-radius:16px;
    padding:2rem 1.75rem; position:relative; overflow:hidden;
  }
  .ft-step::before {
    content:''; position:absolute; top:0; left:0; right:0; height:3px;
    background:#3ab54a;
  }
  .ft-step-num {
    font-size:0.65rem; font-weight:800; color:#3ab54a; letter-spacing:2px;
    border:1.5px solid #3ab54a; padding:0.2rem 0.55rem;
    border-radius:20px; display:inline-block; margin-bottom:1.1rem;
  }
  .ft-trust-bar  { display:flex; gap:2.5rem; padding-top:2rem; border-top:1px solid rgba(255,255,255,0.1); }
  .ft-trust-item { display:flex; align-items:center; gap:0.5rem; font-size:0.82rem; color:rgba(255,255,255,0.55); }
  .ft-trust-item svg { flex-shrink:0; }
  .ft-trust-label { color:#fff; font-size:0.9rem; }
  .ft-step-icon  { margin-bottom:0.75rem; display:flex; align-items:center; }
  .ft-step-title { font-weight:800; font-size:1rem; color:#111311; margin-bottom:0.5rem; line-height:1.3; }
  .ft-step-desc  { font-size:0.85rem; color:#7a8f7c; line-height:1.75; }

  .ft-feature {
    background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.08);
    border-radius:14px; padding:1.75rem;
  }
  .ft-feature-icon  { margin-bottom:0.85rem; display:flex; align-items:center; }
  .ft-feature-title { font-weight:700; font-size:0.95rem; color:white; margin-bottom:0.4rem; }
  .ft-feature-desc  { font-size:0.82rem; color:rgba(255,255,255,0.52); line-height:1.72; }

  .ft-proof {
    background:white; border-radius:14px; padding:1.75rem;
    border:1px solid #c3e6c8; display:flex; flex-direction:column;
    box-shadow:0 4px 20px rgba(58,181,74,0.08);
  }
  .ft-proof-text { font-size:0.875rem; line-height:1.78; color:#111311; font-style:italic; flex:1; margin-bottom:1.25rem; }
  .ft-proof-foot { display:flex; align-items:center; gap:0.75rem; padding-top:1rem; border-top:1px solid #e0e8e1; }
  .ft-proof-av   { width:34px; height:34px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:0.78rem; flex-shrink:0; }
  .ft-proof-name { font-weight:700; font-size:0.83rem; color:#111311; }
  .ft-proof-info { font-size:0.7rem; color:#8a8f8a; margin-top:0.1rem; }

  .ft-nav-link { color:#8a8f8a; text-decoration:none; font-size:0.875rem; font-weight:500; transition:color 0.2s; }
  .ft-nav-link:hover { color:#111311; }

  @media (max-width:900px) {
    .ft-step-grid    { grid-template-columns:1fr !important; }
    .ft-feature-grid { grid-template-columns:1fr 1fr !important; }
    .ft-proof-grid   { grid-template-columns:1fr !important; }
  }
  @media (max-width:600px) {
    .ft-hero-h1      { font-size:2.4rem !important; }
    .ft-trust-bar    { flex-direction:column; gap:1rem !important; }
    .ft-feature-grid { grid-template-columns:1fr !important; }
    section { padding-left:1.25rem !important; padding-right:1.25rem !important; }
    section > div[style*="max-width"] { padding-left:0 !important; padding-right:0 !important; }
    /* Mobile nav */
    nav > div    { height:64px !important; padding:0 1.25rem !important; }
    nav img      { height:46px !important; }
    .ft-nav-links { display:none !important; }
    .ft-mob-ham  { display:flex !important; }
    .ft-mob-nav  { display:flex !important; }
    /* CTA section */
    .ft-cta-section { padding:3.5rem 0 !important; }
    .ft-cta-h2      { font-size:1.75rem !important; }
    /* Footer */
    .ft-footer { padding:1.25rem 1.25rem !important; }
  }
  /* Hamburger button */
  .ft-mob-ham {
    display:none; flex-direction:column; justify-content:center; align-items:center;
    gap:5px; width:40px; height:40px; background:none; border:none; cursor:pointer;
    padding:0; border-radius:8px; transition:background 0.15s;
  }
  .ft-mob-ham:hover { background:#f0f4f0; }
  .ft-mob-ham span {
    display:block; width:22px; height:2px; background:#111311; border-radius:2px;
    transition:all 0.25s;
  }
  .ft-mob-ham.open span:nth-child(1) { transform:translateY(7px) rotate(45deg); }
  .ft-mob-ham.open span:nth-child(2) { opacity:0; }
  .ft-mob-ham.open span:nth-child(3) { transform:translateY(-7px) rotate(-45deg); }
  /* Mobile dropdown nav */
  .ft-mob-nav {
    display:none; flex-direction:column;
    position:fixed; top:64px; left:0; right:0; z-index:499;
    background:white; max-height:0; overflow:hidden;
    transition:max-height 0.3s ease;
    box-shadow:0 4px 24px rgba(0,0,0,0.08);
  }
  .ft-mob-nav.open { max-height:440px; border-bottom:2px solid #3ab54a; }
  .ft-mob-nav a {
    font-size:1rem; font-weight:600; color:#111311; text-decoration:none;
    padding:1rem 1.5rem; border-bottom:1px solid #f0f4f0;
    -webkit-tap-highlight-color:transparent;
  }
  .ft-mob-nav a:active { background:#f7fbf7; }
  .ft-mob-nav-btns {
    display:flex; gap:0.75rem; padding:1rem 1.5rem;
  }
</style>

<!-- ── NAV ── -->
<nav style="position:sticky;top:0;z-index:100;background:white;border-bottom:1px solid #e0e8e1;box-shadow:0 1px 8px rgba(0,0,0,0.05);">
  <div style="max-width:1200px;margin:0 auto;padding:0 2.5rem;display:flex;align-items:center;justify-content:space-between;height:100px;">
    <a href="/" style="text-decoration:none;display:flex;align-items:center;gap:0.6rem;">
      <img src="/images/cc-logo.png" alt="" aria-hidden="true" style="height:42px;width:42px;flex-shrink:0;" />
      <span style="font-family:'Manrope',sans-serif;font-size:1.15rem;font-weight:800;letter-spacing:-0.2px;line-height:1;"><span style="color:#3ab54a;">Coach</span><span style="color:#111311;">Cards</span></span>
    </a>
    <div class="ft-nav-links" style="display:flex;gap:2rem;align-items:center;">
      <a href="/find-a-trainer" class="ft-nav-link">Find a Trainer</a>
      <a href="#how-it-works"   class="ft-nav-link">How It Works</a>
      <a href="#features"       class="ft-nav-link">Features</a>
      <a href="/login" class="ft-nav-link" id="ft-nav-signin">Sign In</a>
      <a href="/signup" id="ft-nav-cta"
        style="background:#3ab54a;color:white;padding:0.6rem 1.4rem;border-radius:6px;font-weight:700;font-size:0.875rem;text-decoration:none;transition:background 0.2s;"
        onmouseover="this.style.background='#2a9438'" onmouseout="this.style.background='#3ab54a'">
        List Your Profile Free
      </a>
      <button id="ft-nav-signout"
        style="display:none;background:none;border:1.5px solid #d0d8d1;border-radius:6px;padding:0.55rem 1.1rem;font-size:0.875rem;font-weight:700;color:#5a6b5c;cursor:pointer;transition:all 0.2s;font-family:inherit;"
        onmouseover="this.style.borderColor='#e05555';this.style.color='#e05555'" onmouseout="this.style.borderColor='#d0d8d1';this.style.color='#5a6b5c'">
        Sign Out
      </button>
    </div>
    <button class="ft-mob-ham" id="ft-mob-ham" aria-label="Toggle menu"
      onclick="(function(){var n=document.getElementById('ft-mob-nav');var h=document.getElementById('ft-mob-ham');var o=n.classList.toggle('open');h.classList.toggle('open',o);})()">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<!-- Mobile dropdown nav -->
<div class="ft-mob-nav" id="ft-mob-nav">
  <a href="/find-a-trainer" onclick="document.getElementById('ft-mob-nav').classList.remove('open');document.getElementById('ft-mob-ham').classList.remove('open')">Find a Trainer</a>
  <a href="#how-it-works"   onclick="document.getElementById('ft-mob-nav').classList.remove('open');document.getElementById('ft-mob-ham').classList.remove('open')">How It Works</a>
  <a href="#features"       onclick="document.getElementById('ft-mob-nav').classList.remove('open');document.getElementById('ft-mob-ham').classList.remove('open')">Features</a>
  <div class="ft-mob-nav-btns">
    <a href="/login"  id="ft-mob-signin"  style="flex:1;text-align:center;border:2px solid #3ab54a;color:#3ab54a;padding:0.75rem 1rem;border-radius:8px;font-size:0.9rem;font-weight:700;text-decoration:none;-webkit-tap-highlight-color:transparent;">Sign In</a>
    <a href="/signup" id="ft-mob-cta"     style="flex:1;text-align:center;background:#3ab54a;color:white;padding:0.75rem 1rem;border-radius:8px;font-size:0.9rem;font-weight:700;text-decoration:none;-webkit-tap-highlight-color:transparent;">List Free</a>
  </div>
</div>

<!-- ── HERO ── -->
<section style="background:linear-gradient(135deg,#0d1a0e 0%,#1a3d1e 55%,#2a5a30 100%);padding:5.5rem 0 4.5rem;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:url('/images/hero-bg.webp');background-size:cover;background-position:center 30%;opacity:0.12;pointer-events:none;"></div>
  <div style="position:absolute;top:-120px;right:-120px;width:500px;height:500px;background:radial-gradient(circle,rgba(58,181,74,0.18) 0%,transparent 65%);pointer-events:none;"></div>

  <div style="max-width:860px;margin:0 auto;padding:0 2.5rem;position:relative;z-index:1;">

    <div class="ft-anim-1" style="display:inline-flex;align-items:center;gap:0.5rem;background:rgba(58,181,74,0.18);color:#7de88a;font-size:0.72rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;padding:0.45rem 1rem;border-radius:20px;margin-bottom:1.75rem;border:1px solid rgba(58,181,74,0.3);">
      For Personal Trainers
    </div>

    <h1 class="ft-anim-2 ft-hero-h1" style="font-family:'Playfair Display',serif;font-size:3.6rem;font-weight:900;line-height:1.1;color:white;margin-bottom:1.5rem;">
      Your results speak<br/>for themselves.<br/><em style="font-style:normal;color:#3ab54a;">Now prove it.</em>
    </h1>

    <p class="ft-anim-3" style="font-size:1.05rem;color:rgba(255,255,255,0.72);line-height:1.8;margin-bottom:2.75rem;max-width:580px;">
      Turn the reputation you've built with your clients into something new clients can discover. Collect verified reviews, grow your BMP and compete in local and UK rankings — giving potential clients another reason to choose you.
    </p>

    <div class="ft-anim-4" style="display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:3rem;">
      <a href="/signup" id="ft-hero-cta"
        style="background:#3ab54a;color:white;padding:1rem 2.25rem;border-radius:8px;font-weight:700;font-size:0.95rem;text-decoration:none;box-shadow:0 4px 20px rgba(58,181,74,0.4);transition:background 0.2s;"
        onmouseover="this.style.background='#2a9438'" onmouseout="this.style.background='#3ab54a'">
        List Your Profile Free →
      </a>
      <a href="#how-it-works"
        style="border:1.5px solid rgba(255,255,255,0.35);color:white;padding:1rem 2.25rem;border-radius:8px;font-weight:600;font-size:0.95rem;text-decoration:none;transition:all 0.2s;"
        onmouseover="this.style.borderColor='#3ab54a';this.style.background='rgba(58,181,74,0.12)'"
        onmouseout="this.style.borderColor='rgba(255,255,255,0.35)';this.style.background='transparent'">
        See How It Works →
      </a>
    </div>

    <ForTrainersTrustBar />
  </div>
</section>

<!-- ── PT BENEFITS ── -->
<section style="padding:6rem 0;background:white;border-top:3px solid #3ab54a;">
  <div style="max-width:1100px;margin:0 auto;padding:0 2.5rem;">
    <div style="text-align:center;max-width:620px;margin:0 auto 4rem;">
      <div style="font-size:0.72rem;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:#3ab54a;margin-bottom:0.75rem;">Why Join?</div>
      <h2 style="font-family:'Playfair Display',serif;font-size:2.5rem;font-weight:900;color:#111311;line-height:1.15;margin-bottom:1rem;">Everything you stand to gain.</h2>
      <p style="font-size:0.95rem;color:#7a8f7c;line-height:1.8;">CoachCards is built around one idea: the best PTs should rise to the top. Here's what that means for you.</p>
    </div>
    <div class="ft-feature-grid">
      {[
        { icon:`<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3ab54a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`, title:'YOUR BUSINESS STAYS YOURS', desc:'We don\'t take a cut of your work or require transactions through the platform. CoachCards is a place to build your reputation — what happens next is between you and your clients.' },
        { icon:`<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2z"/></svg>`, title:'Rise on merit, not budget', desc:'The ranking algorithm cares about one thing: what your clients actually say. Solid coaches rise naturally. You cannot buy your way to the top.' },
        { icon:`<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3ab54a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>`, title:'Keep your existing tools', desc:'Link your Instagram, booking system, and website directly from your profile. CoachCards works alongside your current setup — not instead of it.' },
        { icon:`<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#8B5CF6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`, title:'Show off your highlights', desc:'Add your specialty, certifications, and bio. Let your verified reviews speak for themselves. Clients in your area will see you at your best.' },
        { icon:`<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3ab54a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>`, title:'Get found by serious clients', desc:'People searching CoachCards are actively looking to hire a PT. A strong profile puts you in front of motivated, ready-to-commit clients.' },
        { icon:`<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0EA5E9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M18.66 5.34l1.41-1.41"/><circle cx="12" cy="12" r="4"/></svg>`, title:'WE BUILD THE AUDIENCE. YOU BUILD YOUR REPUTATION.', desc:'We\'re working to grow CoachCards and attract people looking for personal trainers. By joining now, you can start building your profile and reviews while the platform develops.' },
      ].map(f => (
        <div style="background:#f7f9f7;border:1px solid #e0e8e1;border-radius:14px;padding:1.75rem;">
          <div style="margin-bottom:0.85rem;"><Fragment set:html={f.icon} /></div>
          <div style="font-weight:800;font-size:0.95rem;color:#111311;margin-bottom:0.5rem;line-height:1.3;">{f.title}</div>
          <div style="font-size:0.82rem;color:#7a8f7c;line-height:1.75;">{f.desc}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ── EARLY ADOPTER ── -->
<section style="padding:4.5rem 0;background:linear-gradient(135deg,#0d1a0e 0%,#1a3d1e 100%);">
  <div style="max-width:760px;margin:0 auto;padding:0 2.5rem;text-align:center;">
    <div style="display:inline-block;background:rgba(58,181,74,0.2);color:#7de88a;padding:0.4rem 1.1rem;border-radius:20px;font-size:0.7rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;border:1px solid rgba(58,181,74,0.3);margin-bottom:1.5rem;">
      The Early Advantage
    </div>
    <h2 style="font-family:'Playfair Display',serif;font-size:2.25rem;font-weight:900;color:white;line-height:1.15;margin-bottom:1.25rem;">
      YOUR COMPETITORS CAN JOIN TOMORROW.<br/>YOU CAN START TODAY.
    </h2>
    <p style="font-size:0.95rem;color:rgba(255,255,255,0.65);line-height:1.8;max-width:580px;margin:0 auto 1.25rem;">
      CoachCards is growing. The trainers who join now have more time to build their review history and establish their profile before others in their area. The rankings reflect genuine reputation — which takes time to build.
    </p>
    <p style="font-size:0.88rem;color:rgba(255,255,255,0.45);line-height:1.7;max-width:520px;margin:0 auto;">
      Every review you collect now is part of a profile that will be visible to future clients searching in your area.
    </p>
  </div>
</section>

<!-- ── HOW IT WORKS ── -->
<section id="how-it-works" style="padding:5.5rem 0;background:#f7f9f7;border-top:3px solid #3ab54a;">
  <div style="max-width:960px;margin:0 auto;padding:0 2.5rem;">

    <div style="text-align:center;margin-bottom:3.5rem;">
      <div style="font-size:0.72rem;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:#3ab54a;margin-bottom:0.5rem;">Simple &amp; Fast</div>
      <h2 style="font-family:'Playfair Display',serif;font-size:2.25rem;font-weight:900;color:#111311;line-height:1.15;">Up and running in minutes</h2>
      <p style="font-size:0.95rem;color:#7a8f7c;margin-top:0.75rem;max-width:500px;margin-left:auto;margin-right:auto;line-height:1.7;">No tech skills needed. No credit card. No catch.</p>
    </div>

    <div class="ft-step-grid">
      <div class="ft-step">
        <div class="ft-step-num">01</div>
        <div class="ft-step-icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3ab54a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
        <div class="ft-step-title">Create your free profile</div>
        <div class="ft-step-desc">Add your name, city, specialty and qualification. Your public profile goes live immediately — searchable by anyone looking for a PT in your area.</div>
      </div>
      <div class="ft-step">
        <div class="ft-step-num">02</div>
        <div class="ft-step-icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3ab54a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></div>
        <div class="ft-step-title">Share your unique review link</div>
        <div class="ft-step-desc">After every session, send your client a personalised review link via WhatsApp, text or email. Only your real clients can leave a review — no anonymous ratings, ever.</div>
      </div>
      <div class="ft-step">
        <div class="ft-step-num">03</div>
        <div class="ft-step-icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3ab54a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg></div>
        <div class="ft-step-title">Climb the UK rankings</div>
        <div class="ft-step-desc">Every verified review updates your BMP score and your position on the national leaderboard. The more consistent you are, the higher you rank.</div>
      </div>
    </div>

  </div>
</section>

<!-- ── BMP EXPLAINED ── -->
<section style="padding:6rem 0;background:white;border-top:3px solid #3ab54a;border-bottom:3px solid #3ab54a;">
  <div style="max-width:900px;margin:0 auto;padding:0 2.5rem;">
    <div style="text-align:center;margin-bottom:4rem;">
      <div style="font-size:0.72rem;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:#3ab54a;margin-bottom:0.75rem;">The BMP Score</div>
      <h2 style="font-family:'Playfair Display',serif;font-size:2.5rem;font-weight:900;color:#111311;line-height:1.15;margin-bottom:1rem;">Your ranking, explained.</h2>
