<script>
  import { supabase } from '../lib/supabase';
  const { data: { session } } = await supabase.auth.getSession();
  if (session) {
    const { data: trainer } = await supabase.from('trainers').select('id, name').eq('user_id', session.user.id).maybeSingle();
    if (trainer) {
      const label = (trainer.name ? trainer.name.split(' ')[0] + ' · ' : '') + 'My Dashboard →';
      // Desktop nav
      const navSignin  = document.getElementById('ft-nav-signin');
      const navCta     = document.getElementById('ft-nav-cta');
      const navSignout = document.getElementById('ft-nav-signout');
      if (navSignin) navSignin.style.display = 'none';
      if (navCta) { navCta.textContent = label; (navCta as HTMLAnchorElement).href = '/dashboard'; }
      if (navSignout) navSignout.style.display = '';
      // Mobile nav
      const mobSignin = document.getElementById('ft-mob-signin');
      const mobCta    = document.getElementById('ft-mob-cta') as HTMLAnchorElement | null;
      if (mobSignin) mobSignin.style.display = 'none';
      if (mobCta)    { mobCta.textContent = label; mobCta.href = '/dashboard'; }
      // Hero: swap signup CTA for dashboard link
      const heroCta = document.getElementById('ft-hero-cta') as HTMLAnchorElement | null;
      if (heroCta) {
        heroCta.textContent = 'Go to My Dashboard →';
        heroCta.href        = '/dashboard';
      }
      // Bottom CTA: swap entire block
      const ctaGuest    = document.getElementById('ft-bottom-cta-inner');
      const ctaLoggedIn = document.getElementById('ft-bottom-cta-loggedin');
      if (ctaGuest)    ctaGuest.style.display    = 'none';
      if (ctaLoggedIn) ctaLoggedIn.style.display = 'block';
    }
  }

  document.getElementById('ft-nav-signout')?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.href = '/';
  });
</script>

