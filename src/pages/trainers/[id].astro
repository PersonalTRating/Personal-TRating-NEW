)}

<!-- ── GYMS — panel 2b: white ── -->
{Array.isArray(trainer.gyms) && (trainer.gyms as any[]).length > 0 && (
  <section style="padding:3rem 0;background:white;border-bottom:1px solid #e0e8e1;">
    <div style="max-width:900px;margin:0 auto;padding:0 2.5rem;">
      <div style="font-size:0.72rem;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:#3ab54a;margin-bottom:0.5rem;display:inline-block;border-bottom:2px solid #3ab54a;padding-bottom:3px;">Training Locations</div>
      <h2 style="font-family:'Playfair Display',serif;font-size:1.85rem;font-weight:900;color:#111311;margin-top:0.5rem;margin-bottom:1.5rem;">
        Where {trainer.name} trains
      </h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem;">
        {(trainer.gyms as any[]).map((gym: any) => (
          <div style="background:#f4f6f4;border:1px solid #e0e8e1;border-radius:12px;padding:1.25rem 1.5rem;">
            <div style="font-size:1.5rem;margin-bottom:0.5rem;">🏋️</div>
            <div style="font-weight:700;font-size:0.95rem;color:#111311;margin-bottom:0.3rem;">{gym.name}</div>
            <div style="font-size:0.8rem;color:#8a8f8a;">📍 {gym.location}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<!-- ── FEED — hidden until posts load ── -->
<section id="trainer-feed-section" style="padding:3.5rem 0;background:#f4f6f4;border-bottom:1px solid #e0e8e1;display:none;">
  <div style="max-width:900px;margin:0 auto;padding:0 2.5rem;">
    <div style="font-size:0.72rem;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:#3ab54a;margin-bottom:0.5rem;display:inline-block;border-bottom:2px solid #3ab54a;padding-bottom:3px;">Latest Updates</div>
    <h2 style="font-family:'Playfair Display',serif;font-size:1.85rem;font-weight:900;color:#111311;margin-top:0.5rem;margin-bottom:1.5rem;">
      From {trainer.name}
    </h2>
    <div id="trainer-feed-list" class="feed-grid"></div>
  </div>
</section>
<div id="trainer-feed-data" data-trainer-id={trainer.id} style="display:none;"></div>

<!-- ── REVIEWS — panel 3: white ── -->
<section style="padding:5rem 0;background:white;">
  <div style="max-width:900px;margin:0 auto;padding:0 2.5rem;">

    <div style="margin-bottom:2.75rem;">
      <div style="font-size:0.72rem;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:#3ab54a;margin-bottom:0.5rem;display:inline-block;border-bottom:2px solid #3ab54a;padding-bottom:3px;">Verified Reviews</div>
      <h2 style="font-family:'Playfair Display',serif;font-size:2rem;font-weight:900;color:#111311;margin-top:0.5rem;margin-bottom:0;">
        What clients say
      </h2>
    </div>

    {hasReviews ? (
      <>
        <!-- Rating summary -->
        <div style="background:#f4f6f4;border-radius:16px;border:1px solid #e0e8e1;padding:2rem;margin-bottom:2rem;">
          <div class="tp-rating-inner" style="display:flex;align-items:center;gap:3rem;">

            <!-- Big number + dumbbells -->
            <div style="text-align:center;flex-shrink:0;">
              <div style="font-size:4rem;font-weight:900;color:#111311;line-height:1;">{trainer.star_rating}</div>
              <div style="display:flex;gap:4px;justify-content:center;margin:0.5rem 0;">
                <span set:html={bmpDumbbells(trainer.bmp_score, 22)} />
              </div>
              <div style="font-size:0.78rem;color:#8a8f8a;">{reviews.length} verified {reviews.length === 1 ? 'review' : 'reviews'}</div>
            </div>

            <!-- Bar breakdown -->
            <div style="flex:1;display:flex;flex-direction:column;gap:0.6rem;">
              {starCounts.map(({ star, count }) => (
                <div style="display:flex;align-items:center;gap:0.75rem;">
                  <span style="font-size:0.75rem;font-weight:700;color:#111311;width:10px;text-align:right;flex-shrink:0;">{star}</span>
                  <span style="flex-shrink:0;line-height:1;"><Fragment set:html={db(true, 13)} /></span>
                  <div class="db-bar-track">
                    <div class="db-bar-fill" style={`width:${reviews.length > 0 ? Math.round((count / reviews.length) * 100) : 0}%`}></div>
                  </div>
                  <span style="font-size:0.75rem;color:#8a8f8a;width:18px;text-align:right;flex-shrink:0;">{count}</span>
                </div>
              ))}
            </div>

            <!-- Leave a review CTA -->
            <div style="text-align:center;flex-shrink:0;">
              <a href={`/review/${trainer.id}`} class="btn-review" style="display:block;white-space:nowrap;">
                🏋 Leave a Review
              </a>
              <div style="font-size:0.72rem;color:#8a8f8a;margin-top:0.6rem;">Takes 2 minutes</div>
            </div>

          </div>
        </div>

        <!-- Review cards -->
        <div style="display:flex;flex-direction:column;gap:1.25rem;">
          {reviews.map(r => (
            <div class="tp-rev" style="flex-direction:row;align-items:stretch;padding:0;overflow:hidden;">

              {/* Left — avatar, name, date, review text */}
              <div style="flex:1;padding:1.5rem;display:flex;flex-direction:column;gap:0.85rem;min-width:0;">
                <div style="display:flex;align-items:center;gap:0.9rem;">
                  <div style={`width:52px;height:52px;border-radius:50%;background:${r.reviewer_avatar_bg};color:${r.reviewer_avatar_color};display:flex;align-items:center;justify-content:center;font-weight:800;font-size:1rem;flex-shrink:0;`}>
                    {r.is_anonymous ? r.reviewer_initials[0] : r.reviewer_initials}
                  </div>
                  <div>
                    <div style="font-weight:700;font-size:0.95rem;color:#111311;">
                      {r.is_anonymous ? maskName(r.reviewer_name) : r.reviewer_name}
                    </div>
                    <div style="font-size:0.75rem;color:#8a8f8a;margin-top:0.15rem;">
                      {formatDate(r.created_at)}
                    </div>
                  </div>
                </div>
                <p style="font-size:0.875rem;line-height:1.85;color:#111311;font-style:italic;margin:0;">"{r.review_text}"</p>
              </div>

              {/* Right — BMP panel */}
              <div style="width:160px;flex-shrink:0;border-left:1px solid #e0e8e1;background:#fafbfa;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:1.5rem 1rem;gap:0.5rem;text-align:center;">
                <div style="font-size:0.62rem;font-weight:700;letter-spacing:0.08em;color:#8a8f8a;">BMP</div>
                <div style="font-family:'Playfair Display',serif;font-size:2.5rem;font-weight:900;line-height:1;color:#111311;">{Math.round(r.rating * 20)}<span style="font-size:1.1rem;font-weight:700;color:#2a9438;">%</span></div>
                <span style="display:flex;gap:2px;justify-content:center;"><Fragment set:html={dumbbells(r.rating, 17)} /></span>
                <div style="font-size:0.7rem;color:#2a9438;font-weight:600;margin-top:0.2rem;">
                  {r.is_anonymous ? '✓ Verified · Anonymous' : '✓ Verified Client'}
                </div>
              </div>

            </div>
          ))}
        </div>
      </>
    ) : (
      <div style="background:#f4f6f4;border-radius:16px;border:1px dashed #c3e6c8;padding:4rem 2rem;text-align:center;">
        <div style="font-size:2.5rem;margin-bottom:1rem;"><Fragment set:html={dumbbells(0, 28)} /></div>
        <div style="font-family:'Playfair Display',serif;font-size:1.35rem;font-weight:700;color:#111311;margin-bottom:0.6rem;">No reviews yet</div>
        <div style="color:#8a8f8a;font-size:0.9rem;margin-bottom:2rem;max-width:380px;margin-left:auto;margin-right:auto;line-height:1.7;">
          Be the first to leave a verified review and help {trainer.name} build their ranking.
        </div>
        <a href={`/review/${trainer.id}`} class="btn-review">
          🏋 Be the First to Review
        </a>
      </div>
    )}

  </div>
</section>

<!-- ── CTA — panel 4: dark ── -->
<section style="padding:5.5rem 0;background:linear-gradient(135deg,#0d1a0e 0%,#1a3d1e 60%,#2a5a30 100%);text-align:center;">
  <div style="max-width:560px;margin:0 auto;padding:0 2.5rem;">
    <div style="display:inline-block;background:rgba(58,181,74,0.2);color:#7de88a;padding:0.4rem 1rem;border-radius:20px;font-size:0.72rem;font-weight:700;margin-bottom:1.5rem;letter-spacing:1.5px;text-transform:uppercase;border:1px solid rgba(58,181,74,0.3);">
      Verified Trainer
    </div>
    <h2 style="font-family:'Playfair Display',serif;font-size:2.25rem;font-weight:900;color:white;margin-bottom:1rem;line-height:1.15;">
      Worked with {trainer.name}?
    </h2>
    <p style="color:rgba(255,255,255,0.55);font-size:0.95rem;margin-bottom:2.5rem;line-height:1.8;max-width:440px;margin-left:auto;margin-right:auto;">
      Your honest review helps other clients find great trainers and builds their BMP ranking on Personal TRating.
    </p>
    <a href={`/review/${trainer.id}`} class="btn-review" style="font-size:1rem;padding:1rem 2.5rem;">
      🏋 Leave a Verified Review
    </a>
    <div style="margin-top:1rem;font-size:0.78rem;color:rgba(255,255,255,0.35);">Takes 2 minutes · No account needed</div>
  </div>
</section>

<!-- ── FOOTER ── -->
<footer style="padding:2rem 2.5rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;background:#0a130b;border-top:1px solid rgba(255,255,255,0.06);">
  <div style="display:flex;align-items:center;gap:0.75rem;">
    <img src="/images/logo.png" alt="Personal TRating" style="height:44px;width:auto;object-fit:contain;opacity:0.55;" />
    <p style="font-size:0.8rem;color:rgba(255,255,255,0.3);">© 2026 Personal TRating™ · All rights reserved · Built in the UK 🇬🇧</p>
  </div>
  <div style="display:flex;gap:2rem;">
    {[['Home','/'],['Privacy','#'],['Terms','#'],['Contact','#']].map(([label,href]) => (
      <a href={href} style="color:rgba(255,255,255,0.3);text-decoration:none;font-size:0.8rem;font-weight:500;transition:color 0.2s;"
        onmouseover="this.style.color='rgba(255,255,255,0.7)'" onmouseout="this.style.color='rgba(255,255,255,0.3)'">
        {label}
      </a>
    ))}
  </div>
</footer>

<script>
  import { supabase } from '../../lib/supabase';

  (async () => {
  const trainerId = (document.getElementById('trainer-feed-data') as HTMLElement | null)?.dataset.trainerId;
  if (!trainerId) return;

  const { data: { session } } = await supabase.auth.getSession();
  const currentUserId = session?.user?.id ?? null;

  const { data } = await supabase
    .from('trainer_posts')
    .select('id, content, image_url, created_at')
    .eq('trainer_id', trainerId)
    .order('created_at', { ascending: false })
    .limit(20);

  const posts = data ?? [];
  const section = document.getElementById('trainer-feed-section');
  const list    = document.getElementById('trainer-feed-list');
  if (!section || !list || posts.length === 0) return;

    const postIds = posts.map((p: any) => p.id);

    // Fetch all likes for these posts
    const { data: allLikes } = await supabase
      .from('post_likes')
      .select('post_id, user_id')
      .in('post_id', postIds);

    // Build like count map and user-liked set
    const likeMap: Record<string, number> = {};
    const userLiked = new Set<string>();
    postIds.forEach((id: string) => { likeMap[id] = 0; });
    (allLikes ?? []).forEach((l: any) => {
      likeMap[l.post_id] = (likeMap[l.post_id] ?? 0) + 1;
      if (l.user_id === currentUserId) userLiked.add(l.post_id);
    });

    section.style.display = '';
    list.innerHTML = posts.map((p: any) => {
      const date    = new Date(p.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
      const liked   = userLiked.has(p.id);
      const count   = likeMap[p.id] ?? 0;
      return `<div class="feed-card">
        ${p.image_url ? `<img src="${p.image_url}" class="feed-card-img" alt="" loading="lazy" />` : ''}
        <div class="feed-card-body">
          ${p.content ? `<div class="feed-card-text">${p.content}</div>` : ''}
          <div class="feed-card-footer">
            <div class="feed-card-date">${date}</div>
            <button class="like-btn" id="like-btn-${p.id}" data-liked="${liked}" onclick="toggleLike('${p.id}')" title="${currentUserId ? (liked ? 'Unlike' : 'Like') : 'Sign in to like'}">
              <span class="like-heart" style="color:${liked ? '#e53935' : '#d1d5d2'};">${liked ? '❤️' : '🤍'}</span>
              <span class="like-count" id="like-count-${p.id}">${count > 0 ? count : ''}</span>
            </button>
          </div>
        </div>
      </div>`;
    }).join('');

    (window as any).toggleLike = async (postId: string) => {
      if (!currentUserId) { window.location.href = '/login'; return; }
      const btn     = document.getElementById('like-btn-' + postId) as HTMLButtonElement;
      const countEl = document.getElementById('like-count-' + postId) as HTMLElement;
      const heart   = btn.querySelector('.like-heart') as HTMLElement;
      const isLiked = btn.dataset.liked === 'true';
      const cur     = parseInt(countEl.textContent || '0', 10);

      // Optimistic update
      if (isLiked) {
        btn.dataset.liked    = 'false';
        heart.textContent    = '🤍';
        heart.style.color    = '#d1d5d2';
        countEl.textContent  = cur - 1 > 0 ? String(cur - 1) : '';
        await supabase.from('post_likes').delete().eq('post_id', postId).eq('user_id', currentUserId);
      } else {
        btn.dataset.liked    = 'true';
        heart.textContent    = '❤️';
        heart.style.color    = '#e53935';
        countEl.textContent  = String(cur + 1);
        await supabase.from('post_likes').insert({ post_id: postId, user_id: currentUserId });
      }
    };
  })();
</script>

<script>
  import { supabase } from '../../lib/supabase';
  const { data: { session } } = await supabase.auth.getSession();
  if (session) {
    const { data: trainerRow } = await supabase.from('trainers').select('id').eq('user_id', session.user.id).maybeSingle();
    if (trainerRow) {
      // Hide every review CTA and chat button — trainers cannot leave reviews or self-chat
      document.querySelectorAll<HTMLElement>('.btn-review, a[href*="/review/"], #chat-trigger-btn').forEach(el => { el.style.display = 'none'; });
    } else {
      const { data: client } = await supabase.from('clients').select('id').eq('user_id', session.user.id).maybeSingle();
