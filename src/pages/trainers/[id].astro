  }
</script>

<script>
  import { supabase } from '../../lib/supabase';

  // Read trainer data injected by server
  const _d = (document.getElementById('chat-trainer-data') as HTMLElement).dataset;
  const TRAINER_ID       = _d.trainerId!;
  const TRAINER_NAME     = _d.trainerName!;
  const AVATAR_URL       = _d.avatarUrl!;
  const AVATAR_INITIALS  = _d.avatarInitials!;
  const AVATAR_BG        = _d.avatarBg!;
  const AVATAR_COLOR     = _d.avatarColor!;

  // Populate header avatar + name immediately
  const _av = document.getElementById('chat-av')!;
  document.getElementById('chat-hdr-name')!.textContent = TRAINER_NAME;
  if (AVATAR_URL) {
    _av.innerHTML = `<img src="${AVATAR_URL}" style="width:100%;height:100%;object-fit:cover;" alt="" />`;
  } else {
    Object.assign(_av.style, { background: AVATAR_BG, color: AVATAR_COLOR });
    _av.textContent = AVATAR_INITIALS;
  }

  let _convId: string | null   = null;
  let _clientId: string | null = null;
  let _channel: any            = null;

  function _showState(id: string) {
    ['chat-state-guest','chat-state-trainer','chat-state-loading','chat-state-active'].forEach(s => {
      const el = document.getElementById(s)!;
      el.style.display = s === id ? (s === 'chat-state-active' ? 'flex' : 'flex') : 'none';
      if (s === id && s === 'chat-state-active') el.style.flexDirection = 'column';
    });
  }

  (window as any).openChat = async function() {
    const panel = document.getElementById('chat-panel')!;
    panel.classList.remove('chat-panel-hidden');
    requestAnimationFrame(() => requestAnimationFrame(() => panel.classList.add('open')));

    // Already loaded — just reopen
    if (_convId) {
      _showState('chat-state-active');
      _scrollChat();
      if (!_channel) _subscribeChat();
      return;
    }

    _showState('chat-state-loading');

    const { data: { session } } = await supabase.auth.getSession();

    if (!session) { _showState('chat-state-guest'); return; }

    const { data: clientRow } = await supabase
      .from('clients').select('id, name')
      .eq('user_id', session.user.id).maybeSingle();

    if (!clientRow) { _showState('chat-state-trainer'); return; }

    _clientId = clientRow.id;

    // Load or create conversation
    let { data: conv } = await supabase
      .from('conversations').select('id')
      .eq('trainer_id', TRAINER_ID).eq('client_id', _clientId).maybeSingle();

    if (!conv) {
      const { data: created } = await supabase
        .from('conversations')
        .insert({ trainer_id: TRAINER_ID, client_id: _clientId })
        .select('id').single();
      conv = created;
    }

    if (!conv) { _showState('chat-state-guest'); return; }

    _convId = conv.id;

    // Reset client unread
    await supabase.from('conversations').update({ client_unread_count: 0 }).eq('id', _convId);

    // Load messages
    await _loadMsgs();
    _showState('chat-state-active');
    _scrollChat();
    _subscribeChat();
  };

  (window as any).closeChat = function() {
    const panel = document.getElementById('chat-panel')!;
    panel.classList.remove('open');
    setTimeout(() => panel.classList.add('chat-panel-hidden'), 300);
    if (_channel) { _channel.unsubscribe(); _channel = null; }
  };

  async function _loadMsgs() {
    const { data: msgs } = await supabase
      .from('messages').select('id, sender_type, content, created_at')
      .eq('conversation_id', _convId!).order('created_at', { ascending: true });
    const container = document.getElementById('chat-msgs')!;
    const _msgList = msgs || [];
    const _INTRO = "Hi! Thanks for reaching out. I'd love to hear about your fitness goals — feel free to ask me anything or let me know what you're looking for in a PT.";
    container.innerHTML = (_msgList.length === 0 ? _renderMsg({ sender_type: 'trainer', content: _INTRO, created_at: new Date().toISOString() }) : '') + _msgList.map(_renderMsg).join('');
  }

  function _renderMsg(m: any): string {
    const time = new Date(m.created_at).toLocaleTimeString('en-GB', { hour:'2-digit', minute:'2-digit' });
    const esc  = (s: string) => s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>');
    return `<div class="chat-msg ${m.sender_type}">
      <div class="chat-bubble">${esc(m.content)}</div>
      <div class="chat-time">${time}</div>
    </div>`;
  }

  function _scrollChat() {
    const el = document.getElementById('chat-msgs');
    if (el) el.scrollTop = el.scrollHeight;
  }

  function _subscribeChat() {
    if (!_convId || _channel) return;
    _channel = supabase.channel(`chat-${_convId}`)
      .on('postgres_changes', { event:'INSERT', schema:'public', table:'messages',
        filter:`conversation_id=eq.${_convId}` }, (p: any) => {
          const container = document.getElementById('chat-msgs');
          if (container) { container.insertAdjacentHTML('beforeend', _renderMsg(p.new)); _scrollChat(); }
        })
      .subscribe();
  }

  (window as any).sendChatMsg = async function() {
    if (!_convId || !_clientId) return;
    const inp = document.getElementById('chat-input') as HTMLTextAreaElement;
    const content = inp.value.trim();
    if (!content) return;
    const btn = document.getElementById('chat-send-btn') as HTMLButtonElement;
    btn.disabled = true;
    inp.value = '';
    inp.style.height = 'auto';
    await supabase.from('messages').insert({ conversation_id: _convId, sender_type: 'client', content });
    btn.disabled = false;
    inp.focus();
  };

  // Auto-resize chat textarea
  document.getElementById('chat-input')?.addEventListener('input', function(this: HTMLTextAreaElement) {
    this.style.height = 'auto';
    this.style.height = Math.min(this.scrollHeight, 110) + 'px';
  });
</script>

<!-- ── CHAT DATA (server → client) ── -->
<div id="chat-trainer-data"
  data-trainer-id={trainer.id}
  data-trainer-name={trainer.name}
  data-avatar-url={trainer.avatar_url ?? ''}
  data-avatar-initials={trainer.avatar_initials ?? ''}
  data-avatar-bg={trainer.avatar_bg ?? '#eaf7ec'}
  data-avatar-color={trainer.avatar_color ?? '#2a9438'}
  style="display:none;"></div>

<!-- ── CHAT PANEL ── -->
<div id="chat-panel" class="chat-panel chat-panel-hidden">

  <!-- Header -->
  <div class="chat-hdr">
    <div class="chat-hdr-av" id="chat-av"></div>
    <div>
      <div class="chat-hdr-name" id="chat-hdr-name">…</div>
      <div class="chat-hdr-sub">Personal Trainer · Personal TRating</div>
    </div>
    <button class="chat-hdr-close" onclick="closeChat()">✕</button>
  </div>

  <!-- Guest: not logged in -->
  <div id="chat-state-guest" class="chat-notice" style="display:none;">
    <div style="font-size:2.2rem;margin-bottom:1rem;">💬</div>
    <div style="font-weight:700;font-size:0.95rem;color:#111311;margin-bottom:0.5rem;">Sign in to start chatting</div>
    <div style="font-size:0.82rem;color:#7a8f7c;line-height:1.65;margin-bottom:1.5rem;max-width:240px;">Create a free account to message this trainer directly.</div>
    <a href="/login"  style="display:block;text-align:center;background:#3ab54a;color:white;padding:0.7rem 1.4rem;border-radius:8px;font-weight:700;font-size:0.875rem;text-decoration:none;margin-bottom:0.65rem;width:200px;">Sign In</a>
    <a href="/signup" style="display:block;text-align:center;border:1.5px solid #3ab54a;color:#3ab54a;padding:0.7rem 1.4rem;border-radius:8px;font-weight:700;font-size:0.875rem;text-decoration:none;width:200px;">Create Account</a>
  </div>

  <!-- Trainer logged in — can't self-chat -->
  <div id="chat-state-trainer" class="chat-notice" style="display:none;">
    <div style="font-size:2rem;margin-bottom:0.85rem;">👋</div>
    <div style="font-weight:700;font-size:0.95rem;color:#111311;margin-bottom:0.5rem;">You're logged in as a trainer</div>
    <div style="font-size:0.82rem;color:#7a8f7c;line-height:1.65;max-width:240px;">The chat feature is for clients. Sign in with a client account to use it.</div>
  </div>

  <!-- Loading -->
  <div id="chat-state-loading" class="chat-notice" style="display:none;">
    <div style="font-size:1.6rem;color:#3ab54a;animation:spin 1s linear infinite;">↻</div>
    <div style="font-size:0.82rem;color:#7a8f7c;margin-top:0.6rem;">Loading…</div>
  </div>

  <!-- Active chat -->
  <div id="chat-state-active" style="display:none;flex:1;flex-direction:column;overflow:hidden;">
    <div id="chat-msgs" class="chat-msgs"></div>
    <div class="chat-input-row">
      <textarea id="chat-input" class="chat-input" placeholder="Type a message…" rows="1"
        onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendChatMsg();}"></textarea>
      <button id="chat-send-btn" class="chat-send" onclick="sendChatMsg()">➤</button>
    </div>
  </div>

</div>

<style is:global>
@keyframes spin { to { transform:rotate(360deg); } }
</style>

<script>
  import { supabase } from '../../lib/supabase';
  (async () => {
    const trainerId = (document.getElementById('trainer-feed-data') as HTMLElement | null)?.dataset.trainerId;
    if (!trainerId) return;

    // Skip if this browser already counted a view in the last 24 hours
    const key = 'pt_viewed_' + trainerId;
    const lastViewed = parseInt(localStorage.getItem(key) || '0', 10);
    if (Date.now() - lastViewed < 86_400_000) return;

    // Skip if the visitor is the trainer themselves
    const { data: { session } } = await supabase.auth.getSession();
    if (session) {
      const { data: ownRow } = await supabase.from('trainers').select('id').eq('user_id', session.user.id).maybeSingle();
      if (ownRow?.id === trainerId) return;
    }

    await supabase.from('profile_views').insert({ trainer_id: trainerId });
    localStorage.setItem(key, String(Date.now()));
  })();
</script>
