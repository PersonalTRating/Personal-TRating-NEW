---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

export async function getStaticPaths() {
  const { data: trainers } = await supabase
    .from('trainers')
    .select('id')
    .eq('is_active', true);

  return (trainers || []).map(t => ({ params: { id: t.id } }));
}

const { id } = Astro.params;

const { data: trainer } = await supabase
  .from('trainers')
  .select('*')
  .eq('id', id)
  .single();

if (!trainer) return Astro.redirect('/');

const { data: trainerReviews } = await supabase
  .from('reviews')
  .select('*')
  .eq('trainer_id', id)
  .eq('is_verified', true)
  .order('created_at', { ascending: false });

const reviews    = trainerReviews || [];
const hasReviews = reviews.length > 0;
const hasBmp     = hasReviews;

const starCounts = [5, 4, 3, 2, 1].map(s => ({
  star:  s,
  count: reviews.filter(r => Math.round(r.rating) === s).length,
}));

const rankBadge =
  trainer.bmp_score >= 95 ? { label: 'Elite',    color: '#b8860b', bg: '#fdf6e3' } :
  trainer.bmp_score >= 85 ? { label: 'Advanced', color: '#2a9438', bg: '#eaf7ec' } :
  trainer.bmp_score >= 75 ? { label: 'Skilled',  color: '#1a4b6b', bg: '#e8f0f7' } :
                             { label: 'Rising',   color: '#6b1a6b', bg: '#f5e8f7' };

const specialtyEmoji: Record<string, string> = {
  'Strength & Conditioning': '💪',
  'Weight Loss':             '🔥',
  'HIIT & Cardio':           '⚡',
  'Rehabilitation':          '🧘',
  'Nutrition Coaching':      '🥗',
  'Sports Performance':      '🏃',
};
const emoji = specialtyEmoji[trainer.specialty] ?? '🏋️';

const formatDate = (dateStr: string) =>
  new Date(dateStr).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });

const heroThemes: Record<string, string> = {
  forest:   'linear-gradient(135deg,#0d1a0e 0%,#1a3d1e 55%,#2a5a30 100%)',
  midnight: 'linear-gradient(135deg,#0a0f1e 0%,#1a2240 55%,#2a3a6a 100%)',
  charcoal: 'linear-gradient(135deg,#111111 0%,#252525 55%,#333333 100%)',
  royal:    'linear-gradient(135deg,#1a0a2e 0%,#2d1a4a 55%,#4a2a7a 100%)',
  slate:    'linear-gradient(135deg,#0a1828 0%,#1a2c40 55%,#2a3e58 100%)',
  rose:     'linear-gradient(135deg,#3d0a1e 0%,#6b1a3a 55%,#8b2252 100%)',
  lavender: 'linear-gradient(135deg,#1e0a3d 0%,#3a1a6b 55%,#5c2a8b 100%)',
  sky:      'linear-gradient(135deg,#0a1e3d 0%,#1a3a6b 55%,#2a5a8b 100%)',
};
const heroBackground = heroThemes[trainer.hero_theme ?? 'forest'] ?? heroThemes.forest;

// Accent colours for box borders — reflect each theme on the white content sections
const themeAccents: Record<string, string> = {
  forest:   '#b8ddc0',
  midnight: '#aabce0',
  charcoal: '#c8c8c8',
  royal:    '#caaae8',
  slate:    '#aabcd0',
  rose:     '#e0aac8',
  lavender: '#c8aae8',
  sky:      '#aacce0',
};
const themeAccent = themeAccents[trainer.hero_theme ?? 'forest'] ?? themeAccents.forest;

// ── SEO ──────────────────────────────────────────────────────────────────────
const trainerCity = trainer.city ?? trainer.location ?? 'the UK';
const seoTitle = `${trainer.name} — Personal Trainer in ${trainerCity} · Personal TRating`;

const seoParts = [
  trainer.specialty ? `Specialising in ${trainer.specialty}.` : null,
  hasReviews
    ? `Rated ${trainer.star_rating}/5 from ${reviews.length} verified client${reviews.length === 1 ? '' : 's'}.`
    : 'New to Personal TRating — be the first to leave a review.',
  trainer.cert ? `${trainer.cert} certified.` : null,
  `Find and rate the best personal trainers in the UK on Personal TRating.`,
].filter(Boolean);
const seoDescription = seoParts.join(' ');

const ogImage = trainer.avatar_url ?? `${Astro.url.origin}/images/logo.png`;

// Dumbbell SVG helpers — replace star icons throughout
const db = (filled: boolean, w = 20): string => {
  const c  = filled ? '#FFB800' : '#d4dbd5';
  const sk = filled ? 'rgba(0,0,0,0.3)' : 'rgba(0,0,0,0.08)';
  const h  = Math.round(w * 0.46);
  return `<svg viewBox="0 0 28 12" width="${w}" height="${h}" style="display:inline-block;vertical-align:middle;" aria-hidden="true"><rect x="0" y="0.5" width="8" height="11" rx="2.5" fill="${c}" stroke="${sk}" stroke-width="0.7"/><rect x="8" y="3.5" width="12" height="5" fill="${c}" stroke="${sk}" stroke-width="0.7"/><rect x="20" y="0.5" width="8" height="11" rx="2.5" fill="${c}" stroke="${sk}" stroke-width="0.7"/></svg>`;
};
// For individual review ratings (1–5 scale)
const dumbbells = (rating: number, w = 20): string => {
  const n = Math.min(5, Math.max(0, Math.round(rating)));
  return Array.from({ length: 5 }, (_, i) => db(i < n, w)).join('');
};
// Mask full name to initials for anonymous reviews (e.g. "John Smith" → "J. S.")
const maskName = (name: string): string => {
  const parts = name.trim().split(/\s+/).filter(Boolean);
  if (!parts.length) return 'Anonymous';
  if (parts.length === 1) return parts[0][0].toUpperCase() + '.';
  return parts[0][0].toUpperCase() + '. ' + parts[parts.length - 1][0].toUpperCase() + '.';
};

// For BMP aggregate score (0–100 scale, each dumbbell = 20%)
const bmpDumbbells = (bmp: number, w = 20): string => {
  const n = bmp > 0 ? Math.min(5, Math.ceil(bmp / 20)) : 0;
  return Array.from({ length: 5 }, (_, i) => db(i < n, w)).join('');
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  ogImage={ogImage}
  canonicalUrl={Astro.url.href}
>

<style is:global>
  /* ── Trainer profile ──────────────────────────────────── */
  .tp-stat  { background:white; border-radius:12px; padding:1.5rem 1.25rem; border:1px solid var(--tp-accent,#e0e8e1); text-align:center; }
  .tp-rev   { background:white; border-radius:14px; padding:1.75rem; border:1px solid var(--tp-accent,#e0e8e1); display:flex; flex-direction:column; transition:box-shadow 0.2s, transform 0.2s; }
  .tp-rev:hover { box-shadow:0 4px 24px rgba(0,0,0,0.08); transform:translateY(-2px); }

  .db-bar-track { flex:1; height:8px; background:#e0e8e1; border-radius:4px; overflow:hidden; }
  .db-bar-fill  { height:100%; background:#FFB800; border-radius:4px; }

  .btn-review {
    display:inline-flex; align-items:center; gap:0.5rem;
    background:#3ab54a; color:white;
    padding:0.85rem 2rem; border-radius:8px;
    font-weight:700; font-size:0.92rem; text-decoration:none;
    box-shadow:0 4px 16px rgba(58,181,74,0.32);
    transition:background 0.2s, transform 0.15s, box-shadow 0.2s;
  }
  .btn-review:hover { background:#2a9438; transform:translateY(-1px); box-shadow:0 6px 20px rgba(58,181,74,0.4); }

  .bmp-info { position:relative; cursor:pointer; }
  .bmp-tooltip {
    display:none; position:absolute; bottom:calc(100% + 8px); left:50%; transform:translateX(-50%);
    width:220px; background:#0d1a0e; color:rgba(255,255,255,0.85); font-size:0.72rem;
    padding:0.65rem 0.85rem; border-radius:8px; line-height:1.6; text-align:left; z-index:10;
    box-shadow:0 4px 16px rgba(0,0,0,0.3);
  }
  .bmp-tooltip::after {
    content:''; position:absolute; top:100%; left:50%; transform:translateX(-50%);
    border:6px solid transparent; border-top-color:#0d1a0e;
  }
  .bmp-info:hover .bmp-tooltip { display:block; }

  /* Feed */
  .feed-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:1.25rem; }
  .feed-card { background:white; border-radius:14px; border:1px solid #e0e8e1; overflow:hidden; display:flex; flex-direction:column; }
  .feed-card-img { width:100%; aspect-ratio:4/3; object-fit:cover; display:block; }
  .feed-card-body { padding:1rem 1.1rem 1.1rem; flex:1; display:flex; flex-direction:column; gap:0.5rem; }
  .feed-card-text { font-size:0.875rem; line-height:1.7; color:#111311; flex:1; }
  .feed-card-footer { display:flex; align-items:center; justify-content:space-between; margin-top:0.25rem; }
  .feed-card-date { font-size:0.7rem; color:#aab8ac; }
  .like-btn { display:flex; align-items:center; gap:0.35rem; background:none; border:none; cursor:pointer; padding:0.3rem 0.5rem; border-radius:20px; transition:background 0.15s; }
  .like-btn:hover { background:#fef2f2; }
  .like-heart { font-size:1.1rem; line-height:1; transition:transform 0.15s; }
  .like-btn:active .like-heart { transform:scale(1.3); }
  .like-count { font-size:0.78rem; font-weight:600; color:#aab8ac; min-width:12px; }
  .like-btn[data-liked="true"] .like-count { color:#e53935; }
  @media (max-width:600px) { .feed-grid { grid-template-columns:1fr; } }

  /* ── Chat ── */
  .btn-chat {
    display:inline-flex; align-items:center; gap:0.5rem;
    border:2px solid rgba(255,255,255,0.4); color:white;
    background:rgba(255,255,255,0.08);
    padding:0.85rem 1.75rem; border-radius:8px;
    font-weight:600; font-size:0.92rem; cursor:pointer;
    font-family:inherit; transition:all 0.2s;
    white-space:nowrap;
  }
  .btn-chat:hover { border-color:rgba(255,255,255,0.85); background:rgba(255,255,255,0.16); }

  .chat-panel {
    position:fixed; bottom:24px; right:24px;
    width:360px; height:520px;
    background:white; border-radius:16px;
    box-shadow:0 12px 48px rgba(0,0,0,0.2), 0 2px 8px rgba(0,0,0,0.08);
    display:flex; flex-direction:column; z-index:9999; overflow:hidden;
    transform:translateY(24px); opacity:0;
    transition:transform 0.3s cubic-bezier(0.4,0,0.2,1), opacity 0.3s ease;
    pointer-events:none;
  }
  .chat-panel.open { transform:translateY(0); opacity:1; pointer-events:all; }
  .chat-panel-hidden { display:none !important; }

  .chat-hdr {
    background:linear-gradient(135deg,#0d1a0e,#1a3d1e);
    padding:1rem 1.1rem; display:flex; align-items:center; gap:0.85rem; flex-shrink:0;
  }
  .chat-hdr-av {
    width:38px; height:38px; border-radius:50%; overflow:hidden; flex-shrink:0;
    border:2px solid rgba(255,255,255,0.2);
    display:flex; align-items:center; justify-content:center;
    font-weight:800; font-size:0.9rem;
  }
  .chat-hdr-name { font-weight:700; font-size:0.88rem; color:white; }
  .chat-hdr-sub  { font-size:0.68rem; color:rgba(255,255,255,0.45); margin-top:0.1rem; }
  .chat-hdr-close {
    margin-left:auto; background:rgba(255,255,255,0.1); border:none; color:rgba(255,255,255,0.7);
    width:28px; height:28px; border-radius:50%; cursor:pointer; font-size:0.9rem;
    display:flex; align-items:center; justify-content:center; transition:background 0.15s; flex-shrink:0;
  }
  .chat-hdr-close:hover { background:rgba(255,255,255,0.22); }

  .chat-msgs {
    flex:1; overflow-y:auto; padding:1rem;
    display:flex; flex-direction:column; gap:0.7rem; background:#f7f9f7;
  }
  .chat-msg { display:flex; flex-direction:column; max-width:78%; }
  .chat-msg.trainer { align-self:flex-start; }
  .chat-msg.client  { align-self:flex-end; }
  .chat-bubble {
    padding:0.6rem 0.88rem; border-radius:14px;
    font-size:0.875rem; line-height:1.5; word-break:break-word;
  }
  .chat-msg.trainer .chat-bubble { background:white; color:#111311; border:1px solid #e0e8e1; border-bottom-left-radius:4px; }
  .chat-msg.client  .chat-bubble { background:#111311; color:white; border-bottom-right-radius:4px; }
  .chat-time { font-size:0.6rem; color:#aab8ac; margin-top:0.18rem; }
  .chat-msg.client .chat-time { text-align:right; }

  .chat-input-row {
    padding:0.8rem; border-top:1px solid #e0e8e1;
    display:flex; gap:0.5rem; align-items:flex-end; background:white; flex-shrink:0;
  }
  .chat-input {
    flex:1; border:1.5px solid #e0e8e1; border-radius:10px;
    padding:0.6rem 0.8rem; font-size:0.875rem; font-family:inherit;
    resize:none; min-height:40px; max-height:110px; outline:none; transition:border-color 0.2s;
  }
  .chat-input:focus { border-color:#3ab54a; }
  .chat-send {
    background:#3ab54a; border:none; color:white; border-radius:10px;
    width:40px; height:40px; cursor:pointer; display:flex; align-items:center;
    justify-content:center; font-size:1rem; flex-shrink:0; transition:background 0.15s;
  }
  .chat-send:hover { background:#2a9438; }
  .chat-send:disabled { background:#c3e6c8; cursor:not-allowed; }

  .chat-notice {
    flex:1; display:flex; flex-direction:column; align-items:center;
    justify-content:center; padding:2rem; text-align:center; background:#f7f9f7;
  }

  @media (max-width:480px) {
    .chat-panel { bottom:0; right:0; left:0; width:100%; border-bottom-left-radius:0; border-bottom-right-radius:0; height:72vh; }
  }

  @media (max-width:860px) {
    .tp-hero-inner   { flex-direction:column !important; align-items:flex-start !important; gap:1.5rem !important; }
    .tp-bmp-box      { align-self:stretch !important; text-align:center !important; }
    .tp-stats-grid   { grid-template-columns:repeat(2,1fr) !important; }
    .tp-rev-grid     { grid-template-columns:1fr !important; }
    .tp-rating-inner { flex-direction:column !important; gap:1.5rem !important; }
  }
  @media (max-width:600px) {
    .tp-hero-name  { font-size:1.85rem !important; }
    .tp-stats-grid { grid-template-columns:1fr 1fr !important; gap:0.75rem !important; }
    /* Tighten hero and section padding on small phones */
    .tp-hero-section  { padding:2.5rem 1.25rem 2.5rem !important; }
    section > div[style*="max-width:900px"] { padding-left:1.25rem !important; padding-right:1.25rem !important; }
    .tp-rev { padding:1.25rem !important; }
    .btn-review { padding:0.75rem 1.25rem !important; font-size:0.82rem !important; }
  }
</style>

<!-- Inject theme accent colour as CSS variable -->
<Fragment set:html={`<style>:root{--tp-accent:${themeAccent};}</style>`} />

<!-- ── NAV ── -->
<nav style="position:sticky;top:0;z-index:100;background:white;border-bottom:1px solid #e0e8e1;box-shadow:0 1px 8px rgba(0,0,0,0.05);">
  <div style="max-width:1200px;margin:0 auto;padding:0 2.5rem;display:flex;align-items:center;justify-content:space-between;height:100px;">
    <a href="/" style="text-decoration:none;">
      <img src="/images/logo.png" alt="Personal TRating" style="height:83px;width:auto;object-fit:contain;border:2.5px solid #3ab54a;border-radius:10px;background:white;padding:4px;" />
    </a>
    <div style="display:flex;gap:1.25rem;align-items:center;">
      <a href="/#leaderboard" style="color:#8a8f8a;font-size:0.875rem;font-weight:600;text-decoration:none;transition:color 0.2s;"
        onmouseover="this.style.color='#111311'" onmouseout="this.style.color='#8a8f8a'">
        ← All Rankings
      </a>
      <a href={`/review/${trainer.id}`} class="btn-review" style="padding:0.6rem 1.4rem;font-size:0.875rem;">
        🏋 Leave a Review
      </a>
      <a href="/account" id="nav-account" style="display:none;color:#111311;text-decoration:none;font-size:0.875rem;font-weight:600;">My Account</a>
    </div>
  </div>
</nav>

<!-- ── PROFILE HERO ── -->
<section style={`background:${heroBackground};padding:4rem 0 3.5rem;`}>
  <div style="max-width:900px;margin:0 auto;padding:0 2.5rem;">

    <a href="/#leaderboard" style="color:rgba(255,255,255,0.45);font-size:0.82rem;font-weight:500;text-decoration:none;display:inline-block;margin-bottom:2.25rem;transition:color 0.2s;"
      onmouseover="this.style.color='rgba(255,255,255,0.8)'" onmouseout="this.style.color='rgba(255,255,255,0.45)'">
      ← Back to Rankings
    </a>

    <div class="tp-hero-inner" style="display:flex;align-items:center;gap:2.5rem;">

      <!-- Avatar -->
      {trainer.avatar_url ? (
        <img src={trainer.avatar_url} alt={trainer.name}
          style={`width:120px;height:120px;border-radius:50%;object-fit:cover;flex-shrink:0;border:4px solid ${trainer.avatar_color ?? 'rgba(255,255,255,0.3)'};box-shadow:0 8px 32px rgba(0,0,0,0.35);`} />
      ) : (
        <div style={`width:120px;height:120px;border-radius:50%;background:${trainer.avatar_bg};color:${trainer.avatar_color};display:flex;align-items:center;justify-content:center;font-weight:800;font-size:2.25rem;flex-shrink:0;border:4px solid rgba(255,255,255,0.18);box-shadow:0 8px 32px rgba(0,0,0,0.35);`}>
          {trainer.avatar_initials}
        </div>
      )}

      <!-- Name / badges / location -->
      <div style="flex:1;min-width:0;">
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:0.85rem;">
          {hasBmp && (
            <span style={`background:${rankBadge.bg};color:${rankBadge.color};font-size:0.68rem;font-weight:700;padding:0.25rem 0.75rem;border-radius:20px;letter-spacing:1px;text-transform:uppercase;`}>
              {rankBadge.label}
            </span>
          )}
          {trainer.specialty && (
            <span style="background:rgba(58,181,74,0.2);color:#7de88a;font-size:0.68rem;font-weight:700;padding:0.25rem 0.75rem;border-radius:20px;letter-spacing:1px;text-transform:uppercase;border:1px solid rgba(58,181,74,0.3);">
              {emoji} {trainer.specialty}
            </span>
          )}
          {trainer.cert && (
            <span style="background:rgba(255,255,255,0.1);color:rgba(255,255,255,0.65);font-size:0.68rem;font-weight:600;padding:0.25rem 0.75rem;border-radius:20px;">
              ✓ {trainer.cert}
            </span>
          )}
        </div>

        <h1 class="tp-hero-name" style="font-family:'Playfair Display',serif;font-size:2.75rem;font-weight:900;color:white;line-height:1.08;margin-bottom:0.25rem;">
          {trainer.name}
        </h1>

        {(trainer as any).username && (
          <div style="font-size:0.95rem;color:rgba(255,255,255,0.5);font-weight:600;margin-bottom:0.4rem;letter-spacing:0.3px;">
            @{(trainer as any).username}
          </div>
        )}

        {trainer.business_name && (
          <div style="font-size:1rem;color:rgba(255,255,255,0.6);font-weight:600;margin-bottom:0.75rem;">
            {trainer.business_name}
          </div>
        )}

        <div style="display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap;margin-bottom:1.75rem;">
          {(trainer.city || trainer.location) && (
            <span style="color:rgba(255,255,255,0.6);font-size:0.88rem;">📍 {trainer.city ?? trainer.location}</span>
          )}
          {hasReviews && (
            <div style="display:flex;align-items:center;gap:0.5rem;">
              <span set:html={bmpDumbbells(trainer.bmp_score, 17)} />
              <span style="color:white;font-weight:700;font-size:0.9rem;">{trainer.star_rating}</span>
              <span style="color:rgba(255,255,255,0.4);font-size:0.82rem;">({reviews.length} verified reviews)</span>
            </div>
          )}
        </div>

        <div style="display:flex;gap:0.85rem;flex-wrap:wrap;">
          <a href={`/review/${trainer.id}`} class="btn-review">
            🏋 Leave a Verified Review
          </a>
          {(trainer as any).accepts_bookings && (trainer as any).booking_url && (
            <a href={(trainer as any).booking_url} target="_blank" rel="noopener noreferrer"
              style="display:inline-flex;align-items:center;gap:0.5rem;background:white;color:#0d1a0e;padding:0.85rem 1.75rem;border-radius:8px;font-weight:700;font-size:0.92rem;text-decoration:none;transition:opacity 0.2s;"
              onmouseover="this.style.opacity='0.88'" onmouseout="this.style.opacity='1'">
              📅 Book a Session
            </a>
          )}
          <button class="btn-chat" id="chat-trigger-btn" onclick="openChat()">
            💬 Speak to {trainer.name} to find out more
          </button>
        </div>
      </div>

      <!-- BMP Score box -->
      {hasBmp && (
        <div class="tp-bmp-box bmp-info" style="text-align:center;background:rgba(255,255,255,0.07);border-radius:16px;padding:1.5rem 2rem;border:1px solid rgba(255,255,255,0.12);flex-shrink:0;">
          <div class="bmp-tooltip">
            BMP (Body Muscle %) scores PTs 0–100 using ratings + verified review volume. Higher = more trusted.
          </div>
          <div style="font-size:0.6rem;color:rgba(255,255,255,0.45);letter-spacing:2px;text-transform:uppercase;font-weight:700;margin-bottom:0.35rem;">BMP Score ⓘ</div>
          <div style="font-size:3.5rem;font-weight:900;color:#3ab54a;line-height:1;">{trainer.bmp_score}</div>
          <div style="font-size:0.68rem;color:rgba(255,255,255,0.4);margin-top:0.35rem;font-weight:500;">out of 100</div>
        </div>
      )}

    </div>
  </div>
</section>

<!-- ── NEW TRAINER BANNER ── -->
{!hasReviews && (
  <div style="background:linear-gradient(90deg,#eaf7ec,#f4f9f4);border-bottom:1px solid #c3e6c8;padding:0.85rem 0;">
    <div style="max-width:900px;margin:0 auto;padding:0 2.5rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.75rem;">
      <div style="display:flex;align-items:center;gap:0.75rem;">
        <span style="background:#3ab54a;color:white;font-size:0.65rem;font-weight:700;padding:0.2rem 0.65rem;border-radius:20px;letter-spacing:1px;text-transform:uppercase;">New</span>
