      </div>

      <div class="tp-stat">
        <div style="font-size:0.62rem;color:#8a8f8a;letter-spacing:1.5px;text-transform:uppercase;font-weight:700;margin-bottom:0.5rem;">Rating</div>
        {hasReviews ? (
          <>
            <div style="font-size:2.1rem;font-weight:900;color:#111311;line-height:1;">{trainer.star_rating}</div>
            <div style="margin-top:0.35rem;display:flex;gap:3px;justify-content:center;">
              <span set:html={bmpDumbbells(trainer.bmp_score, 14)} />
            </div>
          </>
