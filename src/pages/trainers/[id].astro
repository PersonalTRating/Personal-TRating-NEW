      </div>
      <a href={`/review/${trainer.id}`} style="font-size:0.8rem;font-weight:700;color:#2a9438;text-decoration:none;white-space:nowrap;">Leave a review →</a>
    </div>
  </div>
)}

<!-- ── STATS ROW — panel 1: white ── -->
<section style="background:white;border-top:3px solid #3ab54a;border-bottom:1px solid #e0e8e1;padding:2rem 0;">
