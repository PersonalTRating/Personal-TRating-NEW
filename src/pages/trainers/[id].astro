          <div style="font-size:0.82rem;font-weight:600;color:#c0ccc1;margin-top:0.4rem;">Not listed</div>
        )}
      </div>

    </div>
  </div>
</section>

<!-- ── BIO — panel 2: light grey ── -->
<section style="padding:3.5rem 0;background:#f4f6f4;border-bottom:1px solid #e0e8e1;">
  <div style="max-width:900px;margin:0 auto;padding:0 2.5rem;">
    <div style="font-size:0.72rem;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:#3ab54a;margin-bottom:0.5rem;display:inline-block;border-bottom:2px solid #3ab54a;padding-bottom:3px;">About</div>
