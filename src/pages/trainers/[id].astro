      </div>

      <div class="tp-stat">
        <div style="font-size:0.62rem;color:#8a8f8a;letter-spacing:1.5px;text-transform:uppercase;font-weight:700;margin-bottom:0.5rem;">Reviews</div>
        <div style="font-size:2.1rem;font-weight:900;color:#111311;line-height:1;">{reviews.length}</div>
        <div style="font-size:0.7rem;color:#8a8f8a;margin-top:0.25rem;">Verified clients</div>
      </div>

      <div class="tp-stat">
        <div style="font-size:0.62rem;color:#8a8f8a;letter-spacing:1.5px;text-transform:uppercase;font-weight:700;margin-bottom:0.5rem;">Certification</div>
        {trainer.cert ? (
          <div style="font-size:0.95rem;font-weight:800;color:#111311;line-height:1.35;margin-top:0.4rem;">{trainer.cert}</div>
