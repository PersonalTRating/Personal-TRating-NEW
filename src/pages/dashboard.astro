    <!-- ══════════ REVIEW LINKS ══════════ -->
    <div class="page" id="page-links">
      <div class="section-eyebrow">Collect Feedback</div>
      <div class="section-heading">Review Link Generator</div>

      <!-- Two-column layout: card preview | controls -->
      <div id="link-builder-grid" style="display:grid;grid-template-columns:380px 1fr;gap:1.75rem;align-items:start;margin-bottom:1.5rem;">

        <!-- LEFT: Story Card Preview -->
        <div>
          <div style="font-size:0.68rem;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:var(--muted);margin-bottom:0.75rem;text-align:center;">Instagram Story Preview</div>
          <div id="share-card" style="width:360px;height:640px;border-radius:24px;position:relative;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,0.35);background:linear-gradient(160deg,#0d1a0e 0%,#1a3d1e 45%,#2a5a30 100%);">
            <div style="height:100%;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,0.3);font-size:0.85rem;font-family:'Manrope',sans-serif;">Loading card…</div>
          </div>
        </div>

        <!-- RIGHT: Controls -->
        <div style="display:flex;flex-direction:column;gap:1.25rem;">

          <!-- Download -->
          <div class="card" style="margin-bottom:0;overflow:hidden;">
            <div style="background:linear-gradient(135deg,var(--green-light) 0%,white 80%);padding:1.5rem;">
              <div style="font-weight:800;font-size:0.95rem;color:var(--text);margin-bottom:0.3rem;">📲 Download your review card</div>
              <div style="font-size:0.8rem;color:var(--muted);line-height:1.65;margin-bottom:1.25rem;">Save and post to your Instagram Story, WhatsApp status, or anywhere clients will see it. They scan the QR code to leave you a verified review in seconds.</div>
              <button id="download-card-btn" onclick="downloadShareCard()"
                style="width:100%;padding:0.9rem;background:var(--text);color:white;border:none;border-radius:10px;font-weight:700;font-size:0.9rem;cursor:pointer;font-family:'Manrope',sans-serif;transition:background 0.2s;"
                onmouseover="this.style.background='#1a3d1e'" onmouseout="this.style.background='var(--text)'">
                ⬇️ Download for Instagram Stories
              </button>
              <div style="margin-top:0.6rem;font-size:0.72rem;color:var(--muted);text-align:center;">On mobile? Screenshot the card preview instead.</div>
            </div>
          </div>

          <!-- Review link -->
          <div class="card" style="margin-bottom:0;">
            <div class="card-head">
              <div>
                <div class="card-title">Your Review Link</div>
                <div class="card-sub">Share directly via WhatsApp or email</div>
              </div>
            </div>
            <div class="card-body">
              <div class="link-box">
                <input class="link-url" id="review-link" readonly value="personalTrating.co.uk/review/...">
                <button class="link-copy" onclick="copyLink()">Copy</button>
              </div>
              <div class="link-actions" style="margin-top:1rem;">
                <button class="link-action-btn" onclick="shareLink('whatsapp')">📱 WhatsApp</button>
