  // ── Feed post functions ──────────────────────────────────────────────────
  var _postImgFile = null;

  function handlePostImgSelect(input) {
    var file = input.files && input.files[0];
    if (!file) return;
    if (file.size > 10 * 1024 * 1024) { showToast('❌ Image too large — max 10 MB'); return; }
    _postImgFile = file;
    var reader = new FileReader();
    reader.onload = function(e) {
      document.getElementById('post-img-preview-src').src = e.target.result;
      document.getElementById('post-img-preview').style.display = 'block';
      document.getElementById('post-img-placeholder').style.display = 'none';
    };
    reader.readAsDataURL(file);
  }

  function handlePostDrop(e) {
    e.preventDefault();
    var drop = document.getElementById('post-drop');
    drop.style.borderColor = 'var(--border)'; drop.style.background = '';
    var file = e.dataTransfer && e.dataTransfer.files[0];
    if (!file || !file.type.startsWith('image/')) return;
    handlePostImgSelect({ files: [file] });
  }

  function clearPostImg() {
    _postImgFile = null;
    document.getElementById('post-img-preview').style.display = 'none';
    document.getElementById('post-img-placeholder').style.display = 'block';
    document.getElementById('post-img-input').value = '';
    document.getElementById('post-img-preview-src').src = '';
  }

  async function submitPost() {
    var caption = (document.getElementById('post-caption').value || '').trim();
    var errEl   = document.getElementById('post-err');
    var btn     = document.getElementById('post-submit');
    if (!caption && !_postImgFile) { errEl.style.display = 'block'; return; }
    errEl.style.display = 'none';
    btn.disabled = true; btn.textContent = 'Publishing…';
    var sb  = window['__ptSupabase'];
    var tid = window['__ptTrainerId'];
    var imageUrl = null;
    if (_postImgFile) {
      var ext  = _postImgFile.name.split('.').pop() || 'jpg';
      var path = tid + '/' + Date.now() + '.' + ext;
      var up   = await sb.storage.from('post-images').upload(path, _postImgFile, { contentType: _postImgFile.type });
      if (up.error) { showToast('❌ Upload failed: ' + up.error.message); btn.disabled = false; btn.textContent = 'Publish Post'; return; }
      imageUrl = sb.storage.from('post-images').getPublicUrl(path).data.publicUrl;
    }
    var ins = await sb.from('trainer_posts').insert({ trainer_id: tid, content: caption || null, image_url: imageUrl });
    btn.disabled = false; btn.textContent = 'Publish Post';
    if (ins.error) { showToast('❌ Failed to publish: ' + ins.error.message); return; }
    document.getElementById('post-caption').value = '';
    clearPostImg();
    showToast('✅ Post published!');
    loadFeedPosts();
    loadOverviewFeed();
  }

  async function loadFeedPosts() {
