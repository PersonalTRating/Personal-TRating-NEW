  async function loadOverviewFeed() {
    var listEl = document.getElementById('ov-feed-list');
    var subEl  = document.getElementById('ov-feed-sub');
    if (!listEl) return;
    var sb  = window['__ptSupabase'];
    var tid = window['__ptTrainerId'];
    if (!sb || !tid) return;
    listEl.innerHTML = '<div style="color:var(--muted);font-size:0.84rem;text-align:center;padding:1rem 0;">Loading…</div>';
    var res   = await sb.from('trainer_posts').select('*').eq('trainer_id', tid).order('created_at', { ascending: false }).limit(5);
    var posts = res.data || [];
    if (subEl) subEl.textContent = posts.length + ' recent post' + (posts.length !== 1 ? 's' : '');
    if (posts.length === 0) {
      listEl.innerHTML = '<div style="text-align:center;padding:2rem 0;"><div style="font-size:1.75rem;margin-bottom:0.5rem;">📸</div><div style="font-weight:700;font-size:0.88rem;color:var(--text);margin-bottom:0.25rem;">No posts yet</div><div style="font-size:0.78rem;color:var(--muted);">Click "+ New Post →" to share your first update.</div></div>';
      return;
    }
    // Fetch like counts for these posts
    var postIds = posts.map(function(p) { return p.id; });
    var likesRes = await sb.from('post_likes').select('post_id').in('post_id', postIds);
    var likeMap = {};
    postIds.forEach(function(id) { likeMap[id] = 0; });
    (likesRes.data || []).forEach(function(l) { likeMap[l.post_id] = (likeMap[l.post_id] || 0) + 1; });

    listEl.innerHTML = '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem;padding:1rem 1.5rem;">'
      + posts.map(function(p) {
        var date  = new Date(p.created_at).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' });
        var likes = likeMap[p.id] || 0;
        return '<div style="background:var(--off);border:1px solid var(--border);border-radius:12px;overflow:hidden;">'
          + (p.image_url ? '<img src="' + p.image_url + '" style="width:100%;aspect-ratio:4/3;object-fit:cover;display:block;" />' : '')
          + '<div style="padding:0.75rem 0.9rem;">'
          + (p.content ? '<div style="font-size:0.82rem;line-height:1.6;color:var(--text);margin-bottom:0.4rem;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">' + p.content + '</div>' : '')
          + '<div style="display:flex;align-items:center;gap:0.6rem;">'
          + '<span style="font-size:0.68rem;color:var(--muted);">' + date + '</span>'
          + (likes > 0 ? '<span style="font-size:0.68rem;color:#e53935;font-weight:600;">❤️ ' + likes + '</span>' : '')
          + '</div></div></div>';
      }).join('')
      + '</div>';
  }

  async function deletePost(id) {
    if (!confirm('Delete this post? This cannot be undone.')) return;
    var sb  = window['__ptSupabase'];
    var res = await sb.from('trainer_posts').delete().eq('id', id);
    if (!res.error) { loadFeedPosts(); loadOverviewFeed(); }
    else showToast('❌ Failed to delete post.');
  }
  // ────────────────────────────────────────────────────────────────────────────

  // ── Fireworks celebration ────────────────────────────────────────────────
  window['__ptFireCelebration'] = function(newCount) {
    // Small delay so the page has finished rendering
    setTimeout(function() {
      var end = Date.now() + 3500;

      // Burst from both sides like real fireworks
      (function frame() {
        confetti({
          particleCount: 6,
          angle: 60,
          spread: 55,
          startVelocity: 60,
          origin: { x: 0, y: 0.75 },
          colors: ['#3ab54a','#e6a800','#ffffff','#2a9438','#ffd700'],
          zIndex: 9999,
        });
        confetti({
          particleCount: 6,
          angle: 120,
          spread: 55,
          startVelocity: 60,
          origin: { x: 1, y: 0.75 },
          colors: ['#3ab54a','#e6a800','#ffffff','#2a9438','#ffd700'],
          zIndex: 9999,
        });
        if (Date.now() < end) requestAnimationFrame(frame);
      })();

      // One big central pop at the start
      confetti({
        particleCount: 80,
        spread: 100,
        startVelocity: 45,
        origin: { x: 0.5, y: 0.55 },
        colors: ['#3ab54a','#e6a800','#ffffff','#2a9438','#ffd700'],
        zIndex: 9999,
      });
    }, 300);
  };
  // ────────────────────────────────────────────────────────────────────────
</script>
<!-- Mobile bottom navigation -->
<nav class="mob-bottom-nav" id="mob-bottom-nav">
  <ul>
    <li>
      <button onclick="mobNavTo('overview')" id="bn-overview" class="active">
        <span class="nav-icon">🏠</span>
        <span class="nav-label">Home</span>
      </button>
    </li>
    <li>
      <button onclick="mobNavTo('messages')" id="bn-messages">
        <span class="nav-icon">💬</span>
        <span class="nav-badge" id="bn-msg-badge">0</span>
        <span class="nav-label">Messages</span>
      </button>
    </li>
    <li>
      <button onclick="mobNavTo('reviews')" id="bn-reviews">
        <span class="nav-icon">⭐</span>
        <span class="nav-badge" id="bn-reviews-badge">0</span>
        <span class="nav-label">Reviews</span>
      </button>
    </li>
    <li>
      <button onclick="mobNavTo('notifications')" id="bn-notifications">
        <span class="nav-icon">🔔</span>
        <span class="nav-badge" id="bn-notif-badge">0</span>
        <span class="nav-label">Alerts</span>
      </button>
    </li>
    <li>
      <button onclick="mobNavTo('profile')" id="bn-profile">
        <span class="nav-icon">👤</span>
        <span class="nav-label">Profile</span>
      </button>
    </li>
  </ul>
</nav>

<script is:inline>
  // Pages that have a dedicated bottom nav button
  var MOB_NAV_PAGES = ['overview', 'messages', 'reviews', 'notifications', 'profile'];

  function syncMobNav(pageId) {
    document.querySelectorAll('.mob-bottom-nav button').forEach(function(b) {
      b.classList.remove('active');
    });
    var target = MOB_NAV_PAGES.indexOf(pageId) > -1
      ? document.getElementById('bn-' + pageId)
      : null;
    if (target) target.classList.add('active');
  }

  function toggleMobMenu() {
    document.querySelector('.sidebar').classList.toggle('mob-open');
    document.getElementById('mob-overlay').classList.toggle('active');
    document.getElementById('mob-sidebar-tab').classList.toggle('open');
  }
  function closeMobMenu() {
    document.querySelector('.sidebar').classList.remove('mob-open');
    document.getElementById('mob-overlay').classList.remove('active');
    document.getElementById('mob-sidebar-tab').classList.remove('open');
  }

  function mobNavTo(page) {
    showPage(page);
    closeMobMenu();
    syncMobNav(page);
  }

  // Sync bottom nav when any sidebar item is tapped on mobile
  document.querySelectorAll('.sb-item').forEach(function(item) {
    item.addEventListener('click', function() {
      if (window.innerWidth > 768) return;
      closeMobMenu();
      var match = (item.getAttribute('onclick') || '').match(/showPage\('([^']+)'\)/);
      if (match) syncMobNav(match[1]);
    });
  });
</script>
</body>
</html>
