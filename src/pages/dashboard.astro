  var _cardBuilt = false;

  function buildShareCard() {
    var trainer = window['__ptTrainer'];
    if (!trainer) return;

    var themes = {
      forest:   { bg:'linear-gradient(160deg,#0d1a0e 0%,#1a3d1e 45%,#2a5a30 100%)', accent:'#3ab54a', glow:'rgba(58,181,74,0.45)',  swatch:'linear-gradient(135deg,#0d1a0e,#2a5a30)',  name:'Forest' },
      midnight: { bg:'linear-gradient(160deg,#050a18 0%,#0d1a40 45%,#1a2a70 100%)', accent:'#5b8cff', glow:'rgba(91,140,255,0.45)', swatch:'linear-gradient(135deg,#050a18,#1a2a70)',  name:'Midnight' },
      charcoal: { bg:'linear-gradient(160deg,#080808 0%,#181818 45%,#282828 100%)', accent:'#c8c8c8', glow:'rgba(200,200,200,0.25)', swatch:'linear-gradient(135deg,#080808,#282828)',  name:'Charcoal' },
      royal:    { bg:'linear-gradient(160deg,#150822 0%,#2e1258 45%,#4a1e8a 100%)', accent:'#c17aff', glow:'rgba(193,122,255,0.45)',swatch:'linear-gradient(135deg,#150822,#4a1e8a)',  name:'Royal' },
      slate:    { bg:'linear-gradient(160deg,#080f1a 0%,#122035 45%,#1e3350 100%)', accent:'#5bcfff', glow:'rgba(91,207,255,0.4)',  swatch:'linear-gradient(135deg,#080f1a,#1e3350)',  name:'Slate' },
    };

    var theme    = themes[trainer.hero_theme] || themes.forest;
    var name     = trainer.name || 'Personal Trainer';
    var username = trainer.username ? '@' + trainer.username : null;
    var city     = trainer.city || (trainer.location || '').split(',')[0].trim() || 'United Kingdom';
    var bmp    = (trainer.bmp_score > 0) ? trainer.bmp_score : null;
    var url    = window['__ptReviewUrl'] || (window.location.origin + '/review/' + trainer.id);
    var customMsgEl = document.getElementById('sc-custom-msg');
    var ctaMsg = (customMsgEl && customMsgEl.value.trim()) ? customMsgEl.value.trim() : "I'd love your feedback 🙏";

    // Update theme swatch in controls panel
    var swatchEl = document.getElementById('sc-theme-swatch');
    var nameEl   = document.getElementById('sc-theme-name');
    if (swatchEl) swatchEl.style.background = theme.swatch;
    if (nameEl)   nameEl.textContent = theme.name;

    // Avatar HTML
    var avatarHtml = trainer.avatar_url
      ? '<div style="width:120px;height:120px;min-width:120px;min-height:120px;border-radius:50%;background:url(' + trainer.avatar_url + ') center/cover no-repeat;border:3px solid ' + theme.accent + ';display:block;flex-shrink:0;box-sizing:border-box;"></div>'
      : '<div style="width:120px;height:120px;min-width:120px;min-height:120px;border-radius:50%;background:' + (trainer.avatar_bg||'#1a3d1e') + ';color:' + (trainer.avatar_color||theme.accent) + ';display:flex;align-items:center;justify-content:center;font-size:2.6rem;font-weight:900;border:3px solid ' + theme.accent + ';font-family:\'Manrope\',sans-serif;">' + (trainer.avatar_initials||'?') + '</div>';

    // BMP badge — plain text, no box
    var bmpHtml = bmp
      ? '<div style="color:white;font-size:13px;font-weight:700;font-family:\'Manrope\',sans-serif;text-align:center;">📊 BMP <span style="color:' + theme.accent + ';font-size:15px;">' + bmp + '</span></div>'
      : '';

    var card = document.getElementById('share-card');
    if (!card) return;

    card.style.background = theme.bg;
    card.innerHTML = ''
      // Glow layers
      + '<div style="position:absolute;top:-100px;left:50%;transform:translateX(-50%);width:400px;height:400px;background:radial-gradient(circle,' + theme.glow + ' 0%,transparent 58%);pointer-events:none;z-index:0;"></div>'
      + '<div style="position:absolute;bottom:0;left:0;right:0;height:35%;background:rgba(0,0,0,0.3);pointer-events:none;z-index:0;"></div>'
      // Content
      + '<div style="position:relative;z-index:1;height:100%;display:flex;flex-direction:column;align-items:center;padding:20px 20px 14px;">'
        // Logo bar — logo left, VERIFIED right, absolutely positioned for reliable rendering
        + '<div style="position:relative;align-self:stretch;height:52px;margin-bottom:16px;">'
          + '<div style="position:absolute;left:0;top:0;background:white;border-radius:10px;padding:4px 8px;display:inline-flex;align-items:center;justify-content:center;border:2px solid #3ab54a;">'
            + '<img src="/images/logo.png" style="height:44px;width:auto;object-fit:contain;display:block;" alt="PTRating" />'
          + '</div>'
          + '<div style="position:absolute;right:0;top:18px;font-size:9px;color:rgba(255,255,255,0.4);font-weight:700;letter-spacing:1px;font-family:\'Manrope\',sans-serif;">VERIFIED</div>'
        + '</div>'
        // Avatar with glow ring
        + '<div style="position:relative;margin-bottom:10px;">'
          + '<div style="position:absolute;inset:-8px;border-radius:50%;background:' + theme.glow + ';filter:blur(10px);z-index:0;opacity:0.7;"></div>'
          + '<div style="position:relative;z-index:1;">' + avatarHtml + '</div>'
        + '</div>'
        // Name
        + '<div style="font-family:\'Playfair Display\',serif;font-size:1.5rem;font-weight:900;color:white;text-align:center;line-height:1.15;margin-bottom:3px;text-shadow:0 2px 16px rgba(0,0,0,0.5);">' + name + '</div>'
        // Username
        + (username ? '<div style="color:rgba(255,255,255,0.45);font-size:0.72rem;font-weight:600;text-align:center;margin-bottom:5px;font-family:\'Manrope\',sans-serif;letter-spacing:0.5px;">' + username + '</div>' : '')
        // City
        + '<div style="color:rgba(255,255,255,0.38);font-size:0.7rem;font-weight:500;text-align:center;margin-bottom:10px;font-family:\'Manrope\',sans-serif;letter-spacing:0.5px;">📍 ' + city + '</div>'
        // BMP badge
        + (bmpHtml ? '<div style="margin-bottom:12px;">' + bmpHtml + '</div>' : '<div style="margin-bottom:12px;height:28px;"></div>')
        // Divider
        + '<div style="width:100%;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.14),transparent);margin-bottom:12px;"></div>'
        // CTA text
        + '<div style="color:rgba(255,255,255,0.78);font-size:0.85rem;font-weight:600;text-align:center;line-height:1.6;margin-bottom:12px;font-family:\'Manrope\',sans-serif;width:100%;">'
          + ctaMsg + '<br/>'
          + '<span style="font-size:0.72rem;font-weight:500;color:rgba(255,255,255,0.45);">Scan the QR code to leave a verified review</span>'
        + '</div>'
        // QR code
        + '<div id="sc-qr-inner" style="background:white;padding:8px;border-radius:12px;margin-bottom:10px;box-shadow:0 8px 28px rgba(0,0,0,0.35);line-height:0;"></div>'
        // Spacer
        + '<div style="flex:1;"></div>'
        // URL
        + '<div style="color:rgba(255,255,255,0.22);font-size:0.58rem;letter-spacing:1.5px;font-family:\'Manrope\',sans-serif;text-transform:lowercase;">personalTrating.co.uk</div>'
      + '</div>';

    // Draw QR using API — simple and reliable
    _cardBuilt = false;
    var qrContainer = document.getElementById('sc-qr-inner');
    if (qrContainer) {
      var img = document.createElement('img');
      img.style.cssText = 'width:120px;height:120px;display:block;border-radius:4px;';
      img.onload = function() { _cardBuilt = true; };
      img.onerror = function() { _cardBuilt = true; };
      img.src = 'https://api.qrserver.com/v1/create-qr-code/?size=140x140&margin=4&data=' + encodeURIComponent(url);
      qrContainer.appendChild(img);
    } else {
      _cardBuilt = true;
    }
  }

  async function downloadShareCard() {
    var card = document.getElementById('share-card');
    var btn  = document.getElementById('download-card-btn');
    if (!card) return;

    if (btn) { btn.disabled = true; btn.textContent = '⏳ Generating…'; }

    try {
      // Wait for QR canvas to be drawn before capture
      if (!_cardBuilt) {
        await new Promise(function(resolve) {
          var t = setInterval(function() { if (_cardBuilt) { clearInterval(t); resolve(); } }, 50);
          setTimeout(function() { clearInterval(t); resolve(); }, 8000);
        });
      }
      // Ensure fonts are fully loaded before html2canvas captures
      await document.fonts.ready;
      await new Promise(function(resolve) { setTimeout(resolve, 200); });

      var canvas = await window['html2canvas'](card, {
        scale: 3,
        useCORS: true,
        backgroundColor: null,
        logging: false,
        allowTaint: true,
        imageTimeout: 10000,
      });

      var link = document.createElement('a');
      link.download = 'ptrating-review-card.png';
      link.href = canvas.toDataURL('image/png');
      link.click();
      showToast('✅ Card downloaded — share to your Story!');
    } catch(e) {
      showToast('❌ Download failed — screenshot the card preview instead');
    }

    if (btn) { btn.disabled = false; btn.innerHTML = '⬇️ Download for Instagram Stories'; }
  }

