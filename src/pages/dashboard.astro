---
// PT Dashboard — Personal TRating
// Route: /dashboard
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PT Dashboard — Personal TRating</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --green:       #3ab54a;
    --green-dark:  #2a9438;
    --green-light: #eaf7ec;
    --green-mid:   #d0f0d4;
    --white:       #ffffff;
    --off:         #f7f9f7;
    --border:      #e0e8e1;
    --text:        #0d1a0e;
    --muted:       #7a8f7c;
    --card:        #ffffff;
    --gold:        #b8860b;
    --gold-light:  #fdf6e3;
    --red:         #e53935;
    --sidebar-w:   240px;
  }
  * { margin:0; padding:0; box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { background:var(--off); font-family:'Manrope',sans-serif; color:var(--text); display:flex; min-height:100vh; }

  /* ── SIDEBAR ── */
  .sidebar {
    width:var(--sidebar-w); flex-shrink:0;
    background:var(--text);
    display:flex; flex-direction:column;
    position:fixed; top:0; left:0; bottom:0;
    z-index:100; overflow:hidden;
  }
  .sidebar::before {
    content:''; position:absolute; bottom:-60px; left:-60px;
    width:240px; height:240px;
    background:radial-gradient(circle,rgba(58,181,74,0.18) 0%,transparent 70%);
    pointer-events:none;
  }
  .sb-logo {
    padding:1.5rem 1.25rem 1.25rem;
    border-bottom:1px solid rgba(255,255,255,0.08);
    display:flex; align-items:center; justify-content:center;
  }
  .sb-logo img { height:62px; width:auto; object-fit:contain; }
  .sb-pt-info {
    padding:1.1rem 1.25rem;
    display:flex; align-items:center; gap:0.75rem;
    border-bottom:1px solid rgba(255,255,255,0.08);
  }
  .sb-avatar {
    width:38px; height:38px; border-radius:50%;
    background:var(--green); display:flex; align-items:center;
    justify-content:center; font-weight:800; font-size:0.85rem; color:white;
    flex-shrink:0;
  }
  .sb-pt-name  { font-weight:700; font-size:0.85rem; color:white; }
  .sb-pt-business { font-size:0.7rem; color:rgba(255,255,255,0.55); margin-top:0.1rem; font-weight:500; }
  .sb-pt-status { font-size:0.7rem; color:var(--green); margin-top:0.1rem; font-weight:600; }
  .sb-nav { flex:1; padding:1rem 0; overflow-y:auto; scrollbar-width:none; }
  .sb-nav::-webkit-scrollbar { display:none; }
  .sb-section-label {
    font-size:0.62rem; font-weight:700; letter-spacing:2.5px;
    text-transform:uppercase; color:rgba(255,255,255,0.25);
    padding:0.75rem 1.25rem 0.4rem;
  }
  .sb-item {
    display:flex; align-items:center; gap:0.75rem;
    padding:0.7rem 1.25rem; cursor:pointer;
    color:rgba(255,255,255,0.5); font-size:0.85rem; font-weight:600;
    transition:all 0.15s; border-left:3px solid transparent;
    text-decoration:none; background:none; border-right:none; border-top:none; border-bottom:none;
    width:100%; text-align:left; font-family:'Manrope',sans-serif;
  }
  .sb-item:hover { color:white; background:rgba(255,255,255,0.05); }
  .sb-item.active { color:white; background:rgba(58,181,74,0.12); border-left-color:var(--green); }
  .sb-icon { font-size:1rem; width:20px; text-align:center; }
  .sb-badge {
    margin-left:auto; background:var(--green); color:white;
    font-size:0.62rem; font-weight:800; padding:0.15rem 0.45rem;
    border-radius:20px;
  }
  .sb-footer {
    padding:1.1rem 1.25rem;
    border-top:1px solid rgba(255,255,255,0.08);
    display:flex; align-items:center; gap:1rem;
  }
  .sb-footer-link {
    font-size:0.78rem; color:rgba(255,255,255,0.35);
    text-decoration:none; transition:color 0.15s;
  }
  .sb-footer-link:hover { color:white; }

  /* ── MAIN ── */
  .main { margin-left:var(--sidebar-w); flex:1; display:flex; flex-direction:column; min-height:100vh; }

  /* ── TOP BAR ── */
  .topbar {
    background:white; border-bottom:1px solid var(--border);
    padding:0.9rem 2.5rem; display:flex; align-items:center;
    justify-content:space-between; position:sticky; top:0; z-index:50;
    box-shadow:0 1px 6px rgba(0,0,0,0.04);
  }
  .topbar-left h1 { font-family:'Playfair Display',serif; font-size:1.4rem; font-weight:900; }
  .topbar-left p  { font-size:0.8rem; color:var(--muted); margin-top:0.1rem; }
  .topbar-right   { display:flex; align-items:center; gap:1rem; }
  .topbar-btn {
    background:var(--green); color:white; padding:0.55rem 1.25rem;
    border-radius:8px; font-weight:700; font-size:0.82rem;
    border:none; cursor:pointer; transition:background 0.2s; font-family:'Manrope',sans-serif;
  }
  .topbar-btn:hover { background:var(--green-dark); }
  .topbar-signout {
    background:none; border:1.5px solid var(--border); border-radius:8px;
    padding:0.5rem 1.1rem; font-family:'Manrope',sans-serif; font-size:0.82rem;
    font-weight:700; color:var(--muted); cursor:pointer; transition:all 0.2s;
  }
  .topbar-signout:hover { border-color:#e05555; color:#e05555; }
  .notif-btn {
    width:36px; height:36px; border-radius:50%; background:var(--off);
    border:1px solid var(--border); display:flex; align-items:center;
    justify-content:center; cursor:pointer; position:relative; font-size:1rem;
  }
  .notif-dot {
    position:absolute; top:6px; right:6px; width:8px; height:8px;
    background:var(--green); border-radius:50%; border:2px solid white;
  }

  /* ── CONTENT ── */
  .content { padding:2rem 2.5rem; }
  .page { display:none; }
  .page.active { display:block; }

  /* ── STAT CARDS ── */
  .stats-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:1.25rem; margin-bottom:2rem; }
  .stat-card {
    background:var(--card); border-radius:14px; padding:1.5rem;
    border:1px solid var(--border); position:relative; overflow:hidden;
  }
  .stat-card::after {
    content:''; position:absolute; top:0; right:0; width:80px; height:80px;
    background:radial-gradient(circle,var(--stat-color,rgba(58,181,74,0.08)) 0%,transparent 70%);
  }
  .stat-label  { font-size:0.72rem; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:var(--muted); margin-bottom:0.6rem; }
  .stat-value  { font-family:'Playfair Display',serif; font-size:2.25rem; font-weight:900; line-height:1; margin-bottom:0.4rem; }
  .stat-change { font-size:0.75rem; font-weight:600; display:flex; align-items:center; gap:0.3rem; }
  .stat-change.up   { color:var(--green-dark); }
  .stat-change.down { color:var(--red); }
  .stat-icon { font-size:1.5rem; margin-bottom:0.75rem; }

  /* ── GRID LAYOUTS ── */
  .two-col   { display:grid; grid-template-columns:1fr 1fr;  gap:1.25rem; margin-bottom:1.25rem; }
  .three-col { display:grid; grid-template-columns:2fr 1fr;  gap:1.25rem; margin-bottom:1.25rem; }

  /* ── CARD ── */
  .card { background:var(--card); border-radius:14px; border:1px solid var(--border); overflow:hidden; margin-bottom:1.25rem; }
  .card:last-child { margin-bottom:0; }
  .card-head {
    padding:1.25rem 1.5rem; border-bottom:1px solid var(--border);
    display:flex; justify-content:space-between; align-items:center;
  }
  .card-title { font-weight:800; font-size:0.92rem; }
  .card-sub   { font-size:0.75rem; color:var(--muted); margin-top:0.15rem; }
  .card-body  { padding:1.5rem; }
  .card-link  { font-size:0.78rem; color:var(--green); font-weight:700; text-decoration:none; cursor:pointer; background:none; border:none; font-family:'Manrope',sans-serif; }

  /* ── CHART BARS ── */
  .chart-wrap { display:flex; align-items:flex-end; gap:8px; height:120px; padding:0.5rem 0; }
  .chart-bar-group { display:flex; flex-direction:column; align-items:center; flex:1; gap:4px; }
  .chart-bar { width:100%; border-radius:4px 4px 0 0; background:var(--green-mid); transition:background 0.2s; cursor:pointer; }
  .chart-bar:hover, .chart-bar.highlight { background:var(--green); }
  .chart-label { font-size:0.65rem; color:var(--muted); font-weight:600; }

  /* ── REVIEWS LIST ── */
  .rev-card { display:flex; gap:1rem; align-items:flex-start; padding:1.25rem 1.5rem; border:1px solid #e8ede9; border-radius:12px; margin-bottom:0.75rem; background:white; }
  .rev-card:last-child { margin-bottom:0; }
  .rev-avatar { width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:0.82rem; flex-shrink:0; }
  .rev-main   { flex:1; min-width:0; }
  .rev-meta   { display:flex; align-items:center; gap:0.35rem; flex-wrap:wrap; margin-bottom:0.35rem; }
  .rev-name   { font-weight:700; font-size:0.88rem; color:#0d1a0e; }
  .rev-verified { font-size:0.78rem; font-weight:600; color:#1a7c2a; }
  .rev-date   { font-size:0.78rem; color:#7a8f7c; }
  .rev-rating-row { display:flex; align-items:center; gap:0.5rem; margin-bottom:0.4rem; }
  .rev-bmp    { font-size:0.78rem; font-weight:700; color:#3ab54a; }
  .rev-text   { font-size:0.83rem; color:#3a4a3b; line-height:1.6; overflow-wrap:break-word; word-break:break-word; }
  .rev-action { flex-shrink:0; display:flex; align-items:center; }
  .appeal-btn { padding:0.45rem 1rem; border:1.5px solid #dc2626; background:transparent; color:#dc2626; border-radius:8px; font-size:0.78rem; font-weight:700; cursor:pointer; font-family:inherit; white-space:nowrap; transition:background 0.15s,color 0.15s; }
  .appeal-btn:hover { background:#dc2626; color:white; }
  .appeal-btn.pending { border-color:#9ca3af; color:#9ca3af; cursor:default; background:transparent; }
  .appeal-btn.pending:hover { background:transparent; color:#9ca3af; }
  .appeal-btn.upheld  { border-color:#b45309; color:#b45309; cursor:default; background:transparent; }
  .appeal-btn.upheld:hover  { background:transparent; color:#b45309; }

  /* ── APPEAL MODAL ── */
  .appeal-modal-bg { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.55); z-index:1000; align-items:center; justify-content:center; padding:1rem; }
  .appeal-modal-bg.open { display:flex; }
  .appeal-modal { background:white; border-radius:16px; padding:2rem; max-width:480px; width:100%; box-shadow:0 20px 60px rgba(0,0,0,0.2); }
  .appeal-modal-title { font-family:'Playfair Display',serif; font-size:1.2rem; font-weight:900; color:#0d1a0e; margin-bottom:0.25rem; }
  .appeal-modal-sub { font-size:0.8rem; color:#7a8f7c; margin-bottom:1.25rem; line-height:1.5; }
  .appeal-modal-review { background:#f4f6f4; border-radius:10px; padding:0.9rem 1rem; margin-bottom:1.25rem; font-size:0.82rem; color:#3a4a3b; font-style:italic; line-height:1.6; }
  .appeal-modal textarea { width:100%; box-sizing:border-box; border:1px solid #d0d8d1; border-radius:8px; padding:0.75rem; font-size:0.85rem; font-family:inherit; line-height:1.6; resize:vertical; min-height:90px; color:#0d1a0e; }
  .appeal-modal textarea:focus { outline:none; border-color:#3ab54a; }
  .appeal-modal-actions { display:flex; gap:0.75rem; margin-top:1rem; }
  .appeal-submit-btn { flex:1; padding:0.7rem; background:#dc2626; color:white; border:none; border-radius:8px; font-weight:700; font-size:0.88rem; cursor:pointer; font-family:inherit; }
  .appeal-submit-btn:hover { background:#b91c1c; }
  .appeal-submit-btn:disabled { opacity:0.6; cursor:default; }
  .appeal-cancel-btn { padding:0.7rem 1.25rem; background:#f4f6f4; color:#3a4a3b; border:none; border-radius:8px; font-weight:700; font-size:0.88rem; cursor:pointer; font-family:inherit; }
  .appeal-cancel-btn:hover { background:#e8ece8; }

  /* ── BMP GAUGE ── */
  .bmp-wrap { display:flex; flex-direction:column; align-items:center; padding:1rem 0; }
  .bmp-circle {
    width:130px; height:130px; border-radius:50%;
    background:conic-gradient(var(--green) 0deg 317deg,var(--green-mid) 317deg 360deg);
    display:flex; align-items:center; justify-content:center;
    position:relative; margin-bottom:1rem;
  }
  .bmp-inner {
    width:100px; height:100px; border-radius:50%; background:white;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
  }
  .bmp-score       { font-family:'Playfair Display',serif; font-size:1.75rem; font-weight:900; color:var(--text); line-height:1; }
  .bmp-label-small { font-size:0.6rem; font-weight:700; color:var(--muted); letter-spacing:1px; text-transform:uppercase; }
  .bmp-rank-info   { text-align:center; }
  .bmp-rank-val    { font-size:1.1rem; font-weight:800; color:var(--green-dark); }
  .bmp-rank-label  { font-size:0.72rem; color:var(--muted); margin-top:0.1rem; }

  /* ── RANKING TABLE ── */
  .rank-table { width:100%; border-collapse:collapse; }
  .rank-table th { text-align:left; padding:0.6rem 1rem; font-size:0.68rem; letter-spacing:1.5px; text-transform:uppercase; color:var(--muted); font-weight:700; border-bottom:1px solid var(--border); background:var(--off); }
  .rank-table td { padding:0.9rem 1rem; font-size:0.85rem; border-bottom:1px solid var(--border); vertical-align:middle; }
  .rank-table tr:last-child td { border-bottom:none; }
  .rank-table tr.you { background:var(--green-light); }
  .rank-table tr.you td { font-weight:700; color:var(--green-dark); }
  .rank-pos     { font-weight:900; font-size:1rem; color:var(--muted); }
  .rank-pos.r1  { color:var(--gold); }
  .rank-pos.r2  { color:#888; }
  .rank-pos.r3  { color:#a07040; }
  .rank-you-tag { background:var(--green); color:white; font-size:0.6rem; font-weight:800; padding:0.15rem 0.45rem; border-radius:20px; margin-left:0.5rem; letter-spacing:0.5px; }
  .rank-avatar  { width:32px; height:32px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:0.72rem; }

  /* ── PROFILE FORM ── */
  .form-grid { display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; }
  .form-group { display:flex; flex-direction:column; gap:0.4rem; }
  .form-group.full { grid-column:1 / -1; }
  .form-label { font-size:0.78rem; font-weight:700; color:var(--text); letter-spacing:0.3px; }
  .form-input, .form-select, .form-textarea {
    padding:0.75rem 1rem; border:1.5px solid var(--border);
    border-radius:8px; font-family:'Manrope',sans-serif;
    font-size:0.875rem; color:var(--text); background:white;
    transition:border-color 0.2s, box-shadow 0.2s; outline:none;
  }
  .form-input:focus, .form-select:focus, .form-textarea:focus {
    border-color:var(--green); box-shadow:0 0 0 3px rgba(58,181,74,0.1);
  }
  .form-textarea { resize:vertical; min-height:100px; }
  .form-hint { font-size:0.72rem; color:var(--muted); }
  .tag-wrap { display:flex; flex-wrap:wrap; gap:0.5rem; }
  .tag-pill {
    padding:0.35rem 0.9rem; border-radius:20px; font-size:0.78rem;
    font-weight:600; border:1.5px solid var(--border); cursor:pointer;
    transition:all 0.15s; color:var(--muted); background:white;
    font-family:'Manrope',sans-serif;
  }
  .tag-pill.selected { background:var(--green-light); border-color:var(--green); color:var(--green-dark); }
  /* ── Avatar preview circle ────────────────────────────── */
  .avatar-preview-circle {
    width:90px; height:90px; border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    font-weight:800; font-size:1.5rem; cursor:pointer; overflow:hidden;
    border:3px solid var(--green-mid); transition:border-color 0.2s, background 0.25s, color 0.25s; flex-shrink:0;
  }
  .avatar-preview-circle:hover { border-color:var(--green); }

  /* ── Colour swatches ───────────────────────────────────── */
  .colour-swatch {
    width:38px; height:38px; border-radius:50%;
    border:3px solid transparent; cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    font-weight:800; font-size:0.85rem;
    transition:transform 0.15s, box-shadow 0.15s;
    flex-shrink:0;
  }
  .colour-swatch:hover { transform:scale(1.12); }
  .colour-swatch.selected { box-shadow:0 0 0 2px white, 0 0 0 4px #111311; }

  /* ── Theme swatches ────────────────────────────────────── */
  .theme-swatch {
    display:flex; flex-direction:column; align-items:center; gap:0.4rem;
    background:none; border:none; cursor:pointer; padding:0;
  }
  .theme-swatch-preview {
    width:72px; height:44px; border-radius:8px;
    border:2.5px solid #e0e8e1; transition:border-color 0.15s, transform 0.15s;
  }
  .theme-swatch:hover .theme-swatch-preview { border-color:var(--green); transform:translateY(-2px); }
  .theme-swatch.selected .theme-swatch-preview { border-color:var(--green); box-shadow:0 0 0 2px var(--green); }
  .theme-swatch-label { font-size:0.68rem; font-weight:600; color:var(--muted); }
  .theme-swatch.selected .theme-swatch-label { color:var(--green); }
  .social-row { display:flex; align-items:center; gap:0.75rem; }
  .social-icon { width:36px; height:36px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:1.1rem; flex-shrink:0; }
  .save-bar {
    padding:1.25rem 1.5rem; background:var(--off); border-top:1px solid var(--border);
    display:flex; justify-content:flex-end; gap:0.75rem; align-items:center;
  }
  .btn { padding:0.7rem 1.5rem; border-radius:8px; font-weight:700; font-size:0.85rem; cursor:pointer; font-family:'Manrope',sans-serif; border:none; transition:all 0.2s; }
  .btn-green   { background:var(--green); color:white; }
  .btn-green:hover { background:var(--green-dark); }
  .btn-outline { background:white; border:1.5px solid var(--border); color:var(--text); }
  .btn-outline:hover { border-color:var(--green); }
  .save-msg { font-size:0.78rem; color:var(--green-dark); font-weight:600; opacity:0; transition:opacity 0.3s; margin-right:auto; }
  .save-msg.show { opacity:1; }

  /* ── REVIEW LINK GENERATOR ── */
  .link-card {
    background:linear-gradient(135deg,var(--green-light) 0%,white 60%);
    border:1.5px solid var(--green-mid); border-radius:14px; padding:2rem;
    text-align:center; margin-bottom:1.5rem;
  }
  .link-icon  { font-size:2.5rem; margin-bottom:0.75rem; }
  .link-title { font-family:'Playfair Display',serif; font-size:1.3rem; font-weight:900; margin-bottom:0.5rem; }
  .link-sub   { font-size:0.85rem; color:var(--muted); margin-bottom:1.5rem; line-height:1.6; max-width:420px; margin-left:auto; margin-right:auto; }
  .link-box   { display:flex; border:1.5px solid var(--border); border-radius:10px; overflow:hidden; background:white; max-width:520px; margin:0 auto 1.25rem; }
  .link-url   { flex:1; padding:0.85rem 1rem; font-size:0.82rem; color:var(--muted); font-family:'Manrope',sans-serif; border:none; outline:none; background:transparent; }
  .link-copy  { padding:0.85rem 1.25rem; background:var(--green); color:white; border:none; font-weight:700; font-size:0.82rem; cursor:pointer; font-family:'Manrope',sans-serif; transition:background 0.2s; }
  .link-copy:hover { background:var(--green-dark); }
  .link-actions { display:flex; gap:0.75rem; justify-content:center; flex-wrap:wrap; }
  .link-action-btn {
    display:flex; align-items:center; gap:0.5rem;
    padding:0.6rem 1.25rem; border-radius:8px; font-size:0.82rem;
    font-weight:700; cursor:pointer; border:1.5px solid var(--border);
    background:white; color:var(--text); font-family:'Manrope',sans-serif;
    transition:all 0.2s;
  }
  .link-action-btn:hover { border-color:var(--green); color:var(--green-dark); }
  .link-history-row {
    display:flex; align-items:center; gap:1rem; padding:0.9rem 1.5rem;
    border-bottom:1px solid var(--border); font-size:0.84rem;
  }
  .link-history-row:last-child { border-bottom:none; }
  .lh-client { font-weight:700; flex:1; }
  .lh-date   { color:var(--muted); font-size:0.78rem; }
  .lh-status { padding:0.2rem 0.65rem; border-radius:20px; font-size:0.7rem; font-weight:700; }
  .lh-status.reviewed { background:var(--green-light); color:var(--green-dark); }
  .lh-status.pending  { background:var(--gold-light);  color:var(--gold); }
  .lh-status.expired  { background:#f5f5f5; color:#aaa; }

  /* ── RANKINGS ── */
  .rank-filters { display:flex; gap:0.6rem; margin-bottom:1.5rem; flex-wrap:wrap; }
  .rank-filter {
    padding:0.4rem 1rem; border-radius:20px; font-size:0.78rem; font-weight:600;
    border:1.5px solid var(--border); cursor:pointer; background:white; color:var(--muted);
    transition:all 0.15s; font-family:'Manrope',sans-serif;
  }
  .rank-filter.active { background:var(--green-light); border-color:var(--green); color:var(--green-dark); }
  .progress-row { display:flex; align-items:center; gap:1rem; padding:0.6rem 0; }
  .progress-label   { font-size:0.78rem; font-weight:600; width:120px; flex-shrink:0; }
  .progress-bar-wrap { flex:1; height:8px; background:var(--green-mid); border-radius:4px; overflow:hidden; }
