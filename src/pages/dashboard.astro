              <button class="colour-swatch" data-bg="#fdf6e3" data-color="#b8860b" title="Gold"     onclick="selectColour(this)" style="background:#fdf6e3;"><span style="color:#b8860b;">A</span></button>
              <button class="colour-swatch" data-bg="#e8f0f7" data-color="#1a4b6b" title="Ocean"    onclick="selectColour(this)" style="background:#e8f0f7;"><span style="color:#1a4b6b;">A</span></button>
              <button class="colour-swatch" data-bg="#f5e8f7" data-color="#6b1a6b" title="Royal"    onclick="selectColour(this)" style="background:#f5e8f7;"><span style="color:#6b1a6b;">A</span></button>
              <button class="colour-swatch" data-bg="#e8ecf5" data-color="#1a2b6b" title="Navy"     onclick="selectColour(this)" style="background:#e8ecf5;"><span style="color:#1a2b6b;">A</span></button>
              <button class="colour-swatch" data-bg="#fef0ed" data-color="#c0451a" title="Ember"    onclick="selectColour(this)" style="background:#fef0ed;"><span style="color:#c0451a;">A</span></button>
              <button class="colour-swatch" data-bg="#fde8f0" data-color="#b5265e" title="Rose"     onclick="selectColour(this)" style="background:#fde8f0;"><span style="color:#b5265e;">A</span></button>
              <button class="colour-swatch" data-bg="#f3e8fd" data-color="#7c2dbe" title="Lavender" onclick="selectColour(this)" style="background:#f3e8fd;"><span style="color:#7c2dbe;">A</span></button>
              <button class="colour-swatch" data-bg="#e5f3fd" data-color="#1a6fa8" title="Sky"      onclick="selectColour(this)" style="background:#e5f3fd;"><span style="color:#1a6fa8;">A</span></button>
