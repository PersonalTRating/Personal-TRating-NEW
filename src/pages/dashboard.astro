<div class="copy-toast" id="copy-toast">✅ Link copied to clipboard!</div>

<script>
  import { supabase } from '../lib/supabase';

  // ── Dumbbell SVG helper (matches trainer profile) ───────────────────────
  function _db(filled: boolean, w = 18): string {
    const c  = filled ? '#FFB800' : '#e0e8e1';
    const sk = filled ? '#e6a800' : '#c8d4c8';
    const h  = Math.round(w * 12 / 28);
    return `<svg viewBox="0 0 28 12" width="${w}" height="${h}" style="display:inline-block;vertical-align:middle;" aria-hidden="true"><rect x="0" y="0.5" width="8" height="11" rx="2.5" fill="${c}" stroke="${sk}" stroke-width="0.7"/><rect x="8" y="3.5" width="12" height="5" fill="${c}" stroke="${sk}" stroke-width="0.7"/><rect x="20" y="0.5" width="8" height="11" rx="2.5" fill="${c}" stroke="${sk}" stroke-width="0.7"/></svg>`;
  }
  function _dumbbells(rating: number, w = 18): string {
    const n = Math.min(5, Math.max(0, Math.round(rating)));
    return Array.from({ length: 5 }, (_, i) => _db(i < n, w)).join('');
  }

  // ── Auth guard ──────────────────────────────────────────────────────────
  // Fast path: read from localStorage (persisted across visits).
  let _session: any = (await supabase.auth.getSession()).data.session;

  // Fallback: login page stashes tokens in sessionStorage for the first load
  // after sign-in (handles iOS cases where the localStorage write is delayed).
  if (!_session) {
    const _stored = sessionStorage.getItem('_pt_tokens');
    if (_stored) {
      try {
        const { access_token, refresh_token } = JSON.parse(_stored);
        const { data } = await supabase.auth.setSession({ access_token, refresh_token });
        _session = data.session;
      } catch (_) {}
      sessionStorage.removeItem('_pt_tokens');
    }
  }

  if (!_session) { window.location.href = '/login'; throw new Error('unauthenticated'); }

  // If access token is expired (or about to), refresh before running RLS queries.
  // Expired JWTs cause Supabase to silently return empty rows — no error, just null.
  const _jwtExp = (() => {
    try { return JSON.parse(atob(_session.access_token.split('.')[1])).exp; } catch { return 0; }
  })();
  if (Math.floor(Date.now() / 1000) >= _jwtExp - 60) {
    const { data: _ref } = await supabase.auth.refreshSession();
    if (_ref.session) { _session = _ref.session; }
    else { await supabase.auth.signOut(); window.location.href = '/login'; throw new Error('unauthenticated'); }
  }

  const session = _session;

  // ── Load trainer record ─────────────────────────────────────────────────
  const { data: _trainerData, error: _trainerErr } = await supabase
    .from('trainers').select('*').eq('user_id', session.user.id).maybeSingle();

  let trainer: any = _trainerData;

  // Retry once on transient network error (non-null error means network/server issue,
  // not a missing row — missing row returns null data with null error).
  if (!trainer && _trainerErr) {
    await new Promise(r => setTimeout(r, 600));
    const { data: _retry } = await supabase
      .from('trainers').select('*').eq('user_id', session.user.id).maybeSingle();
    trainer = _retry;
  }

  if (!trainer) {
    // Check if they're a client user — clients belong on /account, not /dashboard.
    const { data: _clientRow } = await supabase
      .from('clients').select('id').eq('user_id', session.user.id).maybeSingle();
    if (_clientRow) {
      window.location.href = '/account';
    } else {
      // No trainer, no client — sign out so they can use the correct account.
      await supabase.auth.signOut();
      window.location.href = '/login';
    }
    throw new Error('no-profile');
  }

  // Store ID for save/update operations
  let trainerId: string | null = trainer?.id ?? null;

  // ── Gyms ────────────────────────────────────────────────────────────────────
  let trainerGyms: { name: string; location: string }[] = [];

  function renderGyms() {
    const el = document.getElementById('gym-list') as HTMLElement;
    if (!el) return;
    if (trainerGyms.length === 0) {
      el.innerHTML = '<div style="font-size:0.82rem;color:var(--muted);">No gyms added yet.</div>';
      return;
    }
    el.innerHTML = trainerGyms.map((g, i) => `
      <div style="display:flex;align-items:center;justify-content:space-between;background:#f4f6f4;border:1px solid var(--border);border-radius:8px;padding:0.65rem 0.9rem;">
        <div>
          <div style="font-weight:700;font-size:0.875rem;">🏋️ ${g.name}</div>
          <div style="font-size:0.75rem;color:var(--muted);margin-top:0.15rem;">📍 ${g.location}</div>
        </div>
        <button onclick="removeGym(${i})" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:1.1rem;padding:0.2rem 0.5rem;border-radius:4px;" title="Remove">✕</button>
      </div>
    `).join('');
  }

  (window as any).addGym = () => {
    const nameInput = document.getElementById('gym-name-input') as HTMLInputElement;
    const locInput  = document.getElementById('gym-location-input') as HTMLInputElement;
    const name     = nameInput.value.trim();
    const location = locInput.value.trim();
    if (!name || !location) return;
    trainerGyms.push({ name, location });
    nameInput.value = '';
    locInput.value  = '';
    renderGyms();
  };

  (window as any).removeGym = (i: number) => {
    trainerGyms.splice(i, 1);
    renderGyms();
  };

  if (trainer) {
    const firstName = trainer.name.split(' ')[0];

    // ── Sidebar ─────────────────────────────────────────────────────────
    const sbAvatarEl = document.querySelector('.sb-avatar') as HTMLElement;
    if (sbAvatarEl) {
      if (trainer.avatar_url) {
        sbAvatarEl.innerHTML = `<img src="${trainer.avatar_url}" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />`;
      } else {
        sbAvatarEl.textContent = trainer.avatar_initials ?? '';
      }
    }
    (document.querySelector('.sb-pt-name')  as HTMLElement).textContent = trainer.name;
    (document.querySelector('.sb-pt-status')as HTMLElement).textContent = `● Active · ${trainer.location}`;
    const sbBusiness = document.querySelector('.sb-pt-business') as HTMLElement;
    if (sbBusiness) {
      if (trainer.business_name) {
        sbBusiness.textContent   = trainer.business_name;
        sbBusiness.style.display = 'block';
      } else {
        sbBusiness.style.display = 'none';
      }
    }

    // ── View Public Profile link ─────────────────────────────────────────
    const profileLink = document.getElementById('view-profile-link') as HTMLAnchorElement;
    if (profileLink) profileLink.href = `/trainers/${trainer.id}`;

    // ── Topbar subtitle ──────────────────────────────────────────────────
    const pageSub = document.getElementById('page-sub');
    if (pageSub) pageSub.textContent = `Welcome back, ${firstName}. Here's how you're performing.`;

    // ── Stat cards ───────────────────────────────────────────────────────
    const hasBmp  = (trainer.bmp_score ?? 0) > 0;
    const bmpEl   = document.getElementById('stat-bmp');
    const revEl   = document.getElementById('stat-reviews');
    const viewsEl = document.getElementById('stat-views');
    if (bmpEl)   bmpEl.textContent   = hasBmp ? String(trainer.bmp_score) : '—';
    if (revEl)   revEl.textContent   = String(trainer.review_count ?? 0);
    const revBadge = document.getElementById('sb-review-badge');
    if (revBadge) revBadge.textContent = String(trainer.review_count ?? 0);
    const bnRevBadge = document.getElementById('bn-reviews-badge') as HTMLElement;
    if (bnRevBadge && (trainer.review_count ?? 0) > 0) {
      bnRevBadge.textContent = String(trainer.review_count ?? 0);
      bnRevBadge.classList.add('visible');
    }

    const bmpChangeEl  = document.getElementById('stat-bmp-change');
    const revChangeEl  = document.getElementById('stat-reviews-change');
    const viewChangeEl = document.getElementById('stat-views-change');
    if (bmpChangeEl)  bmpChangeEl.textContent  = hasBmp ? 'Based on verified reviews'    : 'Earn your first review to unlock';
    if (revChangeEl)  revChangeEl.textContent  = (trainer.review_count ?? 0) > 0 ? `${trainer.review_count} verified reviews` : 'No reviews yet — send your first link';

    // ── Profile views ─────────────────────────────────────────────────────
    const monthStart = new Date(); monthStart.setDate(1); monthStart.setHours(0,0,0,0);
    const [{ count: totalViews }, { count: monthViews }] = await Promise.all([
      supabase.from('profile_views').select('*', { count: 'exact', head: true }).eq('trainer_id', trainer.id),
      supabase.from('profile_views').select('*', { count: 'exact', head: true }).eq('trainer_id', trainer.id).gte('viewed_at', monthStart.toISOString()),
    ]);
    if (viewsEl)    viewsEl.textContent    = String(totalViews ?? 0);
    if (viewChangeEl) viewChangeEl.textContent = (monthViews ?? 0) > 0 ? `${monthViews} this month` : 'Increases as clients find you';

    // ── New-review celebration ────────────────────────────────────────────
    const currentCount = trainer.review_count ?? 0;
    const storageKey   = `pt_last_review_count_${trainer.id}`;
    const lastCount    = parseInt(localStorage.getItem(storageKey) || '0', 10);
    const newReviews   = currentCount - lastCount;

    if (currentCount > 0 && newReviews > 0) {
      // Fire fireworks 🎆
      (window as any).__ptFireCelebration(newReviews);

      // Show inline banner on Overview
      const overviewPage = document.getElementById('page-overview');
      if (overviewPage && !overviewPage.querySelector('.review-alert')) {
        const label    = newReviews === 1 ? '1 new review!' : `${newReviews} new reviews!`;
        const subtext  = newReviews === 1
          ? `A client just rated you — your BMP score has been updated.`
          : `${newReviews} clients rated you since your last login — your BMP score has been updated.`;
        const banner   = document.createElement('div');
        banner.className = 'review-alert';
        banner.innerHTML = `
          <div class="review-alert-icon">🎉</div>
          <div>
            <div class="review-alert-title">You got ${label}</div>
            <div class="review-alert-sub">${subtext}</div>
          </div>
          <button class="review-alert-close" onclick="this.closest('.review-alert').remove()">✕</button>`;
        overviewPage.insertBefore(banner, overviewPage.firstChild);
      }
    }
    localStorage.setItem(storageKey, String(currentCount));
    // ─────────────────────────────────────────────────────────────────────

    // Compute UK rank
    const { count } = await supabase
      .from('trainers')
      .select('*', { count: 'exact', head: true })
      .gt('bmp_score', trainer.bmp_score ?? 0);
    const rank   = (count ?? 0) + 1;
    const rankEl = document.getElementById('stat-rank');
    const rankChangeEl = document.getElementById('stat-rank-change');
    if (rankEl)       rankEl.textContent       = hasBmp ? `#${rank}` : '—';
    if (rankChangeEl) rankChangeEl.textContent = hasBmp ? `Competing with PTs across the UK` : 'Rank unlocks with first review';

    // ── BMP Gauge ────────────────────────────────────────────────────────
    const gaugeCircle = document.getElementById('gauge-circle') as HTMLElement;
    const gaugeScore  = document.getElementById('gauge-score')  as HTMLElement;
    const gaugeRank   = document.getElementById('gauge-rank')   as HTMLElement;
    const gaugeSub    = document.getElementById('gauge-sub')    as HTMLElement;
    if (gaugeScore) gaugeScore.textContent = hasBmp ? String(trainer.bmp_score) : '—';
    if (gaugeCircle && hasBmp) {
      const deg = Math.round(((trainer.bmp_score ?? 0) / 100) * 360);
      gaugeCircle.style.background = `conic-gradient(var(--green) 0deg ${deg}deg, var(--green-mid) ${deg}deg 360deg)`;
    }
    if (gaugeRank) gaugeRank.textContent = hasBmp ? `🏆 Ranked #${rank} in the UK`   : '🔒 Rank unlocks with first review';
    if (gaugeSub)  gaugeSub.textContent  = hasBmp ? `Competing with PTs across the UK`      : 'Start collecting verified reviews';

    // ── Fetch this PT's real reviews ─────────────────────────────────────
    const { data: ptReviews } = await supabase
      .from('reviews')
      .select('id, reviewer_name, reviewer_initials, reviewer_avatar_bg, reviewer_avatar_color, rating, review_text, created_at, appeal_status')
      .eq('trainer_id', trainer.id)
      .eq('is_verified', true)
      .order('created_at', { ascending: false });
    const reviews = ptReviews ?? [];

    // ── Fetch appeal outcome notifications ───────────────────────────────
    const { data: ptAppealNotifs } = await supabase
      .from('notifications')
      .select('id, type, title, body, created_at, is_read')
      .eq('user_id', session.user.id)
      .in('type', ['appeal_approved', 'appeal_declined'])
      .order('created_at', { ascending: false })
      .limit(20);
    const appealNotifs: any[] = ptAppealNotifs ?? [];

    // ── Recent reviews (overview) ────────────────────────────────────────
    const recentList = document.getElementById('recent-reviews-list');
    if (recentList) {
      if (reviews.length === 0) {
        recentList.innerHTML = `
          <div style="padding:2.5rem 0;text-align:center;">
            <div style="font-size:2rem;margin-bottom:0.5rem;">⭐</div>
            <div style="font-weight:700;font-size:0.9rem;color:#0d1a0e;margin-bottom:0.3rem;">No reviews yet</div>
            <div style="font-size:0.8rem;color:#7a8f7c;line-height:1.6;max-width:280px;margin:0 auto 1rem;">Generate a review link and send it to your first client after a session.</div>
            <button onclick="showPage('links')" style="padding:0.55rem 1.25rem;background:#3ab54a;color:white;border:none;border-radius:8px;font-weight:700;font-size:0.82rem;cursor:pointer;font-family:'Manrope',sans-serif;">+ Generate Review Link</button>
          </div>`;
      } else {
        recentList.innerHTML = reviews.slice(0, 3).map(r => `
          <div class="review-item">
            <div style="width:38px;height:38px;border-radius:50%;background:${r.reviewer_avatar_bg||'#eaf7ec'};color:${r.reviewer_avatar_color||'#2a9438'};display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.78rem;flex-shrink:0;">${r.reviewer_initials||'?'}</div>
            <div>
              <div class="rev-name">${r.reviewer_name} <span style="font-weight:400;color:var(--muted);font-size:0.78rem;">· Verified Client</span></div>
              <div style="display:flex;gap:2px;margin-top:0.2rem;">${_dumbbells(r.rating)}</div>
              <div style="font-size:0.75rem;color:var(--green-dark);font-weight:700;margin-top:0.25rem;">BMP assigned: ${Math.round(r.rating * 20)}%</div>
              <div class="rev-text">"${r.review_text}"</div>
              <div class="rev-date">${new Date(r.created_at).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'})}</div>
            </div>
          </div>`).join('');
      }
    }

    // ── Reviews page stats ────────────────────────────────────────────────
    const avgEl   = document.getElementById('rev-stat-avg');
    const totEl   = document.getElementById('rev-stat-total');
    const verEl   = document.getElementById('rev-stat-verified');
    const totSubEl = document.getElementById('rev-stat-total-sub');
    if (reviews.length > 0) {
      const avg = (reviews.reduce((s: number, r: any) => s + r.rating, 0) / reviews.length).toFixed(1);
      if (avgEl)  avgEl.textContent  = avg;
      if (totEl)  totEl.textContent  = String(reviews.length);
      if (verEl)  verEl.textContent  = '100%';
      if (totSubEl) totSubEl.textContent = reviews.length === 1 ? '1 review received' : `${reviews.length} reviews received`;
    } else {
      if (avgEl)  avgEl.textContent  = '—';
      if (totEl)  totEl.textContent  = '0';
      if (verEl)  verEl.textContent  = '—';
    }

    // ── All reviews list ──────────────────────────────────────────────────
    const allList = document.getElementById('all-reviews-list');
    if (allList) {
      if (reviews.length === 0) {
        allList.innerHTML = `
          <div style="padding:3rem 1.5rem;text-align:center;">
            <div style="font-size:2.5rem;margin-bottom:0.75rem;">⭐</div>
            <div style="font-family:'Playfair Display',serif;font-weight:700;font-size:1.15rem;color:#0d1a0e;margin-bottom:0.4rem;">No reviews yet</div>
            <div style="font-size:0.84rem;color:#7a8f7c;line-height:1.65;max-width:340px;margin:0 auto;">Send your first review link to a client after your next session and their verified review will appear here.</div>
          </div>`;
      } else {
        allList.innerHTML = reviews.map((r: any) => {
          const appealStatus = r.appeal_status;
          let appealHtml = '';
          if (!appealStatus) {
            const safeText = (r.review_text || '').replace(/"/g, '&quot;');
            const safeName = (r.reviewer_name || '').replace(/"/g, '&quot;');
            appealHtml = `<button class="appeal-btn" data-appeal-id="${r.id}" data-appeal-text="${safeText}" data-appeal-name="${safeName}">⚠ Appeal</button>`;
          } else if (appealStatus === 'pending') {
            appealHtml = `<button class="appeal-btn pending" disabled>Appeal Pending</button>`;
          } else if (appealStatus === 'upheld') {
            appealHtml = `<button class="appeal-btn upheld" disabled>Appeal Rejected</button>`;
          }
          return `
          <div style="display:flex;gap:1rem;align-items:flex-start;padding:1.25rem 1.5rem;border:1px solid #e8ede9;border-radius:12px;margin-bottom:0.75rem;background:white;">
            <div style="width:44px;height:44px;border-radius:50%;background:${r.reviewer_avatar_bg||'#eaf7ec'};color:${r.reviewer_avatar_color||'#2a9438'};display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.82rem;flex-shrink:0;">${r.reviewer_initials||'?'}</div>
            <div style="flex:1;min-width:0;">
              <div style="display:flex;align-items:center;gap:0.35rem;flex-wrap:wrap;margin-bottom:0.3rem;">
                <span style="font-weight:700;font-size:0.88rem;color:#0d1a0e;">${r.reviewer_name}</span>
                <span style="color:#c8d4c8;font-size:0.75rem;">·</span>
                <span style="font-size:0.78rem;font-weight:600;color:#1a7c2a;">● Verified Client</span>
                <span style="color:#c8d4c8;font-size:0.75rem;">·</span>
                <span style="font-size:0.78rem;color:#7a8f7c;">${new Date(r.created_at).toLocaleDateString('en-GB')}</span>
              </div>
              <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.35rem;">
                <div style="display:flex;gap:3px;align-items:center;">${_dumbbells(r.rating)}</div>
                <span style="font-size:0.78rem;font-weight:700;color:#3ab54a;">BMP assigned: ${Math.round(r.rating * 20)}%</span>
              </div>
              <div style="font-size:0.83rem;color:#3a4a3b;line-height:1.6;overflow-wrap:break-word;word-break:break-word;">"${r.review_text}"</div>
            </div>
            <div style="flex-shrink:0;display:flex;align-items:center;">${appealHtml}</div>
          </div>`;
        }).join('');
      }
    }

    // ── Appeal modal logic (lives here so supabase is in scope) ──────────
    let _appealReviewId: string | null = null;

    const appealModalBg   = document.getElementById('appeal-modal-bg')!;
    const appealQuoteEl   = document.getElementById('appeal-modal-quote')!;
    const appealReasonEl  = document.getElementById('appeal-reason') as HTMLTextAreaElement;
    const appealSubmitBtn = document.getElementById('appeal-submit-btn') as HTMLButtonElement;

    function openAppealModal(reviewId: string, reviewText: string, reviewerName: string) {
      _appealReviewId = reviewId;
      appealQuoteEl.textContent = `"${reviewText}" — ${reviewerName}`;
      appealReasonEl.value = '';
      appealSubmitBtn.disabled = false;
      appealSubmitBtn.textContent = 'Submit Appeal';
      appealModalBg.classList.add('open');
    }

    function closeAppealModal() {
      appealModalBg.classList.remove('open');
      _appealReviewId = null;
    }

    document.getElementById('appeal-cancel-btn')?.addEventListener('click', closeAppealModal);

    appealModalBg.addEventListener('click', (e) => {
      if (e.target === appealModalBg) closeAppealModal();
    });

    // Event delegation — catches clicks on any appeal button in the list
    allList?.addEventListener('click', (e: Event) => {
      const btn = (e.target as HTMLElement).closest('[data-appeal-id]') as HTMLElement | null;
      if (!btn || (btn as HTMLButtonElement).disabled) return;
      openAppealModal(
        btn.dataset.appealId!,
        btn.dataset.appealText!,
        btn.dataset.appealName!,
      );
    });

    appealSubmitBtn?.addEventListener('click', async () => {
      if (!_appealReviewId) return;
      const reason = appealReasonEl.value.trim();
      appealSubmitBtn.disabled = true;
      appealSubmitBtn.textContent = 'Submitting…';

      try {
        const { data, error } = await supabase.rpc('submit_review_appeal', {
          p_review_id: _appealReviewId,
          p_reason:    reason,
        });

        if (error) {
          console.error('[appeal] rpc error:', error.message);
          alert('Something went wrong. Please try again.');
          appealSubmitBtn.disabled = false;
          appealSubmitBtn.textContent = 'Submit Appeal';
          return;
        }

        if (data?.error === 'already_appealed') {
          alert('You have already submitted an appeal for this review.');
          appealSubmitBtn.disabled = false;
          appealSubmitBtn.textContent = 'Submit Appeal';
          return;
        }

        if (data?.error) {
          alert('Something went wrong. Please try again.');
          appealSubmitBtn.disabled = false;
          appealSubmitBtn.textContent = 'Submit Appeal';
          return;
        }

        // Fire-and-forget email
        fetch('/.netlify/functions/submit-appeal', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            token:         data.token,
            reviewer_name: data.reviewer_name,
            review_text:   data.review_text,
            rating:        data.rating,
            trainer_name:  trainer.name,
            reason,
          }),
        }).catch(() => {});

        closeAppealModal();

        // Update the clicked button immediately
        const clickedBtn = allList?.querySelector(`[data-appeal-id="${_appealReviewId}"]`) as HTMLButtonElement | null;
        if (clickedBtn) {
          clickedBtn.className = 'appeal-btn pending';
          clickedBtn.disabled = true;
          clickedBtn.textContent = 'Appeal Pending';
          clickedBtn.removeAttribute('data-appeal-id');
        }
      } catch (err) {
        console.error('[appeal] unexpected error:', err);
        alert('Something went wrong. Please try again.');
        appealSubmitBtn.disabled = false;
        appealSubmitBtn.textContent = 'Submit Appeal';
      }
    });

    // ── Time-ago helper ───────────────────────────────────────────────────
    const timeAgo = (iso: string): string => {
      const diff = Date.now() - new Date(iso).getTime();
      const mins  = Math.floor(diff / 60000);
      const hours = Math.floor(diff / 3600000);
      const days  = Math.floor(diff / 86400000);
      const weeks = Math.floor(days / 7);
      if (mins < 60)  return mins <= 1 ? 'Just now' : `${mins} mins ago`;
      if (hours < 24) return `${hours} hour${hours > 1 ? 's' : ''} ago`;
      if (days < 7)   return `${days} day${days > 1 ? 's' : ''} ago`;
      if (weeks < 5)  return `${weeks} week${weeks > 1 ? 's' : ''} ago`;
      return new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
    };

    // ── Reviews chart (real monthly data) ────────────────────────────────
    const chartWrap = document.getElementById('reviews-chart-wrap') as HTMLElement;
    if (chartWrap) {
      const now = new Date();
      const months: { label: string; count: number }[] = [];
      for (let i = 7; i >= 0; i--) {
        const d     = new Date(now.getFullYear(), now.getMonth() - i, 1);
        const label = d.toLocaleString('en-GB', { month: 'short' });
        const start = new Date(d.getFullYear(), d.getMonth(), 1).toISOString();
        const end   = new Date(d.getFullYear(), d.getMonth() + 1, 0, 23, 59, 59).toISOString();
        const count = reviews.filter((r: any) => r.created_at >= start && r.created_at <= end).length;
        months.push({ label, count });
      }
      const maxCount = Math.max(...months.map(m => m.count), 1);
      chartWrap.innerHTML = months.map((m, i) => {
        const pct     = Math.max(8, Math.round((m.count / maxCount) * 100));
        const isLast  = i === months.length - 1;
        return `<div class="chart-bar-group">
          <div class="chart-bar${isLast ? ' highlight' : ''}" style="height:${pct}%" title="${m.count} review${m.count !== 1 ? 's' : ''}"></div>
          <div class="chart-label">${m.label}</div>
        </div>`;
      }).join('');
    }

    // ── Review History (link history page) ───────────────────────────────
    const linkHistoryEl = document.getElementById('link-history-list') as HTMLElement;
    if (linkHistoryEl) {
      if (reviews.length === 0) {
        linkHistoryEl.innerHTML = `<div style="padding:2.5rem 1.5rem;text-align:center;color:var(--muted);font-size:0.84rem;">No reviews yet. Send your link to clients after each session and their reviews will appear here.</div>`;
      } else {
        linkHistoryEl.innerHTML = reviews.map((r: any) => {
          const dateStr = new Date(r.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
          const initials = r.is_anonymous ? '?' : (r.reviewer_initials || (r.reviewer_name||'?').slice(0,2).toUpperCase());
          const displayName = r.is_anonymous ? 'Anonymous' : (r.reviewer_name || 'Client');
          const bmp = Math.round((r.rating || 0) * 20);
          return `<div style="display:flex;gap:1rem;padding:1.25rem 1.5rem;border-bottom:1px solid var(--border);align-items:flex-start;">
            <div style="width:42px;height:42px;border-radius:50%;background:${r.reviewer_avatar_bg||'#e8f5e9'};color:${r.reviewer_avatar_color||'#2a6b35'};display:flex;align-items:center;justify-content:center;font-size:0.88rem;font-weight:800;flex-shrink:0;font-family:'Manrope',sans-serif;">${initials}</div>
            <div style="flex:1;min-width:0;">
              <div style="font-weight:700;font-size:0.9rem;color:var(--text);">${displayName}</div>
              <div style="font-size:0.75rem;color:var(--muted);margin-bottom:${r.review_text ? '0.45rem' : '0'};">${dateStr}</div>
              ${r.review_text ? `<div style="font-size:0.82rem;color:#4a5a4c;line-height:1.55;font-style:italic;">"${r.review_text}"</div>` : ''}
            </div>
            <div style="text-align:center;flex-shrink:0;min-width:72px;">
              <div style="font-size:0.58rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);margin-bottom:0.1rem;">BMP</div>
              <div style="font-size:1.65rem;font-weight:900;color:var(--text);line-height:1;">${bmp}<span style="font-size:0.72rem;font-weight:600;color:var(--muted);">%</span></div>
              <div style="margin:0.3rem 0;">${_dumbbells(r.rating, 14)}</div>
              <div style="font-size:0.65rem;font-weight:700;color:var(--green-dark);">✓ Verified Client</div>
            </div>
          </div>`;
        }).join('');
      }
    }

    // ── Score Breakdown (real values) ────────────────────────────────────
    const breakdownEl = document.getElementById('score-breakdown-body') as HTMLElement;
    if (breakdownEl) {
      if (!hasBmp) {
        breakdownEl.innerHTML = `<div style="text-align:center;color:var(--muted);font-size:0.82rem;padding:0.75rem 0;">Collect reviews to unlock your score breakdown.</div>`;
      } else {
        const starPct    = Math.round(((trainer.star_rating ?? 0) / 5) * 100);
        const volComp    = Math.min((trainer.review_count ?? 0) * 2, 30);
        const volPct     = Math.round((volComp / 30) * 100);
        let profileScore = 0;
        if (trainer.bio)       profileScore += 25;
        if (trainer.city)      profileScore += 25;
        if (trainer.cert)      profileScore += 25;
        if (trainer.specialty) profileScore += 25;
        const mostRecent  = reviews[0];
        let recencyLabel  = 'Low';
        let recencyPct    = 15;
        if (mostRecent) {
          const daysSince = (Date.now() - new Date(mostRecent.created_at).getTime()) / 86400000;
          if (daysSince < 14)  { recencyLabel = 'High'; recencyPct = 100; }
          else if (daysSince < 60)  { recencyLabel = 'Good'; recencyPct = 65; }
          else if (daysSince < 180) { recencyLabel = 'Fair'; recencyPct = 35; }
        }
        breakdownEl.innerHTML = `
          <div class="progress-row"><span class="progress-label">Star Rating</span><div class="progress-bar-wrap"><div class="progress-bar-fill" style="width:${starPct}%"></div></div><span class="progress-val">${trainer.star_rating ?? '—'}</span></div>
          <div class="progress-row"><span class="progress-label">Review Volume</span><div class="progress-bar-wrap"><div class="progress-bar-fill" style="width:${volPct}%"></div></div><span class="progress-val">${trainer.review_count ?? 0}</span></div>
          <div class="progress-row"><span class="progress-label">Recency</span><div class="progress-bar-wrap"><div class="progress-bar-fill" style="width:${recencyPct}%"></div></div><span class="progress-val">${recencyLabel}</span></div>
          <div class="progress-row"><span class="progress-label">Profile</span><div class="progress-bar-wrap"><div class="progress-bar-fill" style="width:${profileScore}%"></div></div><span class="progress-val">${profileScore}%</span></div>`;
      }
    }

    // ── Notifications badge + read state ─────────────────────────────────
    const notifKey      = `pt_last_notif_seen_${trainer.id}`;
    const lastNotifSeen = parseInt(localStorage.getItem(notifKey) || '0', 10);
    const reviewUnread  = Math.max(0, reviews.length - lastNotifSeen);
    const appealUnread  = appealNotifs.filter((n: any) => !n.is_read).length;
    const unreadCount   = reviewUnread + appealUnread;

    const notifBadgeEl = document.getElementById('notif-badge') as HTMLElement;
    const bnNotifBadge = document.getElementById('bn-notif-badge') as HTMLElement;
    if (notifBadgeEl) {
      if (unreadCount > 0) {
        notifBadgeEl.textContent   = String(unreadCount);
        notifBadgeEl.style.display = '';
        if (bnNotifBadge) { bnNotifBadge.textContent = String(unreadCount); bnNotifBadge.classList.add('visible'); }
      } else {
        notifBadgeEl.style.display = 'none';
      }
    }
    localStorage.setItem(`pt_review_count_snap_${trainer.id}`, String(reviews.length));

    const notifDot = document.querySelector('.notif-dot') as HTMLElement;
    if (notifDot) notifDot.style.display = unreadCount > 0 ? '' : 'none';

    // ── Notifications list ────────────────────────────────────────────────
    const notifCard = document.getElementById('notif-card') as HTMLElement;
    if (notifCard) {
      type NotifItem = { iconBg: string; iconColor: string; iconChar: string; badge: string; title: string; body: string; time: string; isRead: boolean; sortTs: number };
      const notifs: NotifItem[] = [];

      reviews.slice(0, 8).forEach((r: any, i: number) => {
        const quote = r.review_text ? `"${r.review_text.slice(0, 140)}${r.review_text.length > 140 ? '…' : ''}"` : '';
        notifs.push({
          iconBg: '#e8f4fd', iconColor: '#3b82f6', iconChar: '💬', badge: '',
          title: 'New review received',
          body:  `${r.reviewer_name} gave you ${r.rating} dumbbell${r.rating !== 1 ? 's' : ''}.<br><span style="font-style:italic;color:#7a8f7c;">${quote}</span>`,
          time:   timeAgo(r.created_at),
          isRead: i >= reviewUnread,
          sortTs: new Date(r.created_at).getTime(),
        });
      });

      if (hasBmp && reviews.length > 0) {
        notifs.push({
          iconBg: '#eaf7ec', iconColor: '#3ab54a', iconChar: '↗', badge: '',
          title: 'BMP Score updated',
          body:  `Your score is now <strong style="color:#0d1a0e;">${trainer.bmp_score}</strong>, placing you <strong style="color:#3ab54a;">#${rank}</strong> in the UK.`,
          time:   timeAgo(reviews[0].created_at),
          isRead: true,
          sortTs: new Date(reviews[0].created_at).getTime() - 1,
        });
      }

      appealNotifs.forEach((n: any) => {
        const isApproved = n.type === 'appeal_approved';
        notifs.push({
          iconBg:    isApproved ? '#eaf7ec' : '#fff8e1',
          iconColor: isApproved ? '#3ab54a' : '#b45309',
          iconChar:  isApproved ? '✓' : '⚖',
          badge: '<span style="display:inline-block;font-size:0.68rem;font-weight:700;color:#3ab54a;background:#eaf7ec;padding:0.1rem 0.55rem;border-radius:20px;margin-left:0.4rem;">Appeal</span>',
          title: n.title || '',
          body:  n.body  || '',
          time:  timeAgo(n.created_at),
          isRead: n.is_read ?? false,
          sortTs: new Date(n.created_at).getTime(),
        });
      });

      notifs.sort((a, b) => b.sortTs - a.sortTs);

      const badge = (n: NotifItem) => n.badge;
      const unreadDot = (n: NotifItem) => n.isRead ? '' : '<span style="width:8px;height:8px;border-radius:50%;background:#3ab54a;display:inline-block;flex-shrink:0;margin-top:4px;"></span>';

      if (notifs.length === 0) {
        notifCard.innerHTML = `
          <div style="padding:1.5rem 1.5rem 0.75rem;">
            <div style="font-weight:700;font-size:1rem;color:#0d1a0e;">All Notifications</div>
            <div style="font-size:0.8rem;color:#7a8f7c;margin-top:0.15rem;">Showing most recent first</div>
          </div>
          <div style="padding:3rem 1.5rem;text-align:center;">
            <div style="font-size:2rem;margin-bottom:0.5rem;">🔔</div>
            <div style="font-weight:700;font-size:0.9rem;color:#0d1a0e;margin-bottom:0.25rem;">No notifications yet</div>
            <div style="font-size:0.8rem;color:#7a8f7c;">Notifications appear when clients leave you reviews.</div>
          </div>`;
      } else {
        notifCard.innerHTML = `
          <div style="padding:1.5rem 1.5rem 0.75rem;">
            <div style="font-weight:700;font-size:1rem;color:#0d1a0e;">All Notifications</div>
            <div style="font-size:0.8rem;color:#7a8f7c;margin-top:0.15rem;">Showing most recent first</div>
          </div>
          ${notifs.map(n => `
          <div style="display:flex;gap:1rem;padding:1.25rem 1.5rem;border-top:1px solid #f0f4f0;align-items:flex-start;">
            <div style="width:48px;height:48px;border-radius:50%;background:${n.iconBg};color:${n.iconColor};display:flex;align-items:center;justify-content:center;font-size:1.15rem;font-weight:800;flex-shrink:0;">${n.iconChar}</div>
            <div style="flex:1;min-width:0;">
              <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:0.5rem;margin-bottom:0.25rem;">
                <div style="display:flex;align-items:center;flex-wrap:wrap;">
                  <span style="font-weight:700;font-size:0.9rem;color:#0d1a0e;">${n.title}</span>${n.badge}
                </div>
                <span style="font-size:0.78rem;color:#7a8f7c;white-space:nowrap;flex-shrink:0;">${n.time}</span>
              </div>
              <div style="font-size:0.83rem;color:#3a4a3b;line-height:1.6;">${n.body}</div>
              <div style="font-size:0.75rem;color:#7a8f7c;margin-top:0.3rem;">${n.time}</div>
            </div>
          </div>`).join('')}
          <div style="padding:1.25rem 1.5rem;text-align:center;font-size:0.8rem;color:#7a8f7c;border-top:1px solid #f0f4f0;">You've reached the end of your notifications</div>`;
      }
    }

    // ── Profile form pre-fill ────────────────────────────────────────────
    const nameParts = (trainer.name || '').split(' ');
    const fillText = (id: string, val: string) => {
      const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
      if (el) el.value = val ?? '';
    };
    fillText('profile-firstname', nameParts[0] ?? '');
    fillText('profile-lastname',  nameParts.slice(1).join(' ') ?? '');
    fillText('profile-username',  (trainer as any).username ?? '');
    fillText('profile-business',  trainer.business_name ?? '');
    fillText('profile-city',      trainer.city     ?? '');
    fillText('profile-postcode',  trainer.postcode ?? '');
    fillText('profile-bio',       trainer.bio ?? '');
    fillText('profile-intro-msg', (trainer as any).intro_message ?? '');

    // ── Avatar preview ───────────────────────────────────────────────────
    const avatarPreview = document.getElementById('profile-avatar-preview') as HTMLElement;
    if (avatarPreview) {
      if (trainer.avatar_url) {
        avatarPreview.innerHTML = `<img src="${trainer.avatar_url}" style="width:100%;height:100%;object-fit:cover;" />`;
        avatarPreview.style.background = 'transparent';
        if (trainer.avatar_color) avatarPreview.style.border = `4px solid ${trainer.avatar_color}`;
        const uploadBtn = document.getElementById('avatar-upload-btn');
        if (uploadBtn) uploadBtn.textContent = 'Replace Photo';
      } else {
        avatarPreview.textContent = trainer.avatar_initials ?? '';
        avatarPreview.style.background = trainer.avatar_bg ?? '#eaf7ec';
        avatarPreview.style.color      = trainer.avatar_color ?? '#2a9438';
      }
    }

    // ── Colour swatch pre-select ─────────────────────────────────────────
    const currentBg = (trainer.avatar_bg ?? '').trim().toLowerCase();
    document.querySelectorAll('.colour-swatch').forEach((el) => {
      const swatch = el as HTMLElement;
      if ((swatch.dataset.bg ?? '').trim().toLowerCase() === currentBg) {
        swatch.classList.add('selected');
      }
    });

    // ── Theme swatch pre-select ──────────────────────────────────────────
    const currentTheme = trainer.hero_theme ?? 'forest';
    document.querySelectorAll('.theme-swatch').forEach((el) => {
      const swatch = el as HTMLElement;
      if (swatch.dataset.theme === currentTheme) swatch.classList.add('selected');
    });

    // Set hero preview background to match saved theme
    const _heroPreviewEl = document.getElementById('profile-hero-preview');
    if (_heroPreviewEl) {
      const _grads: Record<string,string> = {
        forest:   'linear-gradient(135deg,#0d1a0e 0%,#1a3d1e 55%,#2a5a30 100%)',
        midnight: 'linear-gradient(135deg,#0a0f1e 0%,#1a2240 55%,#2a3a6a 100%)',
        charcoal: 'linear-gradient(135deg,#111111 0%,#252525 55%,#333333 100%)',
        royal:    'linear-gradient(135deg,#1a0a2e 0%,#2d1a4a 55%,#4a2a7a 100%)',
        slate:    'linear-gradient(135deg,#0a1828 0%,#1a2c40 55%,#2a3e58 100%)',
        rose:     'linear-gradient(135deg,#3d0a1e 0%,#6b1a3a 55%,#8b2252 100%)',
        lavender: 'linear-gradient(135deg,#1e0a3d 0%,#3a1a6b 55%,#5c2a8b 100%)',
        sky:      'linear-gradient(135deg,#0a1e3d 0%,#1a3a6b 55%,#2a5a8b 100%)',
      };
      _heroPreviewEl.style.background = _grads[currentTheme] ?? _grads.forest;
    }

    // ── Profile completeness banner ───────────────────────────────────────
    const isNewProfile = !trainer.bio && !trainer.city && (trainer.review_count ?? 0) === 0;
    const profilePage  = document.getElementById('page-profile');
    if (isNewProfile && profilePage && !profilePage.querySelector('.profile-welcome-banner')) {
      const banner = document.createElement('div');
      banner.className = 'profile-welcome-banner';
      banner.style.cssText = `
        background:linear-gradient(135deg,var(--green-light) 0%,white 70%);
        border:1.5px solid var(--green-mid); border-radius:12px;
        padding:1.25rem 1.5rem; margin-bottom:1.5rem;
        display:flex; align-items:center; gap:1rem;
      `;
      banner.innerHTML = `
        <div style="font-size:1.75rem;flex-shrink:0;">👋</div>
        <div>
          <div style="font-weight:800;font-size:0.92rem;color:var(--text);margin-bottom:0.2rem;">Welcome! Let's complete your profile.</div>
          <div style="font-size:0.8rem;color:var(--muted);line-height:1.55;">
            Fill in your city, bio and specialties below, then click <strong>Save Profile</strong>.
            A complete profile attracts more clients and boosts your BMP score.
          </div>
        </div>
      `;
      profilePage.insertBefore(banner, profilePage.firstChild);
    }

    // ── Specialty tags — deselect all, then select matching ───────────────
    document.querySelectorAll('.tag-pill:not(#specialty-other-pill)').forEach(tag => {
      tag.classList.remove('selected');
      const tagText = (tag.textContent ?? '').replace(/^\S+\s*/, '').trim();
      if (trainer.specialty && tagText === trainer.specialty) {
        tag.classList.add('selected');
      }
    });
    // If saved specialty doesn't match a preset pill, restore into Other
    if (trainer.specialty && !document.querySelector('.tag-pill.selected')) {
      const otherPill  = document.getElementById('specialty-other-pill');
      const otherInput = document.getElementById('specialty-other-input') as HTMLInputElement;
      const otherWrap  = document.getElementById('specialty-other-wrap');
      if (otherPill)  otherPill.classList.add('selected');
      if (otherInput) otherInput.value = trainer.specialty;
      if (otherWrap)  otherWrap.style.display = 'block';
    }

    // ── Cert dropdown ────────────────────────────────────────────────────
    const certEl         = document.getElementById('profile-cert')            as HTMLSelectElement;
    const certOtherWrap  = document.getElementById('profile-cert-other-wrap') as HTMLDivElement;
    const certOtherInput = document.getElementById('profile-cert-other')      as HTMLInputElement;
    const certValue = (trainer.cert ?? '').trim();
    if (certEl && certValue) {
      const opts = Array.from(certEl.options).map(o => o.value);
      if (opts.includes(certValue)) {
        certEl.value = certValue;
      } else {
        certEl.value = 'other';
        if (certOtherWrap) certOtherWrap.style.display = 'flex';
        if (certOtherInput) certOtherInput.value = certValue;
      }
    }

    // Show/hide cert other box on change
    certEl?.addEventListener('change', () => {
      const isOther = certEl.value === 'other';
      certOtherWrap.style.display = isOther ? 'flex' : 'none';
    });

    // ── Personalised review link ──────────────────────────────────────────
    const reviewLinkEl = document.getElementById('review-link') as HTMLInputElement;
    const reviewUrl = `${window.location.origin}/review/${trainer.id}`;
    if (reviewLinkEl) reviewLinkEl.value = reviewUrl;
    (window as any).__ptReviewUrl  = reviewUrl;
    (window as any).__ptTrainerId   = trainer.id;
    (window as any).__ptTrainerName = trainer.name;
    (window as any).__ptUserId      = session.user.id;
    (window as any).__ptInitials    = trainer.avatar_initials ?? '';
    (window as any).__ptSupabase        = supabase;
    (window as any).__ptTrainer         = trainer;
    (window as any).__ptUnreadAppealIds = appealNotifs.filter((n: any) => !n.is_read).map((n: any) => n.id);

    // Load feed on initial overview display
    loadOverviewFeed();

    // ── Rankings table (dynamic) ──────────────────────────────────────────
    const { data: leaderboard } = await supabase
      .from('trainers')
      .select('id, name, username, city, location, bmp_score, avatar_initials, avatar_bg, avatar_color')
      .eq('is_active', true)
      .gt('bmp_score', 0)
      .order('bmp_score', { ascending: false })
      .limit(10);

    const rankTbody = document.getElementById('rank-tbody') as HTMLElement;
    const posClasses = ['r1','r2','r3'];
    if (rankTbody) {
      if (leaderboard && leaderboard.length > 0) {
        rankTbody.innerHTML = leaderboard.map((pt: any, i: number) => {
          const isYou = pt.id === trainer.id;
          return `<tr ${isYou ? 'class="you"' : ''}>
            <td class="rank-pos ${posClasses[i] ?? ''}">${i + 1}</td>
            <td><div style="display:flex;align-items:center;gap:0.5rem;">
              <div class="rank-avatar" style="background:${pt.avatar_bg || '#eaf7ec'};color:${pt.avatar_color || '#2a9438'};">${pt.avatar_initials || '?'}</div>
              <div><div>${pt.name}${isYou ? '<span class="rank-you-tag">YOU</span>' : ''}</div>${pt.username ? '<div style="font-size:0.68rem;color:#7a8f7c;font-weight:600;">@' + pt.username + '</div>' : ''}</div>
            </div></td>
            <td>${pt.city || pt.location}</td>
            <td><strong>${pt.bmp_score}</strong></td>
          </tr>`;
        }).join('');
      } else {
        rankTbody.innerHTML = `<tr><td colspan="4" style="text-align:center;padding:2.5rem;color:#7a8f7c;font-size:0.85rem;">Rankings appear once PTs collect verified reviews.</td></tr>`;
      }
    }

    // ── Mini gauge on Rankings page ───────────────────────────────────────
    const miniScore  = document.getElementById('mini-gauge-score')  as HTMLElement;
    const miniRank   = document.getElementById('mini-gauge-rank')   as HTMLElement;
    const miniSub    = document.getElementById('mini-gauge-sub')    as HTMLElement;
    const miniCircle = document.getElementById('mini-gauge-circle') as HTMLElement;
    if (miniScore) miniScore.textContent = hasBmp ? String(trainer.bmp_score) : '—';
    if (miniRank)  miniRank.textContent  = hasBmp ? `🏆 #${rank} in the UK`          : '🔒 Rank unlocks with first review';
    if (miniSub)   miniSub.textContent   = hasBmp ? `Competing with PTs across the UK`       : 'Collect verified reviews to rank';
    if (miniCircle && hasBmp) {
      const deg = Math.round(((trainer.bmp_score ?? 0) / 100) * 360);
      miniCircle.style.background = `conic-gradient(var(--green) 0deg ${deg}deg, var(--green-mid) ${deg}deg 360deg)`;
    }

    // ── Load gyms ─────────────────────────────────────────────────────────
    trainerGyms = Array.isArray(trainer.gyms) ? [...trainer.gyms] : [];
    renderGyms();
  }

  // ── Save Profile (exposed globally so onclick can call it) ──────────────
  (window as any).saveProfile = async () => {
    if (!trainerId) return;

    const firstName    = (document.getElementById('profile-firstname') as HTMLInputElement).value.trim();
    const lastName     = (document.getElementById('profile-lastname')  as HTMLInputElement).value.trim();
    const usernameRaw  = (document.getElementById('profile-username')  as HTMLInputElement).value.trim().toLowerCase();
    const username     = usernameRaw.replace(/[^a-z0-9_]/g, '') || null;
    const businessName = (document.getElementById('profile-business')  as HTMLInputElement).value.trim();
    const city         = (document.getElementById('profile-city')      as HTMLInputElement).value.trim();
    const postcode  = (document.getElementById('profile-postcode')  as HTMLInputElement).value.trim().toUpperCase();
    const bio        = (document.getElementById('profile-bio')        as HTMLTextAreaElement).value.trim();
    const introMsg   = (document.getElementById('profile-intro-msg') as HTMLTextAreaElement).value.trim();

    const certRaw = (document.getElementById('profile-cert') as HTMLSelectElement).value;
    const cert    = certRaw === 'other'
      ? (document.getElementById('profile-cert-other') as HTMLInputElement).value.trim()
      : certRaw;

    // Specialty: prefer Other text input, else first selected preset pill
    const otherPillSelected = document.getElementById('specialty-other-pill')?.classList.contains('selected');
    const otherInputVal = (document.getElementById('specialty-other-input') as HTMLInputElement)?.value.trim();
    const selectedTag = document.querySelector('.tag-pill.selected:not(#specialty-other-pill)');
    const specialty = otherPillSelected && otherInputVal
      ? otherInputVal
      : selectedTag
        ? (selectedTag.textContent ?? '').replace(/^\S+\s*/, '').trim()
        : '';

    const name     = `${firstName} ${lastName}`.trim();
    const location = postcode ? `${city}, ${postcode}` : city;
    const initials = (firstName.charAt(0) + lastName.charAt(0)).toUpperCase();

    const selectedColour = document.querySelector('.colour-swatch.selected') as HTMLElement | null;
    const avatarBg    = selectedColour?.dataset.bg    ?? '#eaf7ec';
    const avatarColor = selectedColour?.dataset.color ?? '#2a9438';

    const selectedTheme = document.querySelector('.theme-swatch.selected') as HTMLElement | null;
    const heroTheme = selectedTheme?.dataset.theme ?? 'forest';

    const { error } = await supabase
      .from('trainers')
      .update({ name, username, business_name: businessName || null, location, city, postcode, bio, intro_message: introMsg || null, specialty, cert, avatar_initials: initials, avatar_bg: avatarBg, avatar_color: avatarColor, hero_theme: heroTheme, gyms: trainerGyms })
      .eq('id', trainerId);

    if (error) {
      showToast('❌ Save failed — please try again.');
    } else {
      // Update sidebar live
      (document.querySelector('.sb-pt-name')  as HTMLElement).textContent = name;
      (document.querySelector('.sb-pt-status')as HTMLElement).textContent = `● Active · ${location}`;
      const sbAv = document.querySelector('.sb-avatar') as HTMLElement;
      if (sbAv && !sbAv.querySelector('img')) {
        sbAv.textContent = initials;
        sbAv.style.background = avatarBg;
        sbAv.style.color = avatarColor;
      }
      // Update avatar preview colour live (if no photo uploaded)
      const prev = document.getElementById('profile-avatar-preview') as HTMLElement;
      if (prev && !prev.querySelector('img')) {
        prev.textContent = initials;
        prev.style.background = avatarBg;
        prev.style.color = avatarColor;
      }
      const sbBiz = document.querySelector('.sb-pt-business') as HTMLElement;
      if (sbBiz) {
        if (businessName) { sbBiz.textContent = businessName; sbBiz.style.display = 'block'; }
        else { sbBiz.style.display = 'none'; }
      }
      showToast('✅ Profile saved successfully!');
    }
  };

  // ── Messages ────────────────────────────────────────────────────────────

  let _msgConvId: string | null   = null;
  let _msgChannel: any            = null;
  let _msgConvChannel: any        = null;

  function _esc(s: string) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>');
  }

  function _msgTime(iso: string): string {
    const d = new Date(iso), now = new Date(), diff = now.getTime() - d.getTime();
    if (diff < 86400000) return d.toLocaleTimeString('en-GB', { hour:'2-digit', minute:'2-digit' });
    if (diff < 604800000) return d.toLocaleDateString('en-GB', { weekday:'short' });
    return d.toLocaleDateString('en-GB', { day:'numeric', month:'short' });
  }

  function _updateMsgBadge(n: number) {
    const el = document.getElementById('sb-msg-badge');
    if (!el) return;
    if (n > 0) { el.textContent = String(n); el.style.display = ''; }
    else el.style.display = 'none';
    const bnMsg = document.getElementById('bn-msg-badge') as HTMLElement;
    if (bnMsg) {
      if (n > 0) { bnMsg.textContent = String(n); bnMsg.classList.add('visible'); }
      else bnMsg.classList.remove('visible');
    }
  }

  async function _fetchUnreadBadge() {
    if (!trainerId) return;
    const { data } = await supabase.from('conversations').select('trainer_unread_count').eq('trainer_id', trainerId);
    _updateMsgBadge((data || []).reduce((s: number, c: any) => s + (c.trainer_unread_count || 0), 0));
  }

  (window as any).loadConversations = async function() {
    if (!trainerId) return;

    const { data: convs } = await supabase
      .from('conversations')
      .select('id, last_message_at, last_message_preview, trainer_unread_count, client_id, client_name')
      .eq('trainer_id', trainerId)
      .order('last_message_at', { ascending: false });

    document.getElementById('msg-loading')!.style.display = 'none';
    const total = (convs || []).reduce((s: number, c: any) => s + (c.trainer_unread_count || 0), 0);
    _updateMsgBadge(total);

    if (!convs || convs.length === 0) {
      document.getElementById('msg-empty')!.style.display = '';
      return;
    }
    document.getElementById('msg-empty')!.style.display = 'none';
    document.getElementById('msg-conv-list')!.style.display = '';

    const AV_PALETTES = [
      { bg:'#fde8e8', color:'#c0392b' },
      { bg:'#eaf7ec', color:'#2a9438' },
      { bg:'#f0e8fd', color:'#7b2fbe' },
      { bg:'#e8f4fd', color:'#2471a3' },
      { bg:'#fdf5e8', color:'#b7770d' },
      { bg:'#fdeef8', color:'#a93277' },
    ];
    const el = document.getElementById('msg-conv-items')!;
    el.innerHTML = convs.map((c: any) => {
      const rawName  = c.client_name || 'Client';
      const p        = rawName.trim().split(' ');
      const initials = ((p[0]?.[0] ?? '') + (p[1]?.[0] ?? '')).toUpperCase() || '?';
      const palette  = AV_PALETTES[(initials.charCodeAt(0) + (initials.charCodeAt(1) || 0)) % AV_PALETTES.length];
      const unread   = c.trainer_unread_count > 0;
      return `<div class="msg-card">
        <div style="display:flex;align-items:center;gap:1rem;padding:1rem 1.5rem;flex:1;min-width:0;">
          <div style="position:relative;flex-shrink:0;width:48px;height:48px;">
            <div style="width:48px;height:48px;border-radius:50%;background:${palette.bg};color:${palette.color};display:flex;align-items:center;justify-content:center;font-weight:800;font-size:0.95rem;">${initials}</div>
            ${unread ? `<span style="position:absolute;bottom:1px;right:1px;width:12px;height:12px;border-radius:50%;background:var(--green);border:2px solid white;"></span>` : ''}
          </div>
          <div style="flex:1;min-width:0;">
            <div style="font-weight:700;font-size:0.93rem;color:var(--text);">${_esc(rawName)}</div>
            ${unread && c.last_message_at ? `<div style="font-size:0.75rem;color:var(--green);font-weight:600;margin-top:0.2rem;">New Message · ${new Date(c.last_message_at).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'})} at ${new Date(c.last_message_at).toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'})}</div>` : ''}
          </div>
          <button class="msg-view-btn" onclick="openMsgThread('${c.id}','${_esc(rawName)}','${initials}')">View Conversation</button>
        </div>
      </div>`;
    }).join('');

    // Subscribe to conversation updates and new conversations for live badge
    if (!_msgConvChannel) {
      const _onConvChange = () => {
        const active = document.getElementById('page-messages')?.classList.contains('active');
        if (active) (window as any).loadConversations();
        else _fetchUnreadBadge();
      };
      _msgConvChannel = supabase.channel('trainer-convs-' + trainerId)
        .on('postgres_changes', { event:'UPDATE', schema:'public', table:'conversations',
          filter:`trainer_id=eq.${trainerId}` }, _onConvChange)
        .on('postgres_changes', { event:'INSERT', schema:'public', table:'conversations',
          filter:`trainer_id=eq.${trainerId}` }, _onConvChange)
        .subscribe();
    }
  };

  (window as any).openMsgThread = async function(convId: string, clientName: string, clientInitials: string) {
    _msgConvId = convId;

    // Update panel header
    document.getElementById('tr-chat-name')!.textContent = clientName;
    document.getElementById('tr-chat-av')!.textContent   = clientInitials;

    // Slide in the panel
    const panel = document.getElementById('tr-chat-panel')!;
    panel.classList.remove('tr-chat-hidden');
    requestAnimationFrame(() => requestAnimationFrame(() => panel.classList.add('open')));

    // Reset trainer unread and refresh list badges
    await supabase.from('conversations').update({ trainer_unread_count: 0 }).eq('id', convId);
    await (window as any).loadConversations();

    // Load messages
    const { data: msgs } = await supabase
      .from('messages').select('id, sender_type, content, created_at')
      .eq('conversation_id', convId).order('created_at', { ascending: true });

    const container = document.getElementById('tr-chat-msgs')!;
    container.innerHTML = (msgs || []).map(_renderThreadMsg).join('');
    container.scrollTop = container.scrollHeight;

    // Subscribe to new messages in this thread
    if (_msgChannel) _msgChannel.unsubscribe();
    _msgChannel = supabase.channel(`trainer-thread-${convId}`)
      .on('postgres_changes', { event:'INSERT', schema:'public', table:'messages',
        filter:`conversation_id=eq.${convId}` }, (p: any) => {
          container.insertAdjacentHTML('beforeend', _renderThreadMsg(p.new));
          container.scrollTop = container.scrollHeight;
          (window as any).loadConversations();
        })
      .subscribe();
  };

  function _renderThreadMsg(m: any): string {
    const isT = m.sender_type === 'trainer';
    const time = new Date(m.created_at).toLocaleTimeString('en-GB', { hour:'2-digit', minute:'2-digit' });
    const bubbleStyle = isT
      ? 'background:#111311;color:white;padding:0.6rem 0.85rem;border-radius:14px 14px 4px 14px;font-size:0.875rem;line-height:1.5;word-break:break-word;'
      : 'background:white;color:#111311;border:1px solid #e0e8e1;padding:0.6rem 0.85rem;border-radius:14px 14px 14px 4px;font-size:0.875rem;line-height:1.5;word-break:break-word;';
    return `<div style="display:flex;flex-direction:column;max-width:75%;${isT ? 'align-self:flex-end;' : 'align-self:flex-start;'}">
      <div style="${bubbleStyle}">${_esc(m.content)}</div>
      <div style="font-size:0.62rem;color:#aab8ac;margin-top:0.2rem;${isT ? 'text-align:right;' : ''}">${time}</div>
    </div>`;
  }

  (window as any).closeMsgThread = function() {
    const panel = document.getElementById('tr-chat-panel')!;
    panel.classList.remove('open');
    setTimeout(() => panel.classList.add('tr-chat-hidden'), 300);
    _msgConvId = null;
    if (_msgChannel) { _msgChannel.unsubscribe(); _msgChannel = null; }
  };

  (window as any).sendTrainerReply = async function() {
    if (!_msgConvId || !trainerId) return;
    const inp = document.getElementById('msg-reply-input') as HTMLTextAreaElement;
    const content = inp.value.trim();
    if (!content) return;
    inp.value = '';
    await supabase.from('messages').insert({ conversation_id: _msgConvId, sender_type: 'trainer', content });
  };

  // Auto-resize reply textarea
  document.getElementById('msg-reply-input')?.addEventListener('input', function(this: HTMLTextAreaElement) {
    this.style.height = 'auto';
    this.style.height = Math.min(this.scrollHeight, 120) + 'px';
  });

  // Load initial badge count on dashboard open
  _fetchUnreadBadge();

  // ── Sign out ─────────────────────────────────────────────────────────────
  document.getElementById('sign-out-btn')?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.href = '/';
  });
</script>

<script is:inline>
  // ── Avatar photo upload ──────────────────────────────────────────────────
  async function handleAvatarUpload(input) {
    const file = input.files[0];
    if (!file) return;

    // Size guard — 5 MB max
    if (file.size > 5 * 1024 * 1024) {
      showToast('❌ Image too large — max 5 MB');
      return;
    }

    const preview   = document.getElementById('profile-avatar-preview');
    const trainerId = window['__ptTrainerId'];
    const userId    = window['__ptUserId'];
    if (!trainerId || !userId) return;

    preview.innerHTML = '<div style="font-size:1.4rem;animation:spin 1s linear infinite;">⏳</div>';

    // Use user ID as folder so the storage RLS policy matches auth.uid()
    const ext  = file.name.split('.').pop() || 'jpg';
    const path = `${userId}/avatar.${ext}`;

    const { error: uploadErr } = await window['__ptSupabase'].storage
      .from('avatars')
      .upload(path, file, { upsert: true, contentType: file.type });

    if (uploadErr) {
      showToast('❌ Upload failed — ' + uploadErr.message);
      // Restore initials
      preview.textContent = window['__ptInitials'] || '?';
      return;
    }

    const { data: { publicUrl } } = window['__ptSupabase'].storage
      .from('avatars')
      .getPublicUrl(path);

    // Cache-bust the URL
    const urlWithBust = publicUrl + '?t=' + Date.now();

