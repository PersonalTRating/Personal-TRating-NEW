    <div class="page" id="page-reviews">
      <div class="section-eyebrow">Client Feedback</div>
      <div class="section-heading">Your Reviews</div>

      <div class="stats-grid" style="grid-template-columns:repeat(3,1fr);">
        <div class="stat-card"><div class="stat-icon">⭐</div><div class="stat-label">Average Rating</div><div class="stat-value" id="rev-stat-avg" style="color:var(--gold)">—</div><div class="stat-change up" id="rev-stat-avg-sub"></div></div>
        <div class="stat-card"><div class="stat-icon">📝</div><div class="stat-label">Total Reviews</div><div class="stat-value" id="rev-stat-total">—</div><div class="stat-change up" id="rev-stat-total-sub"></div></div>
        <div class="stat-card"><div class="stat-icon">✅</div><div class="stat-label">Verified Rate</div><div class="stat-value" id="rev-stat-verified">—</div><div class="stat-change up">All client-verified</div></div>
      </div>

      <div class="card">
        <div class="card-head">
          <div>
            <div class="card-title">All Reviews</div>
            <div class="card-sub">Showing most recent first</div>
          </div>
        </div>
        <div id="all-reviews-list" style="padding:0 1.5rem;"></div>
      </div>
