  function showPage(id) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.sb-item').forEach(i => i.classList.remove('active'));
    const page = document.getElementById('page-' + id);
    if (page) page.classList.add('active');
    const match = [...document.querySelectorAll('.sb-item')].find(el => el.getAttribute('onclick') && el.getAttribute('onclick').includes(id));
    if (match) match.classList.add('active');
    const [title, sub] = titles[id] || ['Dashboard', ''];
    document.getElementById('page-title').textContent = title;
    // Only update subtitle when we have one (overview keeps the personalised welcome set by auth script)
    if (sub) document.getElementById('page-sub').textContent = sub;
    window.scrollTo(0, 0);

    // Load feed posts when navigating to that page
    if (id === 'feed') loadFeedPosts();

    // Load messages when navigating to messages tab
    if (id === 'messages') loadConversations();

    // Load feed preview on overview
    if (id === 'overview') loadOverviewFeed();

    // Build share card when navigating to the links page
    if (id === 'links') setTimeout(buildShareCard, 80);

    // Mark notifications as read when the user opens that page
    if (id === 'notifications') {
      const badge  = document.getElementById('notif-badge');
      const dot    = document.querySelector('.notif-dot');
      const trainerId = window['__ptTrainerId'];
      if (trainerId) {
        // Count current reviews and persist as "last seen"
        const notifCard = document.getElementById('notif-card');
        const count = notifCard ? notifCard.querySelectorAll('.notif-item').length : 0;
        // We stored review count at login time — update the localStorage key
        const reviewCount = parseInt(localStorage.getItem('pt_review_count_snap_' + trainerId) || '0', 10);
        localStorage.setItem('pt_last_notif_seen_' + trainerId, String(reviewCount));
      }
      if (badge) badge.style.display = 'none';
      if (dot)   dot.style.display   = 'none';
      // No DOM bullet elements to update — unread state is purely from DB/localStorage
      // Mark appeal notifications as read in the database
      var supa = window['__ptSupabase'];
      var unreadAppealIds = window['__ptUnreadAppealIds'] || [];
      if (supa && unreadAppealIds.length > 0) {
        supa.from('notifications').update({ is_read: true }).in('id', unreadAppealIds).then(function() {
          window['__ptUnreadAppealIds'] = [];
        });
      }
    }
  }

