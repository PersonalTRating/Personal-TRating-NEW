      listEl.innerHTML = '<div style="text-align:center;padding:2.5rem 0;"><div style="font-size:2rem;margin-bottom:0.5rem;">📸</div><div style="font-weight:700;font-size:0.9rem;color:var(--text);margin-bottom:0.3rem;">No posts yet</div><div style="font-size:0.78rem;color:var(--muted);">Use the form above to publish your first update.</div></div>';
