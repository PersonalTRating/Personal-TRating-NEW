    box-shadow:0 0 0 3px rgba(58,181,74,0.15);
  }
  .notif-bullet.read { background:var(--border); box-shadow:none; }
  .notif-body { display:flex; flex-direction:column; gap:0.25rem; flex:1; min-width:0; }
  .notif-text { font-size:0.855rem; line-height:1.55; word-break:break-word; color:var(--text); }
  .notif-time { font-size:0.7rem; color:var(--muted); margin-top:0.15rem; }

  /* ── SECTION HEADING ── */
  .section-eyebrow { font-size:0.7rem; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--green); margin-bottom:0.3rem; }
  .section-heading { font-family:'Playfair Display',serif; font-size:1.6rem; font-weight:900; margin-bottom:1.5rem; }

  /* ── TOAST ── */
  .copy-toast {
    position:fixed; bottom:2rem; left:50%; transform:translateX(-50%);
    background:var(--text); color:white; padding:0.6rem 1.5rem;
    border-radius:8px; font-size:0.82rem; font-weight:600;
    opacity:0; pointer-events:none; transition:opacity 0.3s; z-index:999;
  }
  .copy-toast.show { opacity:1; }

  /* ── ANIMATIONS ── */
  @keyframes fadeUp { from { opacity:0; transform:translateY(16px); } to { opacity:1; transform:translateY(0); } }
  .page.active .stat-card { animation:fadeUp 0.4s ease both; }
  .page.active .stat-card:nth-child(2) { animation-delay:0.05s; }
  .page.active .stat-card:nth-child(3) { animation-delay:0.10s; }
  .page.active .stat-card:nth-child(4) { animation-delay:0.15s; }

  /* ── RESPONSIVE ── */
  @media (max-width: 1100px) {
    .stats-grid { grid-template-columns:repeat(2,1fr); }
    .three-col  { grid-template-columns:1fr; }
  }
  @media (max-width: 768px) {
    /* Sidebar slides in as overlay */
    .sidebar {
      transform:translateX(-100%);
      transition:transform 0.3s ease;
      z-index:200;
    }
    .sidebar.mob-open { transform:translateX(0); }
    /* Dark backdrop */
    .mob-overlay {
      display:none; position:fixed; inset:0;
      background:rgba(0,0,0,0.5); z-index:199;
    }
    .mob-overlay.active { display:block; }
    /* Hamburger button */
    .mob-menu-btn {
      display:flex !important; align-items:center; justify-content:center;
      width:36px; height:36px; background:none; border:1px solid var(--border);
      border-radius:8px; cursor:pointer; font-size:1.15rem; flex-shrink:0;
    }
    .main      { margin-left:0; }
    .content   { padding:1.25rem; }
    .topbar    { padding:0.75rem 1.25rem; gap:0.75rem; }
    .topbar-btn { font-size:0.75rem; padding:0.5rem 0.85rem; }
    .form-grid  { grid-template-columns:1fr; }
    .stats-grid { grid-template-columns:1fr 1fr; }
    .form-grid .full { grid-column:1; }
    .card-body  { padding:1.25rem; }
    .card-head  { padding:1rem 1.25rem; }
  }
  @media (max-width: 480px) {
    .stats-grid  { grid-template-columns:1fr 1fr; gap:0.75rem; }
    .topbar-btn  { display:none; }
    .topbar-left h1 { font-size:1.15rem; }
    .content { padding-bottom:80px; }
  }

  /* ── Mobile bottom nav ── */
  .mob-bottom-nav {
    display:none;
    position:fixed; bottom:0; left:0; right:0; z-index:300;
    background:white; border-top:1px solid #e8ede9;
    padding:0.5rem 0 calc(0.5rem + env(safe-area-inset-bottom));
    box-shadow:0 -4px 24px rgba(0,0,0,0.07);
  }
  .mob-bottom-nav ul {
    list-style:none; margin:0; padding:0 0.5rem;
    display:flex; justify-content:space-around; align-items:center;
  }
  .mob-bottom-nav li { flex:1; position:relative; }
  .mob-bottom-nav button {
    width:100%; background:none; border:none; cursor:pointer;
    display:flex; flex-direction:column; align-items:center; gap:0.25rem;
    padding:0.4rem 0.25rem; color:#7a8f7c; transition:color 0.15s;
  }
  .mob-bottom-nav button.active { color:#3ab54a; }
  .mob-bottom-nav .nav-icon { font-size:1.45rem; line-height:1; }
  .mob-bottom-nav .nav-label { font-size:0.58rem; font-weight:700; letter-spacing:0.5px; text-transform:uppercase; }
  .mob-bottom-nav .nav-badge {
    position:absolute; top:2px; right:calc(50% - 18px);
    background:#3ab54a; color:white;
    font-size:0.5rem; font-weight:800;
    min-width:14px; height:14px; border-radius:7px; padding:0 3px;
    display:none; align-items:center; justify-content:center;
    box-sizing:border-box;
  }
  .mob-bottom-nav .nav-badge.visible { display:flex; }
  @media (max-width:768px) {
    .mob-bottom-nav { display:block; }
    #mob-sidebar-tab { display:flex !important; }
    #mob-sidebar-tab.open { left:var(--sidebar-w); }
    #mob-sidebar-tab.open svg { transform:rotate(180deg); }
  }
  @media (max-width: 900px) {
    #link-builder-grid { grid-template-columns:1fr !important; }
    #share-card { width:100% !important; max-width:360px; margin:0 auto; }
  }

  /* ── Messages ── */
  #msg-conv-list { background:none !important; border:none !important; box-shadow:none !important; padding:0 !important; }
  .msg-card {
    display:flex; align-items:stretch;
    background:white; border:1px solid var(--border); border-radius:14px;
    overflow:hidden; margin-bottom:0.85rem;
  }
  .msg-card:last-child { margin-bottom:0; }
  .msg-card-left {
    display:flex; align-items:flex-start; gap:1rem;
    flex:1; padding:1.25rem 1.5rem; min-width:0;
  }
  .msg-card-av {
    width:52px; height:52px; border-radius:50%; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
    font-weight:800; font-size:1rem;
  }
  .msg-card-info { flex:1; min-width:0; }
  .msg-card-name  { font-weight:700; font-size:0.95rem; color:var(--text); margin-bottom:0.15rem; }
  .msg-card-date  { font-size:0.78rem; color:var(--muted); margin-bottom:0.6rem; }
  .msg-card-preview { font-size:0.85rem; color:var(--muted); font-style:italic; }
  .msg-card-right {
    width:170px; flex-shrink:0; border-left:1px solid var(--border);
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    padding:1.25rem 1rem; gap:0.5rem; background:#fafbfa;
  }
  .msg-card-stat-label { font-size:0.62rem; font-weight:700; letter-spacing:0.08em; color:var(--muted); }
  .msg-card-stat-num   { font-family:'Playfair Display',serif; font-size:2.4rem; font-weight:900; line-height:1; color:var(--text); }
  .msg-card-stat-num.new { color:var(--green); }
  .msg-view-btn {
    background:var(--green-light); color:var(--green-dark);
    border:1.5px solid var(--green-mid); border-radius:7px;
    padding:0.45rem 0.8rem; font-size:0.75rem; font-weight:700;
    cursor:pointer; width:100%; transition:all 0.15s;
    font-family:inherit; white-space:nowrap; margin-top:0.25rem;
  }
  .msg-view-btn:hover { background:var(--green); color:white; border-color:var(--green); }
  .msg-bubble-t { background:var(--text); color:white; padding:0.6rem 0.85rem; border-radius:14px 14px 4px 14px; font-size:0.875rem; line-height:1.5; word-break:break-word; }
  .msg-bubble-c { background:white; color:var(--text); border:1px solid var(--border); padding:0.6rem 0.85rem; border-radius:14px 14px 14px 4px; font-size:0.875rem; line-height:1.5; word-break:break-word; }
  .msg-time { font-size:0.62rem; color:#aab8ac; margin-top:0.2rem; }

  /* ── Trainer reply panel (bottom-right) ── */
  .tr-chat-panel {
    position:fixed; bottom:24px; right:24px; z-index:9999;
    width:360px; max-height:520px;
    background:white; border-radius:16px;
    box-shadow:0 12px 48px rgba(0,0,0,0.18), 0 2px 8px rgba(0,0,0,0.08);
    display:flex; flex-direction:column; overflow:hidden;
    transform:translateY(24px); opacity:0; pointer-events:none;
    transition:transform 0.3s cubic-bezier(.34,1.56,.64,1), opacity 0.25s ease;
  }
  .tr-chat-panel.open { transform:translateY(0); opacity:1; pointer-events:all; }
  .tr-chat-hidden { display:none !important; }
  .tr-chat-hdr {
    background:linear-gradient(135deg,#0d1a0e,#1a3d1e);
    padding:0.85rem 1rem; display:flex; align-items:center; gap:0.75rem; flex-shrink:0;
  }
  .tr-chat-av {
    width:38px; height:38px; border-radius:50%; flex-shrink:0;
    background:#2a9438; color:white;
    display:flex; align-items:center; justify-content:center;
    font-weight:800; font-size:0.82rem;
  }
  .tr-chat-name { font-weight:700; font-size:0.88rem; color:white; }
  .tr-chat-sub  { font-size:0.68rem; color:rgba(255,255,255,0.45); margin-top:0.1rem; }
  .tr-chat-close {
    margin-left:auto; background:rgba(255,255,255,0.1); border:none;
    color:rgba(255,255,255,0.7); width:28px; height:28px; border-radius:6px;
    cursor:pointer; font-size:0.85rem; display:flex; align-items:center;
    justify-content:center; transition:background 0.15s;
  }
  .tr-chat-close:hover { background:rgba(255,255,255,0.22); }
  .tr-chat-msgs {
    flex:1; overflow-y:auto; padding:1rem;
    display:flex; flex-direction:column; gap:0.65rem; background:#f7f9f7;
  }
  .tr-chat-input-row {
    padding:0.75rem; border-top:1px solid var(--border);
    display:flex; gap:0.5rem; align-items:flex-end;
    flex-shrink:0; background:white;
  }
  .tr-chat-input {
    flex:1; border:1.5px solid var(--border); border-radius:10px;
    padding:0.55rem 0.85rem; font-family:inherit; font-size:0.875rem;
    resize:none; outline:none; min-height:40px; max-height:110px;
    transition:border-color 0.2s;
  }
  .tr-chat-input:focus { border-color:var(--green); }
  .tr-chat-send {
    width:40px; height:40px; border-radius:10px; background:var(--green);
    color:white; border:none; cursor:pointer; font-size:1.05rem;
    display:flex; align-items:center; justify-content:center; flex-shrink:0;
    transition:background 0.15s;
  }
  .tr-chat-send:hover { background:var(--green-dark); }
  @media (max-width:480px) {
    .tr-chat-panel { bottom:0; right:0; left:0; width:100%; border-bottom-left-radius:0; border-bottom-right-radius:0; max-height:72vh; }
  }
</style>
