                <button id="avatar-upload-btn" style="background:none;border:1.5px solid rgba(255,255,255,0.5);color:rgba(255,255,255,0.85);padding:0.4rem 1rem;border-radius:6px;font-size:0.78rem;font-weight:600;cursor:pointer;transition:all 0.15s;font-family:inherit;"
