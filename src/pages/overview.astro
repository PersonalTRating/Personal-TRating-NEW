---
import TrainerCard from '../components/TrainerCard.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CoachCards â€” Get Discovered. Get Booked.</title>
  <meta name="description" content="CoachCards helps personal trainers turn their existing client reputation into visibility and a stronger reason for potential new clients to choose them. Build your CoachCard free." />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Manrope:wght@400;500;600;700;800&display=swap"
    rel="stylesheet" media="print" onload="this.media='all'"
  />
  <link rel="preload" as="image" href="/images/hero-bg.webp" />
</head>

<style is:global>
/* â”€â”€ Base â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: 'Manrope', ui-sans-serif, system-ui, sans-serif;
  background: #0d1a0e;
  color: #fff;
  -webkit-font-smoothing: antialiased;
}
img { max-width: 100%; height: auto; display: block; }
a:focus-visible { outline: 2px solid #3ab54a; outline-offset: 3px; }

/* â”€â”€ Container â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
.ov-wrap {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 2.5rem;
}

/* â”€â”€ Navigation â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
#ov-nav {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #fff;
  border-bottom: 1px solid #e0e8e1;
  box-shadow: 0 1px 8px rgba(0,0,0,0.05);
}
.ov-nav-inner {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 2.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72px;
}
.ov-nav-brand { display:flex; align-items:center; gap:0.6rem; text-decoration:none; }
.ov-logo-img { height:42px; width:42px; flex-shrink:0; }
.ov-wordmark { font-family:'Manrope',sans-serif; font-size:1.15rem; font-weight:800; letter-spacing:-0.2px; line-height:1; }
.ov-wordmark-coach { color:#3ab54a; }
.ov-wordmark-cards { color:#111311; }
.ov-nav-links {
  display: flex;
  align-items: center;
  gap: 1.75rem;
}
.ov-nl {
  color: #8a8f8a;
  font-size: 0.875rem;
  font-weight: 500;
  text-decoration: none;
  transition: color 0.15s;
}
.ov-nl:hover { color: #111311; }
.ov-nav-cta {
  background: #3ab54a;
  color: #fff;
  padding: 0.55rem 1.3rem;
  border-radius: 6px;
  font-size: 0.875rem;
  font-weight: 700;
  text-decoration: none;
  transition: background 0.15s, transform 0.15s;
  white-space: nowrap;
}
.ov-nav-cta:hover { background: #2a9438; transform: translateY(-1px); }
.ov-ham {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
  color: #111311;
}
.ov-mob-nav {
  background: #fff;
  border-top: 1px solid #e0e8e1;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
  display: none;
  flex-direction: column;
}
.ov-mob-nav.ov-mob-open { max-height: 340px; }
.ov-mob-link {
  display: block;
  padding: 0.9rem 1.5rem;
  color: #111311;
  font-size: 0.9rem;
  font-weight: 500;
  text-decoration: none;
  border-bottom: 1px solid #f0f0f0;
}
.ov-mob-btns {
  display: flex;
  gap: 0.75rem;
  padding: 1rem 1.5rem 1.25rem;
}
.ov-mob-signin {
  flex: 1; text-align: center; padding: 0.65rem;
  border: 2px solid #3ab54a; color: #3ab54a;
  font-weight: 700; font-size: 0.875rem; border-radius: 6px; text-decoration: none;
}
.ov-mob-cta {
  flex: 1; text-align: center; padding: 0.65rem;
  background: #3ab54a; color: #fff;
  font-weight: 700; font-size: 0.875rem; border-radius: 6px; text-decoration: none;
}

/* â”€â”€ Buttons â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
.ov-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  background: #3ab54a;
  color: #fff;
  padding: 0.875rem 2rem;
  border-radius: 8px;
  font-size: 0.95rem;
  font-weight: 800;
  text-decoration: none;
  letter-spacing: 0.2px;
  transition: background 0.15s, transform 0.2s, box-shadow 0.2s;
  box-shadow: 0 4px 16px rgba(58,181,74,0.22);
  white-space: nowrap;
}
.ov-btn:hover { background: #2a9438; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(58,181,74,0.35); }
.ov-btn:active { transform: translateY(0); }
.ov-btn--xl { padding: 1.1rem 2.75rem; font-size: 1.1rem; }
.ov-btn-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  color: rgba(255,255,255,0.68);
  border: 1px solid rgba(255,255,255,0.22);
  padding: 0.875rem 1.75rem;
  border-radius: 8px;
  font-size: 0.95rem;
  font-weight: 600;
  text-decoration: none;
  transition: color 0.15s, border-color 0.15s, background 0.15s;
  white-space: nowrap;
}
.ov-btn-ghost:hover { color: #fff; border-color: rgba(255,255,255,0.48); background: rgba(255,255,255,0.05); }

/* â”€â”€ Shared type â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
.ov-eyebrow {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: #3ab54a;
  margin-bottom: 0.9rem;
}
.ov-h2 {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 2.5rem;
  font-weight: 900;
  line-height: 1.1;
  color: #fff;
  margin-bottom: 3rem;
}
.ov-h2--center { text-align: center; }
.ov-accent { font-style: normal; color: #3ab54a; }

/* â”€â”€ Section 1: Hero â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
#ov-hero {
  position: relative;
  min-height: 91vh;
  display: flex;
  align-items: center;
  overflow: hidden;
}
.ov-hero-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.ov-hero-bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 35%;
  filter: brightness(0.38) saturate(0.65);
  will-change: transform;
}
.ov-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(130deg,
    rgba(5,14,6,0.9) 0%,
    rgba(6,16,7,0.75) 55%,
    rgba(6,16,7,0.48) 100%
  );
}
.ov-hero-content {
  position: relative;
  z-index: 1;
  padding-top: 5rem;
  padding-bottom: 5.5rem;
  max-width: 720px;
  width: 100%;
}
.ov-pill {
  display: inline-block;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: #3ab54a;
  border: 1px solid rgba(58,181,74,0.5);
  padding: 0.28rem 0.8rem;
  border-radius: 100px;
  margin-bottom: 1.5rem;
}
.ov-hero-h1 {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 4.1rem;
  font-weight: 900;
  line-height: 1.07;
  color: #fff;
  margin-bottom: 1.5rem;
}
.ov-hero-sub {
  font-size: 1.05rem;
  line-height: 1.75;
  color: rgba(255,255,255,0.68);
  max-width: 540px;
  margin-bottom: 2.25rem;
}
.ov-hero-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 0.875rem;
  align-items: center;
}

/* Hero entrance â€” runs once on load */
.ov-h-1 { animation: ovUp 0.6s 0.10s ease both; }
.ov-h-2 { animation: ovUp 0.65s 0.26s ease both; }
.ov-h-3 { animation: ovUp 0.65s 0.40s ease both; }
.ov-h-4 { animation: ovUp 0.6s 0.54s ease both; }
.ov-h-5 { animation: ovUp 0.6s 0.66s ease both; }
@keyframes ovUp {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: none; }
}

/* â”€â”€ Section 2: 53% â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
#ov-stat {
  background: #060e07;
  padding: 6rem 0;
  border-top: 1px solid rgba(58,181,74,0.1);
  overflow: hidden;
}
.ov-stat-bar {
  height: 2px;
  width: 0;
  max-width: 520px;
  background: linear-gradient(90deg, #3ab54a 0%, rgba(58,181,74,0.15) 100%);
  margin: 0 auto 3.5rem;
  transition: width 1s 0.15s cubic-bezier(0.4, 0, 0.2, 1);
}
.ov-stat-bar.ov-vis { width: 100%; }
.ov-stat-inner {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 3.5rem;
  align-items: center;
}
.ov-stat-big {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 8.5rem;
  font-weight: 900;
  color: #3ab54a;
  line-height: 1;
  white-space: nowrap;
  text-shadow: 0 0 80px rgba(58,181,74,0.2);
  transition: opacity 0.4s;
}
.ov-stat-text-h {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 1.75rem;
  font-weight: 900;
  color: #fff;
  line-height: 1.25;
  margin-bottom: 0.9rem;
}
.ov-stat-body {
  font-size: 0.97rem;
  color: rgba(255,255,255,0.6);
  line-height: 1.72;
  margin-bottom: 0.85rem;
}
.ov-stat-source {
  font-size: 0.73rem;
  color: rgba(255,255,255,0.28);
}

/* â”€â”€ Section 3: Ready in Minutes â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
#ov-easy {
  background: #0a120b;
  padding: 6rem 0;
  border-top: 1px solid rgba(58,181,74,0.1);
}
.ov-easy-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  margin-bottom: 2.5rem;
}
.ov-easy-card {
  background: rgba(58,181,74,0.03);
  border: 1px solid rgba(58,181,74,0.18);
  border-radius: 16px;
  padding: 2rem 1.75rem;
  position: relative;
  overflow: hidden;
}
.ov-easy-card::before {
  content: '';
  position: absolute;
  inset: 0 0 auto 0;
  height: 2px;
  background: #3ab54a;
  border-radius: 16px 16px 0 0;
}
.ov-easy-val {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 2.75rem;
  font-weight: 900;
  color: #3ab54a;
  line-height: 1;
  margin-bottom: 0.5rem;
}
.ov-easy-lbl {
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: #fff;
  margin-bottom: 0.7rem;
}
.ov-easy-desc {
  font-size: 0.875rem;
  color: rgba(255,255,255,0.45);
  line-height: 1.65;
}
.ov-easy-foot {
  text-align: center;
  font-size: 0.875rem;
  color: rgba(255,255,255,0.35);
  max-width: 500px;
  margin: 0 auto;
  line-height: 1.65;
}

/* â”€â”€ Section 4: Why CoachCard â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
#ov-why {
  background: #0d1a0e;
  padding: 6rem 0;
  border-top: 1px solid rgba(58,181,74,0.08);
}
.ov-why-grid {
  display: grid;
  grid-template-columns: 1fr 420px;
  gap: 5rem;
  align-items: start;
}
.ov-benefit {
  display: flex;
  gap: 1.2rem;
  align-items: flex-start;
  padding: 1.75rem 0;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
.ov-benefit:last-of-type { border-bottom: none; }
.ov-benefit-num {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 1.85rem;
  font-weight: 900;
  color: rgba(58,181,74,0.28);
  flex-shrink: 0;
  width: 2.4rem;
  line-height: 1;
  padding-top: 0.1rem;
}
.ov-benefit-title {
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: #fff;
  margin-bottom: 0.4rem;
}
.ov-benefit-body {
  font-size: 0.88rem;
  color: rgba(255,255,255,0.48);
  line-height: 1.65;
}
.ov-why-cta { margin-top: 2rem; }

/* CoachCard demo */
.ov-card-wrap {
  position: sticky;
  top: 92px;
}
.ov-card-lbl {
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: rgba(58,181,74,0.55);
  text-align: center;
  margin-bottom: 0.75rem;
}
.ov-card-demo .trc { pointer-events: none; transition: box-shadow 0.4s ease !important; }
.ov-card-caption {
  font-size: 0.7rem;
  color: rgba(255,255,255,0.22);
  text-align: center;
  margin-top: 0.75rem;
  font-style: italic;
}

/* Card highlight states toggled by scroll JS */
.ov-card-demo.hl-reviews .trc-reviews {
  color: rgba(220,100,60,0.95) !important;
  text-shadow: 0 0 10px rgba(220,100,60,0.35);
}
.ov-card-demo.hl-bmp .trc-bmp-num {
  text-shadow: 0 0 18px rgba(58,181,74,0.8) !important;
}
.ov-card-demo.hl-bmp .trc-rank {
  text-shadow: 0 0 14px rgba(58,181,74,0.65) !important;
}
.ov-card-demo.hl-card .trc {
  box-shadow:
    0 0 0 2px rgba(58,181,74,0.55),
    0 0 28px rgba(58,181,74,0.22),
    0 2px 12px rgba(0,0,0,0.35) !important;
}

/* â”€â”€ Section 5: How It Works â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
#ov-how {
  background: #060e07;
  padding: 3rem 0;
  border-top: 1px solid rgba(58,181,74,0.1);
}
#ov-how .ov-h2 { margin-bottom: 1.25rem; }
.ov-tl { position: relative; }
.ov-tl-track {
  position: absolute;
  left: 0; right: 0;
  top: 64px; /* below 56px circles + 8px connector gap */
  height: 2px;
  background: rgba(255,255,255,0.05);
  pointer-events: none;
}
.ov-tl-fill {
  height: 100%;
  width: 0;
  background: linear-gradient(90deg, #3ab54a 0%, rgba(58,181,74,0.35) 100%);
  transition: width 1.5s 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}
.ov-tl-fill.ov-tl-go { width: 100%; }
/* Vertical track â€” mobile only */
.ov-tl-vtrack {
  display: none;
  position: absolute;
  left: 64px; /* right of 56px circles + 8px connector gap */
  top: 0; bottom: 0;
  width: 2px;
  background: rgba(255,255,255,0.05);
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}
.ov-tl-vfill {
  width: 100%;
  height: 0;
  background: linear-gradient(180deg, #3ab54a 0%, rgba(58,181,74,0.35) 100%);
  transition: height 1.8s 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
.ov-tl-vfill.ov-tl-go { height: 100%; }
.ov-tl-steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
  position: relative;
  z-index: 1;
}
.ov-tl-step { display: flex; flex-direction: column; align-items: center; text-align: center; }
@keyframes ov-tl-pulse {
  0%   { transform: scale(1); }
  45%  { transform: scale(1.06); }
  100% { transform: scale(1); }
}
.ov-tl-num {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  border: 2px solid rgba(58,181,74,0.2);
  background: #0d1a0e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.8rem;
  font-weight: 800;
  letter-spacing: 1px;
  color: rgba(58,181,74,0.5);
  flex-shrink: 0;
  margin-bottom: 1rem;
  position: relative;
  transition: border-color 0.35s, background 0.35s, box-shadow 0.35s, color 0.35s;
}
.ov-tl-num::after {
  content: '';
  position: absolute;
  bottom: -8px;
  left: 50%;
  transform: translateX(-50%);
  width: 1px;
  height: 8px;
  background: rgba(58,181,74,0.18);
  transition: background 0.35s;
}
.ov-tl-step.ov-tl-active .ov-tl-num {
  border-color: #3ab54a;
  background: rgba(58,181,74,0.1);
  box-shadow: 0 0 0 5px rgba(58,181,74,0.1), 0 0 14px rgba(58,181,74,0.18);
  color: #3ab54a;
  animation: ov-tl-pulse 0.45s ease-out forwards;
}
.ov-tl-step.ov-tl-active .ov-tl-num::after { background: rgba(58,181,74,0.5); }
.ov-tl-title {
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.55);
