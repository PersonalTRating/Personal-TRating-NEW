<script>
// â”€â”€ Disable demo card link/focus â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
const demoLink = document.querySelector<HTMLAnchorElement>('#ov-card-demo .trc');
if (demoLink) {
  demoLink.setAttribute('tabindex', '-1');
  demoLink.removeAttribute('href');
}

// â”€â”€ Reduced motion flag â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

// â”€â”€ Scroll reveal â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
const revEls = document.querySelectorAll<HTMLElement>('[data-reveal]');

if (reducedMotion) {
  revEls.forEach(el => el.classList.add('ov-vis'));
} else {
  const revObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('ov-vis');
        revObs.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -30px 0px' });
  revEls.forEach(el => revObs.observe(el));
}

// â”€â”€ Stat section: bar + count â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
const statBar   = document.getElementById('ov-stat-bar');
const countEl   = document.getElementById('ov-count');
const statSect  = document.getElementById('ov-stat');
let statDone    = false;

if (statSect && countEl && statBar) {
  const statObs = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting && !statDone) {
      statDone = true;
      statObs.disconnect();
      statBar.classList.add('ov-vis');

      if (reducedMotion) {
        countEl.textContent = '53';
        return;
      }

      const startTime = performance.now();
      const duration  = 1700;
      const target    = 53;

      function tick(now: number) {
        const elapsed  = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const eased    = 1 - Math.pow(1 - progress, 3); // ease-out cubic
        countEl!.textContent = String(Math.round(eased * target));
        if (progress < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }
  }, { threshold: 0.25 });
  statObs.observe(statSect);
}

// â”€â”€ Timeline: sequential stage activation â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
const tlFill  = document.getElementById('ov-tl-fill');
const tlVFill = document.getElementById('ov-tl-vfill');
const tlSect  = document.getElementById('ov-tl');
const tlSteps = document.querySelectorAll<HTMLElement>('.ov-tl-step');

if (reducedMotion) {
  if (tlFill)  tlFill.classList.add('ov-tl-go');
  if (tlVFill) tlVFill.classList.add('ov-tl-go');
  tlSteps.forEach(s => s.classList.add('ov-tl-active'));
} else if (tlSect) {
  // Desktop line: 1.5s duration, 0.4s delay. Steps at 12.5/37.5/62.5/87.5% width.
  // Mobile vline: 1.8s duration, 0.3s delay. Steps at 12.5/37.5/62.5/87.5% height.
  // Activation ms from observer fire (desktop timings):
  //   step 1: 400 + (0.125 * 1500) = 588ms
  //   step 2: 400 + (0.375 * 1500) = 963ms
  //   step 3: 400 + (0.625 * 1500) = 1338ms
  //   step 4: 400 + (0.875 * 1500) = 1713ms
  const isMobile = () => window.innerWidth <= 768;
  const desktopDelays = [588, 963, 1338, 1713];
  // Mobile vline: 1.8s duration, 0.3s delay:
  //   step 1: 300 + (0.125 * 1800) = 525ms
  //   step 2: 300 + (0.375 * 1800) = 975ms
  //   step 3: 300 + (0.625 * 1800) = 1425ms
  //   step 4: 300 + (0.875 * 1800) = 1875ms
  const mobileDelays  = [525, 975, 1425, 1875];

  const tlObs = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) {
      if (tlFill)  tlFill.classList.add('ov-tl-go');
      if (tlVFill) tlVFill.classList.add('ov-tl-go');
      const delays = isMobile() ? mobileDelays : desktopDelays;
      tlSteps.forEach((step, i) => {
        setTimeout(() => step.classList.add('ov-tl-active'), delays[i]);
      });
      tlObs.disconnect();
    }
  }, { threshold: 0.2 });
  tlObs.observe(tlSect);
}

// â”€â”€ CoachCard benefit highlight â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
const cardDemo   = document.getElementById('ov-card-demo');
const benefits   = document.querySelectorAll<HTMLElement>('[data-hl]');
const hlClasses  = { reviews: 'hl-reviews', bmp: 'hl-bmp', card: 'hl-card' } as const;

if (cardDemo && benefits.length && !reducedMotion) {
  const hlObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const key = (entry.target as HTMLElement).dataset.hl as keyof typeof hlClasses;
        const cls = hlClasses[key];
        if (!cls) return;
        Object.values(hlClasses).forEach(c => cardDemo!.classList.remove(c));
        cardDemo!.classList.add(cls);
      }
    });
  }, { threshold: 0.65, rootMargin: '-80px 0px -80px 0px' });
  benefits.forEach(b => hlObs.observe(b));
}

// â”€â”€ Subtle hero parallax (desktop only, performance-safe) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
const heroImg = document.getElementById('ov-parallax-img') as HTMLElement | null;
if (heroImg && !reducedMotion && window.innerWidth > 768) {
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        const scrollY = window.scrollY;
        const hero = document.getElementById('ov-hero');
        if (hero) {
          const heroH = hero.offsetHeight;
          if (scrollY <= heroH) {
            heroImg.style.transform = `translateY(${scrollY * 0.18}px)`;
          }
        }
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });
}

// â”€â”€ Mobile hamburger â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
const ham    = document.getElementById('ov-ham');
const mobNav = document.getElementById('ov-mob-nav');
if (ham && mobNav) {
  ham.addEventListener('click', () => {
    const isOpen = mobNav.classList.contains('ov-mob-open');
    mobNav.classList.toggle('ov-mob-open');
    ham.setAttribute('aria-expanded', String(!isOpen));
    mobNav.setAttribute('aria-hidden', String(isOpen));
  });

  // Close on nav link click
  mobNav.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      mobNav.classList.remove('ov-mob-open');
      ham.setAttribute('aria-expanded', 'false');
      mobNav.setAttribute('aria-hidden', 'true');
    });
  });
}

// â”€â”€ Smooth scroll for anchor link (hero â†’ section 3) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
document.querySelector('a[href="#ov-easy"]')?.addEventListener('click', (e) => {
  e.preventDefault();
  document.getElementById('ov-easy')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
});
</script>
