---
// Force sign out
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Signing out… — CoachCards</title>
<style>
  body { margin:0; font-family:'Manrope',sans-serif; background:#f7f9f7; display:flex; align-items:center; justify-content:center; min-height:100vh; }
  .box { text-align:center; }
  .spinner { width:44px; height:44px; border:4px solid #eaf7ec; border-top-color:#3ab54a; border-radius:50%; animation:spin 0.8s linear infinite; margin:0 auto 1rem; }
  @keyframes spin { to { transform:rotate(360deg); } }
  p { color:#7a8f7c; font-size:0.9rem; }
</style>
</head>
<body>
  <div class="box">
    <div class="spinner"></div>
    <p>Signing you out…</p>
  </div>
  <script>
    import { supabase } from '../lib/supabase';
    supabase.auth.signOut().then(() => {
      // Clear all Supabase keys from localStorage to ensure a clean slate
      Object.keys(localStorage).forEach(function(key) {
        if (key.startsWith('sb-')) localStorage.removeItem(key);
      });
      window.location.href = '/login';
    });
  </script>
</body>
</html>
