    'bradford':[53.7960,-1.7594],'exeter':[50.7184,-3.5339],'plymouth':[50.3755,-4.1427],
    'southampton':[50.9097,-1.4044],'portsmouth':[50.8198,-1.0880],'brighton':[50.8225,-0.1372],
    'oxford':[51.7520,-1.2577],'cambridge':[52.2053,0.1218],'norwich':[52.6309,1.2974],
    'reading':[51.4543,-0.9781],'derby':[52.9225,-1.4746],'stoke':[53.0027,-2.1794],
    'wolverhampton':[52.5869,-2.1288],'sunderland':[54.9069,-1.3838],'middlesbrough':[54.5752,-1.2349],
    'hull':[53.7457,-0.3367],'york':[53.9590,-1.0815],'aberdeen':[57.1497,-2.0943],
    'dundee':[56.4620,-2.9707],'inverness':[57.4778,-4.2247],'swansea':[51.6214,-3.9436],
    'newport':[51.5842,-2.9977],'bath':[51.3758,-2.3599],'cheltenham':[51.9000,-2.0830],
    'gloucester':[51.8642,-2.2380],'bournemouth':[50.7192,-1.8808],'poole':[50.7155,-1.9871],
    'bolton':[53.5780,-2.4282],'wigan':[53.5450,-2.6370],'blackpool':[53.8142,-3.0503],
    'preston':[53.7632,-2.7031],'burnley':[53.7890,-2.2494],'oldham':[53.5409,-2.1114],
    'salford':[53.4875,-2.2901],'stockport':[53.4106,-2.1575],'warrington':[53.3900,-2.5970],
    'chester':[53.1905,-2.8910],'bury':[53.5933,-2.2986],'huddersfield':[53.6458,-1.7850],
    'wakefield':[53.6830,-1.4977],'doncaster':[53.5228,-1.1286],'rotherham':[53.4326,-1.3635],
    'harrogate':[53.9922,-1.5378],'barnsley':[53.5547,-1.4791],'salisbury':[51.0693,-1.7957],
    'truro':[50.2632,-5.0510],'torquay':[50.4619,-3.5253],'yeovil':[50.9425,-2.6303],
