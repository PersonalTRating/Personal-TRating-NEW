<!-- ── BMP EXPLAINED ── -->
<section style="padding:6rem 0;background:white;border-top:3px solid #3ab54a;border-bottom:3px solid #3ab54a;">
  <div style="max-width:900px;margin:0 auto;padding:0 2.5rem;">
    <div style="text-align:center;margin-bottom:4rem;">
      <div style="font-size:0.72rem;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:#3ab54a;margin-bottom:0.75rem;">The BMP Score</div>
      <div style="font-family:'Playfair Display',serif;font-size:2.5rem;font-weight:900;color:#111311;line-height:1.15;margin-bottom:1rem;">One number that actually means something.</div>
      <p style="font-size:0.95rem;color:#7a8f7c;line-height:1.8;max-width:580px;margin:0 auto;">Star ratings alone can be gamed. One five-star review from a friend tells you nothing. The BMP score is designed to reward trainers who are consistently excellent — not just occasionally lucky.</p>
    </div>

    <!-- Formula breakdown -->
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;margin-bottom:3.5rem;" class="bmp-formula-grid">

      <div style="background:#f7f9f7;border:1px solid #e0e8e1;border-radius:16px;padding:2rem;">
        <div style="margin-bottom:1.25rem;">
          <div style="font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:900;color:#2a9438;line-height:1;margin-bottom:0.3rem;">70 PTS</div>
          <div style="font-weight:800;font-size:0.78rem;color:#2a9438;margin-bottom:0.4rem;">Review Quality</div>
        </div>
        <p style="font-size:0.875rem;color:#7a8f7c;line-height:1.8;">The foundation of your BMP score. Based on your <strong style="color:#111311;">verified average rating</strong>, smoothed to prevent a single lucky review from inflating the score. Consistent excellence wins here.</p>
      </div>

      <div style="background:#f7f9f7;border:1px solid #e0e8e1;border-radius:16px;padding:2rem;">
        <div style="margin-bottom:1.25rem;">
          <div style="font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:900;color:#1a4b6b;line-height:1;margin-bottom:0.3rem;">20 PTS</div>
          <div style="font-weight:800;font-size:0.78rem;color:#1a4b6b;margin-bottom:0.4rem;">Review Confidence</div>
        </div>
        <p style="font-size:0.875rem;color:#7a8f7c;line-height:1.8;">A logarithmic bonus for <strong style="color:#111311;">review volume</strong>. Gains come quickly early on, then taper — 10 reviews earns most of the confidence score. Rewards track record, not just quantity.</p>
      </div>

      <div style="background:#f7f9f7;border:1px solid #e0e8e1;border-radius:16px;padding:2rem;">
        <div style="margin-bottom:1.25rem;">
          <div style="font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:900;color:#e65c00;line-height:1;margin-bottom:0.3rem;">10 PTS</div>
