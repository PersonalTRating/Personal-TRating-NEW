              </div>
            )}
          </div>
          <div style="text-align:right;flex-shrink:0;">
            <div style="font-family:'Manrope',sans-serif;font-weight:800;font-size:1.3rem;color:#3ab54a;line-height:1;">{t.bmp}</div>
