<script is:inline>
(function () {
  var mapEl = document.getElementById('pt-map');
  if (!mapEl) return;

  function loadLeaflet(cb) {
    if (typeof L !== 'undefined') { cb(); return; }
    if (!document.getElementById('leaflet-css')) {
      var link = document.createElement('link');
      link.id = 'leaflet-css'; link.rel = 'stylesheet';
      link.href = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css';
      document.head.appendChild(link);
    }
    var s = document.createElement('script');
    s.src = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js';
    s.onload = cb;
    document.head.appendChild(s);
  }

  var observer = new IntersectionObserver(function (entries) {
    if (!entries[0].isIntersecting) return;
    observer.disconnect();
    loadLeaflet(initMap);
  }, { rootMargin: '200px' });
  observer.observe(mapEl);

  function initMap() {

  var ukBounds = L.latLngBounds(
    L.latLng(49.0, -11.0),
    L.latLng(61.5,  3.5)
  );

  var map = L.map('pt-map', {
    scrollWheelZoom: false,
    attributionControl: false,
    maxBounds: ukBounds,
    maxBoundsViscosity: 1.0,
    minZoom: 5,
    maxZoom: 13
  }).setView([54.2, -2.5], 6);

  // Zoom into user's location if available
  if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(
      function(pos) {
        map.setView([pos.coords.latitude, pos.coords.longitude], 11);
      },
      function() { /* denied — keep UK overview */ }
    );
  }

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>',
    maxZoom: 19
  }).addTo(map);

  var cityCoords = {
    'london':[51.5074,-0.1278],'manchester':[53.4808,-2.2426],'birmingham':[52.4862,-1.8904],
    'leeds':[53.8008,-1.5491],'glasgow':[55.8642,-4.2518],'edinburgh':[55.9533,-3.1883],
