    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;" class="about-features-grid">
      {[
        { icon:`<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#3ab54a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>`, title:'Make an informed choice', desc:'Every trainer profile shows their BMP score, verified reviews, specialty, location and certifications in one place — everything you need to decide with confidence before you spend a penny.' },
