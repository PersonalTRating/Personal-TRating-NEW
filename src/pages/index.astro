---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

// Fetch ranked trainers — enough to filter by location client-side
const { data: topTrainers } = await supabase
  .from('trainers')
  .select('id, name, username, location, city, specialty, cert, bmp_score, star_rating, review_count, avatar_initials, avatar_bg, avatar_color, avatar_url')
  .eq('is_active', true)
  .gt('bmp_score', 0)
  .order('bmp_score', { ascending: false })
  .limit(200);

const leaderboard = topTrainers || [];
const heroRankings = leaderboard.slice(0, 4).map((t, i) => ({ ...t, rank: i + 1 }));

// Real platform stats
const { count: totalTrainers } = await supabase
  .from('trainers')
  .select('*', { count: 'exact', head: true })
  .eq('is_active', true);

const { count: totalReviews } = await supabase
  .from('reviews')
  .select('*', { count: 'exact', head: true })
  .eq('is_verified', true);

const { data: cityRows } = await supabase
  .from('trainers')
  .select('city, location')
  .eq('is_active', true);

const distinctCities = new Set(
  (cityRows || [])
    .map(t => (t.city || t.location || '').split(',')[0].trim().toLowerCase())
    .filter(Boolean)
).size;

// Dumbbell SVG helpers (consistent with trainer profile page)
const db = (filled: boolean, w = 18): string => {
  const c  = filled ? '#FFB800' : '#d4dbd5';
  const sk = filled ? 'rgba(0,0,0,0.3)' : 'rgba(0,0,0,0.08)';
  const h  = Math.round(w * 0.46);
  return `<svg viewBox="0 0 28 12" width="${w}" height="${h}" style="display:inline-block;vertical-align:middle;" aria-hidden="true"><rect x="0" y="0.5" width="8" height="11" rx="2.5" fill="${c}" stroke="${sk}" stroke-width="0.7"/><rect x="8" y="3.5" width="12" height="5" fill="${c}" stroke="${sk}" stroke-width="0.7"/><rect x="20" y="0.5" width="8" height="11" rx="2.5" fill="${c}" stroke="${sk}" stroke-width="0.7"/></svg>`;
};
const dumbbells = (rating: number, w = 18): string => {
  const n = Math.min(5, Math.max(0, Math.round(rating ?? 0)));
  return Array.from({ length: 5 }, (_, i) => db(i < n, w)).join('');
};

const rankColor = (r: number) =>
  r === 1 ? '#b8860b' : r === 2 ? '#888888' : r === 3 ? '#b07040' : '#8a8f8a';

const previewTrainers = leaderboard.slice(0, 3).map((t: any, i: number) => {
  const bmp    = t.bmp_score ?? 0;
  const filled = bmp > 0 ? Math.min(5, Math.ceil(bmp / 20)) : 0;
  const dbs    = Array.from({ length: 5 }, (_: any, j: number) => db(j < filled, 13)).join('');
  const avatar = t.avatar_url
    ? `<img src="${t.avatar_url}" width="44" height="44" style="width:44px;min-width:44px;height:44px;border-radius:50%;object-fit:cover;overflow:hidden;flex-shrink:0;border:2px solid rgba(255,255,255,0.15);" alt="" />`
    : `<div style="width:44px;min-width:44px;height:44px;border-radius:50%;background:rgba(58,181,74,0.15);color:#3ab54a;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:0.82rem;flex-shrink:0;">${t.avatar_initials || '?'}</div>`;
  return { id: t.id, name: t.name as string, username: (t.username || '') as string, city: (t.city || t.location || '') as string, specialty: (t.specialty || '') as string, bmp, rank: i + 1, avatar, dbs };
});

const cbg = (id: string): string => {
  const cx = 240, cy = 240;
  // Chamfered-octagon polygon: r=reach from centre, wf=chamfer ratio (0=pure diamond, 0.35=full octagon)
  const oct = (r: number, wf: number) => {
    const w = r * wf;
    return `${cx-w},${cy-r} ${cx+w},${cy-r} ${cx+r},${cy-w} ${cx+r},${cy+w} ${cx+w},${cy+r} ${cx-w},${cy+r} ${cx-r},${cy+w} ${cx-r},${cy-w}`;
  };
  // Inner band: 5 pure diamonds r=24..36 (wf=0 collapses octagon to 4-pointed diamond)
  const iB = Array.from({length:5}, (_:any, i:number) =>
    `<polygon points="${oct(24+i*3, 0)}" fill="none" stroke="#3ab54a" stroke-width="1.2"/>`
  ).join('');
  // Outer band: 14 growing-chamfer octagons r=96..135 (wf grows 0.18→0.32 so inner looks diamond, outer looks octagon)
  const oB = Array.from({length:14}, (_:any, i:number) => {
    const r = 96 + i*3; const wf = 0.18 + i*0.011;
    return `<polygon points="${oct(r, wf)}" fill="none" stroke="#3ab54a" stroke-width="1.2"/>`;
  }).join('');
  // Hollow pad: outer ring + centre dot
  const pad = (x:number, y:number, r:number=4) =>
    `<circle cx="${x}" cy="${y}" r="${r}" fill="white" stroke="#3ab54a" stroke-width="1.2"/>` +
    `<circle cx="${x}" cy="${y}" r="1.8" fill="#3ab54a" stroke="none"/>`;
  // Outermost octagon reference (r=135, wf≈0.323): top side at y=105 from x≈197 to x≈283, right side at x=375 from y≈197 to y≈283
  // TOP FAN — 7 straight traces + L-bends from top side (y=105) to top edge (y=0)
  const topFan =
    Array.from({length:7}, (_:any, i:number) => { const x=203+i*13; return `<line x1="${x}" y1="105" x2="${x}" y2="0"/>` + pad(x,0,3.5); }).join('') +
    `<polyline points="197,108 172,83 172,0"/>` + pad(172,0) +
    `<polyline points="199,106 168,75 140,75 140,0"/>` + pad(140,0,3) +
    `<polyline points="201,104 162,65 108,65 108,0"/>` + pad(108,0,3) +
    `<polyline points="283,108 308,83 308,0"/>` + pad(308,0) +
    `<polyline points="281,106 312,75 340,75 340,0"/>` + pad(340,0,3) +
    `<polyline points="279,104 318,65 372,65 372,0"/>` + pad(372,0,3);
  // BOTTOM FAN
  const botFan =
    Array.from({length:7}, (_:any, i:number) => { const x=203+i*13; return `<line x1="${x}" y1="375" x2="${x}" y2="480"/>` + pad(x,480,3.5); }).join('') +
    `<polyline points="197,372 172,397 172,480"/>` + pad(172,480) +
    `<polyline points="199,374 168,405 140,405 140,480"/>` + pad(140,480,3) +
    `<polyline points="201,376 162,415 108,415 108,480"/>` + pad(108,480,3) +
    `<polyline points="283,372 308,397 308,480"/>` + pad(308,480) +
    `<polyline points="281,374 312,405 340,405 340,480"/>` + pad(340,480,3) +
    `<polyline points="279,376 318,415 372,415 372,480"/>` + pad(372,480,3);
  // RIGHT FAN
  const rgtFan =
    Array.from({length:7}, (_:any, i:number) => { const y=203+i*13; return `<line x1="375" y1="${y}" x2="480" y2="${y}"/>` + pad(480,y,3.5); }).join('') +
    `<polyline points="372,197 397,172 480,172"/>` + pad(480,172) +
    `<polyline points="374,199 405,168 405,140 480,140"/>` + pad(480,140,3) +
    `<polyline points="376,201 415,162 415,108 480,108"/>` + pad(480,108,3) +
    `<polyline points="372,283 397,308 480,308"/>` + pad(480,308) +
    `<polyline points="374,281 405,312 405,340 480,340"/>` + pad(480,340,3) +
    `<polyline points="376,279 415,318 415,372 480,372"/>` + pad(480,372,3);
  // LEFT FAN
  const lftFan =
    Array.from({length:7}, (_:any, i:number) => { const y=203+i*13; return `<line x1="105" y1="${y}" x2="0" y2="${y}"/>` + pad(0,y,3.5); }).join('') +
    `<polyline points="108,197 83,172 0,172"/>` + pad(0,172) +
    `<polyline points="106,199 75,168 75,140 0,140"/>` + pad(0,140,3) +
    `<polyline points="104,201 65,162 65,108 0,108"/>` + pad(0,108,3) +
    `<polyline points="108,283 83,308 0,308"/>` + pad(0,308) +
    `<polyline points="106,281 75,312 75,340 0,340"/>` + pad(0,340,3) +
    `<polyline points="104,279 65,318 65,372 0,372"/>` + pad(0,372,3);
  // CORNER TRACES — from each 45° chamfer outward to tile corner edges (4 per corner)
  const trC =
    `<polyline points="311,132 334,109 334,0"/>` + pad(334,0) +
    `<polyline points="302,123 355,70 480,70"/>` + pad(480,70) +
    `<polyline points="348,169 410,107 410,0"/>` + pad(410,0) +
    `<polyline points="357,178 420,115 480,115"/>` + pad(480,115);
  const tlC =
    `<polyline points="169,132 146,109 146,0"/>` + pad(146,0) +
    `<polyline points="178,123 125,70 0,70"/>` + pad(0,70) +
    `<polyline points="132,169 70,107 70,0"/>` + pad(70,0) +
    `<polyline points="123,178 60,115 0,115"/>` + pad(0,115);
  const brC =
    `<polyline points="311,348 334,371 334,480"/>` + pad(334,480) +
    `<polyline points="302,357 355,410 480,410"/>` + pad(480,410) +
    `<polyline points="348,311 410,373 410,480"/>` + pad(410,480) +
    `<polyline points="357,302 420,365 480,365"/>` + pad(480,365);
  const blC =
    `<polyline points="169,348 146,371 0,371"/>` + pad(0,371) +
    `<polyline points="178,357 125,410 0,410"/>` + pad(0,410) +
    `<polyline points="132,311 70,373 70,480"/>` + pad(70,480) +
    `<polyline points="123,302 60,365 0,365"/>` + pad(0,365);
  const inner =
    `<rect width="480" height="480" fill="white"/>` +
    `<g fill="none" stroke="#3ab54a" stroke-width="1.2" opacity="0.35">` +
    iB + oB + topFan + botFan + rgtFan + lftFan + trC + tlC + brC + blC +
    `</g>`;
  return `<svg style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;" xmlns="http://www.w3.org/2000/svg"><defs><pattern id="${id}" width="480" height="480" patternUnits="userSpaceOnUse" patternTransform="scale(0.18)">${inner}</pattern></defs><rect width="100%" height="100%" fill="url(#${id})"/></svg>`;
};

// Placeholder reviews (social proof) — will be replaced by real reviews as platform grows
const reviews = [
  { initials: 'TW', bg: '#fdf6e3', color: '#b8860b',
    name: 'Tom W.', info: 'Verified Client · London', trainer: 'Personal TRating',
    text: '"I\'d tried a few generic PT directories before but they were all the same. PTranking actually lets you filter by specialism — I found someone focused on powerlifting within minutes. Completely different experience."' },
  { initials: 'ER', bg: '#e8f7ee', color: '#1a6b3d',
    name: 'Emma R.', info: 'Verified Client · Manchester', trainer: 'Personal TRating',
    text: '"The location search is brilliant. I could see every highly-rated trainer within a few miles of me, compare their reviews side by side, and reach out directly. Found the perfect match without any back and forth."' },
  { initials: '★', bg: '#eaf7ec', color: '#2a9438',
    name: 'Anonymous', info: 'Verified Client · Birmingham', trainer: 'Personal TRating',
    text: '"What sold me was being able to read verified client reviews before committing to anything. You can actually compare trainers honestly — specialisms, location, ratings — all in one place. Made the decision so easy."' },
  { initials: 'PJ', bg: '#f5e8f7', color: '#6b1a6b',
    name: 'Priya J.', info: 'Verified Client · Leeds', trainer: 'Personal TRating',
    text: '"I needed someone who specialised in post-injury rehabilitation — a very specific niche. PTranking had a filter for exactly that. I found a qualified specialist nearby in under 10 minutes and messaged them straight from the profile."' },
  { initials: '★', bg: '#e8f0f7', color: '#1a4b6b',
    name: 'Anonymous', info: 'Verified Client · Edinburgh', trainer: 'Personal TRating',
    text: '"The site is genuinely simple to use. I searched my area, filtered by goal, read a few reviews and had a trainer booked within the same evening. No confusing sign-up process, no middleman — just direct contact."' },
  { initials: 'MF', bg: '#f8f7f4', color: '#665544',
    name: 'Marcus F.', info: 'Verified Client · Bristol', trainer: 'Personal TRating',
    text: '"I\'d never used a PT before and didn\'t know where to start. Being able to compare trainers by reviews, location and specialism gave me the confidence to actually take the first step. Booked within a week and haven\'t looked back."' },
];
---

<Layout title="Personal TRating – Find the UK's Top Personal Trainers">

<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Personal TRating",
  "url": "https://personaltrating.com",
  "description": "The UK's personal trainer ranking platform. Find and compare personal trainers by real, verified client reviews.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://personaltrating.com/find-a-trainer?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
}
</script>

<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Personal TRating",
  "url": "https://personaltrating.com",
  "logo": "https://personaltrating.com/images/logo.png",
  "contactPoint": {
    "@type": "ContactPoint",
    "email": "personaltrating@protonmail.com",
    "contactType": "customer support"
  },
  "areaServed": "GB",
  "description": "UK platform ranking personal trainers by verified client reviews using the BMP™ scoring system."
}
</script>

<style is:global>
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(22px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .anim-1 { animation: fadeUp 0.6s 0.00s ease both; }
  .anim-2 { animation: fadeUp 0.6s 0.10s ease both; }
  .anim-3 { animation: fadeUp 0.6s 0.20s ease both; }
  .anim-4 { animation: fadeUp 0.6s 0.30s ease both; }
  .anim-5 { animation: fadeUp 0.7s 0.20s ease both; }

  /* ── Green button glow — applies to all green buttons via attribute selector ── */
  a[style*="3ab54a"], button[style*="3ab54a"] {
    box-shadow: 0 0 16px rgba(58,181,74,0.28), 0 4px 14px rgba(58,181,74,0.18) !important;
    transition: background 0.2s ease, box-shadow 0.25s ease !important;
  }
  a[style*="3ab54a"]:hover, button[style*="3ab54a"]:hover {
    box-shadow: 0 0 26px rgba(58,181,74,0.48), 0 6px 20px rgba(58,181,74,0.28) !important;
  }

  /* ── Leaderboard card ── */
  .lb-card {
    display:flex; align-items:center; gap:1.25rem;
    background:white; border-radius:14px; padding:1.1rem 1.4rem;
    border:1px solid #e0e8e1; border-left:4px solid #3ab54a;
    text-decoration:none; color:inherit;
    transition:box-shadow 0.2s, transform 0.2s;
  }
  .lb-card:hover { box-shadow:0 6px 24px rgba(0,0,0,0.08); transform:translateY(-2px); }
  .lbc-rank  { font-family:'Playfair Display',serif; font-size:1.65rem; font-weight:900; width:2.5rem; flex-shrink:0; line-height:1; color:#3ab54a; }
  .lbc-av    { width:42px; min-width:42px; height:42px; border-radius:50%; flex-shrink:0; object-fit:cover; overflow:hidden; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:0.8rem; border:2px solid rgba(0,0,0,0.06); }
  .lbc-mid   { flex:1; min-width:0; }
  .lbc-top   { display:flex; align-items:center; gap:0.6rem; flex-wrap:wrap; margin-bottom:0.3rem; }
  .lbc-name  { font-family:'Playfair Display',serif; font-size:1rem; font-weight:700; color:#111311; }
  .lbc-cert  { font-size:0.68rem; font-weight:600; color:#2a9438; background:#eaf7ec; padding:0.15rem 0.5rem; border-radius:10px; border:1px solid #c3e6c8; white-space:nowrap; }
  .lbc-detail { font-size:0.78rem; color:#8a8f8a; margin-top:0.18rem; display:flex; align-items:center; gap:0.35rem; }
  .lbc-bmp   { text-align:right; flex-shrink:0; }
  .lbc-bmp-label  { font-size:0.58rem; color:#8a8f8a; letter-spacing:1.2px; text-transform:uppercase; }
  .lbc-bmp-score  { font-size:1.7rem; font-weight:800; color:#111311; line-height:1.1; }
  .lbc-bmp-dbs   { display:flex; gap:2px; justify-content:flex-end; margin-top:0.2rem; }
  .lbc-bmp-rev   { font-size:0.7rem; color:#8a8f8a; margin-top:0.15rem; }

  @media (max-width:600px) {
    #lb-list .lb-card:nth-child(n+4) { display:none; }
    .lb-card {
      flex-direction:column; align-items:stretch; gap:0.3rem;
      padding:1.1rem 1.1rem 1rem;
      border:2px solid #7defa0 !important;
      border-left:2px solid #7defa0 !important;
      box-shadow:0 0 8px #4cd46a, 0 0 22px rgba(58,181,74,0.9), 0 0 50px rgba(58,181,74,0.5) !important;
      border-radius:16px !important;
    }
    .lbc-rank  { display:none; }
    .lbc-bmp   { text-align:left; display:flex; align-items:center; gap:0.75rem; padding-top:0.65rem; border-top:1px solid rgba(58,181,74,0.2); margin-top:0.35rem; }
    .lbc-bmp-score { font-size:1.3rem; }
    .lbc-bmp-dbs   { justify-content:flex-start; margin-top:0; }
    .lbc-bmp-rev   { margin-top:0; }
    #lb-list > div { display:flex; flex-direction:column; gap:1rem; }
    #find-preview a[href^="/trainers/"] {
      border:2px solid #7defa0 !important;
      border-left:2px solid #7defa0 !important;
      background:rgba(255,255,255,0.06) !important;
      border-radius:16px !important;
      box-shadow:0 0 8px #4cd46a, 0 0 22px rgba(58,181,74,0.9), 0 0 50px rgba(58,181,74,0.5) !important;
    }
    #find-preview > div > div[style*="flex-direction:column"] { gap:1rem !important; }
  }

  .pt-marker { width:36px; height:36px; background:#3ab54a; border:2.5px solid #2a9438; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:1rem; cursor:pointer; box-shadow:0 2px 8px rgba(58,181,74,0.4); transition:transform 0.15s, box-shadow 0.15s; }
  .pt-marker:hover { transform:scale(1.25); box-shadow:0 4px 16px rgba(58,181,74,0.55); }
  .leaflet-container { font-family:'Manrope',sans-serif; }

  #reviews { position:relative; }
  #reviews::before {
    content:''; position:absolute; inset:0;
    background-image:url('/images/logo.png');
    background-repeat:no-repeat; background-position:center; background-size:70%;
    opacity:0.06; pointer-events:none; z-index:0;
  }
  #reviews > * { position:relative; z-index:1; }

  .eyebrow { display:inline-block; border-bottom:2px solid #3ab54a; padding-bottom:3px; }

  /* BMP explanation chip + tooltip */
  .bmp-chip-tip {
    display:none; position:absolute; bottom:calc(100% + 10px); left:0;
    width:260px; background:#0d1a0e; color:rgba(255,255,255,0.8);
    font-size:0.72rem; line-height:1.65; padding:0.75rem 0.9rem;
    border-radius:10px; border:1px solid rgba(58,181,74,0.25);
    box-shadow:0 6px 24px rgba(0,0,0,0.4); z-index:20; cursor:default;
    font-weight:400;
  }
  .bmp-chip-tip::after {
    content:''; position:absolute; top:100%; left:1.2rem;
    border:6px solid transparent; border-top-color:#0d1a0e;
  }
  .bmp-chip:hover .bmp-chip-tip { display:block; }
  @keyframes fp-scroll {
    from { transform: translateX(var(--fps-from)); }
    to   { transform: translateX(var(--fps-to)); }
  }

  .nav-link { color:#8a8f8a; text-decoration:none; font-size:0.875rem; font-weight:500; transition:color 0.2s; }
  .nav-link:hover { color:#111311; }

  /* Hero rankings card — dark glass overrides */
  .hero-card .lb-card { background:rgba(255,255,255,0.07); border:2px solid #7defa0; border-left:2px solid #7defa0; box-shadow:0 0 8px #4cd46a, 0 0 22px rgba(58,181,74,0.9), 0 0 50px rgba(58,181,74,0.5); }
  .hero-card .lb-card:hover { box-shadow:0 0 12px #4cd46a, 0 0 30px rgba(58,181,74,0.95), 0 0 60px rgba(58,181,74,0.6); transform:translateY(-1px); }
  .hero-card .lbc-name { color:#ffffff; }
  .hero-card .lbc-detail { color:rgba(255,255,255,0.52); }
  .hero-card .lbc-bmp-score { color:#ffffff; }
  .hero-card .lbc-bmp-label, .hero-card .lbc-bmp-rev { color:rgba(255,255,255,0.45); }

  /* Leaderboard section — white cards on dark green */
  #leaderboard .lb-card { border:2px solid #7defa0; border-left:2px solid #7defa0; box-shadow:0 0 8px #4cd46a, 0 0 22px rgba(58,181,74,0.9), 0 0 50px rgba(58,181,74,0.5); }
  #leaderboard .lb-card:hover { box-shadow:0 0 12px #4cd46a, 0 0 30px rgba(58,181,74,0.95), 0 0 60px rgba(58,181,74,0.6); transform:translateY(-2px); }
  /* Find-a-trainer preview — dark section card glow */
  #find-preview a[href^="/trainers/"] { border:2px solid #7defa0 !important; border-left:2px solid #7defa0 !important; box-shadow:0 0 8px #4cd46a, 0 0 22px rgba(58,181,74,0.9), 0 0 50px rgba(58,181,74,0.5) !important; }
  #leaderboard p { color:rgba(255,255,255,0.5); }

  /* Review card hover */
  .rev-card { background:white; border-radius:14px; padding:1.75rem; border:1px solid #c3e6c8; display:flex; flex-direction:column; transition:box-shadow 0.2s, transform 0.2s; box-shadow:0 4px 20px rgba(58,181,74,0.13); }
  .rev-card:hover { box-shadow:0 8px 32px rgba(58,181,74,0.28); transform:translateY(-2px); }

  /* Mobile hamburger */
  .mob-ham { display:none; flex-direction:column; gap:5px; cursor:pointer; padding:0.5rem; background:none; border:none; }
  .mob-ham span { display:block; width:22px; height:2px; background:#111311; border-radius:2px; transition:transform 0.25s, opacity 0.25s; }
  .mob-ham.open span:nth-child(1) { transform:translateY(7px) rotate(45deg); }
  .mob-ham.open span:nth-child(2) { opacity:0; }
  .mob-ham.open span:nth-child(3) { transform:translateY(-7px) rotate(-45deg); }
  /* Dropdown nav */
  .mob-nav {
    position:fixed; top:80px; left:0; right:0; z-index:499;
    background:white;
    box-shadow:0 8px 24px rgba(0,0,0,0.10);
    flex-direction:column; align-items:stretch;
    overflow:hidden; max-height:0;
    transition:max-height 0.35s cubic-bezier(0.4,0,0.2,1);
    display:none;
  }
