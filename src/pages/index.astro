<script is:inline>
(function () {
  var cityCoords = {
    'london': [51.505, -0.09], 'manchester': [53.480, -2.242],
    'birmingham': [52.480, -1.893], 'leeds': [53.800, -1.548],
    'edinburgh': [55.953, -3.188], 'bristol': [51.454, -2.587],
    'liverpool': [53.408, -2.991], 'sheffield': [53.383, -1.465],
    'nottingham': [52.954, -1.158], 'cardiff': [51.481, -3.179],
    'glasgow': [55.860, -4.251], 'leicester': [52.636, -1.133],
    'newcastle': [54.978, -1.617], 'oxford': [51.752, -1.257],
    'cambridge': [52.205, 0.119], 'brighton': [50.827, -0.137],
    'portsmouth': [50.798, -1.091], 'exeter': [50.724, -3.527],
    'norwich': [52.628, 1.299], 'belfast': [54.597, -5.930],
    'coventry': [52.408, -1.510], 'reading': [51.454, -0.973],
    'southampton': [50.909, -1.404], 'hull': [53.744, -0.332],
  };

  function haversine(lat1, lon1, lat2, lon2) {
    var R = 3958.8;
    var dLat = (lat2 - lat1) * Math.PI / 180;
    var dLon = (lon2 - lon1) * Math.PI / 180;
    var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
      Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
      Math.sin(dLon / 2) * Math.sin(dLon / 2);
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  function rankColor(i) {
    return i === 0 ? '#b8860b' : i === 1 ? '#888888' : i === 2 ? '#b07040' : '#8a8f8a';
  }

  function bmpDumbbell(bmp, w) {
    var score = Math.max(0, Math.min(100, bmp || 0));
    var h = Math.round(w * 0.42);
    var fw = ((score / 100) * 42).toFixed(2);
    var hi = score >= 90;
    function hiRing(cx) { return hi ? '<circle cx="'+cx+'" cy="21" r="14.2" fill="none" stroke="#39e858" stroke-width="1.3" opacity="0.55"/>' : ''; }
    function plate(cx) { return '<circle cx="'+cx+'" cy="21" r="15" fill="#0a0a0a"/><circle cx="'+cx+'" cy="21" r="13.5" fill="#1e1e1e"/><circle cx="'+cx+'" cy="21" r="10.5" fill="#131313"/><circle cx="'+cx+'" cy="21" r="4.5" fill="#0a0a0a"/><ellipse cx="'+(cx-5)+'" cy="13" rx="5" ry="3" fill="white" opacity="0.06" transform="rotate(-20,'+(cx-5)+',13)"/>'+hiRing(cx); }
    var fill = score > 0 ? '<rect x="29" y="16" width="'+fw+'" height="10" fill="#39e858"/><rect x="29" y="16" width="'+fw+'" height="3.5" fill="white" opacity="0.15"/><rect x="29" y="22" width="'+fw+'" height="4" fill="black" opacity="0.15"/>' : '';
    var glow = score >= 95 ? ';filter:drop-shadow(0 0 8px rgba(57,232,88,0.65))' : '';
    return '<svg viewBox="0 0 100 42" width="'+w+'" height="'+h+'" style="display:inline-block;vertical-align:middle'+glow+';" aria-hidden="true"><rect x="10" y="15" width="80" height="12" rx="4" fill="#151515"/><rect x="10" y="15" width="80" height="4" rx="2" fill="white" opacity="0.03"/>'+fill+plate(15)+plate(85)+'</svg>';
  }

  function renderCard(pt, rank) {
    var avatar = pt.avatar_url
      ? '<img src="' + pt.avatar_url + '" alt="" class="lbc-av" width="40" height="40" style="width:40px;min-width:40px;height:40px;border-radius:50%;object-fit:cover;overflow:hidden;flex-shrink:0;border:2px solid rgba(255,255,255,0.12);">'
      : '<div class="lbc-av" style="background:' + (pt.avatar_bg || '#eaf7ec') + ';color:' + (pt.avatar_color || '#2a9438') + ';">' + (pt.avatar_initials || '?') + '</div>';
    var cert = pt.cert ? '<span class="lbc-cert">' + pt.cert + '</span>' : '';
    var city = pt.city || pt.location || '';
    var spec = pt.specialty ? pt.specialty.split(/[,\/]/)[0].trim() : '';
    var dbs = bmpDumbbell(pt.bmp_score || 0, 44);
    var revCount = pt.review_count || 0;
    var revText  = revCount + ' ' + (revCount === 1 ? 'review' : 'reviews');
    var bmpDisplay = revCount === 0 ? 'Be first to review' : pt.bmp_score;
    var bmpStyle   = revCount === 0 ? 'font-size:0.7rem;font-weight:700;color:#3ab54a;line-height:1.3;' : '';
    var lbComplete = !!(pt.avatar_url && (pt.city || pt.location) && pt.bio && pt.specialty);
    var lbTick = lbComplete ? '<span title="Profile complete" style="display:inline-flex;align-items:center;flex-shrink:0;"><svg width="13" height="13" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="8" cy="8" r="8" fill="#3ab54a"/><path d="M4.5 8.2l2.3 2.3 4.7-4.7" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>' : '';

    // Rank movement from weekly snapshot
    var moveHtml = '';
    if (pt.rank_history && pt.rank_history.length >= 2) {
      var prevRank = pt.rank_history[pt.rank_history.length - 2].rank;
      var move = prevRank - rank;
      if (move > 0)      moveHtml = '<span style="font-size:0.58rem;font-weight:800;color:#2a9438;line-height:1;">▲' + move + '</span>';
      else if (move < 0) moveHtml = '<span style="font-size:0.58rem;font-weight:800;color:#c0392b;line-height:1;">▼' + Math.abs(move) + '</span>';
    }

    // BMP change from snapshot
    var bmpChangeHtml = '';
    if (pt.rank_history && pt.rank_history.length >= 2) {
      var prevBmp = pt.rank_history[pt.rank_history.length - 2].bmp;
      var bmpDiff = Math.round(((pt.bmp_score || 0) - prevBmp) * 10) / 10;
      if (bmpDiff > 0)      bmpChangeHtml = '<div style="font-size:0.68rem;font-weight:800;color:#2a9438;margin-top:0.15rem;">+' + bmpDiff + ' this month</div>';
      else if (bmpDiff < 0) bmpChangeHtml = '<div style="font-size:0.68rem;font-weight:800;color:#c0392b;margin-top:0.15rem;">' + bmpDiff + ' this month</div>';
    }

    // ── Recent reviews line (all trainers) ─────────────────────────────────
    var recentCount  = pt.recent_review_count || 0;
    var reviewsLine  = '';
    if (revCount === 0) {
      reviewsLine = '<div class="lbc-detail" style="color:#3ab54a;">Be first to review</div>';
    } else if (recentCount >= 1) {
      var rWord = recentCount === 1 ? 'review' : 'reviews';
      reviewsLine = '<div class="lbc-detail" style="color:rgba(220,100,60,0.9);display:flex;align-items:center;gap:0.25rem;"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 3z"/></svg>' + recentCount + ' verified ' + rWord + ' in the last 30 days</div>';
    } else {
      reviewsLine = '<div class="lbc-bmp-rev">' + revText + '</div>';
    }

    // ── TRENDING card ────────────────────────────────────────────────────────
    if (pt.is_trending) {
      var trendingBadge = '<div class="trend-info"><span style="display:inline-flex;align-items:center;gap:4px;background:linear-gradient(135deg,#cc0000,#e81414);color:white;font-size:0.65rem;font-weight:800;letter-spacing:1.5px;padding:0.28rem 0.7rem;border-radius:20px;box-shadow:0 2px 8px rgba(180,0,0,0.5);white-space:nowrap;flex-shrink:0;"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 3z"/></svg> TRENDING</span><div class="trend-tooltip">Trending trainers have earned 4+ verified reviews in the last 30 days, spread across at least 2 separate calendar weeks, and hold a quality score of 42 or above.</div></div>';
      var hotReviews = recentCount >= 1
        ? '<div class="lbc-detail" style="color:rgba(220,80,40,0.95);display:flex;align-items:center;gap:0.25rem;"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 3z"/></svg>' + recentCount + ' verified ' + (recentCount === 1 ? 'review' : 'reviews') + ' in the last 30 days</div>'
        : '';

      return '<a href="/trainers/' + pt.id + '" class="lb-card lb-card--trending" data-cc="card" data-cc-trending="1" style="view-transition-name:tc-' + pt.id + ';">' +
        '<div class="lbc-rank">' + String(rank).padStart(2, '0') +
          (moveHtml ? '<div style="margin-top:0.2rem;">' + moveHtml + '</div>' : '') +
        '</div>' +
        avatar +
        '<div class="lbc-mid">' +
          '<div class="lbc-top">' +
            '<div class="lbc-name">' + pt.name + '</div>' +
            lbTick +
            trendingBadge +
            cert +
          '</div>' +
          (city ? '<div class="lbc-detail" style="display:flex;align-items:center;gap:0.25rem;"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#E85D4A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>' + city + '</div>' : '') +
          (spec ? '<div class="lbc-detail"><span class="spec-pill">' + spec + '</span></div>' : '') +
          hotReviews +
        '</div>' +
        '<div class="lbc-bmp">' +
          '<div class="lbc-bmp-label">BMP</div>' +
          '<div class="lbc-bmp-score" style="' + bmpStyle + '">' + bmpDisplay + '</div>' +
          '<div class="lbc-bmp-dbs">' + dbs + '</div>' +
          (bmpChangeHtml || '') +
          '<div class="bmp-tooltip">BMP — Body Muscle Percentage.<br>CoachCards\' verified ranking score:<br><strong>Quality 70pts · Confidence 20pts · Momentum 10pts</strong><br>Calculated from verified client reviews only.</div>' +
        '</div>' +
      '</a>';
    }

    // ── Standard card ───────────────────────────────────────────────────────
    return '<a href="/trainers/' + pt.id + '" class="lb-card" data-cc="card" style="view-transition-name:tc-' + pt.id + ';">' +
      '<div class="lbc-rank">' + String(rank).padStart(2, '0') +
        (moveHtml ? '<div style="margin-top:0.2rem;">' + moveHtml + '</div>' : '') +
      '</div>' +
      '<div class="lbc-mid">' +
        '<div class="lbc-top">' + avatar + '<div class="lbc-name">' + pt.name + lbTick + '</div>' + cert + '</div>' +
        (city ? '<div class="lbc-detail" style="display:flex;align-items:center;gap:0.25rem;"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#E85D4A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>' + city + '</div>' : '') +
        (spec ? '<div class="lbc-detail"><span class="spec-pill">' + spec + '</span></div>' : '') +
        reviewsLine +
      '</div>' +
      '<div class="lbc-bmp">' +
        '<div class="lbc-bmp-label">BMP</div>' +
        '<div class="lbc-bmp-score" style="' + bmpStyle + '">' + bmpDisplay + '</div>' +
        '<div class="lbc-bmp-dbs">' + dbs + '</div>' +
        (bmpChangeHtml || '') +
        '<div class="bmp-tooltip">BMP — Body Muscle Percentage.<br>CoachCards\' verified ranking score:<br><strong>Quality 70pts · Confidence 20pts · Momentum 10pts</strong><br>Calculated from verified client reviews only.</div>' +
      '</div>' +
    '</a>';
  }

  function paintList(trainers, eyebrow, sub, pill) {
    var el     = document.getElementById('lb-list');
    var eyeEl  = document.getElementById('lb-eyebrow');
    var subEl  = document.getElementById('lb-sub');
    var pillEl = document.getElementById('lb-location-pill');
    if (eyeEl) eyeEl.textContent  = eyebrow;
    if (subEl)  subEl.textContent  = sub;
    if (pillEl) { pillEl.textContent = pill || ''; pillEl.style.display = pill ? '' : 'none'; }
    if (!el) return;
    if (trainers.length === 0) {
      el.innerHTML = '<div style="text-align:center;padding:4rem 2rem;background:rgba(8,16,9,0.8);border-radius:16px;border:1px dashed rgba(58,181,74,0.25);">' +
        '<div style="margin-bottom:0.75rem;display:flex;justify-content:center;"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#8a8f8a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="12" x2="18" y2="12"/><line x1="6" y1="8" x2="6" y2="16"/><line x1="18" y1="8" x2="18" y2="16"/><line x1="4" y1="9" x2="4" y2="15"/><line x1="20" y1="9" x2="20" y2="15"/></svg></div>' +
        '<div style="font-family:\'Playfair Display\',serif;font-size:1.25rem;font-weight:700;color:white;margin-bottom:0.5rem;">No trainers nearby yet</div>' +
        '<div style="color:#8a8f8a;font-size:0.9rem;">Be the first PT in your area to collect verified reviews.</div>' +
        '<a href="/signup" style="display:inline-block;margin-top:1.5rem;background:#3ab54a;color:white;padding:0.75rem 1.75rem;border-radius:8px;font-weight:700;font-size:0.875rem;text-decoration:none;">List Your Profile Free →</a>' +
        '</div>';
      return;
    }
    el.innerHTML = '<div style="display:flex;flex-direction:column;gap:0.875rem;">' +
      trainers.map(function (pt, i) { return renderCard(pt, i + 1); }).join('') +
      '</div>';
  }

  function makeHeroCard(t, rank) {
    var trending  = t.is_trending;
    var revCount  = t.review_count || 0;
    var recent    = t.recent_review_count || 0;
    var complete  = !!(t.avatar_url && (t.city || t.location) && t.bio && t.specialty);

    var av = t.avatar_url
      ? '<img class="hc-av" src="' + t.avatar_url + '" alt="' + t.name + '" width="48" height="48">'
      : '<div class="hc-av" style="background:' + (t.avatar_bg||'#0d1a0e') + ';color:' + (t.avatar_color||'#3ab54a') + ';">' + (t.avatar_initials||'?') + '</div>';

    var tick = complete
      ? '<span title="Profile complete" style="display:inline-flex;align-items:center;flex-shrink:0;"><svg width="11" height="11" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="8" fill="#3ab54a"/><path d="M4.5 8.2l2.3 2.3 4.7-4.7" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>'
      : '';

    var trendBadge = trending
      ? '<span class="trend-info"><span class="hc-badge-trend" style="display:inline-flex;align-items:center;gap:0.25rem;"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 3z"/></svg> TRENDING</span><div class="trend-tooltip">Trending trainers have earned 4+ verified reviews in the last 30 days, spread across at least 2 separate calendar weeks, and hold a quality score of 42 or above.</div></span>'
      : '';

    var cityMeta = (t.city || t.location)
      ? '<span style="display:inline-flex;align-items:center;gap:0.2rem;"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#E85D4A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>' + (t.city || t.location) + '</span>'
      : '';
    var specMeta = t.specialty ? '<span class="spec-pill spec-pill--sm">' + t.specialty.split(/[,\/]/)[0].trim() + '</span>' : '';

    var statsHtml = '';
    if (revCount === 0) {
      statsHtml = '<span class="hc-stats">Be first to review</span>';
    } else if (recent >= 1) {
      var rWord2 = recent === 1 ? 'review' : 'reviews';
      var statsClass = trending ? 'hc-stats-hot' : 'hc-stats';
      statsHtml = '<span class="' + statsClass + '" style="display:inline-flex;align-items:center;gap:0.25rem;"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 3z"/></svg>' + recent + ' verified ' + rWord2 + ' in the last 30 days</span>';
    } else {
      statsHtml = '<span class="hc-stats">' + revCount + ' verified ' + (revCount === 1 ? 'review' : 'reviews') + '</span>';
    }

    var bmpNum = revCount === 0
      ? '<span class="hc-bmp-num" style="font-size:0.62rem;line-height:1.3;">First<br>review</span>'
      : '<span class="hc-bmp-num">' + (t.bmp_score || '—') + '</span>';
    var hcDbs = revCount > 0 ? bmpDumbbell(t.bmp_score || 0, 38) : '';

    return '<a class="hc-card' + (trending ? ' hc-card--trending' : '') + '" href="/trainers/' + t.id + '" data-cc="card"' + (trending ? ' data-cc-trending="1"' : '') + ' style="view-transition-name:tc-' + t.id + ';">' +
      '<span class="hc-rank">' + String(rank).padStart(2, '0') + '</span>' +
      av +
      '<div class="hc-mid">' +
        '<div class="hc-name-row"><span class="hc-name">' + t.name + '</span>' + tick + trendBadge + '</div>' +
        (cityMeta  ? '<div class="hc-meta">'      + cityMeta + '</div>' : '') +
        (specMeta  ? '<div class="hc-meta-spec">' + specMeta + '</div>' : '') +
        (statsHtml  ? '<div>'                  + statsHtml + '</div>' : '') +
      '</div>' +
      '<div class="hc-bmp"><span class="hc-bmp-lbl">BMP</span>' + bmpNum + (hcDbs ? '<div class="hc-bmp-db">' + hcDbs + '</div>' : '') + '<div class="bmp-tooltip">BMP — Body Muscle Percentage.<br>CoachCards\' verified ranking score:<br><strong>Quality 70pts · Confidence 20pts · Momentum 10pts</strong><br>Calculated from verified client reviews only.</div></div>' +
    '</a>';
  }

  function paintHero(trainers, title) {
    var titleEl = document.getElementById('hero-card-title');
    var listEl  = document.getElementById('hero-rankings-list');
    if (titleEl) titleEl.innerHTML = title;
    if (!listEl) return;
    if (trainers.length === 0) {
      listEl.innerHTML = '<div style="padding:1rem 0;text-align:center;color:rgba(255,255,255,0.4);font-size:0.82rem;">No trainers found nearby.</div>';
      return;
    }
    listEl.innerHTML = '<div style="display:flex;flex-direction:column;gap:8px;">' +
      trainers.slice(0, 5).map(function (t, i) { return makeHeroCard(t, i + 1); }).join('') +
    '</div>';
  }

  function showUkFallback(reason) {
    var all = (window['__ptAllTrainers'] || []).slice(0, 10);
    paintList(all, 'National Rankings', reason || 'Ranked by Body Muscle Percentage (BMP) score', '');
    paintHero(all, '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-2px;flex-shrink:0;"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2z"/></svg> Top Trainers — UK');
  }

  // Wait for define:vars data to be ready
  function init() {
    if (!window['__ptAllTrainers']) { setTimeout(init, 50); return; }

    if (!navigator.geolocation) { showUkFallback('Location unavailable — showing UK Top 10'); return; }

    navigator.geolocation.getCurrentPosition(
      function (pos) {
        var uLat = pos.coords.latitude;
        var uLng = pos.coords.longitude;
        var all  = window['__ptAllTrainers'] || [];

        var nearby = all.filter(function (t) {
          var key    = (t.city || t.location || '').toLowerCase().split(',')[0].trim();
          var coords = cityCoords[key];
          return coords && haversine(uLat, uLng, coords[0], coords[1]) <= 50;
        });
        nearby.sort(function (a, b) { return (b.bmp_score || 0) - (a.bmp_score || 0); });
        nearby = nearby.slice(0, 10);

        // Nearest named city for the pill label
        var nearestCity = '', nearestDist = Infinity;
        Object.keys(cityCoords).forEach(function (city) {
          var d = haversine(uLat, uLng, cityCoords[city][0], cityCoords[city][1]);
          if (d < nearestDist) { nearestDist = d; nearestCity = city; }
        });
        var cityLabel = nearestCity ? nearestCity.charAt(0).toUpperCase() + nearestCity.slice(1) : '';

        if (nearby.length === 0) {
          showUkFallback('No trainers within 50 miles yet — showing UK Top 10');
          return;
        }

        var countTxt = nearby.length + ' trainer' + (nearby.length !== 1 ? 's' : '') + ' within 50 miles';
        var heroTitle = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#E85D4A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-2px;flex-shrink:0;"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0"/><circle cx="12" cy="10" r="3"/></svg> ' + (cityLabel ? 'Near ' + cityLabel : 'Near You');
        paintList(nearby, 'Local Rankings', countTxt, cityLabel ? cityLabel + ' area' : '');
        paintHero(nearby, heroTitle);
      },
      function () {
        showUkFallback('Enable location for local results — showing UK Top 10');
      },
      { timeout: 8000, maximumAge: 300000 }
    );
  }

  init();
})();
</script>


<!-- ── SCROLL REVEAL ── -->
<style>
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  @media (max-width: 600px) {
    .reveal { transform: translateY(14px); transition-duration: 0.45s, 0.45s; }
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
  /* Stagger grid children when parent becomes visible */
  .stagger > *        { opacity:0; transform:translateY(20px); transition:opacity 0.55s ease-out, transform 0.55s ease-out; }
  .stagger.visible > *:nth-child(1) { opacity:1; transform:none; transition-delay:0.05s; }
  .stagger.visible > *:nth-child(2) { opacity:1; transform:none; transition-delay:0.15s; }
  .stagger.visible > *:nth-child(3) { opacity:1; transform:none; transition-delay:0.25s; }
  .stagger.visible > *:nth-child(4) { opacity:1; transform:none; transition-delay:0.35s; }
  .stagger.visible > *:nth-child(5) { opacity:1; transform:none; transition-delay:0.45s; }
  .stagger.visible > *:nth-child(6) { opacity:1; transform:none; transition-delay:0.55s; }

  @media (max-width:600px) {
    .idx-footer { padding:1.25rem 1.25rem !important; }
    .idx-footer-left { align-items:flex-start !important; }
    .idx-footer-text { max-width:calc(100vw - 6rem); }
  }
</style>

<script is:inline>
  (function () {
    // Sections to animate — skip hero (#top) and map (Leaflet breaks if hidden)
    var skipIds = ['top', 'map'];
    document.querySelectorAll('section').forEach(function (s) {
      if (!skipIds.includes(s.id)) s.classList.add('reveal');
    });

    // Stagger the about grids so cards pop in one by one
    ['about-stats-grid', 'about-steps-grid', 'about-features-grid'].forEach(function (cls) {
      var el = document.querySelector('.' + cls);
      if (el) el.classList.add('stagger');
    });

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0, rootMargin: '0px 0px 80px 0px' });

    document.querySelectorAll('.reveal, .stagger').forEach(function (el) {
      observer.observe(el);
    });
  })();
</script>

<script>
  import { supabase } from '../lib/supabase';
  const { data: { session } } = await supabase.auth.getSession();
  if (session) {
    const { data: trainerRow } = await supabase.from('trainers').select('id, name').eq('user_id', session.user.id).maybeSingle();
    if (trainerRow && !new URLSearchParams(window.location.search).has('cv')) {
      window.location.replace('/for-trainers');
    } else if (trainerRow) {
      // Trainer viewing customer home via ?cv=1 — show their dashboard button
      const firstName = trainerRow.name ? trainerRow.name.split(' ')[0] : '';
      document.getElementById('nav-signin')!.style.display  = 'none';
      document.getElementById('nav-signup')!.style.display  = 'none';
      const accountEl = document.getElementById('nav-account') as HTMLAnchorElement;
      accountEl.style.display = '';
      accountEl.href          = '/dashboard';
      accountEl.textContent   = (firstName ? firstName + ' · ' : '') + 'My Dashboard →';
      document.getElementById('mob-signin')!.style.display   = 'none';
      document.getElementById('mob-signup')!.style.display   = 'none';
      const mobAcc = document.getElementById('mob-account') as HTMLAnchorElement;
      mobAcc.style.display  = 'block';
      mobAcc.href           = '/dashboard';
      mobAcc.textContent    = (firstName ? firstName + ' · ' : '') + 'My Dashboard →';
    } else {
      const { data: client } = await supabase.from('clients').select('id, name').eq('user_id', session.user.id).maybeSingle();
      if (client) {
        const firstName = client.name.split(' ')[0];
        document.getElementById('nav-signin')!.style.display  = 'none';
        document.getElementById('nav-signup')!.style.display  = 'none';
        const accountEl = document.getElementById('nav-account')!;
        accountEl.style.display  = '';
        accountEl.textContent    = `Hi, ${firstName}  →  My Account`;
        document.getElementById('nav-signout')!.style.display = '';
        document.getElementById('mob-signin')!.style.display  = 'none';
        document.getElementById('mob-signup')!.style.display  = 'none';
        document.getElementById('mob-account')!.style.display = 'block';
        document.getElementById('mob-signout')!.style.display = 'block';
        document.getElementById('mob-account')!.textContent   = `Hi, ${firstName} — My Account`;
      }
    }
  }

  const signOutHandler = async () => {
    await supabase.auth.signOut();
    window.location.href = '/';
  };
  document.getElementById('nav-signout')?.addEventListener('click', signOutHandler);
  document.getElementById('mob-signout')?.addEventListener('click', signOutHandler);
</script>


