---
// Auth callback — CoachCards
// Supabase redirects here after email confirmation.
// This page exchanges the token for a live session, then sends the PT to their dashboard.
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Confirming your account… — CoachCards</title>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700&display=swap" rel="stylesheet">
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body {
      font-family:'Manrope',sans-serif; background:#f7f9f7;
      display:flex; align-items:center; justify-content:center; min-height:100vh;
    }
    .box {
      text-align:center; background:white; border-radius:16px;
      padding:3rem 2.5rem; border:1px solid #e0e8e1;
      box-shadow:0 8px 32px rgba(0,0,0,0.07); max-width:380px; width:100%;
    }
    .spinner {
      width:52px; height:52px; border:4px solid #eaf7ec; border-top-color:#3ab54a;
      border-radius:50%; animation:spin 0.8s linear infinite; margin:0 auto 1.5rem;
    }
    @keyframes spin { to { transform:rotate(360deg); } }
    h2 { font-size:1.2rem; font-weight:700; color:#0d1a0e; margin-bottom:0.5rem; }
    p  { font-size:0.85rem; color:#7a8f7c; line-height:1.6; }
    .err { color:#c62828; font-size:0.82rem; margin-top:1rem; display:none; }
  </style>
</head>
<body>
  <div class="box">
    <div class="spinner"></div>
    <h2>Confirming your account…</h2>
    <p>Just a moment while we set everything up for you.</p>
    <p class="err" id="err-msg"></p>
  </div>

  <script>
    import { supabase } from '../../lib/supabase';

    (async () => {
      // ── PKCE flow ──────────────────────────────────────────────────────
      const params = new URLSearchParams(window.location.search);
      const code   = params.get('code');

      if (code) {
        const { error } = await supabase.auth.exchangeCodeForSession(code);
        if (error) { showError('Confirmation failed: ' + error.message); return; }

        // Broadcast to the desktop signup page so it auto-redirects to login
        const { data: { session: cs } } = await supabase.auth.getSession();
        if (cs) {
          await new Promise<void>((resolve) => {
            const ch = supabase.channel('email-confirm:' + cs.user.id);
            ch.subscribe((status) => {
              if (status === 'SUBSCRIBED') {
                ch.send({ type: 'broadcast', event: 'confirmed', payload: {} })
                  .finally(() => { supabase.realtime.removeChannel(ch); resolve(); });
              }
            });
            setTimeout(resolve, 3000); // safety timeout
          });
        }

        await supabase.auth.signOut();
        window.location.href = '/login?confirmed=1';
        return;
      }

      // ── Implicit / hash flow ───────────────────────────────────────────
      const { data: { session } } = await supabase.auth.getSession();
      if (session) {
        await supabase.auth.signOut();
        window.location.href = '/login?confirmed=1';
        return;
      }

      const { data: { subscription } } = supabase.auth.onAuthStateChange(async (event, sess) => {
        if ((event === 'SIGNED_IN' || event === 'TOKEN_REFRESHED') && sess) {
          subscription.unsubscribe();
          await supabase.auth.signOut();
          window.location.href = '/login?confirmed=1';
        }
      });

      // Safety net
      setTimeout(() => {
        subscription.unsubscribe();
        window.location.href = '/login';
      }, 8000);
    })();

    function showError(msg) {
      const el = document.getElementById('err-msg');
      if (el) { el.textContent = msg; el.style.display = 'block'; }
      setTimeout(() => { window.location.href = '/login'; }, 3000);
    }
  </script>
</body>
</html>
