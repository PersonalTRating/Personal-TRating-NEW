  .fat-bar-bottom { display:flex; align-items:center; justify-content:space-between; padding:0.5rem 0 0.75rem; gap:1rem; flex-wrap:wrap; }
  .fat-sort-sel { border:1.5px solid #e0e8e1; border-radius:20px; padding:0.3rem 0.85rem; font-size:0.8rem; font-family:'Manrope',sans-serif; color:#111311; background:white; cursor:pointer; outline:none; }

  /* Chips */
  .chip { flex-shrink:0; padding:0.38rem 1rem; border-radius:20px; font-size:0.78rem; font-weight:600; border:1.5px solid #e0e8e1; background:white; color:#5a6b5c; cursor:pointer; transition:all 0.15s; white-space:nowrap; font-family:'Manrope',sans-serif; }
  .chip:hover { border-color:#3ab54a; color:#2a9438; }
  .chip-active { background:#3ab54a; border-color:#3ab54a; color:white; }

  /* View toggle */
  .vt-wrap { display:flex; background:#f0f4f0; border-radius:20px; padding:0.2rem; gap:0.1rem; }
