      <a href="/for-trainers" style="display:inline-block;background:#3ab54a;color:white;font-weight:700;font-size:0.875rem;padding:0.85rem 2rem;border-radius:30px;text-decoration:none;font-family:'Manrope',sans-serif;transition:background 0.2s;" onmouseover="this.style.background='#2a9438'" onmouseout="this.style.background='#3ab54a'">Join CoachCards</a>
