<script is:inline>
(function () {
  // Animated placeholder: hide on focus/type, restore on blur if empty
  var fatInput = document.getElementById('fat-search');
  var fatPh    = document.getElementById('fat-ph');
  if (fatInput && fatPh) {
    fatInput.addEventListener('focus', function () { fatPh.style.display = 'none'; });
    fatInput.addEventListener('input', function () { fatPh.style.display = fatInput.value ? 'none' : 'flex'; });
    fatInput.addEventListener('blur',  function () { if (!fatInput.value) fatPh.style.display = 'flex'; });
  }
  var fatSpan = document.getElementById('fat-ph-span');
  if (fatSpan && fatPh) {
    var cw = fatPh.offsetWidth;
    var sw = fatSpan.offsetWidth;
    fatSpan.style.setProperty('--fs-from', (cw + 20) + 'px');
    fatSpan.style.setProperty('--fs-to',   (-sw - 20) + 'px');
    fatSpan.style.animation = 'fat-scroll 10s linear infinite';
  }
})();

(function () {
  var activeSpec       = '';
  var activeSort       = 'bmp';
  var activeSearch     = '';
  var activeCoachType  = '';
  var mapInited    = false;

  var searchEl  = document.getElementById('fat-search');
  var sortEl    = document.getElementById('fat-sort');
  var countEl   = document.getElementById('fat-count-txt');
  var emptyEl   = document.getElementById('fat-empty');
  var listView  = document.getElementById('fat-list-view');
  var mapView   = document.getElementById('fat-map-view');
  var listInner = document.getElementById('fat-list-inner');
  var cardsWrap = document.getElementById('fat-cards-wrap');
  var cards     = Array.from(document.querySelectorAll('.trc'));

  // ── Geo state ──
  var activeTier    = 'uk';
  var activeCountry = '';
  var activeLocal   = '';
  var localAreaData = [];
  var PART_THRESHOLD = 10;
  try { localAreaData   = JSON.parse(document.getElementById('fat-geo-data').textContent || '[]'); } catch(e) {}
  try { PART_THRESHOLD  = JSON.parse(document.getElementById('fat-part-threshold').textContent || '10'); } catch(e) {}

  var regionMap = {
    'scotland':        ['glasgow','edinburgh','aberdeen','dundee','inverness','stirling','perth','falkirk','ayr','paisley','hamilton','livingston','greenock','kirkcaldy','dunfermline','motherwell'],
    'scottish':        ['glasgow','edinburgh','aberdeen','dundee','inverness','stirling','perth','falkirk','ayr','paisley','hamilton','livingston','greenock','kirkcaldy','dunfermline','motherwell'],
    'wales':           ['cardiff','swansea','newport','bangor','wrexham','barry','bridgend','merthyr','rhyl','aberystwyth','llandudno','cwmbran','pontypridd'],
    'welsh':           ['cardiff','swansea','newport','bangor','wrexham','barry','bridgend','merthyr','rhyl','aberystwyth','llandudno','cwmbran','pontypridd'],
    'northern ireland':['belfast','derry','londonderry','lisburn','newry','armagh','omagh','ballymena','antrim','bangor'],
    'north west':      ['manchester','liverpool','preston','bolton','wigan','blackpool','chester','carlisle','warrington','oldham','salford','rochdale','bury','stockport','burnley','lancaster'],
    'north east':      ['newcastle','sunderland','middlesbrough','durham','gateshead','hartlepool','darlington','stockton','south shields'],
    'yorkshire':       ['leeds','sheffield','bradford','hull','york','halifax','huddersfield','wakefield','doncaster','rotherham','harrogate','scarborough','barnsley'],
    'midlands':        ['birmingham','coventry','leicester','nottingham','derby','wolverhampton','stoke','stafford','walsall','northampton','shrewsbury','worcester','hereford'],
    'west midlands':   ['birmingham','coventry','wolverhampton','walsall','west bromwich','lichfield','solihull','dudley','redditch'],
    'east midlands':   ['nottingham','derby','leicester','lincoln','northampton','peterborough','mansfield','loughborough'],
    'east of england': ['norwich','cambridge','ipswich','peterborough','colchester','chelmsford','luton','southend','bury st edmunds'],
    'south east':      ['brighton','southampton','portsmouth','oxford','reading','milton keynes','guildford','canterbury','maidstone','eastbourne','hastings','worthing','crawley','basingstoke'],
    'south west':      ['bristol','exeter','plymouth','bath','gloucester','truro','swindon','cheltenham','bournemouth','poole','salisbury','torquay','yeovil','taunton'],
    'london':          ['london'],
  };

  /* ── Specialty chip ── */
  function setSpec(btn, spec) {
    activeSpec = spec;
    document.querySelectorAll('.chip').forEach(function (c) { c.classList.remove('chip-active'); });
    btn.classList.add('chip-active');
    applyFilters();
  }
  window.setSpec = setSpec;

  /* ── Search ── */
  function doSearch() {
    activeSearch = searchEl ? searchEl.value.trim().toLowerCase() : '';
    applyFilters();
  }
  window.doSearch = doSearch;

  /* ── Delivery / coaching type filter ── */
  function setCoachType() {
    var sel = document.getElementById('fat-coach-type');
    activeCoachType = sel ? sel.value : '';
    applyFilters();
  }
  window.setCoachType = setCoachType;

  /* ── Geo navigation ── */
  function setGeoTier(tier) {
    activeTier = tier;
    ['uk','country','local'].forEach(function (t) {
      var el = document.getElementById('geo-tab-' + t);
      if (el) el.classList.toggle('fat-tier-active', t === tier);
    });
    var selWrap   = document.getElementById('fat-geo-selectors');
    var localWrap = document.getElementById('geo-local-wrap');
    if (selWrap)   selWrap.style.display   = (tier === 'uk') ? 'none' : '';
    if (localWrap) localWrap.style.display = (tier === 'local') ? 'flex' : 'none';
    if (tier === 'uk') {
      activeCountry = '';
      activeLocal   = '';
      var csel = document.getElementById('geo-country-sel');
      if (csel) csel.value = '';
    }
    if (tier !== 'local') {
      activeLocal = '';
      var lsel  = document.getElementById('geo-local-sel');
      var lsrch = document.getElementById('geo-local-srch');
      if (lsel)  lsel.value  = '';
      if (lsrch) lsrch.value = '';
    }
    if (tier === 'local' && activeCountry) populateLocalAreas(activeCountry);
    updateLbHead();
    updateUrl();
    applyFilters();
  }
  window.setGeoTier = setGeoTier;

  function onGeoCountryChange() {
    var csel = document.getElementById('geo-country-sel');
    activeCountry = csel ? csel.value : '';
    activeLocal   = '';
    var lsel  = document.getElementById('geo-local-sel');
    var lsrch = document.getElementById('geo-local-srch');
    if (lsel)  lsel.value  = '';
    if (lsrch) lsrch.value = '';
    if (activeTier === 'local' && activeCountry) populateLocalAreas(activeCountry);
    updateLbHead();
    updateUrl();
    applyFilters();
  }
  window.onGeoCountryChange = onGeoCountryChange;

  function onGeoLocalChange() {
    var lsel = document.getElementById('geo-local-sel');
    activeLocal = lsel ? lsel.value : '';
    updateLbHead();
    updateUrl();
    applyFilters();
  }
  window.onGeoLocalChange = onGeoLocalChange;

  function onGeoLocalSearch() {
    var lsrch = document.getElementById('geo-local-srch');
    var lsel  = document.getElementById('geo-local-sel');
    if (!lsrch || !lsel) return;
    var q = lsrch.value.trim().toLowerCase();
    var filtered = localAreaData.filter(function (a) {
      return (!activeCountry || a.country === activeCountry)
          && a.display_name.toLowerCase().indexOf(q) !== -1;
    });
    lsel.innerHTML = '<option value="">Select area…</option>';
    filtered.forEach(function (a) {
      var opt = document.createElement('option');
      opt.value       = a.id;
      opt.textContent = a.display_name;
      lsel.appendChild(opt);
    });
  }
  window.onGeoLocalSearch = onGeoLocalSearch;

  function populateLocalAreas(country) {
    var lsel = document.getElementById('geo-local-sel');
    if (!lsel) return;
    var areas = localAreaData.filter(function (a) { return a.country === country; });
    lsel.innerHTML = '<option value="">Select area…</option>';
    areas.forEach(function (a) {
      var opt = document.createElement('option');
      opt.value       = a.id;
      opt.textContent = a.display_name;
      lsel.appendChild(opt);
    });
  }

  function updateLbHead() {
    var titleEl = document.getElementById('fat-lb-title');
    var subEl   = document.getElementById('fat-lb-sub');
    if (!titleEl || !subEl) return;
    if (activeTier === 'uk') {
      titleEl.textContent = 'United Kingdom Rankings';
      subEl.textContent   = 'UK Leaderboard · Ranked by Body Muscle Percentage (BMP)';
    } else if (activeTier === 'country') {
      if (activeCountry) {
        titleEl.textContent = activeCountry + ' Rankings';
        subEl.textContent   = activeCountry + ' Leaderboard · Ranked by Body Muscle Percentage (BMP)';
      } else {
        titleEl.textContent = 'Country Rankings';
        subEl.textContent   = 'Select a country to view its leaderboard';
      }
    } else {
      if (activeLocal) {
        var area = localAreaData.find(function (a) { return a.id === activeLocal; });
        var areaName = area ? area.display_name : 'Local Area';
        titleEl.textContent = areaName + ' Rankings';
        subEl.textContent   = areaName + ' Leaderboard · Ranked by Body Muscle Percentage (BMP)';
      } else if (activeCountry) {
        titleEl.textContent = activeCountry + ' · Local Rankings';
        subEl.textContent   = 'Select a local area to view its leaderboard';
      } else {
        titleEl.textContent = 'Local Rankings';
        subEl.textContent   = 'Select a country and local area to view its leaderboard';
      }
    }
  }

  function updateRankDisplay() {
    var rankAttr = activeTier === 'country' ? 'data-country-rank'
                 : activeTier === 'local'   ? 'data-local-rank'
                 : 'data-uk-rank';
    cards.forEach(function (card) {
      var rankEl = card.querySelector('.trc-rank');
      if (!rankEl) return;
      var rank = card.getAttribute(rankAttr);
      if (rank != null) {
        var n = parseInt(rank);
        rankEl.textContent = isNaN(n) ? '' : String(n).padStart(2, '0');
      }
    });
  }

  function updateUrl() {
    var existing = new URLSearchParams(window.location.search);
    var params   = new URLSearchParams();
    var q    = existing.get('q');
    var spec = existing.get('spec');
    if (q)    params.set('q', q);
    if (spec) params.set('spec', spec);
    if (activeTier !== 'uk') {
      params.set('tier', activeTier);
      if (activeCountry) params.set('cc', activeCountry);
      if (activeTier === 'local' && activeLocal) params.set('area', activeLocal);
    }
    var qs = params.toString();
    history.pushState(null, '', qs ? '?' + qs : window.location.pathname);
  }

  function restoreGeoUI(tier, country, local) {
    activeTier    = tier    || 'uk';
    activeCountry = country || '';
    activeLocal   = local   || '';
    ['uk','country','local'].forEach(function (t) {
      var el = document.getElementById('geo-tab-' + t);
      if (el) el.classList.toggle('fat-tier-active', t === activeTier);
    });
    var selWrap   = document.getElementById('fat-geo-selectors');
    var localWrap = document.getElementById('geo-local-wrap');
    if (selWrap)   selWrap.style.display   = (activeTier === 'uk') ? 'none' : '';
    if (localWrap) localWrap.style.display = (activeTier === 'local') ? 'flex' : 'none';
    var csel = document.getElementById('geo-country-sel');
    if (csel) csel.value = activeCountry;
    if (activeTier === 'local' && activeCountry) {
      populateLocalAreas(activeCountry);
      var lsel = document.getElementById('geo-local-sel');
      if (lsel) lsel.value = activeLocal;
    }
    updateLbHead();
    updateRankDisplay();
    applyFilters();
  }

  /* ── Sort ── */
  function doSort() {
    activeSort = sortEl ? sortEl.value : 'bmp';
    applySortDOM();
  }
  window.doSort = doSort;

  /* ── View toggle ── */
  function setView(v) {
    document.getElementById('btn-list').classList.toggle('vt-active', v === 'list');
    document.getElementById('btn-map').classList.toggle('vt-active',  v === 'map');
    listView.style.display = v === 'list' ? '' : 'none';
    mapView.style.display  = v === 'map'  ? '' : 'none';
    if (v === 'map') initMap();
  }
  window.setView = setView;

  /* ── Core filter ── */
  function applyFilters() {
    var noGeoEl    = document.getElementById('fat-no-geo');
    var comingSoon = document.getElementById('fat-coming-soon');
    var growthMsg  = document.getElementById('fat-growth-msg');

    // No-geo state: user must pick a country/area first
    var needsSelection = (activeTier === 'country' && !activeCountry)
                      || (activeTier === 'local'   && (!activeCountry || !activeLocal));

    // Update the no-geo prompt text to match current tier state
    if (noGeoEl) {
      var noGeoTitle = document.getElementById('fat-no-geo-title');
      var noGeoSub   = document.getElementById('fat-no-geo-sub');
      if (activeTier === 'local' && activeCountry && !activeLocal) {
        if (noGeoTitle) noGeoTitle.textContent = 'Select a local area above';
        if (noGeoSub)   noGeoSub.textContent   = 'Select a local area within ' + activeCountry + ' to view rankings';
      } else if (activeTier === 'local') {
        if (noGeoTitle) noGeoTitle.textContent = 'Select a ranking area above';
        if (noGeoSub)   noGeoSub.textContent   = 'Choose a country and local area to view rankings';
      } else {
        if (noGeoTitle) noGeoTitle.textContent = 'Select a country above';
        if (noGeoSub)   noGeoSub.textContent   = 'Choose a country to view its trainer rankings';
      }
      noGeoEl.style.display = needsSelection ? '' : 'none';
    }

    // Geo-filter each card; count the geo pool (trainers in the selected area)
    var geoPool = 0;
    cards.forEach(function (card) {
      var geoPass;
      if (activeTier === 'uk') {
        geoPass = true;
      } else if (activeTier === 'country') {
        geoPass = !!activeCountry
          && card.getAttribute('data-cc-country')         === activeCountry
          && card.getAttribute('data-location-confirmed') === 'true';
      } else {
        geoPass = !!activeLocal
          && card.getAttribute('data-cc-local-area')      === activeLocal
          && card.getAttribute('data-location-confirmed') === 'true';
      }
      card._geoPass = geoPass;
      if (geoPass) geoPool++;
    });

    // Participation state for the current geo selection
    var partState = geoPool === 0 ? 'empty' : (geoPool < PART_THRESHOLD ? 'growing' : 'full');
    if (comingSoon) comingSoon.style.display = (!needsSelection && partState === 'empty')   ? '' : 'none';
    if (growthMsg)  growthMsg.style.display  = (!needsSelection && partState === 'growing') ? '' : 'none';

    // Apply all filters (geo + specialty + search + delivery)
    var regionCities = activeSearch ? (regionMap[activeSearch] || null) : null;
    var visible = 0;
    cards.forEach(function (card) {
      if (needsSelection || !card._geoPass) { card.style.display = 'none'; return; }
      var name = card.getAttribute('data-name') || '';
      var city = card.getAttribute('data-city') || '';
      var spec = card.getAttribute('data-spec') || '';
      var mQ = true;
      if (activeSearch) {
        if (regionCities) {
          mQ = regionCities.some(function (c) { return city.indexOf(c) !== -1; });
        } else {
          var q = activeSearch.replace(/^@/, '');
          mQ = name.indexOf(q) !== -1 || city.indexOf(q) !== -1;
        }
      }
      var mS = !activeSpec || spec.indexOf(activeSpec) !== -1;
      var ct = card.getAttribute('data-coaching-type') || '';
      var mC = !activeCoachType
        || (activeCoachType === 'online'    && (ct === 'online'    || ct === 'hybrid'))
        || (activeCoachType === 'in_person' && (ct === 'in_person' || ct === 'hybrid'))
        || (activeCoachType === 'hybrid'    && ct === 'hybrid');
      var show = mQ && mS && mC;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    if (countEl) countEl.textContent = needsSelection ? '' : (visible + ' trainer' + (visible !== 1 ? 's' : ''));
    if (emptyEl) emptyEl.style.display = (!needsSelection && partState === 'full' && visible === 0) ? '' : 'none';

    updateRankDisplay();
    applySortDOM();
  }

  /* ── Sort DOM ── */
  function applySortDOM() {
    if (!cardsWrap) return;
    var visible = cards.filter(function (c) { return c.style.display !== 'none'; });
    visible.sort(function (a, b) {
      if (activeSort === 'bmp') {
        if (activeTier !== 'uk') {
          var rankAttr = activeTier === 'country' ? 'data-country-rank' : 'data-local-rank';
          var ra = parseInt(a.getAttribute(rankAttr) || '9999');
          var rb = parseInt(b.getAttribute(rankAttr) || '9999');
          if (ra !== rb) return ra - rb;
        }
        return parseFloat(b.getAttribute('data-bmp') || '0') - parseFloat(a.getAttribute('data-bmp') || '0');
      }
      if (activeSort === 'reviews') return parseInt(b.getAttribute('data-reviews') || '0') - parseInt(a.getAttribute('data-reviews') || '0');
      return (a.getAttribute('data-name') || '').localeCompare(b.getAttribute('data-name') || '');
    });
    visible.forEach(function (c) { cardsWrap.appendChild(c); });
    var growthMsg  = document.getElementById('fat-growth-msg');
    var comingSoon = document.getElementById('fat-coming-soon');
    var noGeoEl    = document.getElementById('fat-no-geo');
    if (growthMsg)  cardsWrap.appendChild(growthMsg);
    if (emptyEl)    cardsWrap.appendChild(emptyEl);
    if (comingSoon) cardsWrap.appendChild(comingSoon);
    if (noGeoEl)    cardsWrap.appendChild(noGeoEl);
  }

  /* ── Leaflet map (lazy-loaded on first switch to map view) ── */
  function initMap() {
    if (mapInited) return;
    mapInited = true;
    var LEAFLET_CSS = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css';
    var LEAFLET_JS  = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js';
    if (!document.getElementById('leaflet-css')) {
      var link = document.createElement('link');
      link.id = 'leaflet-css'; link.rel = 'stylesheet'; link.href = LEAFLET_CSS;
      document.head.appendChild(link);
    }
    if (typeof L === 'undefined') {
      var s = document.createElement('script');
      s.src = LEAFLET_JS;
      s.onload = function() { doInitMap(); };
      document.head.appendChild(s);
      return;
    }
    doInitMap();
  }
