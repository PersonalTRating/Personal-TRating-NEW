const localAreasJson = JSON.stringify(
  (rankingAreasData && rankingAreasData.length > 0) ? rankingAreasData : STATIC_RANKING_AREAS
);

const specialties  = ['Weight Loss','Muscle Building','Strength & Conditioning','HIIT','Rehabilitation','Nutrition','Sports Performance','Hyrox','Yoga & Pilates','Boxing','Running'];

const PARTICIPATION_THRESHOLD = 10;
const participationState: 'empty' | 'growing' | 'full' =
  allTrainers.length === 0                           ? 'empty'   :
  allTrainers.length < PARTICIPATION_THRESHOLD       ? 'growing' :
  'full';
---

<Layout
  title="Find a Personal Trainer · CoachCards"
  description="Browse UK personal trainers ranked by real client reviews. Search by city, region or specialty and view full profiles with BMP scores."
>

<!-- ── NAV ── -->
<nav style="position:sticky;top:0;z-index:200;background:white;border-bottom:2.5px solid #3ab54a;box-shadow:0 1px 8px rgba(0,0,0,0.05);">
  <div style="max-width:1200px;margin:0 auto;padding:0 2rem;display:flex;align-items:center;justify-content:space-between;height:84px;">
    <a href="/" style="text-decoration:none;display:flex;align-items:center;gap:0.6rem;">
      <img src="/images/cc-logo.png" alt="" aria-hidden="true" style="height:42px;width:42px;flex-shrink:0;" />
      <span style="font-family:'Manrope',sans-serif;font-size:1.15rem;font-weight:800;letter-spacing:-0.2px;line-height:1;"><span style="color:#3ab54a;">Coach</span><span style="color:#111311;">Cards</span></span>
    </a>
    <div style="display:flex;gap:1.5rem;align-items:center;">
      <a href="/" id="fat-home-link" style="color:#8a8f8a;font-size:0.875rem;font-weight:600;text-decoration:none;transition:color 0.2s;"
         onmouseover="this.style.color='#111311'" onmouseout="this.style.color='#8a8f8a'">
        ← Home
      </a>
      <a href="/account" id="nav-account" style="display:none;color:#111311;text-decoration:none;font-size:0.875rem;font-weight:600;">My Account</a>
    </div>
  </div>
</nav>

<!-- Geo data for client-side JS -->
<script id="fat-geo-data" type="application/json" set:html={localAreasJson}></script>
<script id="fat-part-threshold" type="application/json" set:html={PARTICIPATION_THRESHOLD}></script>

<!-- Prevent hero/filters flash when loading directly into mobile map view -->
<script is:inline>
(function(){
  if(new URLSearchParams(window.location.search).get('view')==='map'&&
     window.matchMedia&&window.matchMedia('(max-width:768px)').matches){
    document.documentElement.classList.add('fat-map-early');
  }
})();
</script>

<!-- ── HERO ── -->
<section class="fat-hero">
  <div style="position:absolute;top:-80px;left:50%;transform:translateX(-50%);width:700px;height:700px;background:radial-gradient(circle,rgba(58,181,74,0.14) 0%,transparent 68%);pointer-events:none;"></div>
  <div style="max-width:860px;margin:0 auto;padding:0 2rem;text-align:center;position:relative;">

    <div class="fat-hero-eyebrow">UK Personal Trainer Directory</div>
    <h1 class="fat-hero-h1">Find Your Perfect<br/><span style="color:#3ab54a;">Personal Trainer</span></h1>
    <p class="fat-hero-sub">Explore personal trainers across the UK, compare verified client feedback and find a coach who matches your goals.</p>

    <!-- Search -->
    <div class="fat-search-wrap">
      <span style="flex-shrink:0;display:flex;align-items:center;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8a8f8a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
      <div style="position:relative;flex:1;min-width:0;overflow:hidden;">
        <input
          id="fat-search"
          type="text"
          placeholder=""
          autocomplete="off"
          style="width:100%;border:none;outline:none;font-size:0.95rem;font-family:'Manrope',sans-serif;background:transparent;color:#111311;min-width:0;"
        />
        <div id="fat-ph" style="position:absolute;inset:0;display:flex;align-items:center;overflow:hidden;pointer-events:none;">
          <span id="fat-ph-span" style="display:inline-block;white-space:nowrap;color:rgba(0,0,0,0.35);font-size:0.95rem;font-family:'Manrope',sans-serif;">Search by name, city or region…</span>
        </div>
      </div>
      <button onclick="doSearch()" class="fat-search-btn">Search</button>
    </div>

  </div>
</section>

<div id="fat-geo-nav-anchor" style="display:none;"></div>
<!-- ── GEO NAV ── -->
<section class="fat-geo-nav" id="fat-geo-nav">
  <div class="fat-geo-inner">

    <!-- Tier tabs: always visible -->
    <div class="fat-tier-tabs">
      <button id="geo-tab-uk"      class="fat-tier-tab fat-tier-active" onclick="setGeoTier('uk')">UK</button>
      <button id="geo-tab-country" class="fat-tier-tab"                 onclick="setGeoTier('country')">Country</button>
      <button id="geo-tab-local"   class="fat-tier-tab"                 onclick="setGeoTier('local')">Local</button>
    </div>

    <!-- Country selector: shown on Country tab only -->
    <div id="fat-geo-country-wrap" style="display:none;width:100%;">
      <select id="geo-country-sel" class="fat-geo-sel" onchange="onGeoCountryChange()" aria-label="Select country">
        <option value="">Select country…</option>
        <option value="England">England</option>
        <option value="Scotland">Scotland</option>
        <option value="Wales">Wales</option>
        <option value="Northern Ireland">Northern Ireland</option>
      </select>
    </div>

    <!-- Unified local search: shown on Local tab only -->
    <div id="fat-geo-local-wrap" style="display:none;width:100%;position:relative;">
      <input id="geo-local-unified" type="text" class="fat-geo-sel"
        placeholder="Search town, city or area…"
        autocomplete="off"
        oninput="onLocalUnifiedInput()"
        onfocus="onLocalUnifiedInput()"
        onblur="onLocalUnifiedBlur()"
        onkeydown="onLocalUnifiedKeydown(event)"
        aria-label="Search local area"
        aria-autocomplete="list"
        aria-haspopup="listbox"
        role="combobox"
        aria-expanded="false"
        aria-controls="geo-local-sugg" />
      <div id="geo-local-sugg" class="geo-local-sugg" role="listbox" style="display:none;"></div>
    </div>

  </div>
</section>

<div id="fat-filters-anchor" style="display:none;"></div>
<!-- ── STICKY FILTER BAR ── -->
<div class="fat-filters" id="fat-filters" style={participationState === 'empty' ? 'display:none;' : ''}>
  <div style="max-width:1100px;margin:0 auto;padding:0 2rem;">

    <!-- Specialty chips -->
    <div class="fat-chips-wrap">
      <button class="fat-chips-arrow fat-chips-arrow-l" id="chips-left"  onclick="scrollChips(-1)" aria-label="Scroll left"  tabindex="-1">‹</button>
      <div class="fat-chips" id="fat-chips">
        <button class="chip chip-active" data-spec="" onclick="setSpec(this,'')">All</button>
        {specialties.map(s => (
          <button class="chip" data-spec={s.toLowerCase()} onclick={"setSpec(this,'" + s.toLowerCase().replace(/'/g,"\\'") + "')"}>{s}</button>
        ))}
      </div>
      <button class="fat-chips-arrow fat-chips-arrow-r" id="chips-right" onclick="scrollChips(1)"  aria-label="Scroll right" tabindex="-1">›</button>
    </div>

    <!-- Sort + delivery filter + view toggle -->
    <div class="fat-bar-bottom">
      <div style="display:flex;align-items:center;gap:0.5rem;">
        <span style="font-size:0.78rem;color:#8a8f8a;white-space:nowrap;">Sort by:</span>
        <select id="fat-sort" onchange="doSort()" class="fat-sort-sel">
          <option value="bmp">BMP Score</option>
          <option value="reviews">Most Reviews</option>
          <option value="alpha">A — Z</option>
        </select>
      </div>
      <div style="display:flex;align-items:center;gap:0.5rem;">
        <span style="font-size:0.78rem;color:#8a8f8a;white-space:nowrap;">Delivery:</span>
        <select id="fat-coach-type" onchange="setCoachType()" class="fat-sort-sel">
          <option value="">Any</option>
          <option value="online">Online</option>
          <option value="in_person">In Person</option>
          <option value="hybrid">Hybrid</option>
        </select>
      </div>
      <div style="display:flex;align-items:center;gap:0.85rem;">
        <span id="fat-count-txt" style="font-size:0.8rem;color:#8a8f8a;"></span>
        <div class="vt-wrap">
          <button id="btn-list" class="vt-btn vt-active" onclick="setView('list')">≡ List</button>
          <button id="btn-map"  class="vt-btn"           onclick="setView('map')">◎ Map</button>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- ── LIST VIEW ── -->
<div id="fat-list-view" style="background:#0a120b;min-height:60vh;padding:2rem 0 5rem;">
  <div style="max-width:1100px;margin:0 auto;padding:0 2rem;" id="fat-list-inner">

    <!-- Leaderboard heading: always visible, updated by JS -->
    <div id="fat-lb-head" class="fat-lb-head">
      <div id="fat-lb-title" class="fat-lb-title">United Kingdom Rankings</div>
      <div id="fat-lb-sub"   class="fat-lb-sub">UK Leaderboard · Ranked by Body Muscle Percentage (BMP)</div>
    </div>

    <!-- Cards + special states wrapper -->
    <div style="display:flex;flex-direction:column;gap:1rem;" id="fat-cards-wrap">

    {participationState === 'empty' ? (
      <div id="fat-uk-empty" style="text-align:center;padding:6rem 2rem;color:rgba(255,255,255,0.7);">
        <div style="margin-bottom:1.5rem;display:inline-flex;align-items:center;justify-content:center;width:64px;height:64px;border-radius:50%;background:rgba(58,181,74,0.15);border:1px solid rgba(58,181,74,0.3);">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3ab54a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div style="font-family:'Playfair Display',serif;font-size:1.7rem;font-weight:900;color:white;margin-bottom:0.75rem;">Rankings Coming Soon</div>
        <p style="font-size:0.9rem;color:rgba(255,255,255,0.5);max-width:380px;margin:0 auto 2rem;line-height:1.75;">Be the first personal trainer in this area to join CoachCards, collect verified reviews and claim the #1 spot.</p>
        <a href="/for-trainers" style="display:inline-block;background:#3ab54a;color:white;font-weight:700;font-size:0.875rem;padding:0.85rem 2rem;border-radius:30px;text-decoration:none;font-family:'Manrope',sans-serif;transition:background 0.2s;" onmouseover="this.style.background='#2a9438'" onmouseout="this.style.background='#3ab54a'">Join CoachCards</a>
