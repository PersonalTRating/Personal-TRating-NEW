  }
  .fat-mob-filter-inner .fat-geo-nav { position: static !important; }
  .fat-mob-filter-inner .fat-filters  { position: static !important; top: auto !important; }
  .fat-mmfp-footer {
    flex-shrink: 0; padding: 0.8rem 1.2rem;
    border-top: 1px solid #f0f4f0; background: white;
  }
  .fat-mmfp-apply {
    width: 100%; background: #3ab54a; color: white;
    border: none; border-radius: 10px; padding: 0.8rem;
    font-size: 0.9rem; font-weight: 700; cursor: pointer;
    font-family: 'Manrope', sans-serif;
  }
  .fat-mob-filter-backdrop {
    position: fixed; inset: 0; z-index: 401;
    background: rgba(0,0,0,0.45);
    opacity: 0; pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .fat-mob-filter-backdrop.open { opacity: 1; pointer-events: auto; }

  /* ── Mobile Map Active layout ── */
  @media (max-width: 768px) {
    body.fat-map-active { overflow: hidden; }
    body.fat-map-active .fat-hero,
    body.fat-map-active footer { display: none !important; }
    /* Hide geo-nav + filter bar from page flow; re-show when moved into panel */
    body.fat-map-active #fat-geo-nav,
    body.fat-map-active #fat-filters { display: none !important; }
    /* Override above when elements are inside the filter panel (higher specificity) */
    #fat-mob-filter-inner #fat-geo-nav { display: block !important; }
