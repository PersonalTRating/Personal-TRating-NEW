    top: 60px; left: 0; right: 0;
    z-index: 151;
    background: white;
    border-bottom: 1.5px solid #e0e8e1;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    padding: 0.45rem 0.75rem;
    gap: 0.45rem;
