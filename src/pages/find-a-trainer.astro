---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import TrainerCard from '../components/TrainerCard.astro';

const { data: trainersData } = await supabase
  .from('trainers')
  .select('id, name, username, location, city, specialty, coaching_type, bmp_score, review_count, recent_review_count, avatar_initials, avatar_bg, avatar_color, avatar_url, bio, is_trending, cc_country, cc_local_area, location_confirmed')
  .eq('is_active', true)
  .gt('review_count', 0)
  .order('bmp_score', { ascending: false })
  .limit(500);

const raw = trainersData || [];

const allTrainers = raw.map((t: any, i: number) => ({
  id:                 t.id,
  name:               t.name || '',
  city:               t.city || t.location || '',
  spec:               t.specialty || '',
  profileComplete:    !!(t.avatar_url && (t.city || t.location) && t.bio?.trim() && t.specialty?.trim()),
  bmp:                t.bmp_score ?? 0,
  revCount:           t.review_count || 0,
  recentReviewCount:  t.recent_review_count || 0,
  rank:               i + 1,
  avatarUrl:          t.avatar_url || undefined,
  avatarInitials:     t.avatar_initials || '?',
  avatarBg:           t.avatar_bg || '#0d1a0e',
  avatarColor:        t.avatar_color || '#3ab54a',
  isTrending:         t.is_trending === true,
  coachingType:       t.coaching_type || '',
  ccCountry:          (t as any).cc_country || '',
  ccLocalArea:        (t as any).cc_local_area || '',
  locationConfirmed:  !!(t as any).location_confirmed,
}));

// Country rank map: rank within confirmed country groups of 10+ trainers, sorted by BMP
const countryRankMap: Record<string, number> = {};
{
  const groups: Record<string, typeof allTrainers> = {};
  allTrainers.forEach(t => { if (t.locationConfirmed && t.ccCountry) { (groups[t.ccCountry] = groups[t.ccCountry] || []).push(t); } });
  Object.values(groups).forEach(group => {
    if (group.length < 10) return;
    group.slice().sort((a, b) => b.bmp - a.bmp).forEach((t, i) => { countryRankMap[t.id] = i + 1; });
  });
}

// Local rank map: rank within confirmed local area groups of 10+ trainers, sorted by BMP
const localRankMap: Record<string, number> = {};
{
  const groups: Record<string, typeof allTrainers> = {};
  allTrainers.forEach(t => { if (t.locationConfirmed && t.ccLocalArea) { (groups[t.ccLocalArea] = groups[t.ccLocalArea] || []).push(t); } });
  Object.values(groups).forEach(group => {
    if (group.length < 10) return;
    group.slice().sort((a, b) => b.bmp - a.bmp).forEach((t, i) => { localRankMap[t.id] = i + 1; });
  });
}

// Fetch local ranking areas for the Local tab selectors
const { data: rankingAreasData } = await supabase
  .from('ranking_areas')
  .select('id, display_name, country, slug')
  .eq('area_type', 'local')
  .eq('is_active', true)
  .order('display_name', { ascending: true });

// Static fallback — used when the DB query returns empty (e.g. RLS blocks anon reads).
// Matches ranking_areas seed data exactly so IDs align with trainer data-cc-local-area attrs.
