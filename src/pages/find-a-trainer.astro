---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import TrainerCard from '../components/TrainerCard.astro';

const { data: trainersData } = await supabase
  .from('trainers')
  .select('id, name, username, location, city, specialty, coaching_type, bmp_score, review_count, recent_review_count, avatar_initials, avatar_bg, avatar_color, avatar_url, bio, is_trending, cc_country, cc_local_area, location_confirmed')
  .eq('is_active', true)
  .gt('review_count', 0)
  .order('bmp_score', { ascending: false })
  .limit(500);

const raw = trainersData || [];

const allTrainers = raw.map((t: any, i: number) => ({
  id:                 t.id,
  name:               t.name || '',
  city:               t.city || t.location || '',
  spec:               t.specialty || '',
  profileComplete:    !!(t.avatar_url && (t.city || t.location) && t.bio?.trim() && t.specialty?.trim()),
  bmp:                t.bmp_score ?? 0,
  revCount:           t.review_count || 0,
  recentReviewCount:  t.recent_review_count || 0,
  rank:               i + 1,
  avatarUrl:          t.avatar_url || undefined,
  avatarInitials:     t.avatar_initials || '?',
  avatarBg:           t.avatar_bg || '#0d1a0e',
  avatarColor:        t.avatar_color || '#3ab54a',
  isTrending:         t.is_trending === true,
  coachingType:       t.coaching_type || '',
  ccCountry:          (t as any).cc_country || '',
  ccLocalArea:        (t as any).cc_local_area || '',
  locationConfirmed:  !!(t as any).location_confirmed,
}));

// Country rank map: rank within each confirmed country group, sorted by BMP
const countryRankMap: Record<string, number> = {};
{
  const groups: Record<string, typeof allTrainers> = {};
  allTrainers.forEach(t => { if (t.locationConfirmed && t.ccCountry) { (groups[t.ccCountry] = groups[t.ccCountry] || []).push(t); } });
  Object.values(groups).forEach(group => {
    group.slice().sort((a, b) => b.bmp - a.bmp).forEach((t, i) => { countryRankMap[t.id] = i + 1; });
  });
}

// Local rank map: rank within each confirmed local area group, sorted by BMP
const localRankMap: Record<string, number> = {};
{
  const groups: Record<string, typeof allTrainers> = {};
  allTrainers.forEach(t => { if (t.locationConfirmed && t.ccLocalArea) { (groups[t.ccLocalArea] = groups[t.ccLocalArea] || []).push(t); } });
  Object.values(groups).forEach(group => {
    group.slice().sort((a, b) => b.bmp - a.bmp).forEach((t, i) => { localRankMap[t.id] = i + 1; });
  });
}

// Fetch local ranking areas for the Local tab selectors
const { data: rankingAreasData } = await supabase
  .from('ranking_areas')
  .select('id, display_name, country, slug')
  .eq('area_type', 'local')
  .eq('is_active', true)
  .order('display_name', { ascending: true });

const localAreasJson = JSON.stringify(rankingAreasData ?? []);

const specialties  = ['Weight Loss','Muscle Building','Strength & Conditioning','HIIT','Rehabilitation','Nutrition','Sports Performance','Hyrox','Yoga & Pilates','Boxing','Running'];

const PARTICIPATION_THRESHOLD = 10;
const participationState: 'empty' | 'growing' | 'full' =
  allTrainers.length === 0                           ? 'empty'   :
  allTrainers.length < PARTICIPATION_THRESHOLD       ? 'growing' :
  'full';
---

<Layout
  title="Find a Personal Trainer · CoachCards"
  description="Browse UK personal trainers ranked by real client reviews. Search by city, region or specialty and view full profiles with BMP scores."
>

<!-- ── NAV ── -->
<nav style="position:sticky;top:0;z-index:200;background:white;border-bottom:2.5px solid #3ab54a;box-shadow:0 1px 8px rgba(0,0,0,0.05);">
  <div style="max-width:1200px;margin:0 auto;padding:0 2rem;display:flex;align-items:center;justify-content:space-between;height:84px;">
    <a href="/" style="text-decoration:none;display:flex;align-items:center;gap:0.6rem;">
      <img src="/images/cc-logo.png" alt="" aria-hidden="true" style="height:42px;width:42px;flex-shrink:0;" />
      <span style="font-family:'Manrope',sans-serif;font-size:1.15rem;font-weight:800;letter-spacing:-0.2px;line-height:1;"><span style="color:#3ab54a;">Coach</span><span style="color:#111311;">Cards</span></span>
    </a>
    <div style="display:flex;gap:1.5rem;align-items:center;">
      <a href="/" id="fat-home-link" style="color:#8a8f8a;font-size:0.875rem;font-weight:600;text-decoration:none;transition:color 0.2s;"
         onmouseover="this.style.color='#111311'" onmouseout="this.style.color='#8a8f8a'">
        ← Home
      </a>
      <a href="/account" id="nav-account" style="display:none;color:#111311;text-decoration:none;font-size:0.875rem;font-weight:600;">My Account</a>
    </div>
  </div>
</nav>

<!-- Geo data for client-side JS -->
<script id="fat-geo-data" type="application/json" set:html={localAreasJson}></script>
<script id="fat-part-threshold" type="application/json" set:html={PARTICIPATION_THRESHOLD}></script>

<!-- ── HERO ── -->
<section class="fat-hero">
  <div style="position:absolute;top:-80px;left:50%;transform:translateX(-50%);width:700px;height:700px;background:radial-gradient(circle,rgba(58,181,74,0.14) 0%,transparent 68%);pointer-events:none;"></div>
  <div style="max-width:860px;margin:0 auto;padding:0 2rem;text-align:center;position:relative;">

    <div class="fat-hero-eyebrow">UK Personal Trainer Directory</div>
    <h1 class="fat-hero-h1">Find Your Perfect<br/><span style="color:#3ab54a;">Personal Trainer</span></h1>
    <p class="fat-hero-sub">Explore personal trainers across the UK, compare verified client feedback and find a coach who matches your goals.</p>

    <!-- Search -->
    <div class="fat-search-wrap">
      <span style="flex-shrink:0;display:flex;align-items:center;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8a8f8a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
      <div style="position:relative;flex:1;min-width:0;overflow:hidden;">
        <input
          id="fat-search"
          type="text"
          placeholder=""
          autocomplete="off"
          style="width:100%;border:none;outline:none;font-size:0.95rem;font-family:'Manrope',sans-serif;background:transparent;color:#111311;min-width:0;"
        />
        <div id="fat-ph" style="position:absolute;inset:0;display:flex;align-items:center;overflow:hidden;pointer-events:none;">
          <span id="fat-ph-span" style="display:inline-block;white-space:nowrap;color:rgba(0,0,0,0.35);font-size:0.95rem;font-family:'Manrope',sans-serif;">Search by name, city or region…</span>
        </div>
      </div>
      <button onclick="doSearch()" class="fat-search-btn">Search</button>
    </div>

  </div>
</section>

<!-- ── GEO NAV ── -->
<section class="fat-geo-nav" id="fat-geo-nav">
  <div class="fat-geo-inner">

    <!-- Tier tabs: always visible -->
    <div class="fat-tier-tabs">
      <button id="geo-tab-uk"      class="fat-tier-tab fat-tier-active" onclick="setGeoTier('uk')">🇬🇧 UK</button>
      <button id="geo-tab-country" class="fat-tier-tab"                 onclick="setGeoTier('country')">Country</button>
      <button id="geo-tab-local"   class="fat-tier-tab"                 onclick="setGeoTier('local')">Local</button>
    </div>

    <!-- Selectors: visible when Country or Local tab active -->
    <div id="fat-geo-selectors" class="fat-geo-selectors" style="display:none;">

      <!-- Country select (Country + Local) -->
      <select id="geo-country-sel" class="fat-geo-sel" onchange="onGeoCountryChange()" aria-label="Select country">
        <option value="">Select country…</option>
        <option value="England">England</option>
        <option value="Scotland">Scotland</option>
        <option value="Wales">Wales</option>
        <option value="Northern Ireland">Northern Ireland</option>
      </select>

      <!-- Local area inputs: Local tab only -->
      <div id="geo-local-wrap" style="display:none;gap:0.5rem;align-items:center;flex-wrap:wrap;">
        <input id="geo-local-srch" type="text" class="fat-geo-sel" placeholder="Search area…"
          oninput="onGeoLocalSearch()" autocomplete="off" aria-label="Search local area" style="min-width:150px;">
        <select id="geo-local-sel" class="fat-geo-sel" onchange="onGeoLocalChange()"
          aria-label="Select local area" style="min-width:180px;">
          <option value="">Select area…</option>
        </select>
      </div>

    </div>

  </div>
</section>

<!-- ── STICKY FILTER BAR ── -->
<div class="fat-filters" id="fat-filters" style={participationState === 'empty' ? 'display:none;' : ''}>
  <div style="max-width:1100px;margin:0 auto;padding:0 2rem;">

    <!-- Specialty chips -->
    <div class="fat-chips-wrap">
      <button class="fat-chips-arrow fat-chips-arrow-l" id="chips-left"  onclick="scrollChips(-1)" aria-label="Scroll left"  tabindex="-1">‹</button>
      <div class="fat-chips" id="fat-chips">
        <button class="chip chip-active" data-spec="" onclick="setSpec(this,'')">All</button>
        {specialties.map(s => (
          <button class="chip" data-spec={s.toLowerCase()} onclick={"setSpec(this,'" + s.toLowerCase().replace(/'/g,"\\'") + "')"}>{s}</button>
        ))}
      </div>
      <button class="fat-chips-arrow fat-chips-arrow-r" id="chips-right" onclick="scrollChips(1)"  aria-label="Scroll right" tabindex="-1">›</button>
    </div>

    <!-- Sort + delivery filter + view toggle -->
    <div class="fat-bar-bottom">
      <div style="display:flex;align-items:center;gap:0.5rem;">
        <span style="font-size:0.78rem;color:#8a8f8a;white-space:nowrap;">Sort by:</span>
        <select id="fat-sort" onchange="doSort()" class="fat-sort-sel">
          <option value="bmp">BMP Score</option>
          <option value="reviews">Most Reviews</option>
          <option value="alpha">A — Z</option>
        </select>
      </div>
      <div style="display:flex;align-items:center;gap:0.5rem;">
        <span style="font-size:0.78rem;color:#8a8f8a;white-space:nowrap;">Delivery:</span>
        <select id="fat-coach-type" onchange="setCoachType()" class="fat-sort-sel">
          <option value="">Any</option>
          <option value="online">Online</option>
          <option value="in_person">In Person</option>
          <option value="hybrid">Hybrid</option>
        </select>
      </div>
      <div style="display:flex;align-items:center;gap:0.85rem;">
        <span id="fat-count-txt" style="font-size:0.8rem;color:#8a8f8a;"></span>
        <div class="vt-wrap">
          <button id="btn-list" class="vt-btn vt-active" onclick="setView('list')">≡ List</button>
          <button id="btn-map"  class="vt-btn"           onclick="setView('map')">◎ Map</button>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- ── LIST VIEW ── -->
<div id="fat-list-view" style="background:#0a120b;min-height:60vh;padding:2rem 0 5rem;">
  <div style="max-width:1100px;margin:0 auto;padding:0 2rem;" id="fat-list-inner">

    <!-- Leaderboard heading: always visible, updated by JS -->
    <div id="fat-lb-head" class="fat-lb-head">
      <div id="fat-lb-title" class="fat-lb-title">United Kingdom Rankings</div>
      <div id="fat-lb-sub"   class="fat-lb-sub">UK Leaderboard · Ranked by Body Muscle Percentage (BMP)</div>
    </div>

    <!-- Cards + special states wrapper -->
    <div style="display:flex;flex-direction:column;gap:1rem;" id="fat-cards-wrap">

    {participationState === 'empty' ? (
      <div id="fat-uk-empty" style="text-align:center;padding:6rem 2rem;color:rgba(255,255,255,0.7);">
        <div style="margin-bottom:1.5rem;display:inline-flex;align-items:center;justify-content:center;width:64px;height:64px;border-radius:50%;background:rgba(58,181,74,0.15);border:1px solid rgba(58,181,74,0.3);">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3ab54a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div style="font-family:'Playfair Display',serif;font-size:1.7rem;font-weight:900;color:white;margin-bottom:0.75rem;">Rankings Coming Soon</div>
        <p style="font-size:0.9rem;color:rgba(255,255,255,0.5);max-width:380px;margin:0 auto 2rem;line-height:1.75;">Be the first personal trainer in this area to join CoachCards, collect verified reviews and claim the #1 spot.</p>
        <a href="/for-trainers" style="display:inline-block;background:#3ab54a;color:white;font-weight:700;font-size:0.875rem;padding:0.85rem 2rem;border-radius:30px;text-decoration:none;font-family:'Manrope',sans-serif;transition:background 0.2s;" onmouseover="this.style.background='#2a9438'" onmouseout="this.style.background='#3ab54a'">Join CoachCards</a>
      </div>
    ) : (
      <Fragment>
        {allTrainers.map(t => (
          <TrainerCard
            id={t.id}
            name={t.name}
            city={t.city}
            spec={t.spec}
            bmpScore={t.bmp}
            revCount={t.revCount}
            recentReviewCount={t.recentReviewCount}
            rank={t.rank}
            profileComplete={t.profileComplete}
            avatarUrl={t.avatarUrl}
            avatarInitials={t.avatarInitials}
            avatarBg={t.avatarBg}
            avatarColor={t.avatarColor}
            isTrending={t.isTrending}
            coachingType={t.coachingType}
            countryRank={countryRankMap[t.id]}
            localRank={localRankMap[t.id]}
            ccCountry={t.ccCountry}
            ccLocalArea={t.ccLocalArea}
            locationConfirmed={t.locationConfirmed}
          />
        ))}
      </Fragment>
    )}

    <!-- Growth message: hidden by default, JS controls display -->
    <div id="fat-growth-msg" style="display:none;text-align:center;padding:1.25rem 1rem 0.25rem;font-size:0.78rem;color:rgba(255,255,255,0.22);letter-spacing:0.04em;">More trainers coming soon</div>

    <!-- Filter empty state: filters narrowed to 0 in a populated pool -->
    <div id="fat-empty" style="display:none;text-align:center;padding:5rem 2rem;color:rgba(255,255,255,0.4);">
      <div style="margin-bottom:1rem;display:flex;justify-content:center;"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.3)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></div>
      <div style="font-size:1.05rem;font-weight:700;margin-bottom:0.4rem;color:rgba(255,255,255,0.8);">No trainers found</div>
      <div style="font-size:0.88rem;">Try a different city, region or specialty</div>
    </div>

    <!-- Geo coming soon: no trainers in selected country/area yet -->
    <div id="fat-coming-soon" style="display:none;text-align:center;padding:6rem 2rem;color:rgba(255,255,255,0.7);">
      <div style="margin-bottom:1.5rem;display:inline-flex;align-items:center;justify-content:center;width:64px;height:64px;border-radius:50%;background:rgba(58,181,74,0.15);border:1px solid rgba(58,181,74,0.3);">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3ab54a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div id="fat-coming-soon-title" style="font-family:'Playfair Display',serif;font-size:1.7rem;font-weight:900;color:white;margin-bottom:0.75rem;">Rankings Coming Soon</div>
      <p style="font-size:0.9rem;color:rgba(255,255,255,0.5);max-width:380px;margin:0 auto 2rem;line-height:1.75;">Be the first personal trainer in this area to join CoachCards, collect verified reviews and claim the #1 spot.</p>
      <a href="/for-trainers" style="display:inline-block;background:#3ab54a;color:white;font-weight:700;font-size:0.875rem;padding:0.85rem 2rem;border-radius:30px;text-decoration:none;font-family:'Manrope',sans-serif;transition:background 0.2s;" onmouseover="this.style.background='#2a9438'" onmouseout="this.style.background='#3ab54a'">Join CoachCards</a>
    </div>

    <!-- No geo selection: prompt to select country/area -->
    <div id="fat-no-geo" style="display:none;text-align:center;padding:5rem 2rem;color:rgba(255,255,255,0.45);">
      <div style="margin-bottom:1rem;display:flex;justify-content:center;"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="rgba(58,181,74,0.4)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></div>
      <div id="fat-no-geo-title" style="font-size:1rem;font-weight:700;color:white;margin-bottom:0.4rem;">Select a ranking area above</div>
      <div id="fat-no-geo-sub" style="font-size:0.88rem;">Choose a country to view its trainer rankings</div>
    </div>

    </div><!-- /.fat-cards-wrap -->

  </div>
</div>

<!-- ── MAP VIEW ── -->
<div id="fat-map-view" style="display:none;">
  <div id="fat-map" style="height:70vh;min-height:480px;width:100%;"></div>
  <div id="fat-map-note" style="text-align:center;padding:0.75rem;font-size:0.78rem;color:rgba(255,255,255,0.4);background:#0a120b;border-top:1px solid rgba(255,255,255,0.08);">
    Showing trainers matched to known UK cities. Click a pin to view.
  </div>
</div>

<!-- ── FOOTER ── -->
<footer style="background:#111311;padding:2.5rem 2rem;text-align:center;">
  <div style="display:flex;align-items:center;justify-content:center;gap:0.75rem;">
    <img src="/images/cc-logo.png" alt="CoachCards" style="height:38px;width:38px;" />
    <p style="font-size:0.8rem;color:rgba(255,255,255,0.3);margin:0;">© 2026 CoachCards™ · All rights reserved · Built in the UK 🇬🇧</p>
  </div>
</footer>

</Layout>

<style>
  /* ── Hero ── */
  .fat-hero { background:#111311; padding:4.5rem 0 2.5rem; position:relative; overflow:hidden; }
  .fat-hero-eyebrow { display:inline-block; background:rgba(58,181,74,0.15); border:1px solid rgba(58,181,74,0.3); color:#3ab54a; font-size:0.7rem; font-weight:700; letter-spacing:2.5px; text-transform:uppercase; padding:0.4rem 1.1rem; border-radius:20px; margin-bottom:1.4rem; }
  .fat-hero-h1 { font-family:'Playfair Display',serif; font-size:3.2rem; font-weight:900; color:white; margin:0 0 1rem; line-height:1.1; }
  .fat-hero-sub { color:rgba(255,255,255,0.55); font-size:1rem; margin:0 0 2.5rem; line-height:1.6; }

  /* Search bar */
  .fat-search-wrap { background:white; border-radius:50px; display:flex; align-items:center; max-width:640px; margin:0 auto; padding:0.45rem 0.45rem 0.45rem 1.4rem; box-shadow:0 8px 40px rgba(0,0,0,0.35); gap:0.75rem; }
  .fat-search-btn  { background:#3ab54a; color:white; border:none; padding:0.65rem 1.6rem; border-radius:30px; font-weight:700; font-size:0.9rem; cursor:pointer; font-family:'Manrope',sans-serif; flex-shrink:0; transition:background 0.2s; }
  .fat-search-btn:hover { background:#2a9438; }
  @keyframes fat-scroll {
    from { transform: translateX(var(--fs-from)); }
    to   { transform: translateX(var(--fs-to)); }
  }

  /* Stats strip */
  .fat-stats    { display:flex; align-items:center; justify-content:center; gap:2.5rem; margin-top:2.25rem; flex-wrap:wrap; }
  .fat-stat     { text-align:center; }
  .fat-stat-num { font-family:'Playfair Display',serif; font-size:1.9rem; font-weight:900; color:white; line-height:1; }
  .fat-stat-lbl { font-size:0.68rem; color:rgba(255,255,255,0.4); letter-spacing:1.5px; text-transform:uppercase; margin-top:0.25rem; }
  .fat-stat-div { width:1px; height:40px; background:rgba(255,255,255,0.1); }

  /* Filter bar */
  .fat-filters { background:white; border:none; border-top:2.5px solid #3ab54a; border-bottom:2.5px solid #3ab54a; position:sticky; top:72px; z-index:100; box-shadow:0 2px 8px rgba(0,0,0,0.05); }
  /* Chips scroll wrapper: arrows + scrollable row */
  .fat-chips-wrap { position:relative; display:flex; align-items:center; padding:0.85rem 0 0.5rem; }
  .fat-chips { display:flex; gap:0.45rem; overflow-x:auto; scrollbar-width:none; flex:1; min-width:0; scroll-behavior:smooth; }
  .fat-chips::-webkit-scrollbar { display:none; }
  /* Scroll arrows */
  .fat-chips-arrow {
    flex-shrink:0; background:white; border:1.5px solid #e0e8e1; border-radius:50%;
    width:26px; height:26px; display:flex; align-items:center; justify-content:center;
    font-size:1.1rem; line-height:1; color:#5a6b5c; cursor:pointer;
    transition:border-color 0.15s, color 0.15s; padding:0;
  }
  .fat-chips-arrow:hover { border-color:#3ab54a; color:#2a9438; }
  .fat-chips-arrow-l { margin-right:0.35rem; }
  .fat-chips-arrow-r { margin-left:0.35rem; }
  .fat-chips-arrow[disabled] { opacity:0.25; cursor:default; pointer-events:none; }
  .fat-bar-bottom { display:flex; align-items:center; justify-content:space-between; padding:0.5rem 0 0.75rem; gap:1rem; flex-wrap:wrap; }
  .fat-sort-sel { border:1.5px solid #e0e8e1; border-radius:20px; padding:0.3rem 0.85rem; font-size:0.8rem; font-family:'Manrope',sans-serif; color:#111311; background:white; cursor:pointer; outline:none; }

  /* Chips */
  .chip { flex-shrink:0; padding:0.38rem 1rem; border-radius:20px; font-size:0.78rem; font-weight:600; border:1.5px solid #e0e8e1; background:white; color:#5a6b5c; cursor:pointer; transition:all 0.15s; white-space:nowrap; font-family:'Manrope',sans-serif; }
  .chip:hover { border-color:#3ab54a; color:#2a9438; }
  .chip-active { background:#3ab54a; border-color:#3ab54a; color:white; }

  /* View toggle */
  .vt-wrap { display:flex; background:#f0f4f0; border-radius:20px; padding:0.2rem; gap:0.1rem; }
  .vt-btn  { padding:0.28rem 0.85rem; border-radius:16px; border:none; background:transparent; font-size:0.78rem; font-weight:600; color:#8a8f8a; cursor:pointer; transition:all 0.15s; font-family:'Manrope',sans-serif; white-space:nowrap; }
  .vt-active { background:white; color:#111311; box-shadow:0 1px 4px rgba(0,0,0,0.1); }

  /* ── Geo navigation ── */
  .fat-geo-nav { background:#111311; border-bottom:1px solid rgba(58,181,74,0.18); }
