<script>
  import { supabase } from '../lib/supabase';

  // ── Auth guard ─────────────────────────────────────────────────────────────
  const { data: { session } } = await supabase.auth.getSession();
  if (!session) { window.location.href = '/login'; throw new Error('unauthenticated'); }

  // ── Check if trainer (redirect to dashboard) ───────────────────────────────
  const { data: trainer } = await supabase
    .from('trainers').select('id').eq('user_id', session.user.id).maybeSingle();
  if (trainer) { window.location.href = '/dashboard'; throw new Error('is-trainer'); }

  // ── Load client record ─────────────────────────────────────────────────────
  const { data: client } = await supabase
    .from('clients').select('*').eq('user_id', session.user.id).maybeSingle();

  if (!client) {
    // Might be a trainer — send them to their dashboard instead of signing out
    const { data: trainerRow } = await supabase.from('trainers').select('id').eq('user_id', session.user.id).maybeSingle();
    window.location.href = trainerRow ? '/dashboard' : '/';
    throw new Error('no-profile');
  }

  // ── Populate UI ────────────────────────────────────────────────────────────
  const firstName = client.name.split(' ')[0];
  const initials  = client.name.split(' ').map((w: string) => w[0] || '').join('').toUpperCase().slice(0, 2);
  const avatarBgInit    = client.avatar_bg    ?? '#eaf7ec';
  const avatarColorInit = client.avatar_color ?? '#2a9438';

  (document.getElementById('welcome-name') as HTMLElement).textContent  = `Welcome back, ${firstName}.`;
  const welcomeAv = document.getElementById('welcome-avatar') as HTMLElement;
  if (client.avatar_url) {
    welcomeAv.innerHTML = `<img src="${client.avatar_url}" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />`;
    welcomeAv.style.background = 'transparent';
  } else {
    welcomeAv.textContent = initials;
    welcomeAv.style.background = avatarBgInit;
    welcomeAv.style.color      = avatarColorInit;
  }
  (document.getElementById('account-email') as HTMLElement).textContent = session.user.email ?? '—';

  // ── Profile form pre-populate ──────────────────────────────────────────────
  const nameParts = client.name.split(' ');
  (document.getElementById('cl-first-name') as HTMLInputElement).value = nameParts[0] || '';
  (document.getElementById('cl-last-name')  as HTMLInputElement).value = nameParts.slice(1).join(' ') || '';

  // Avatar preview
  const clAvPrev = document.getElementById('cl-avatar-preview') as HTMLElement;
  clAvPrev.textContent       = initials;
  // Avatar preview — photo takes priority; colour becomes border ring when photo is set
  if (client.avatar_url) {
    clAvPrev.innerHTML = `<img src="${client.avatar_url}" style="width:100%;height:100%;object-fit:cover;" />`;
    clAvPrev.style.background = 'transparent';
    clAvPrev.style.border     = `4px solid ${avatarColorInit}`;
    const upBtn = document.getElementById('cl-upload-btn') as HTMLButtonElement;
    if (upBtn) upBtn.textContent = 'Replace Photo';
  } else {
    clAvPrev.textContent      = initials;
    clAvPrev.style.background = avatarBgInit;
    clAvPrev.style.color      = avatarColorInit;
    clAvPrev.style.border     = '3px solid var(--border)';
  }

  // Pre-select saved colour swatch
  const savedBg = avatarBgInit.trim().toLowerCase();
  document.querySelectorAll('.cl-colour-swatch').forEach((el) => {
    if ((el as HTMLElement).dataset.bg?.trim().toLowerCase() === savedBg)
      el.classList.add('selected');
  });

  // Username
  (document.getElementById('cl-username') as HTMLInputElement).value = client.username ?? '';

  // Sidebar avatar
  const sbAv = document.getElementById('acc-sb-avatar') as HTMLElement;
  if (sbAv) {
    if (client.avatar_url) {
      sbAv.innerHTML = `<img src="${client.avatar_url}" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />`;
    } else {
      sbAv.textContent = initials; sbAv.style.background = avatarBgInit; sbAv.style.color = avatarColorInit;
    }
  }
  const sbName = document.getElementById('acc-sb-name') as HTMLElement;
  if (sbName) sbName.textContent = client.name;

  // ── Load past reviews ──────────────────────────────────────────────────────
  const { data: reviews } = await supabase
    .from('reviews')
    .select('id, rating, review_text, created_at, trainer_id, trainers(name, avatar_initials, avatar_bg, avatar_color, bmp_score, review_count)')
    .eq('client_id', client.id)
    .order('created_at', { ascending: false });

  if (reviews && reviews.length > 0) {
    const listEl = document.getElementById('reviews-list')!;
    listEl.innerHTML = reviews.map((r: any) => {
      const t       = r.trainers;
      const date    = new Date(r.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
      const bmp     = t?.bmp_score ?? 0;
      const bmpDisp = bmp % 1 === 0 ? String(bmp) : bmp.toFixed(1);
      const filled  = Math.min(5, Math.round(bmp / 20));
      const dbs     = '🏋️'.repeat(filled) + '<span style="opacity:0.22">' + '🏋️'.repeat(5 - filled) + '</span>';
      const revCount = t?.review_count ?? 0;
      return `<a href="/trainers/${r.trainer_id}" class="review-item">
        <div class="review-left">
          <div class="review-trainer-row">
            <div class="review-trainer-avatar" style="background:${t?.avatar_bg ?? '#eaf7ec'};color:${t?.avatar_color ?? '#2a9438'}">${t?.avatar_initials ?? '?'}</div>
            <div>
              <div class="review-trainer-name">${t?.name ?? 'Unknown Trainer'}</div>
              <div class="review-date">${date}</div>
            </div>
          </div>
          <div class="review-text">"${r.review_text}"</div>
        </div>
        <div class="review-right">
          <div class="review-bmp-label">BMP</div>
          <div class="review-bmp-score">${bmpDisp}</div>
          <div class="review-dbs">${dbs}</div>
          <div class="review-count">${revCount} review${revCount !== 1 ? 's' : ''}</div>
        </div>
      </a>`;
    }).join('');
  }

  // ── Notifications ──────────────────────────────────────────────────────────
  function timeAgoNotif(iso: string): string {
    const d = Date.now() - new Date(iso).getTime();
    const m = Math.floor(d / 60000);
    if (m < 2)   return 'just now';
    if (m < 60)  return `${m}m ago`;
    const h = Math.floor(m / 60);
    if (h < 24)  return `${h}h ago`;
    return `${Math.floor(h / 24)}d ago`;
  }

  const { data: userNotifs } = await supabase
    .from('notifications')
    .select('*')
    .eq('user_id', session.user.id)
    .order('created_at', { ascending: false })
    .limit(30);

  const unreadCount = (userNotifs ?? []).filter((n: any) => !n.is_read).length;

  function updateNotifBadge(count: number) {
    const bellBadge = document.getElementById('notif-bell-badge') as HTMLElement;
    const tabBadge  = document.getElementById('notif-tab-badge') as HTMLElement;
    const dot       = document.getElementById('abn-notif-dot') as HTMLElement;
    if (count > 0) {
      if (bellBadge) { bellBadge.textContent = String(count); bellBadge.style.display = 'flex'; }
      if (tabBadge)  { tabBadge.textContent  = String(count); tabBadge.style.display  = 'inline'; }
      if (dot)         dot.style.display = 'block';
    } else {
      if (bellBadge) bellBadge.style.display = 'none';
      if (tabBadge)  tabBadge.style.display  = 'none';
      if (dot)       dot.style.display        = 'none';
    }
  }

  let _unreadNotifCount = unreadCount;
  updateNotifBadge(_unreadNotifCount);

  // ── Toast helper (appears regardless of which tab is active) ───────────────
  function showToast(icon: string, title: string, body: string, link?: string) {
    const el = document.createElement(link ? 'a' : 'div') as HTMLAnchorElement;
    if (link) el.href = link;
    el.className = 'rt-toast';
    el.innerHTML = `
      <div style="font-size:1.25rem;flex-shrink:0;">${icon}</div>
      <div style="flex:1;min-width:0;">
        <div style="font-weight:700;font-size:0.875rem;margin-bottom:0.1rem;">${title}</div>
        ${body ? `<div style="font-size:0.78rem;color:var(--muted);line-height:1.5;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">${body}</div>` : ''}
      </div>
      <button style="background:none;border:none;cursor:pointer;color:var(--muted);font-size:1rem;padding:0;flex-shrink:0;margin-left:0.25rem;line-height:1;"
        onclick="event.preventDefault();event.stopPropagation();this.closest('.rt-toast').remove()">✕</button>`;
    document.body.appendChild(el);
    setTimeout(() => {
      el.style.animation = 'fadeOutToast 0.35s ease forwards';
      setTimeout(() => el.remove(), 350);
    }, 5500);
  }

  // Render notifications list
  const notifListEl = document.getElementById('notif-list') as HTMLElement;
  if (notifListEl) {
    if (!userNotifs || userNotifs.length === 0) {
      notifListEl.innerHTML = `<div class="empty-state">
        <span class="empty-state-icon">🔔</span>
        <div class="empty-state-title">No notifications yet</div>
        <div class="empty-state-text">You'll be notified here when your reviews are approved and go live.</div>
      </div>`;
    } else {
      notifListEl.innerHTML = (userNotifs as any[]).map(n => `
        <a href="${n.link || '#'}" class="notif-item-card${n.is_read ? '' : ' unread'}">
          <div class="notif-icon">🎉</div>
          <div style="flex:1;">
            <div class="notif-title">${n.title}</div>
            <div class="notif-body-text">${n.body ?? ''}</div>
            <div class="notif-time">${timeAgoNotif(n.created_at)}</div>
          </div>
        </a>`).join('');
    }
  }

  // ── Real-time: new notification ────────────────────────────────────────────
  supabase.channel('rt-notifs-' + session.user.id)
    .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'notifications',
      filter: `user_id=eq.${session.user.id}` }, (p: any) => {
        const n = p.new;
        _unreadNotifCount++;
        updateNotifBadge(_unreadNotifCount);

        // Prepend card to the notifications list
        const listEl = document.getElementById('notif-list');
        if (listEl) {
          const empty = listEl.querySelector('.empty-state');
          if (empty) listEl.innerHTML = '';
          const card = document.createElement('a');
          card.href = n.link || '#';
          card.className = 'notif-item-card unread';
          card.innerHTML = `<div class="notif-icon">🎉</div><div style="flex:1;"><div class="notif-title">${n.title}</div><div class="notif-body-text">${n.body ?? ''}</div><div class="notif-time">just now</div></div>`;
          listEl.prepend(card);
        }

        showToast('🔔', n.title, n.body ?? '', n.link ?? undefined);
      })
    .subscribe();

  // ── Messages ───────────────────────────────────────────────────────────────
  let _clConvId: string | null = null;
  let _clMsgChannel: any = null;
  let _clConvChannel: any = null;
  const _clConvData = new Map<string, { name: string; initials: string; bg: string; color: string }>();

  function _clEsc(s: string): string {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function _clHighlightActive() {
    document.querySelectorAll('#cl-conv-list .msg-card').forEach((card) => {
      const btn = card.querySelector('[data-cid]') as HTMLElement | null;
      if (!btn) return;
      if (btn.dataset.cid === _clConvId) {
        card.classList.add('active');
        btn.textContent = 'Viewing';
      } else {
        card.classList.remove('active');
        btn.textContent = 'View Conversation';
      }
    });
  }

  async function _clLoadConvs() {
    const { data: convs } = await supabase
      .from('conversations')
      .select('id, last_message_at, last_message_preview, client_unread_count, trainer_id, trainers(name, avatar_initials, avatar_bg, avatar_color)')
      .eq('client_id', client.id)
      .order('last_message_at', { ascending: false });

    const loadingEl = document.getElementById('cl-conv-loading')!;
    const emptyEl   = document.getElementById('cl-conv-empty')!;
    const listEl    = document.getElementById('cl-conv-list')!;
    loadingEl.style.display = 'none';

    if (!convs || convs.length === 0) {
      emptyEl.style.display = '';
      listEl.style.display  = 'none';
      return;
    }

    emptyEl.style.display = 'none';
    listEl.style.display  = 'flex';
    _clConvData.clear();

    listEl.innerHTML = convs.map((c: any) => {
      const t        = (c.trainers as any) || {};
      const name     = t.name || 'Trainer';
      const initials = t.avatar_initials || name.split(' ').map((w: string) => w[0] ?? '').join('').toUpperCase().slice(0, 2) || '?';
      const bg       = t.avatar_bg    || '#eaf7ec';
      const color    = t.avatar_color || '#2a9438';
      const unread   = (c.client_unread_count ?? 0) > 0;
      _clConvData.set(c.id, { name, initials, bg, color });

      const dot     = unread ? `<span style="position:absolute;bottom:1px;right:1px;width:12px;height:12px;border-radius:50%;background:var(--green);border:2px solid white;"></span>` : '';
      const newLine = unread && c.last_message_at
        ? `<div style="font-size:0.75rem;color:var(--green);font-weight:600;margin-top:0.2rem;">New Message · ${new Date(c.last_message_at).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'})} at ${new Date(c.last_message_at).toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'})}</div>`
        : '';
      return `<div class="msg-card">
        <div style="display:flex;align-items:center;gap:1rem;padding:1rem 1.5rem;flex:1;min-width:0;">
          <div style="position:relative;flex-shrink:0;width:48px;height:48px;">
            <div style="width:48px;height:48px;border-radius:50%;background:${bg};color:${color};display:flex;align-items:center;justify-content:center;font-weight:800;font-size:0.95rem;">${_clEsc(initials)}</div>
            ${dot}
          </div>
          <div style="flex:1;min-width:0;">
            <div style="font-weight:700;font-size:0.93rem;color:var(--text);">${_clEsc(name)}</div>
            ${newLine}
          </div>
          <button class="msg-view-btn" data-cid="${c.id}">View Conversation</button>
        </div>
      </div>`;
    }).join('');

    _clHighlightActive();
  }

  // Single delegated listener — safe for any trainer name including apostrophes
  document.getElementById('cl-conv-list')!.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest('[data-cid]') as HTMLElement | null;
    if (!btn) return;
    const cid = btn.dataset.cid!;
    const d   = _clConvData.get(cid);
    if (d) _clOpenConv(cid, d.name, d.initials, d.bg, d.color);
  });

  function _clRenderMsg(m: any): string {
    const isClient = m.sender_type === 'client';
    const time = new Date(m.created_at).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
    const body = _clEsc(m.content).replace(/\n/g, '<br>');
    return `<div style="display:flex;flex-direction:column;max-width:75%;${isClient ? 'align-self:flex-end;' : 'align-self:flex-start;'}">
      <div style="${isClient ? 'background:#111311;color:white;' : 'background:white;border:1px solid #e0e8e1;color:#111311;'}padding:0.6rem 0.85rem;border-radius:${isClient ? '14px 14px 4px 14px' : '14px 14px 14px 4px'};font-size:0.875rem;line-height:1.5;word-break:break-word;">${body}</div>
      <div style="font-size:0.62rem;color:#aab8ac;margin-top:0.2rem;${isClient ? 'text-align:right;' : ''}">${time}</div>
    </div>`;
  }

  async function _clOpenConv(convId: string, trainerName: string, initials: string, avBg: string, avColor: string) {
    const switching = _clConvId !== null && _clConvId !== convId;
    _clConvId = convId;

    // Update panel header
    const avEl = document.getElementById('cl-chat-av')!;
    avEl.textContent      = initials;
    avEl.style.background = avBg;
    avEl.style.color      = avColor;
    document.getElementById('cl-chat-name')!.textContent = trainerName;

    // Show panel — skip slide animation when already open (just switching conversations)
    const panel = document.getElementById('cl-chat-panel')!;
    if (panel.classList.contains('cl-chat-hidden') || !panel.classList.contains('open')) {
      panel.classList.remove('cl-chat-hidden');
      requestAnimationFrame(() => requestAnimationFrame(() => panel.classList.add('open')));
    }

    // Show a loading spinner in the message area only when switching between conversations
    const container = document.getElementById('cl-chat-msgs')!;
    if (switching) {
      container.innerHTML = `<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#aab8ac;font-size:0.82rem;">Loading…</div>`;
    }

    _clHighlightActive();

    await supabase.from('conversations').update({ client_unread_count: 0 }).eq('id', convId);
    _clLoadConvs();

    const { data: msgs } = await supabase
      .from('messages').select('id, sender_type, content, created_at')
      .eq('conversation_id', convId).order('created_at', { ascending: true });

    // Race-condition guard: user may have switched again before this response arrived
    if (_clConvId !== convId) return;

    const _msgList = msgs || [];
    const _INTRO = "Hi! Thanks for reaching out. I'd love to hear about your fitness goals — feel free to ask me anything or let me know what you're looking for in a PT.";
    container.innerHTML = (_msgList.length === 0 ? _clRenderMsg({ sender_type: 'trainer', content: _INTRO, created_at: new Date().toISOString() }) : '') + _msgList.map(_clRenderMsg).join('');
    container.scrollTop = container.scrollHeight;

    if (_clMsgChannel) _clMsgChannel.unsubscribe();
    _clMsgChannel = supabase.channel(`cl-thread-${convId}`)
      .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'messages',
        filter: `conversation_id=eq.${convId}` }, (p: any) => {
          if (_clConvId !== convId) return;
          const cont = document.getElementById('cl-chat-msgs')!;
          cont.insertAdjacentHTML('beforeend', _clRenderMsg(p.new));
          cont.scrollTop = cont.scrollHeight;
          supabase.from('conversations').update({ client_unread_count: 0 }).eq('id', convId);
          _clLoadConvs();
        })
      .subscribe();
  }

  (window as any).clCloseConv = function() {
    const panel = document.getElementById('cl-chat-panel')!;
    panel.classList.remove('open');
    setTimeout(() => panel.classList.add('cl-chat-hidden'), 300);
    _clConvId = null;
    if (_clMsgChannel) { _clMsgChannel.unsubscribe(); _clMsgChannel = null; }
    _clHighlightActive();
  };

  (window as any).clSendMsg = async function() {
    if (!_clConvId || !client?.id) return;
    const inp = document.getElementById('cl-chat-input') as HTMLTextAreaElement;
    const content = inp.value.trim();
    if (!content) return;
    inp.value = '';
    inp.style.height = 'auto';
    await supabase.from('messages').insert({ conversation_id: _clConvId, sender_type: 'client', content });
  };

  document.getElementById('cl-chat-input')?.addEventListener('input', function(this: HTMLTextAreaElement) {
    this.style.height = 'auto';
    this.style.height = Math.min(this.scrollHeight, 110) + 'px';
  });

  _clConvChannel = supabase.channel(`cl-convs-${client.id}`)
    .on('postgres_changes', { event: 'UPDATE', schema: 'public', table: 'conversations',
      filter: `client_id=eq.${client.id}` }, (p: any) => {
        _clLoadConvs();
        // Toast if a new trainer message arrived and the user isn't viewing that thread
        if ((p.new?.client_unread_count ?? 0) > 0 && p.new?.id !== _clConvId) {
          const td = _clConvData.get(p.new.id);
          const name = td?.name || 'Your trainer';
          const preview = p.new.last_message_preview || 'sent you a message';
          showToast('💬', `New message from ${name}`, preview);
        }
      })
    .subscribe();

  _clLoadConvs();

  // ── Profile: photo upload ──────────────────────────────────────────────────
  (window as any).clHandleAvatarUpload = async function(input: HTMLInputElement) {
    const file = input.files?.[0];
    if (!file) return;
    if (file.size > 5 * 1024 * 1024) {
      const s = document.getElementById('cl-save-status') as HTMLElement;
      s.textContent = '❌ Image too large — max 5 MB'; s.style.color = '#e53935'; s.style.display = 'inline';
      setTimeout(() => { s.style.display = 'none'; }, 4000);
      return;
    }
    const preview = document.getElementById('cl-avatar-preview') as HTMLElement;
    preview.innerHTML = '<div style="font-size:1.4rem;animation:spin 1s linear infinite;">⏳</div>';

    const ext  = file.name.split('.').pop() || 'jpg';
    const path = `${session.user.id}/avatar.${ext}`;

    const { error: upErr } = await supabase.storage
      .from('avatars').upload(path, file, { upsert: true, contentType: file.type });

    if (upErr) {
      preview.textContent = initials; preview.style.background = avatarBgInit; preview.style.color = avatarColorInit;
      const s = document.getElementById('cl-save-status') as HTMLElement;
      s.textContent = '❌ Upload failed'; s.style.color = '#e53935'; s.style.display = 'inline';
      setTimeout(() => { s.style.display = 'none'; }, 4000);
      return;
    }

    const { data: { publicUrl } } = supabase.storage.from('avatars').getPublicUrl(path);
    const url = publicUrl + '?t=' + Date.now();

    await supabase.from('clients').update({ avatar_url: url }).eq('user_id', session.user.id);

    const selSwatch = document.querySelector('.cl-colour-swatch.selected') as HTMLElement | null;
    const borderColor = selSwatch?.dataset.color ?? '#2a9438';
    preview.innerHTML = `<img src="${url}" style="width:100%;height:100%;object-fit:cover;" />`;
    preview.style.background = 'transparent';
    preview.style.border     = `4px solid ${borderColor}`;
    const upBtn = document.getElementById('cl-upload-btn') as HTMLButtonElement;
    if (upBtn) upBtn.textContent = 'Replace Photo';

    const waEl = document.getElementById('welcome-avatar') as HTMLElement;
    if (waEl) { waEl.innerHTML = `<img src="${url}" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />`; waEl.style.background = 'transparent'; }

    const sbAvEl = document.getElementById('acc-sb-avatar') as HTMLElement;
    if (sbAvEl) sbAvEl.innerHTML = `<img src="${url}" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />`;
  };

  // ── Profile: colour picker ─────────────────────────────────────────────────
  (window as any).clSelectColour = function(btn: HTMLElement) {
    document.querySelectorAll('.cl-colour-swatch').forEach(s => s.classList.remove('selected'));
    btn.classList.add('selected');
    const preview = document.getElementById('cl-avatar-preview') as HTMLElement;
    if (!preview) return;
    if (preview.querySelector('img')) {
      preview.style.border = `4px solid ${btn.dataset.color ?? '#2a9438'}`;
    } else {
      preview.style.background = btn.dataset.bg    ?? '#eaf7ec';
      preview.style.color      = btn.dataset.color ?? '#2a9438';
    }
  };

  // ── Profile: save ──────────────────────────────────────────────────────────
  (window as any).clSaveProfile = async function() {
    const saveBtn  = document.getElementById('cl-save-profile-btn') as HTMLButtonElement;
    const statusEl = document.getElementById('cl-save-status') as HTMLElement;
    const fn = (document.getElementById('cl-first-name') as HTMLInputElement).value.trim();
    const ln = (document.getElementById('cl-last-name')  as HTMLInputElement).value.trim();
    const newName = [fn, ln].filter(Boolean).join(' ');
    if (!newName) return;

    const usernameRaw = (document.getElementById('cl-username') as HTMLInputElement).value.trim().toLowerCase();
    const username    = usernameRaw.replace(/[^a-z0-9_]/g, '') || null;

    const sel   = document.querySelector('.cl-colour-swatch.selected') as HTMLElement | null;
    const bg    = sel?.dataset.bg    ?? '#eaf7ec';
    const color = sel?.dataset.color ?? '#2a9438';
    const newInitials = newName.split(' ').map((w: string) => w[0] || '').join('').toUpperCase().slice(0, 2);

    saveBtn.disabled    = true;
    saveBtn.textContent = 'Saving…';

    const { error } = await supabase.from('clients')
      .update({ name: newName, username, avatar_bg: bg, avatar_color: color })
      .eq('user_id', session.user.id);

    saveBtn.disabled    = false;
    saveBtn.textContent = 'Save Changes';

    if (error) {
      statusEl.textContent    = error.message.includes('unique') ? '❌ Username taken' : '❌ Save failed';
      statusEl.style.color    = '#e53935';
      statusEl.style.display  = 'inline';
      setTimeout(() => { statusEl.style.display = 'none'; }, 4000);
      return;
    }

    statusEl.textContent   = '✓ Saved!';
    statusEl.style.color   = 'var(--green)';
    statusEl.style.display = 'inline';
    setTimeout(() => { statusEl.style.display = 'none'; }, 3000);

    const wnEl = document.getElementById('welcome-name') as HTMLElement;
    if (wnEl) wnEl.textContent = `Welcome back, ${fn}.`;
    const waEl = document.getElementById('welcome-avatar') as HTMLElement;
    if (waEl && !waEl.querySelector('img')) { waEl.textContent = newInitials; waEl.style.background = bg; waEl.style.color = color; }
    const sbAvEl   = document.getElementById('acc-sb-avatar') as HTMLElement;
    const sbNameEl = document.getElementById('acc-sb-name')   as HTMLElement;
    if (sbAvEl && !sbAvEl.querySelector('img'))   { sbAvEl.textContent = newInitials; sbAvEl.style.background = bg; sbAvEl.style.color = color; }
    if (sbNameEl) sbNameEl.textContent = newName;
  };

  // ── Sign out ───────────────────────────────────────────────────────────────
  document.getElementById('signout-btn')!.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.href = '/';
  });

  // ── Tab navigation ─────────────────────────────────────────────────────────
  (window as any).accTab = function(name: string, _btn: HTMLElement) {
    document.querySelectorAll('.acc-section').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.acc-tab').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.acc-bottom-nav button').forEach(el => el.classList.remove('active'));

    document.getElementById('acc-' + name)?.classList.add('active');
    document.querySelector(`.acc-tab[data-tab="${name}"]`)?.classList.add('active');
    const bnBtn = document.getElementById('abn-' + name);
    if (bnBtn) bnBtn.classList.add('active');

    // Mark notifications as read when panel opened
    if (name === 'notifications') {
      updateNotifBadge(0);
      // Mark unread items visually
      document.querySelectorAll('.notif-item-card.unread').forEach(el => el.classList.remove('unread'));
      // Persist to DB (fire and forget)
      supabase.from('notifications')
        .update({ is_read: true })
        .eq('user_id', session.user.id)
        .eq('is_read', false)
        .then(() => {});
    }

    // Sync sidebar active state
    document.querySelectorAll('.acc-sb-item').forEach(el => el.classList.remove('active'));
    const asbItem = document.getElementById('asb-' + name);
    if (asbItem) asbItem.classList.add('active');
  };

  // Populate sidebar avatar/name once user loads
  // Sidebar name/avatar already populated from client record above

  // Wire sign-out button in sidebar
  document.getElementById('acc-sb-signout')?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.href = '/login';
  });
</script>

<script is:inline>
  function toggleAccSidebar() {
    document.getElementById('acc-sidebar').classList.toggle('open');
    document.getElementById('acc-mob-overlay').classList.toggle('active');
    document.getElementById('acc-mob-tab').classList.toggle('open');
  }
  function closeAccSidebar() {
    document.getElementById('acc-sidebar').classList.remove('open');
    document.getElementById('acc-mob-overlay').classList.remove('active');
    document.getElementById('acc-mob-tab').classList.remove('open');
  }
  function accSbNav(name) {
    closeAccSidebar();
    // Trigger the existing accTab function
    var btn = document.getElementById('abn-' + name);
    if (btn) btn.click();
    else if (typeof accTab === 'function') accTab(name, null);
  }
</script>
