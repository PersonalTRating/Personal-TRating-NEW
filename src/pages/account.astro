---
// Client Account — CoachCards
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Account — CoachCards</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style is:global>
  :root {
    --green:#3ab54a; --green-dark:#2a9438; --green-light:#eaf7ec;
    --border:#e0e8e1; --text:#0d1a0e; --muted:#7a8f7c; --off:#f7f9f7;
  }
  * { margin:0; padding:0; box-sizing:border-box; }
  html { overflow-x:hidden; }
  body { font-family:'Manrope',sans-serif; color:var(--text); background:var(--off); min-height:100vh; overflow-x:hidden; }

  /* ── Top bar ── */
  .topbar {
    background:white; border-bottom:1px solid var(--border);
    box-shadow:0 1px 8px rgba(0,0,0,0.05);
    position:sticky; top:0; z-index:100;
  }
  .topbar-inner {
    max-width:1100px; margin:0 auto; padding:0 2.5rem;
    display:flex; align-items:center; justify-content:space-between; height:73px;
  }
  .topbar-logo img { height:57px; width:auto; object-fit:contain; }
  .topbar-right { display:flex; align-items:center; gap:1rem; }
  .topbar-link {
    font-size:0.85rem; font-weight:600; color:var(--muted);
    text-decoration:none; transition:color 0.2s;
  }
  .topbar-link:hover { color:var(--text); }
  .signout-btn {
    background:none; border:1.5px solid var(--border); border-radius:7px;
    padding:0.45rem 1rem; font-family:'Manrope',sans-serif; font-size:0.82rem;
    font-weight:700; color:var(--muted); cursor:pointer; transition:all 0.2s;
  }
  .signout-btn:hover { border-color:var(--text); color:var(--text); }

  /* ── Page layout ── */
  .page { max-width:1100px; margin:0 auto; padding:2.5rem 2.5rem 4rem; }

  /* ── Tab nav (desktop) ── */
  .acc-tabs {
    display:flex; gap:0; background:white; border:none; border-radius:0;
    padding:0; margin-bottom:2rem;
    border-bottom:2px solid var(--border);
  }
  .acc-tab {
    flex:0 0 auto; background:none; border:none; border-radius:0;
    border-bottom:3px solid transparent; margin-bottom:-2px;
    padding:0.85rem 1.75rem; font-family:'Manrope',sans-serif;
    font-size:0.875rem; font-weight:700; color:var(--muted);
    cursor:pointer; transition:color 0.15s, border-color 0.15s;
    text-align:center; letter-spacing:0.2px;
  }
  .acc-tab.active { color:var(--green); border-bottom-color:var(--green); }
  .acc-tab:not(.active):hover { color:var(--text); }
  .acc-section { display:none; }
  .acc-section.active { display:block; }

  /* ── Mobile bottom nav ── */
  .acc-bottom-nav {
    display:none; position:fixed; bottom:0; left:0; right:0; z-index:300;
    background:white; border-top:1px solid var(--border);
    padding:0.4rem 0 calc(0.4rem + env(safe-area-inset-bottom));
    box-shadow:0 -4px 20px rgba(0,0,0,0.08);
  }
  .acc-bottom-nav ul { list-style:none; margin:0; padding:0; display:flex; justify-content:space-around; }
  .acc-bottom-nav li { flex:1; }
  .acc-bottom-nav button {
    width:100%; background:none; border:none; cursor:pointer;
    display:flex; flex-direction:column; align-items:center; gap:0.2rem;
    padding:0.35rem 0; color:var(--muted); transition:color 0.15s;
  }
  .acc-bottom-nav button.active { color:var(--green); }
  .acc-bottom-nav .bn-icon { font-size:1.35rem; line-height:1; }
  .acc-bottom-nav .bn-label { font-size:0.6rem; font-weight:700; letter-spacing:0.3px; text-transform:uppercase; }
  /* ── Real-time toast ── */
  @keyframes slideInToast {
    from { opacity:0; transform:translateY(16px); }
    to   { opacity:1; transform:translateY(0); }
  }
  @keyframes fadeOutToast {
    from { opacity:1; transform:translateY(0); }
    to   { opacity:0; transform:translateY(8px); }
  }
  .rt-toast {
    position:fixed; bottom:1.75rem; right:1.5rem; z-index:9999;
    background:white; border:1px solid var(--border); border-left:4px solid var(--green);
    border-radius:12px; padding:0.9rem 1.1rem; max-width:300px;
    box-shadow:0 8px 30px rgba(0,0,0,0.13);
    display:flex; align-items:flex-start; gap:0.7rem;
    animation:slideInToast 0.3s ease; text-decoration:none; color:var(--text);
    cursor:pointer;
  }
  .rt-toast:hover { border-color:var(--green); }
  @media (max-width:768px) {
    .rt-toast { bottom:calc(68px + env(safe-area-inset-bottom)); right:0.75rem; left:0.75rem; max-width:none; }
  }

  /* ── Notification bell ── */
  .notif-bell-btn {
    position:relative; background:none; border:none; cursor:pointer;
    padding:0.35rem 0.45rem; border-radius:8px; transition:background 0.15s;
    font-size:1.2rem; line-height:1; display:flex; align-items:center;
  }
  .notif-bell-btn:hover { background:var(--off); }
  .notif-bell-badge {
    position:absolute; top:-2px; right:-2px;
    background:#e53935; color:white; font-size:0.55rem; font-weight:800;
    min-width:16px; height:16px; border-radius:8px; padding:0 3px;
    display:none; align-items:center; justify-content:center;
    border:1.5px solid white; font-family:'Manrope',sans-serif;
  }
  /* ── Notification item cards ── */
  .notif-item-card {
    display:flex; align-items:flex-start; gap:0.85rem;
    background:white; border:1px solid var(--border); border-radius:12px;
    padding:1rem 1.1rem; text-decoration:none; color:var(--text);
    margin-bottom:0.75rem; transition:border-color 0.2s;
  }
  .notif-item-card.unread { border-left:3px solid var(--green); background:var(--green-light); }
  .notif-item-card:hover { border-color:var(--green); }
  .notif-icon { font-size:1.4rem; flex-shrink:0; margin-top:0.05rem; }
  .notif-title { font-weight:700; font-size:0.875rem; margin-bottom:0.25rem; }
  .notif-body-text { font-size:0.8rem; color:var(--muted); line-height:1.55; }
  .notif-time { font-size:0.72rem; color:var(--muted); margin-top:0.35rem; }

  @media (max-width:768px) {
    .acc-tabs { display:none; }
    .acc-bottom-nav { display:block; }
    .page { padding-bottom:80px; }
    .welcome-banner h1 { font-size:1.5rem; }
    .welcome-avatar { width:52px; height:52px; font-size:1.2rem; right:1.25rem; }
  }

  /* ── Welcome banner ── */
  .welcome-banner {
    background:linear-gradient(135deg,#0d1a0e 0%,#1a3d1e 60%,#2a5a30 100%);
    border-radius:16px; padding:2.5rem; margin-bottom:2rem;
    position:relative; overflow:hidden;
  }
  .welcome-banner::before {
    content:''; position:absolute; right:-60px; top:-60px;
    width:240px; height:240px;
    background:radial-gradient(circle,rgba(58,181,74,0.18) 0%,transparent 70%);
    pointer-events:none;
  }
  .welcome-banner-label {
    font-size:0.7rem; font-weight:700; letter-spacing:2.5px; text-transform:uppercase;
    color:rgba(255,255,255,0.45); margin-bottom:0.5rem;
  }
  .welcome-banner h1 {
    font-family:'Playfair Display',serif; font-size:2rem; font-weight:900;
    color:white; line-height:1.15; margin-bottom:0.5rem;
  }
  .welcome-banner p { font-size:0.875rem; color:rgba(255,255,255,0.55); line-height:1.7; }
  .welcome-avatar {
    position:absolute; right:2.5rem; top:50%; transform:translateY(-50%);
    width:72px; height:72px; border-radius:50%;
    background:rgba(58,181,74,0.2); border:2px solid rgba(255,255,255,0.15);
    display:flex; align-items:center; justify-content:center;
    font-size:1.6rem; font-weight:800; color:white;
  }

  /* ── Grid ── */
  .grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; margin-bottom:1.25rem; align-items:stretch; }
  .grid-2 > * { display:flex; flex-direction:column; }

  /* ── Cards ── */
  .card {
    background:white; border-radius:14px; border:1px solid var(--border);
    padding:1.75rem; margin-bottom:1.25rem;
  }
  .card:last-child { margin-bottom:0; }
  .card-label {
    font-size:0.68rem; font-weight:700; letter-spacing:2.5px; text-transform:uppercase;
    color:var(--green); margin-bottom:0.4rem;
  }
  .card-title {
    font-family:'Playfair Display',serif; font-size:1.2rem; font-weight:900;
    color:var(--text); margin-bottom:1.25rem;
  }

  /* ── Quick action buttons ── */
  .action-btn {
    display:flex; align-items:center; gap:1rem;
    background:var(--off); border:1.5px solid var(--border); border-radius:10px;
    padding:1rem 1.25rem; text-decoration:none; color:var(--text);
    transition:border-color 0.2s, box-shadow 0.2s; margin-bottom:0.75rem;
    min-height:82px;
  }
  .action-btn:last-child { margin-bottom:0; }
  .action-btn:hover { border-color:var(--green); box-shadow:0 2px 12px rgba(58,181,74,0.12); }
  .action-btn-icon {
    width:42px; height:42px; border-radius:10px; flex-shrink:0;
    background:var(--green-light); display:flex; align-items:center;
    justify-content:center; font-size:1.2rem;
  }
  .action-btn-body { flex:1; }
  .action-btn-title { font-weight:700; font-size:0.9rem; margin-bottom:0.15rem; }
  .action-btn-desc  { font-size:0.77rem; color:var(--muted); line-height:1.5; }
  .action-btn-arrow { font-size:1rem; color:var(--green); font-weight:700; }

  /* ── Reviews empty state ── */
  .empty-state {
    text-align:center; padding:2.5rem 1rem;
    border:2px dashed var(--border); border-radius:10px;
  }
  .empty-state-icon { font-size:2.5rem; margin-bottom:0.875rem; display:block; }
  .empty-state-title { font-weight:700; font-size:0.95rem; margin-bottom:0.4rem; }
  .empty-state-text  { font-size:0.82rem; color:var(--muted); line-height:1.7; max-width:340px; margin:0 auto; }

  /* ── Avatar colour swatches ── */
  .cl-colour-swatch {
    width:40px; height:40px; border-radius:50%; border:2px solid rgba(0,0,0,0.08);
    cursor:pointer; display:flex; align-items:center; justify-content:center;
    font-weight:800; font-size:0.9rem; transition:transform 0.15s; flex-shrink:0;
  }
  .cl-colour-swatch:hover { transform:scale(1.12); }
  .cl-colour-swatch.selected { box-shadow:0 0 0 2px white, 0 0 0 4px #111311; }
  .cl-profile-input {
    width:100%; border:1.5px solid var(--border); border-radius:8px;
    padding:0.7rem 0.9rem; font-family:'Manrope',sans-serif; font-size:0.875rem;
    color:var(--text); outline:none; transition:border-color 0.15s; background:white;
  }
  .cl-profile-input:focus { border-color:var(--green); }
  .cl-profile-label { font-size:0.78rem; font-weight:700; color:var(--muted); display:block; margin-bottom:0.4rem; }

  /* ── Account info ── */
  .info-row {
    display:flex; align-items:center; justify-content:space-between;
    padding:0.85rem 0; border-bottom:1px solid var(--border);
  }
  .info-row:last-child { border-bottom:none; padding-bottom:0; }
  .info-label { font-size:0.78rem; font-weight:700; color:var(--muted); }
  .info-value { font-size:0.875rem; font-weight:600; color:var(--text); }

  /* ── Message conversation cards ── */
  .msg-card {
    background:white; border:1px solid var(--border); border-radius:14px;
    overflow:hidden; display:flex;
  }
  .msg-view-btn {
    background:var(--green-light); color:var(--green-dark);
    border:1.5px solid #c3e6c8; border-radius:7px;
    padding:0.45rem 0.9rem; font-size:0.75rem; font-weight:700;
    cursor:pointer; flex-shrink:0; transition:all 0.15s;
    font-family:inherit; white-space:nowrap;
  }
  .msg-view-btn:hover { background:var(--green); color:white; border-color:var(--green); }
  .msg-card.active { border-color:var(--green); box-shadow:0 0 0 2px rgba(58,181,74,0.15); }
  .msg-card.active .msg-view-btn { background:var(--green); color:white; border-color:var(--green); cursor:default; }

  /* ── Client reply panel (bottom-right) ── */
  .cl-chat-panel {
    position:fixed; bottom:24px; right:24px; z-index:9999;
    width:360px; max-height:520px;
    background:white; border-radius:16px;
    box-shadow:0 12px 48px rgba(0,0,0,0.18), 0 2px 8px rgba(0,0,0,0.08);
    display:flex; flex-direction:column; overflow:hidden;
    transform:translateY(24px); opacity:0; pointer-events:none;
    transition:transform 0.3s cubic-bezier(.34,1.56,.64,1), opacity 0.25s ease;
  }
  .cl-chat-panel.open { transform:translateY(0); opacity:1; pointer-events:all; }
  .cl-chat-hidden { display:none !important; }
  .cl-chat-hdr {
    background:linear-gradient(135deg,#0d1a0e,#1a3d1e);
    padding:0.85rem 1rem; display:flex; align-items:center; gap:0.75rem; flex-shrink:0;
  }
  .cl-chat-av {
    width:38px; height:38px; border-radius:50%; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
    font-weight:800; font-size:0.82rem;
  }
  .cl-chat-name { font-weight:700; font-size:0.88rem; color:white; }
  .cl-chat-sub  { font-size:0.68rem; color:rgba(255,255,255,0.45); margin-top:0.1rem; }
  .cl-chat-close {
    margin-left:auto; background:rgba(255,255,255,0.1); border:none;
    color:rgba(255,255,255,0.7); width:28px; height:28px; border-radius:6px;
    cursor:pointer; font-size:0.85rem; display:flex; align-items:center;
    justify-content:center; transition:background 0.15s;
  }
  .cl-chat-close:hover { background:rgba(255,255,255,0.22); }
  .cl-chat-msgs {
    flex:1; overflow-y:auto; padding:1rem;
    display:flex; flex-direction:column; gap:0.65rem; background:#f7f9f7;
  }
  .cl-chat-input-row {
    padding:0.75rem; border-top:1px solid var(--border);
    display:flex; gap:0.5rem; align-items:flex-end;
    flex-shrink:0; background:white;
  }
  .cl-chat-input {
    flex:1; border:1.5px solid var(--border); border-radius:10px;
    padding:0.55rem 0.85rem; font-family:inherit; font-size:0.875rem;
    resize:none; outline:none; min-height:40px; max-height:110px;
    transition:border-color 0.2s;
  }
  .cl-chat-input:focus { border-color:var(--green); }
  .cl-chat-send {
    width:40px; height:40px; border-radius:10px; background:var(--green);
    color:white; border:none; cursor:pointer; font-size:1.05rem;
    display:flex; align-items:center; justify-content:center; flex-shrink:0;
    transition:background 0.15s;
  }
  .cl-chat-send:hover { background:var(--green-dark); }
  @media (max-width:480px) {
    .cl-chat-panel {
      bottom:0; right:0; left:0; width:100%;
      height:58vh; max-height:none;
      border-radius:20px 20px 0 0;
      transform:translateY(100%);
      opacity:1;
    }
    .cl-chat-panel.open { transform:translateY(0); opacity:1; }
    .cl-chat-hdr { padding:1rem 1rem 0.85rem; }
    .cl-chat-input-row { padding:0.85rem; }
    .cl-chat-input { font-size:1rem; }
    .cl-chat-send { width:46px; height:46px; font-size:1.2rem; }
  }

  /* ── Review cards ── */
  #reviews-list { display:flex; flex-direction:column; gap:0.85rem; }
  .review-item {
    background:white; border-radius:14px;
    border:1px solid var(--border); display:flex; align-items:stretch;
    text-decoration:none; color:inherit;
    transition:box-shadow 0.2s, transform 0.2s; overflow:hidden;
  }
  .review-item:hover { box-shadow:0 4px 24px rgba(0,0,0,0.08); transform:translateY(-2px); }
  .review-left { flex:1; padding:1.25rem 1.5rem; min-width:0; }
  .review-trainer-row { display:flex; align-items:center; gap:0.75rem; margin-bottom:0.6rem; }
  .review-trainer-avatar {
    width:44px; height:44px; border-radius:50%; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
    font-size:0.85rem; font-weight:800;
  }
  .review-trainer-name { font-weight:700; font-size:0.95rem; color:#111311; }
  .review-date { font-size:0.72rem; color:var(--muted); margin-top:0.1rem; }
  .review-text { font-size:0.875rem; line-height:1.75; color:#3a4a3b; font-style:italic; margin-top:0.5rem; overflow-wrap:break-word; word-break:break-word; }
  .review-right {
    flex-shrink:0; width:130px; padding:1.25rem 1rem;
    border-left:1px solid var(--border); text-align:center;
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:0.2rem;
  }
  .review-bmp-label { font-size:0.65rem; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:var(--muted); }
  .review-bmp-score { font-family:'Playfair Display',serif; font-size:2rem; font-weight:900; color:#111311; line-height:1; }
  .review-dbs { font-size:1rem; letter-spacing:1px; margin-top:0.2rem; }
  .review-count { font-size:0.7rem; color:var(--muted); margin-top:0.2rem; }

  @media (max-width:640px) {
    .page           { padding:1.5rem 1.25rem 3rem; }
    .welcome-banner { padding:1.75rem; }
    .welcome-avatar { display:none; }
    .welcome-banner h1 { font-size:1.55rem; }
    .grid-2         { grid-template-columns:1fr; }
    .topbar-inner   { padding:0 1.25rem; height:60px; }
    .topbar-logo img { height:44px; }
  }

  /* ── Account sidebar ── */
  :root { --acc-sb-w: 260px; }
  .acc-sidebar {
    position:fixed; top:0; left:0; bottom:0; width:var(--acc-sb-w);
    background:linear-gradient(180deg,#0d1a0e 0%,#1a3d1e 100%);
    z-index:201; display:flex; flex-direction:column;
    transform:translateX(-100%); transition:transform 0.3s ease;
    overflow-y:auto;
  }
  .acc-sidebar.open { transform:translateX(0); }
  .acc-mob-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:200; }
  .acc-mob-overlay.active { display:block; }
  .acc-sb-logo { padding:1.25rem 1.25rem 0.75rem; border-bottom:1px solid rgba(255,255,255,0.08); }
  .acc-sb-logo img { height:54px; width:auto; object-fit:contain; border:2px solid #3ab54a; border-radius:10px; background:white; padding:3px; display:block; }
  .acc-sb-header { padding:1.25rem 1.25rem 0.75rem; border-bottom:1px solid rgba(255,255,255,0.08); }
  .acc-sb-avatar { width:44px; height:44px; border-radius:50%; background:#3ab54a; color:white; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:1rem; margin-bottom:0.5rem; }
  .acc-sb-name { font-weight:700; font-size:0.88rem; color:white; }
  .acc-sb-sub  { font-size:0.72rem; color:rgba(255,255,255,0.5); margin-top:0.1rem; }
  .acc-sb-nav  { flex:1; padding:0.75rem 0; }
  .acc-sb-item { display:flex; align-items:center; gap:0.75rem; width:100%; background:none; border:none; border-left:3px solid transparent; padding:0.75rem 1.25rem; color:rgba(255,255,255,0.65); font-size:0.85rem; font-weight:600; font-family:'Manrope',sans-serif; cursor:pointer; text-decoration:none; text-align:left; transition:background 0.15s,color 0.15s; }
  .acc-sb-item:hover { color:white; background:rgba(255,255,255,0.05); }
  .acc-sb-item.active { color:white; background:rgba(58,181,74,0.12); border-left-color:#3ab54a; }
  .acc-sb-icon { font-size:1rem; width:20px; text-align:center; }
  .acc-sb-footer { padding:1rem 1.25rem; border-top:1px solid rgba(255,255,255,0.08); }
  #acc-mob-tab { display:none; position:fixed; left:0; top:50%; transform:translateY(-50%); z-index:198; background:#3ab54a; border:none; border-radius:0 10px 10px 0; width:22px; height:64px; cursor:pointer; padding:0; align-items:center; justify-content:center; box-shadow:2px 0 8px rgba(0,0,0,0.15); transition:left 0.3s; }
  #acc-mob-tab.open { left:var(--acc-sb-w); }
  #acc-mob-tab.open svg { transform:rotate(180deg); }
  @media (max-width:768px) { #acc-mob-tab { display:flex !important; } }

  /* ── Desktop: permanent sidebar ── */
  @media (min-width:769px) {
    .acc-sidebar { transform:none; transition:none; box-shadow:2px 0 20px rgba(0,0,0,0.18); }
    .acc-mob-overlay { display:none !important; }
    #acc-mob-tab { display:none !important; }
    .topbar { margin-left:var(--acc-sb-w); }
    .topbar-inner { max-width:none; }
    .topbar-logo { display:none; }
    .page { max-width:none; margin:0 0 0 var(--acc-sb-w); padding:2.5rem 3rem 4rem; }
    .acc-tabs { display:none !important; }
  }
</style>
</head>
<body>

<!-- Mobile sidebar overlay -->
<div class="acc-mob-overlay" id="acc-mob-overlay" onclick="closeAccSidebar()"></div>

<!-- Sidebar -->
<aside class="acc-sidebar" id="acc-sidebar">
  <div class="acc-sb-logo">
    <a href="/"><img src="/images/logo.png" alt="CoachCards" /></a>
  </div>
  <div class="acc-sb-header">
    <div class="acc-sb-avatar" id="acc-sb-avatar">?</div>
