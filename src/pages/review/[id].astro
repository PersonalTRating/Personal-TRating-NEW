---
// Review Submission Page — CoachCards
import { supabase } from '../../lib/supabase';

export async function getStaticPaths() {
  const { data: trainers } = await supabase
    .from('trainers')
    .select('id')
    .eq('is_active', true);
  return (trainers || []).map(t => ({ params: { id: t.id } }));
}

const { id } = Astro.params;
const { data: trainer } = await supabase
  .from('trainers')
  .select('id, name, username, business_name, location, specialty, avatar_initials, avatar_bg, avatar_color, avatar_url, hero_theme, star_rating, review_count, bmp_score')
  .eq('id', id)
  .maybeSingle();

if (!trainer) return Astro.redirect('/');

// Hero background helpers (same logic as trainers/[id].astro)
function _hexToRGB(hex: string): [number,number,number] {
  const h = hex.replace('#',''); return [parseInt(h.slice(0,2),16),parseInt(h.slice(2,4),16),parseInt(h.slice(4,6),16)];
}
function _darkenHex(hex: string, f: number): string {
  const [r,g,b] = _hexToRGB(hex);
  return '#'+[r,g,b].map(v=>('0'+Math.round(v*(1-f)).toString(16)).slice(-2)).join('');
}
function _heroGradient(hex: string): string {
  const [r,g,b] = _hexToRGB(hex);
  const lum = (0.299*r + 0.587*g + 0.114*b) / 255;
  const [f0,f1,f2]: [number,number,number] = lum > 0.5 ? [0.90,0.82,0.72] : lum > 0.2 ? [0.78,0.64,0.46] : [0.62,0.38,0.12];
  return `linear-gradient(160deg,${_darkenHex(hex,f0)} 0%,${_darkenHex(hex,f1)} 55%,${_darkenHex(hex,f2)} 100%)`;
}
const _heroThemePresets: Record<string,string> = {
  forest:   'linear-gradient(160deg,#0d1a0e 0%,#1a3d1e 55%,#2a5a30 100%)',
  midnight: 'linear-gradient(160deg,#0a0f1e 0%,#1a2240 55%,#2a3a6a 100%)',
  charcoal: 'linear-gradient(160deg,#111111 0%,#252525 55%,#333333 100%)',
  royal:    'linear-gradient(160deg,#1a0a2e 0%,#2d1a4a 55%,#4a2a7a 100%)',
  slate:    'linear-gradient(160deg,#0a1828 0%,#1a2c40 55%,#2a3e58 100%)',
  rose:     'linear-gradient(160deg,#3d0a1e 0%,#6b1a3a 55%,#8b2252 100%)',
  lavender: 'linear-gradient(160deg,#1e0a3d 0%,#3a1a6b 55%,#5c2a8b 100%)',
  sky:      'linear-gradient(160deg,#0a1e3d 0%,#1a3a6b 55%,#2a5a8b 100%)',
};
const _ht = (trainer as any).hero_theme ?? '';
const heroBackground = _ht.startsWith('#')
  ? _heroGradient(_ht)
  : (_heroThemePresets[_ht] ?? _heroThemePresets.forest);
const avatarBorderColor = (trainer as any).avatar_color ?? 'rgba(255,255,255,0.2)';

const specialtyIconSvg: Record<string, string> = {
  'Strength & Conditioning': '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="9" width="4" height="6" rx="1"/><rect x="18" y="9" width="4" height="6" rx="1"/><line x1="6" y1="12" x2="18" y2="12"/></svg>',
  'Weight Loss':             '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>',
  'HIIT & Cardio':           '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>',
  'Rehabilitation':          '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>',
  'Nutrition Coaching':      '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>',
  'Sports Performance':      '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>',
  'Powerlifting':            '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="9" width="4" height="6" rx="1"/><rect x="18" y="9" width="4" height="6" rx="1"/><line x1="6" y1="12" x2="18" y2="12"/></svg>',
  'Functional Fitness':      '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>',
  'Hyrox':                   '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>',
};
const defaultSpecialtyIcon = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="9" width="4" height="6" rx="1"/><rect x="18" y="9" width="4" height="6" rx="1"/><line x1="6" y1="12" x2="18" y2="12"/></svg>';
const specialtyIcon = trainer.specialty ? (specialtyIconSvg[trainer.specialty] ?? defaultSpecialtyIcon) : defaultSpecialtyIcon;
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Review {trainer.name} — CoachCards</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --green:#3ab54a; --green-dark:#2a9438; --green-light:#eaf7ec;
    --green-mid:#d0f0d4; --border:#e0e8e1; --text:#0d1a0e;
    --muted:#7a8f7c; --off:#f7f9f7; --gold:#e6a800;
  }
  * { margin:0; padding:0; box-sizing:border-box; }
  body { font-family:'Manrope',sans-serif; color:var(--text); background:var(--off); min-height:100vh; }

  /* ── Top nav ── */
  .rv-nav {
    background:#0d1a0e;
    padding:0 2rem; height:94px;
    display:flex; align-items:center;
    border-bottom:2px solid #3ab54a;
  }
  .rv-nav img { height:78px; width:auto; object-fit:contain; display:block; }
  .rv-nav a { display:inline-flex; align-items:center; }

  /* ── Hero ── */
  .rv-hero {
    padding:2.5rem 1.5rem 4rem; text-align:center; position:relative;
  }
  .rv-hero::after {
    content:''; position:absolute; bottom:-60px; left:50%; transform:translateX(-50%);
    width:200px; height:120px;
    background:radial-gradient(ellipse,rgba(58,181,74,0.15) 0%,transparent 70%);
    pointer-events:none;
  }
  .rv-avatar {
    width:88px; height:88px; border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    font-weight:800; font-size:1.75rem;
    margin:0 auto 1.1rem;
    border:3px solid rgba(255,255,255,0.2);
    box-shadow:0 8px 28px rgba(0,0,0,0.35);
  }
  .rv-name {
    font-family:'Playfair Display',serif; font-size:1.85rem;
    font-weight:900; color:white; line-height:1.1; margin-bottom:0.3rem;
  }
  .rv-biz { font-size:0.88rem; color:rgba(255,255,255,0.6); margin-bottom:0.75rem; font-weight:500; }
  .rv-tags { display:flex; justify-content:center; gap:0.6rem; flex-wrap:wrap; }
  .rv-tag {
    background:rgba(255,255,255,0.12); color:rgba(255,255,255,0.75);
    font-size:0.73rem; font-weight:600; padding:0.28rem 0.75rem;
    border-radius:20px; border:1px solid rgba(255,255,255,0.15);
    display:inline-flex; align-items:center; gap:0.3rem;
  }

  /* ── Card ── */
  .rv-wrap { max-width:500px; margin:-2.25rem auto 0; padding:0 1.25rem 3rem; position:relative; z-index:2; }
  .rv-card {
    background:white; border-radius:18px;
    border:1px solid var(--border);
    box-shadow:0 8px 48px rgba(0,0,0,0.12);
    overflow:hidden;
  }
  .rv-card-body { padding:2rem 2rem 1.5rem; }

  /* ── BMP Slider ── */
  .bmp-heading {
    text-align:center; font-size:0.7rem; font-weight:700;
    letter-spacing:2px; text-transform:uppercase;
    color:var(--muted); margin-bottom:0.6rem;
  }
  .bmp-pct-display {
    text-align:center; line-height:1; margin-bottom:0.6rem;
  }
  .bmp-pct-num {
    font-family:'Playfair Display',serif; font-size:3rem;
    font-weight:900; color:var(--green-dark);
  }
  .bmp-pct-sym {
    font-size:1.4rem; font-weight:700; color:var(--green-dark); vertical-align:super;
  }
  .bmp-slider {
    -webkit-appearance:none; appearance:none;
    width:100%; height:6px; border-radius:3px;
    background: linear-gradient(to right, var(--green) 0%, var(--green) 50%, #dde8de 50%, #dde8de 100%);
    outline:none; cursor:pointer; margin-bottom:0.75rem;
  }
  .bmp-slider::-webkit-slider-thumb {
    -webkit-appearance:none; appearance:none;
    width:22px; height:22px; border-radius:50%;
    background:var(--green); border:3px solid white;
    box-shadow:0 2px 8px rgba(58,181,74,0.45); cursor:pointer;
  }
  .bmp-slider::-moz-range-thumb {
    width:22px; height:22px; border-radius:50%;
    background:var(--green); border:3px solid white;
    box-shadow:0 2px 8px rgba(58,181,74,0.45); cursor:pointer;
  }
  .bmp-dbs { display:flex; gap:4px; justify-content:center; margin-bottom:0.5rem; }
  .bmp-dbs-wrap { display:flex; justify-content:center; margin-bottom:0.4rem; }
  .bmp-label {
    text-align:center; font-size:0.8rem; font-weight:600;
    color:var(--green-dark); min-height:1.3em; margin-bottom:1.75rem;
  }

  /* ── Form ── */
  .rv-section { font-size:0.7rem; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--green); margin-bottom:1rem; }
  .form-row { display:grid; grid-template-columns:1fr 1fr; gap:0.85rem; margin-bottom:0.85rem; }
  .form-group { display:flex; flex-direction:column; gap:0.35rem; margin-bottom:0.85rem; }
  .form-group:last-of-type { margin-bottom:0; }
  .form-label { font-size:0.76rem; font-weight:700; }
  .optional { font-weight:400; color:var(--muted); }
  .form-input, .form-textarea {
    padding:0.8rem 1rem; border:1.5px solid var(--border); border-radius:8px;
    font-family:'Manrope',sans-serif; font-size:0.875rem; color:var(--text);
    background:white; outline:none; transition:border-color 0.2s, box-shadow 0.2s;
  }
  .form-input:focus, .form-textarea:focus {
    border-color:var(--green); box-shadow:0 0 0 3px rgba(58,181,74,0.1);
  }
  .form-textarea { resize:vertical; min-height:115px; }
  .char-hint { font-size:0.7rem; color:var(--muted); text-align:right; margin-top:0.2rem; transition:color 0.2s; }
  .char-hint.ok { color:var(--green-dark); }

  /* ── Error / Submit ── */
  .rv-error {
    background:#fdecea; border:1px solid #f5c6c6; color:#c62828;
    padding:0.7rem 1rem; border-radius:8px; font-size:0.82rem;
    margin-bottom:1rem; display:none;
  }
  .rv-footer { padding:1.25rem 2rem; border-top:1px solid var(--border); }
  .rv-btn {
    width:100%; padding:0.95rem; background:var(--green); color:white;
    border:none; border-radius:8px; font-family:'Manrope',sans-serif;
    font-weight:700; font-size:0.95rem; cursor:pointer;
    transition:background 0.2s; box-shadow:0 4px 16px rgba(58,181,74,0.28);
  }
  .rv-btn:hover    { background:var(--green-dark); }
  .rv-btn:disabled { opacity:0.6; cursor:not-allowed; }
  .rv-trust {
    text-align:center; font-size:0.7rem; color:var(--muted);
    margin-top:0.85rem; display:flex; align-items:center; justify-content:center; gap:0.3rem;
  }

  /* ── Thank-you ── */
  .rv-thanks { display:none; padding:3rem 2rem; text-align:center; }
  .rv-thanks-icon { display:flex; align-items:center; justify-content:center; margin-bottom:1rem; }
  .rv-thanks h2 {
    font-family:'Playfair Display',serif; font-size:1.65rem;
    font-weight:900; margin-bottom:0.6rem;
  }
  .rv-thanks p { font-size:0.875rem; color:var(--muted); line-height:1.7; margin-bottom:0.5rem; }
  .rv-thanks-stars { font-size:1.3rem; color:var(--gold); letter-spacing:2px; margin-bottom:1.5rem; }
  .rv-back {
    display:inline-block; color:var(--green); font-weight:700;
    text-decoration:none; font-size:0.875rem;
  }
  .rv-back:hover { text-decoration:underline; }

  @media (max-width: 480px) {
    .form-row   { grid-template-columns:1fr; }
    .rv-card-body { padding:1.5rem; }
    .rv-footer  { padding:1rem 1.5rem; }
    .star       { font-size:2.4rem; }
    .rv-name    { font-size:1.5rem; }
  }

  /* ── Intro Section ──────────────────────────────────────────────── */
  .rv-intro {
    background:var(--off); padding:2.5rem 1.25rem 0; overflow-x:hidden;
    animation:rv-fade-in 0.4s ease both;
  }
  @keyframes rv-fade-in { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:none; } }
  @media (prefers-reduced-motion:reduce) {
    .rv-intro, .rv-mini-card, .rv-reason { animation:none !important; transition:none !important; }
  }
  .rv-intro-inner { max-width:500px; margin:0 auto; padding-bottom:2.5rem; }

  .rv-intro-eyebrow {
    display:inline-flex; align-items:center; gap:0.45rem;
    background:rgba(58,181,74,0.1); border:1px solid rgba(58,181,74,0.22);
    color:#2a9438; font-size:0.63rem; font-weight:700; letter-spacing:1.5px;
    text-transform:uppercase; padding:0.28rem 0.75rem; border-radius:20px;
    margin-bottom:1rem;
  }
  .rv-intro-headline {
    font-family:'Playfair Display',serif; font-size:1.9rem; font-weight:900;
    color:var(--text); line-height:1.15; margin-bottom:0.7rem; text-wrap:balance;
  }
  .rv-intro-name { color:var(--green-dark); }
  .rv-intro-sub {
    font-size:0.88rem; color:var(--muted); line-height:1.7; margin-bottom:1.75rem;
  }

  /* ── Mini CoachCard ── */
  .rv-mini-card {
    display:flex; align-items:center; gap:0.85rem;
    padding:0.95rem 1.1rem;
    background:rgba(4,10,5,0.97);
    border:1px solid rgba(58,181,74,0.3); border-left:3px solid rgba(58,181,74,0.65);
    border-radius:14px;
    box-shadow:0 0 8px rgba(58,181,74,0.15), 0 2px 12px rgba(0,0,0,0.32);
    margin-bottom:1.5rem;
    animation:rv-card-in 0.45s 0.08s ease both;
  }
  @keyframes rv-card-in { from { opacity:0; transform:scale(0.97); } to { opacity:1; transform:none; } }
  .rv-mini-av {
    width:46px; min-width:46px; height:46px; border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    font-weight:800; font-size:0.82rem;
    border:2px solid rgba(255,255,255,0.12); overflow:hidden; flex-shrink:0;
  }
  .rv-mini-info { flex:1; min-width:0; }
  .rv-mini-name {
    font-family:'Playfair Display',serif; font-size:0.92rem; font-weight:700;
    color:white; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
    margin-bottom:0.2rem;
  }
  .rv-mini-meta { display:flex; align-items:center; gap:0.35rem; flex-wrap:wrap; }
  .rv-mini-loc {
    font-size:0.7rem; color:rgba(255,255,255,0.36);
    display:inline-flex; align-items:center; gap:0.2rem;
  }
  .rv-mini-spec {
    font-size:0.63rem; font-weight:600; padding:0.16rem 0.45rem;
    background:rgba(58,181,74,0.1); border:1px solid rgba(58,181,74,0.2);
    color:rgba(180,255,185,0.78); border-radius:4px;
  }
  .rv-mini-bmp { text-align:right; flex-shrink:0; }
  .rv-mini-bmp-lbl {
    display:block; font-size:0.52rem; font-weight:700; letter-spacing:1.5px;
    text-transform:uppercase; color:rgba(255,255,255,0.32);
  }
  .rv-mini-bmp-num {
    font-family:'Manrope',sans-serif; font-size:1.5rem; font-weight:800;
    color:#3ab54a; line-height:1;
  }
  .rv-mini-rev-count { font-size:0.62rem; color:rgba(255,255,255,0.28); margin-top:0.12rem; }

  /* ── 3 Reasons ── */
  .rv-intro-reasons { display:flex; flex-direction:column; gap:0.6rem; margin-bottom:2rem; }
  .rv-reason {
    display:flex; align-items:flex-start; gap:0.7rem;
    padding:0.8rem 0.9rem;
    background:white; border:1px solid var(--border); border-radius:10px;
    animation:rv-fade-in 0.35s ease both;
  }
  .rv-reason:nth-child(2) { animation-delay:0.06s; }
  .rv-reason:nth-child(3) { animation-delay:0.12s; }
  .rv-reason-icon {
    width:30px; min-width:30px; height:30px;
    background:var(--green-light); border-radius:7px;
    display:flex; align-items:center; justify-content:center; flex-shrink:0;
  }
  .rv-reason-title { font-size:0.8rem; font-weight:700; color:var(--text); margin-bottom:0.18rem; }
  .rv-reason-text  { font-size:0.76rem; color:var(--muted); line-height:1.5; }

  /* ── Intro CTA ── */
  .rv-intro-cta-wrap { text-align:center; }
  .rv-intro-btn {
    display:block; width:100%;
    background:var(--green); color:white;
    padding:0.95rem 1.5rem; border-radius:10px; border:none;
    font-family:'Manrope',sans-serif; font-size:0.875rem; font-weight:700;
    letter-spacing:0.4px; text-decoration:none; text-align:center;
    cursor:pointer; transition:background 0.2s, transform 0.15s;
    box-shadow:0 4px 16px rgba(58,181,74,0.28); margin-bottom:0.85rem;
  }
  .rv-intro-btn:hover  { background:var(--green-dark); transform:translateY(-1px); }
  .rv-intro-btn:active { transform:translateY(0); }
  .rv-intro-signin {
    display:none; justify-content:center; align-items:center; gap:0.35rem;
    font-size:0.8rem; color:var(--muted);
  }
  .rv-intro-signin a { color:var(--green-dark); font-weight:600; text-decoration:none; }
  .rv-intro-signin a:hover { text-decoration:underline; }

  /* ── Section divider ── */
  .rv-section-divider { height:1px; background:var(--border); margin:0 1.25rem; }

  /* ── Mobile sticky CTA ── */
  .rv-sticky-cta {
    display:none; position:fixed; bottom:0; left:0; right:0; z-index:200;
    padding:0.8rem 1.25rem calc(0.8rem + env(safe-area-inset-bottom));
    background:white; border-top:1px solid var(--border);
    box-shadow:0 -4px 20px rgba(0,0,0,0.1);
  }
  .rv-sticky-cta .rv-intro-btn { margin-bottom:0; }

  @media (max-width:640px) {
    .rv-intro-headline    { font-size:1.6rem; }
    .rv-sticky-cta        { display:block; }
    .rv-intro-cta-wrap    { padding-bottom:5rem; }
  }
</style>
</head>
<body>

<!-- Top nav -->
<nav class="rv-nav">
  <a id="rv-logo-link" href="/">
    <img src="/images/logo.png" alt="CoachCards" style="border:2.5px solid #3ab54a;border-radius:10px;background:white;padding:4px;">
  </a>
</nav>

<!-- Hero -->
<div id="rv-hero" class="rv-hero" style={`background:${heroBackground};`}>
<div>
  <div class="rv-avatar" style={`background:${trainer.avatar_bg ?? '#eaf7ec'};border-color:${avatarBorderColor};`}>
    {(trainer as any).avatar_url
      ? <img src={(trainer as any).avatar_url} alt={trainer.name} style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />
      : <span style={`color:${trainer.avatar_color ?? '#2a9438'};`}>{trainer.avatar_initials}</span>
    }
  </div>
  <div class="rv-name">{trainer.name}</div>
  {(trainer as any).username && <div style="font-size:0.9rem;color:rgba(255,255,255,0.5);font-weight:600;margin-top:0.2rem;margin-bottom:0.25rem;">@{(trainer as any).username}</div>}
  {trainer.business_name && <div class="rv-biz">{trainer.business_name}</div>}
  <div class="rv-tags">
    {trainer.specialty && <span class="rv-tag"><Fragment set:html={specialtyIcon} /> {trainer.specialty}</span>}
    {trainer.location  && <span class="rv-tag"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg> {trainer.location}</span>}
  </div>
</div>
</div>

<!-- Pass trainer data to client script -->
<div id="rv-data"
  data-trainer-id={trainer.id}
  data-trainer-name={trainer.name}
  style="display:none;">
</div>

<!-- ── Personalised intro section ──────────────────────────────────────── -->
<section id="rv-intro" class="rv-intro">
  <div class="rv-intro-inner">

    <div class="rv-intro-eyebrow">
      <svg width="11" height="11" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="8" fill="#3ab54a"/><path d="M4.5 8.2l2.3 2.3 4.7-4.7" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Your review matters
    </div>

    <h1 class="rv-intro-headline">
      Share your experience with <span class="rv-intro-name">{trainer.name}</span>
    </h1>

    <p class="rv-intro-sub">
      Your honest feedback helps future clients choose the right trainer — and helps {trainer.name} build their reputation on merit.
    </p>

    <!-- Trainer CoachCard preview -->
    <div class="rv-mini-card" id="rv-mini-card">
      <div class="rv-mini-av" id="rv-mini-av" style={`background:${trainer.avatar_bg ?? '#eaf7ec'};border-color:${avatarBorderColor};`}>
        {(trainer as any).avatar_url
          ? <img src={(trainer as any).avatar_url} alt={trainer.name} style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />
          : <span style={`color:${trainer.avatar_color ?? '#2a9438'};`}>{trainer.avatar_initials}</span>
        }
      </div>
      <div class="rv-mini-info">
        <div class="rv-mini-name">{trainer.name}</div>
        <div class="rv-mini-meta">
          {trainer.location && (
            <span class="rv-mini-loc">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#E85D4A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
              {trainer.location}
            </span>
          )}
          {trainer.specialty && (
            <span class="rv-mini-spec">{trainer.specialty.split(/[,\/]/)[0].trim()}</span>
          )}
        </div>
      </div>
      <div class="rv-mini-bmp">
        <span class="rv-mini-bmp-lbl">BMP</span>
        {trainer.review_count > 0
          ? <span class="rv-mini-bmp-num">{Math.round((trainer as any).bmp_score ?? (trainer.star_rating ?? 0) * 20)}</span>
          : <span style="font-size:0.7rem;font-weight:700;color:#3ab54a;line-height:1.3;">First<br/>review</span>
        }
        {trainer.review_count > 0 && (
          <div class="rv-mini-rev-count">{trainer.review_count} {trainer.review_count === 1 ? 'review' : 'reviews'}</div>
        )}
      </div>
    </div>

    <!-- 3 reasons to leave a review -->
    <div class="rv-intro-reasons">
      <div class="rv-reason">
        <div class="rv-reason-icon">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#2a9438" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div>
          <div class="rv-reason-title">Real reviews, real impact</div>
          <div class="rv-reason-text">Your experience helps future clients find quality training.</div>
        </div>
      </div>
      <div class="rv-reason">
        <div class="rv-reason-icon">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#2a9438" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div>
          <div class="rv-reason-title">Verified by CoachCards</div>
          <div class="rv-reason-text">Every review is checked before it goes live. No fake reviews.</div>
        </div>
      </div>
      <div class="rv-reason">
        <div class="rv-reason-icon">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#2a9438" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div>
          <div class="rv-reason-title">Under 2 minutes</div>
          <div class="rv-reason-text">Quick, honest, and anonymous if you prefer.</div>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="rv-intro-cta-wrap">
      <a
        id="rv-intro-cta"
        class="rv-intro-btn"
        href={`/signup?review=${encodeURIComponent(trainer.id)}&tname=${encodeURIComponent(trainer.name)}`}
      >
        REVIEW {trainer.name.toUpperCase()} →
      </a>
      <div id="rv-intro-signin" class="rv-intro-signin">
        Already have an account?
        <a href={`/login?redirect=${encodeURIComponent('/review/' + trainer.id)}`}>Sign in →</a>
      </div>
    </div>

  </div>
</section>

<div class="rv-section-divider"></div>

<!-- Form card -->
<div class="rv-wrap" id="rv-form-section">
  <div class="rv-card">

    <!-- Form state — hidden until auth check completes -->
    <div id="rv-form-state" style="display:none;">
      <div class="rv-card-body">

        <!-- BMP Slider -->
        <div class="bmp-heading">Body Muscle Percentage (BMP) Rating</div>
        <div class="bmp-pct-display">
          <span class="bmp-pct-num" id="bmp-pct">0</span><span class="bmp-pct-sym">%</span>
        </div>
        <input type="range" id="bmp-slider" class="bmp-slider" min="0" max="100" value="0" step="1">
        <div class="bmp-dbs-wrap">
          <div class="bmp-dbs" id="bmp-dbs"></div>
        </div>
        <div class="bmp-label" id="bmp-label">Drag the slider to rate</div>

        <div class="rv-section">Your Review</div>
        <div class="rv-error" id="rv-error"></div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="rv-name">Your Name *</label>
            <input class="form-input" type="text" id="rv-name" placeholder="e.g. Sarah M." autocomplete="name">
          </div>
          <div class="form-group">
            <label class="form-label" for="rv-location">Location <span class="optional">(optional)</span></label>
            <input class="form-input" type="text" id="rv-location" placeholder="e.g. London">
          </div>
        </div>

        <!-- Anonymous toggle -->
        <div style="display:flex;align-items:flex-start;gap:0.75rem;background:#f7f9f7;border:1px solid #e0e8e1;border-radius:10px;padding:0.85rem 1rem;margin-bottom:1.25rem;">
          <input type="checkbox" id="rv-anon" style="margin-top:3px;accent-color:#3ab54a;width:16px;height:16px;flex-shrink:0;cursor:pointer;">
          <div>
            <label for="rv-anon" style="font-size:0.82rem;font-weight:700;color:#111311;cursor:pointer;display:block;margin-bottom:0.2rem;">Submit anonymously</label>
            <div style="font-size:0.75rem;color:#7a8f7c;line-height:1.5;">Only your initials will be shown publicly (e.g. <strong id="rv-anon-preview">J. S.</strong>). Your full name is kept private.</div>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="rv-text">Your Review *</label>
          <textarea
            class="form-textarea"
            id="rv-text"
            placeholder={`Tell others about your experience with ${trainer.name}…`}
          ></textarea>
          <div class="char-hint" id="char-hint">Minimum 30 characters</div>
        </div>

      </div>

      <div class="rv-footer">
        <div class="rv-error" id="rv-error-foot" style="margin-bottom:0.85rem;"></div>
        <button class="rv-btn" id="rv-submit">Submit Review →</button>
        <div class="rv-trust"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> Verified by CoachCards · Your honest review helps others find great PTs</div>
        <div style="margin-top:0.6rem;font-size:0.74rem;color:var(--muted);text-align:center;line-height:1.5;">Clients can review the same trainer once every 30 days.</div>
      </div>
    </div>

    <!-- Thank-you state -->
    <div class="rv-thanks" id="rv-thanks">
      <span class="rv-thanks-icon" id="rv-thanks-icon"><svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span>
      <h2 id="rv-thanks-name">Thank you!</h2>
      <div class="rv-thanks-stars" id="rv-thanks-stars"></div>
      <p id="rv-thanks-body">Your review has been submitted and is currently being verified by our team. It will appear on their profile within 24 hours.</p>
      <p style="font-size:0.8rem;color:var(--muted);margin-bottom:1.75rem;">Every review is checked to keep CoachCards honest and trustworthy.</p>
      <a href="/" class="rv-back">← Explore CoachCards</a>
    </div>

  </div>
</div>

<!-- Mobile sticky CTA (hidden on desktop via CSS) -->
<div id="rv-sticky-cta" class="rv-sticky-cta">
  <a
    id="rv-sticky-btn"
    class="rv-intro-btn"
    href={`/signup?review=${encodeURIComponent(trainer.id)}&tname=${encodeURIComponent(trainer.name)}`}
  >
    REVIEW {trainer.name.toUpperCase()} →
  </a>
</div>

</body>
</html>

<script>
  import { supabase } from '../../lib/supabase';
  import { bmpDumbbell as _bmpDumbbell } from '../../lib/bmpDumbbell';

  const dataEl      = document.getElementById('rv-data') as HTMLElement;
  const trainerId   = dataEl.dataset.trainerId!;
  const trainerName = dataEl.dataset.trainerName!;

  // ── Live patch: hero background + avatar photo (SSG may be stale) ──────────
  (async () => {
    const { data: t } = await supabase
      .from('trainers')
      .select('avatar_url, avatar_color, hero_theme')
      .eq('id', trainerId)
      .single();
    if (!t) return;

    // Patch hero background
    const heroEl = document.getElementById('rv-hero');
    if (heroEl && t.hero_theme) {
      function __darken(hex: string, f: number): string {
        const h = hex.replace('#','');
        const [r,g,b] = [parseInt(h.slice(0,2),16),parseInt(h.slice(2,4),16),parseInt(h.slice(4,6),16)];
        return '#'+[r,g,b].map((v: number)=>('0'+Math.round(v*(1-f)).toString(16)).slice(-2)).join('');
      }
      const presets: Record<string,string> = {
        forest:'linear-gradient(160deg,#0d1a0e 0%,#1a3d1e 55%,#2a5a30 100%)',
        midnight:'linear-gradient(160deg,#0a0f1e 0%,#1a2240 55%,#2a3a6a 100%)',
        charcoal:'linear-gradient(160deg,#111111 0%,#252525 55%,#333333 100%)',
        royal:'linear-gradient(160deg,#1a0a2e 0%,#2d1a4a 55%,#4a2a7a 100%)',
        slate:'linear-gradient(160deg,#0a1828 0%,#1a2c40 55%,#2a3e58 100%)',
        rose:'linear-gradient(160deg,#3d0a1e 0%,#6b1a3a 55%,#8b2252 100%)',
        lavender:'linear-gradient(160deg,#1e0a3d 0%,#3a1a6b 55%,#5c2a8b 100%)',
        sky:'linear-gradient(160deg,#0a1e3d 0%,#1a3a6b 55%,#2a5a8b 100%)',
      };
      if (t.hero_theme.startsWith('#')) {
        const h2 = t.hero_theme;
        const hx = h2.replace('#','');
        const lum = (0.299*parseInt(hx.slice(0,2),16)+0.587*parseInt(hx.slice(2,4),16)+0.114*parseInt(hx.slice(4,6),16))/255;
        const [f0,f1,f2]: [number,number,number] = lum>0.5?[0.90,0.82,0.72]:lum>0.2?[0.78,0.64,0.46]:[0.62,0.38,0.12];
        heroEl.style.background = `linear-gradient(160deg,${__darken(h2,f0)} 0%,${__darken(h2,f1)} 55%,${__darken(h2,f2)} 100%)`;
      } else {
        heroEl.style.background = presets[t.hero_theme] ?? presets.forest;
      }
    }

    // Patch avatar photo + ring (hero + mini card)
    if (t.avatar_url) {
      const imgHtml = `<img src="${t.avatar_url}" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />`;
      for (const sel of ['.rv-avatar', '#rv-mini-av']) {
        const av = document.querySelector(sel) as HTMLElement | null;
        if (av) {
          av.innerHTML = imgHtml;
          av.style.background = 'transparent';
          if (t.avatar_color) av.style.borderColor = t.avatar_color;
        }
      }
    }
  })();

  // ── Logo link — intercept before auth resolves so native href="/" can't fire ──
  const logoLink = document.getElementById('rv-logo-link') as HTMLAnchorElement;
  logoLink.addEventListener('click', (e) => {
    e.preventDefault();
    window.location.href = logoLink.href;
  });

  // ── Check auth via getUser() — safe: does NOT clear the session if refresh ──
  // fails (unlike getSession(), which wipes localStorage on a bad refresh token)
  let clientId: string | null = null;

  function formatEligibleDate(isoString: string): string {
    const d   = new Date(isoString);
    const now = new Date();
    const todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const eligStart  = new Date(d.getFullYear(),   d.getMonth(),   d.getDate());
    if (eligStart.getTime() === todayStart.getTime()) {
      return 'today at ' + d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
    }
    return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
  }

  const { data: { user } } = await supabase.auth.getUser();

  // ── Intro section — update CTA based on auth state ────────────────────────
  const introCta  = document.getElementById('rv-intro-cta')  as HTMLAnchorElement | null;
  const stickyBtn = document.getElementById('rv-sticky-btn') as HTMLAnchorElement | null;

  const formState = document.getElementById('rv-form-state') as HTMLElement;
  if (!user) {
    // Unauthenticated: update intro CTA to "ACTIVATE & REVIEW [NAME] →"
    const tName     = dataEl.dataset.trainerName || 'your trainer';
    const signupUrl = `/signup?review=${encodeURIComponent(trainerId)}&tname=${encodeURIComponent(tName)}`;
    const ctaLabel  = `ACTIVATE & REVIEW ${tName.toUpperCase()} →`;
    if (introCta)  { introCta.textContent  = ctaLabel; introCta.href  = signupUrl; }
    if (stickyBtn) { stickyBtn.textContent = ctaLabel; stickyBtn.href = signupUrl; }
    const introSignin = document.getElementById('rv-intro-signin') as HTMLElement | null;
    if (introSignin) introSignin.style.display = 'flex';
    // Don't show the form — intro section handles the unauthenticated gate
    throw new Error('unauthenticated');
  }

  // Authenticated: CTA scrolls to form section; hide sticky when form is visible
  if (introCta) {
    introCta.textContent = `REVIEW ${trainerName.toUpperCase()} →`;
    introCta.removeAttribute('href');
    introCta.addEventListener('click', (e) => {
      e.preventDefault();
      document.getElementById('rv-form-section')?.scrollIntoView({ behavior: 'smooth' });
    });
  }
  if (stickyBtn) {
    stickyBtn.textContent = `REVIEW ${trainerName.toUpperCase()} →`;
    stickyBtn.removeAttribute('href');
    stickyBtn.addEventListener('click', (e) => {
      e.preventDefault();
      document.getElementById('rv-form-section')?.scrollIntoView({ behavior: 'smooth' });
      const stickyEl = document.getElementById('rv-sticky-cta');
      if (stickyEl) stickyEl.style.display = 'none';
    });
  }
  if (window.IntersectionObserver) {
    const formSec = document.getElementById('rv-form-section');
    if (formSec) {
      new IntersectionObserver(([entry]) => {
        const stickyEl = document.getElementById('rv-sticky-cta');
        if (stickyEl) stickyEl.style.display = entry.isIntersecting ? 'none' : '';
      }, { threshold: 0.05 }).observe(formSec);
    }
  }

  if (user) {
    const { data: trainer } = await supabase
      .from('trainers').select('id').eq('user_id', user.id).maybeSingle();
    if (trainer) {
      logoLink.href = '/dashboard';
      // Block the review form entirely for trainers
      if (formState) {
        formState.innerHTML = `
          <div style="padding:3rem 2rem;text-align:center;">
            <div style="margin-bottom:1rem;display:flex;justify-content:center;"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><line x1="9" y1="9" x2="15" y2="15"/><line x1="15" y1="9" x2="9" y2="15"/></svg></div>
            <h3 style="font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:700;color:var(--text);margin-bottom:0.75rem;">Trainers can't leave reviews</h3>
            <p style="color:var(--muted);font-size:0.9rem;line-height:1.7;margin-bottom:1.5rem;">Only verified clients can review personal trainers on CoachCards.</p>
            <a href="/dashboard" style="display:inline-flex;align-items:center;gap:0.5rem;background:#3ab54a;color:white;padding:0.75rem 1.5rem;border-radius:8px;font-weight:700;font-size:0.875rem;text-decoration:none;">← Back to Dashboard</a>
          </div>`;
      }
    } else {
      const { data: client } = await supabase
        .from('clients').select('id, name').eq('user_id', user.id).maybeSingle();
      if (client) {
        clientId = client.id;
        logoLink.href = '/account';
        const nameInput = document.getElementById('rv-name') as HTMLInputElement;
        nameInput.value    = client.name;
        nameInput.readOnly = true;
        nameInput.style.background = '#f7f9f7';
        nameInput.style.color      = '#7a8f7c';
        nameInput.title = 'Logged in as ' + client.name;
        // Pre-check eligibility so we can show a friendly message before form load.
        // Server-side enforcement runs again on submit — this is UX only.
        const { data: elig } = await supabase.rpc('check_review_eligibility', {
          p_client_id:  client.id,
          p_trainer_id: trainerId,
        });

        if (elig?.status === 'blocked') {
          const nextDate = formatEligibleDate(elig.next_eligible_at);
          if (formState) {
            formState.innerHTML = `
              <div style="padding:2.5rem 2rem;text-align:center;">
                <div style="margin-bottom:1rem;display:flex;justify-content:center;"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
                <h3 style="font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:700;color:var(--text);margin-bottom:0.75rem;">You've recently reviewed ${trainerName}</h3>
                <p style="color:var(--muted);font-size:0.9rem;line-height:1.7;margin-bottom:0.5rem;">You can leave another review for <strong style="color:var(--text);">${trainerName}</strong> on <strong style="color:var(--text);">${nextDate}</strong>.</p>
                <p style="color:var(--muted);font-size:0.82rem;line-height:1.6;">Clients can review the same trainer once every 30 days to keep CoachCards rankings fair.</p>
              </div>`;
            formState.style.display = 'block';
          }
        } else if (elig?.status === 'pending_review') {
          if (formState) {
            formState.innerHTML = `
              <div style="padding:2.5rem 2rem;text-align:center;">
                <div style="margin-bottom:1rem;display:flex;justify-content:center;"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
                <h3 style="font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:700;color:var(--text);margin-bottom:0.75rem;">Your review is awaiting approval</h3>
                <p style="color:var(--muted);font-size:0.9rem;line-height:1.7;">Your recent review of <strong style="color:var(--text);">${trainerName}</strong> is waiting to be approved. You can submit another once this one is resolved.</p>
              </div>`;
            formState.style.display = 'block';
          }
        } else {
          if (formState) formState.style.display = 'block';
        }
      } else {
        // Logged in but no client record — show form anyway (they can still review)
        if (formState) formState.style.display = 'block';
      }
    }
  }

  // ── BMP Slider ─────────────────────────────────────────────────────────────
  let selectedRating = 0; // percentage 0-100

  const slider     = document.getElementById('bmp-slider') as HTMLInputElement;
  const pctDisplay = document.getElementById('bmp-pct')    as HTMLElement;
  const bmpDbsEl   = document.getElementById('bmp-dbs')    as HTMLElement;
  const labelEl    = document.getElementById('bmp-label')  as HTMLElement;

  bmpDbsEl.innerHTML = _bmpDumbbell(0);

  function bmpLabel(pct: number): string {
    if (pct === 0)  return 'Drag the slider to rate';
    if (pct <= 20)  return 'Needs Improvement';
    if (pct <= 40)  return 'Below Average';
    if (pct <= 60)  return 'Average';
    if (pct <= 75)  return 'Good';
    if (pct <= 90)  return 'Very Good';
    return 'Outstanding! 🎉';
  }

  function updateSliderTrack(pct: number) {
    slider.style.background = `linear-gradient(to right, var(--green) 0%, var(--green) ${pct}%, #dde8de ${pct}%, #dde8de 100%)`;
  }

  slider.addEventListener('input', () => {
    selectedRating         = parseInt(slider.value);
    pctDisplay.textContent = String(selectedRating);
    labelEl.textContent    = bmpLabel(selectedRating);
    bmpDbsEl.innerHTML     = _bmpDumbbell(selectedRating);
    updateSliderTrack(selectedRating);
  });

  updateSliderTrack(0);

  // ── Anonymous toggle — live initials preview ───────────────────────────────
  const anonCheck   = document.getElementById('rv-anon')         as HTMLInputElement;
  const anonPreview = document.getElementById('rv-anon-preview') as HTMLElement;
  const nameInput   = document.getElementById('rv-name')         as HTMLInputElement;

  function toInitials(name: string): string {
    const parts = name.trim().split(/\s+/).filter(Boolean);
    if (!parts.length) return 'J. S.';
    if (parts.length === 1) return parts[0][0].toUpperCase() + '.';
    return parts[0][0].toUpperCase() + '. ' + parts[parts.length - 1][0].toUpperCase() + '.';
  }

  nameInput.addEventListener('input', () => {
    anonPreview.textContent = nameInput.value.trim() ? toInitials(nameInput.value) : 'J. S.';
  });

  // ── Character count ────────────────────────────────────────────────────────
  const rvText    = document.getElementById('rv-text')    as HTMLTextAreaElement;
  const charHint  = document.getElementById('char-hint')  as HTMLElement;

  rvText.addEventListener('input', () => {
    const len = rvText.value.trim().length;
    charHint.textContent = len >= 30 ? `${len} characters ✓` : `${len} / 30 minimum`;
    charHint.classList.toggle('ok', len >= 30);
  });

  // ── Submit ─────────────────────────────────────────────────────────────────
  const submitBtn   = document.getElementById('rv-submit')      as HTMLButtonElement;
  const errorEl     = document.getElementById('rv-error')       as HTMLElement;
  const errorFoot   = document.getElementById('rv-error-foot')  as HTMLElement;
  const thanksState = document.getElementById('rv-thanks')      as HTMLElement;
  const thanksName  = document.getElementById('rv-thanks-name') as HTMLElement;
  const thanksStars = document.getElementById('rv-thanks-stars')as HTMLElement;
  const thanksBody  = document.getElementById('rv-thanks-body') as HTMLElement;

  function showError(msg: string) {
    errorEl.textContent      = msg;
    errorFoot.textContent    = msg;
    errorEl.style.display    = 'block';
    errorFoot.style.display  = 'block';
    errorEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  submitBtn.addEventListener('click', async () => {
    errorEl.style.display   = 'none';
    errorFoot.style.display = 'none';

    // Hard auth guard — re-check in case the page-load auth check hasn't completed yet
    const { data: { user: submitUser } } = await supabase.auth.getUser();
    if (!submitUser) {
      const trainerNameEl = document.getElementById('rv-trainer-name') as HTMLElement;
      const tName = trainerNameEl?.textContent?.trim() || 'this trainer';
      const trainerId = (document as any).__rvTrainerId || window.location.pathname.split('/').pop() || '';
      const signupUrl = `/signup?review=${encodeURIComponent(trainerId)}&tname=${encodeURIComponent(tName)}`;
      if (formState) {
        formState.innerHTML = `
          <div style="padding:2.5rem 2rem;text-align:center;max-width:400px;margin:0 auto;">
            <div style="margin-bottom:1rem;display:flex;justify-content:center;"><svg width="40" height="40" viewBox="0 0 24 24" fill="#F59E0B" stroke="#F59E0B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></div>
            <h3 style="font-family:'Playfair Display',serif;font-size:1.4rem;font-weight:900;color:var(--text);margin-bottom:0.75rem;">Sign up to review ${tName}</h3>
            <p style="color:var(--muted);font-size:0.9rem;line-height:1.7;margin-bottom:1.75rem;">Create your free account in seconds — then leave your verified review straight away.</p>
            <a href="${signupUrl}" style="display:block;background:#3ab54a;color:white;padding:0.9rem 1.5rem;border-radius:10px;font-weight:700;font-size:0.95rem;text-decoration:none;margin-bottom:0.85rem;">Create free account →</a>
            <a href="/login?redirect=${encodeURIComponent(window.location.pathname)}" style="display:block;color:var(--muted);font-size:0.85rem;text-decoration:none;padding:0.5rem;">Already have an account? Sign in</a>
          </div>`;
      }
      return;
    }

    const name     = (document.getElementById('rv-name')     as HTMLInputElement).value.trim();
    const location = (document.getElementById('rv-location') as HTMLInputElement).value.trim();
    const text     = rvText.value.trim();

    if (!selectedRating) { showError('Please drag the BMP slider to set a rating.'); return; }
    if (!name)            { showError('Please enter your name.'); return; }
    if (text.length < 30) { showError(`Your review needs at least 30 characters (${text.length} so far).`); return; }

    submitBtn.textContent = 'Submitting…';
    submitBtn.disabled    = true;

    const initials = name.split(' ').map((w: string) => w[0] || '').join('').toUpperCase().slice(0, 2);
    const palettes = [
      { bg:'#eaf7ec', color:'#2a9438' }, { bg:'#e8f0f7', color:'#1a4b6b' },
      { bg:'#fdf6e3', color:'#b8860b' }, { bg:'#f5e8f7', color:'#6b1a6b' },
    ];
    const pal = palettes[Math.floor(Math.random() * palettes.length)];

    const approval_token = crypto.randomUUID() as string;

    const { data: rpcResult, error: rpcError } = await supabase.rpc('submit_review_for_client', {
      p_trainer_id:            trainerId,
      p_client_id:             clientId || null,
      p_reviewer_name:         name,
      p_reviewer_initials:     initials,
      p_reviewer_avatar_bg:    pal.bg,
      p_reviewer_avatar_color: pal.color,
      p_reviewer_location:     location || null,
      p_rating:                selectedRating / 20,
      p_review_text:           text,
      p_is_anonymous:          anonCheck.checked,
      p_approval_token:        approval_token,
    });

    if (rpcError) {
      showError('Something went wrong — please try again.');
      submitBtn.textContent = 'Submit Review →';
      submitBtn.disabled    = false;
      return;
    }

    if (rpcResult?.status === 'blocked') {
      const nextDate = formatEligibleDate(rpcResult.next_eligible_at);
      showError(`You can review ${trainerName} again on ${nextDate}.`);
      submitBtn.textContent = 'Submit Review →';
      submitBtn.disabled    = false;
      return;
    }

    if (rpcResult?.status === 'pending_review') {
      showError('Your recent review is still being processed. Please wait for it to be approved before submitting another.');
      submitBtn.textContent = 'Submit Review →';
      submitBtn.disabled    = false;
      return;
    }

    const payload = { approval_token }; // referenced by email fetch below

    // Fire approval email (non-blocking — don't fail submission if email errors)
    // Use the token we already generated client-side — no need to read it back from Supabase
    fetch('/.netlify/functions/send-review-email', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        trainerName,
        trainerId,
        reviewerName:   name,
        isClient:       !!clientId,
        rating:         selectedRating / 20,
        reviewText:     text,
        approvalToken:  payload.approval_token,
      }),
    }).catch(() => {}); // silent — email failure shouldn't block the reviewer

    formState.style.display   = 'none';
    thanksState.style.display = 'block';
    thanksName.textContent    = `Thank you, ${name.split(' ')[0]}!`;
    thanksStars.innerHTML   = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:4px"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>Pending Approval`;
    thanksBody.textContent    = `Your review for ${trainerName} has been received. It will appear on their profile once approved — usually within 24 hours.`;

    // Update the back link destination and label to match auth state
    const backLink = document.querySelector<HTMLAnchorElement>('.rv-back');
    if (backLink) {
      backLink.href = logoLink.href;
      if (logoLink.href.endsWith('/dashboard')) backLink.textContent = '← Back to Dashboard';
      else if (logoLink.href.endsWith('/account')) backLink.textContent = '← Back to My Account';
    }
  });
</script>
