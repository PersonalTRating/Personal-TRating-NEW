---
// PT Login — Personal TRating
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sign In — Personal TRating</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --green: #3ab54a; --green-dark: #2a9438; --green-light: #eaf7ec;
    --border: #e0e8e1; --text: #0d1a0e; --muted: #7a8f7c; --off: #f7f9f7;
  }
  * { margin:0; padding:0; box-sizing:border-box; }
  body {
    font-family:'Manrope',sans-serif; color:var(--text);
    min-height:100vh; display:flex;
  }

  /* ── Left panel ── */
  .auth-left {
    width:420px; flex-shrink:0;
    background:linear-gradient(160deg,#0d1a0e 0%,#1a3d1e 55%,#2a5a30 100%);
    display:flex; flex-direction:column; justify-content:space-between;
    padding:3rem 2.5rem; position:relative; overflow:hidden;
  }
  .auth-left::before {
    content:''; position:absolute; bottom:-80px; right:-80px;
    width:300px; height:300px;
    background:radial-gradient(circle,rgba(58,181,74,0.2) 0%,transparent 70%);
    pointer-events:none;
  }
  .auth-left-logo img { height:73px; width:auto; object-fit:contain; }
  .auth-left-copy { position:relative; z-index:1; }
  .auth-left-copy h2 {
    font-family:'Playfair Display',serif; font-size:2rem; font-weight:900;
    color:white; line-height:1.2; margin-bottom:1rem;
  }
  .auth-left-copy p { font-size:0.9rem; color:rgba(255,255,255,0.55); line-height:1.75; }
  .auth-left-stats { display:flex; flex-direction:column; gap:1rem; position:relative; z-index:1; }
  .auth-stat { display:flex; align-items:center; gap:0.75rem; }
  .auth-stat-icon {
    width:36px; height:36px; border-radius:8px;
    background:rgba(58,181,74,0.15); display:flex; align-items:center;
    justify-content:center; font-size:1rem; flex-shrink:0;
  }
  .auth-stat-text { font-size:0.82rem; color:rgba(255,255,255,0.6); }
  .auth-stat-text strong { color:white; }

  /* ── Right panel ── */
  .auth-right {
    flex:1; background:var(--off); display:flex; align-items:center;
    justify-content:center; padding:2rem;
  }
  .auth-card {
    background:white; border-radius:16px; border:1px solid var(--border);
    padding:2.5rem; width:100%; max-width:400px;
    box-shadow:0 8px 32px rgba(0,0,0,0.07);
  }
  .auth-card h1 {
    font-family:'Playfair Display',serif; font-size:1.75rem; font-weight:900;
    margin-bottom:0.4rem;
  }
  .auth-card .auth-sub { font-size:0.875rem; color:var(--muted); margin-bottom:2rem; }

  .form-group { display:flex; flex-direction:column; gap:0.4rem; margin-bottom:1.1rem; }
  .form-label { font-size:0.78rem; font-weight:700; color:var(--text); }
  .form-input {
    padding:0.8rem 1rem; border:1.5px solid var(--border); border-radius:8px;
    font-family:'Manrope',sans-serif; font-size:0.875rem; color:var(--text);
    background:white; transition:border-color 0.2s, box-shadow 0.2s; outline:none;
  }
  .form-input:focus { border-color:var(--green); box-shadow:0 0 0 3px rgba(58,181,74,0.1); }

  .auth-btn {
    width:100%; padding:0.875rem; background:var(--green); color:white;
    border:none; border-radius:8px; font-family:'Manrope',sans-serif;
    font-weight:700; font-size:0.95rem; cursor:pointer;
    transition:background 0.2s; margin-top:0.5rem;
  }
  .auth-btn:hover   { background:var(--green-dark); }
  .auth-btn:disabled { opacity:0.65; cursor:not-allowed; }

  .auth-error {
    background:#fdecea; border:1px solid #f5c6c6; color:#c62828;
    padding:0.75rem 1rem; border-radius:8px; font-size:0.82rem;
    margin-bottom:1rem; display:none;
  }
  .auth-footer { text-align:center; margin-top:1.5rem; font-size:0.83rem; color:var(--muted); }
  .auth-footer a { color:var(--green); font-weight:700; text-decoration:none; }
  .auth-footer a:hover { text-decoration:underline; }
  .auth-divider { border:none; border-top:1px solid var(--border); margin:1.5rem 0; }

  @media (max-width: 768px) {
    .auth-left { display:none; }
    .auth-right { padding:1.25rem; }
    .auth-card  { padding:1.75rem; }
  }
</style>
</head>
<body>

<!-- Left panel -->
<div class="auth-left">
  <div class="auth-left-logo">
    <img src="/images/logo.png" alt="Personal TRating" style="border:2.5px solid #3ab54a;border-radius:10px;background:white;padding:4px;" />
  </div>
  <div class="auth-left-copy">
    <h2>Your dashboard awaits.</h2>
    <p>Manage your profile, collect verified reviews, and track your UK ranking — all in one place.</p>
  </div>
  <div class="auth-left-stats">
    <div class="auth-stat">
      <div class="auth-stat-icon">🏆</div>
      <div class="auth-stat-text"><strong>2,400+</strong> personal trainers ranked</div>
    </div>
    <div class="auth-stat">
      <div class="auth-stat-icon">⭐</div>
      <div class="auth-stat-text"><strong>18,000+</strong> verified client reviews</div>
    </div>
    <div class="auth-stat">
      <div class="auth-stat-icon">📍</div>
      <div class="auth-stat-text"><strong>120+</strong> UK locations covered</div>
    </div>
  </div>
</div>

<!-- Right panel -->
<div class="auth-right">
  <div class="auth-card">
    <h1>Welcome back</h1>
    <p class="auth-sub">Sign in to your PT dashboard</p>

    <div class="auth-error" id="error-msg"></div>

    <form id="login-form">
      <div class="form-group">
        <label class="form-label" for="email">Email address</label>
        <input class="form-input" type="email" id="email" placeholder="you@example.com" required autocomplete="email">
      </div>
      <div class="form-group">
        <label class="form-label" for="password">Password</label>
        <input class="form-input" type="password" id="password" placeholder="Your password" required autocomplete="current-password">
      </div>
      <button class="auth-btn" type="submit" id="submit-btn">Sign In</button>
    </form>

    <hr class="auth-divider">
    <div class="auth-footer">
      Don't have an account? <a href="/signup">Create your free profile →</a>
    </div>
    <div class="auth-footer" style="margin-top:0.5rem;">
      <a href="/">← Back to Personal TRating</a>
    </div>
  </div>
</div>

</body>
</html>

<script>
  import { supabase } from '../lib/supabase';

  // If already logged in, redirect based on user type
  supabase.auth.getSession().then(async ({ data: { session } }) => {
    if (!session) return;
    const { data: trainer } = await supabase.from('trainers').select('id').eq('user_id', session.user.id).maybeSingle();
    window.location.href = trainer ? '/dashboard' : '/';
  });

  const form      = document.getElementById('login-form') as HTMLFormElement;
  const errorMsg  = document.getElementById('error-msg') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg.style.display = 'none';
    submitBtn.textContent  = 'Signing in…';
    submitBtn.disabled     = true;

    const email    = (document.getElementById('email')    as HTMLInputElement).value.trim();
    const password = (document.getElementById('password') as HTMLInputElement).value;

    const { error } = await supabase.auth.signInWithPassword({ email, password });

    if (error) {
      errorMsg.textContent   = error.message;
      errorMsg.style.display = 'block';
      submitBtn.textContent  = 'Sign In';
      submitBtn.disabled     = false;
    } else {
      const { data: { user } } = await supabase.auth.getUser();
      const { data: trainer }  = await supabase.from('trainers').select('id').eq('user_id', user!.id).maybeSingle();
      window.location.href = trainer ? '/dashboard' : '/';
    }
  });
</script>
