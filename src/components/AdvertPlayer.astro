---
// The finished 30-second CoachCards advert: poster thumbnail as one play button,
// inline click-to-play, native controls once playback starts. Media is referenced
// from /videos and /images — not duplicated. Used on /overview/ and the home page.
---
<div class="advert-player" data-advert-player>
  <button type="button" class="advert-play" aria-label="Play CoachCards advert (30 seconds)" hidden>
    <span class="advert-icon" aria-hidden="true">
      <svg width="28" height="32" viewBox="0 0 14 16"><path d="M0 0v16l14-8z" fill="currentColor"/></svg>
    </span>
    <span class="advert-badge" aria-hidden="true">0:30</span>
  </button>
  <video
    class="advert-video"
    controls
    playsinline
    preload="none"
    width="1280"
    height="720"
    poster="/images/coachcards-advert-poster.webp"
    aria-label="CoachCards 30-second advert"
  >
    <source src="/videos/coachcards-advert-30s.mp4" type="video/mp4" />
    <track kind="captions" src="/videos/coachcards-advert-30s.en.vtt" srclang="en" label="English" />
  </video>
</div>

<style>
  .advert-player {
    position: relative;
    max-width: 616px;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgba(58,181,74,0.25), 0 18px 48px rgba(0,0,0,0.45);
  }
  .advert-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .advert-play {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 55%, rgba(0,0,0,0.35) 100%);
    border: 0;
    border-radius: inherit;
    cursor: pointer;
    font: inherit;
    color: #fff;
  }
  .advert-play[hidden] { display: none; }
  .advert-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    background: rgba(255,255,255,0.94);
    color: #0d1a0e;
    box-shadow: 0 0 0 6px rgba(0,0,0,0.25), 0 10px 30px rgba(0,0,0,0.45);
    transition: transform 0.2s, background 0.15s;
  }
  .advert-icon svg { margin-left: 6px; }
  .advert-play:hover .advert-icon { transform: scale(1.08); background: #fff; }
  .advert-badge {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: rgba(0,0,0,0.78);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.3px;
    font-variant-numeric: tabular-nums;
  }
  .advert-play:focus-visible {
    outline: 3px solid #3ab54a;
    outline-offset: -3px;
    box-shadow: inset 0 0 0 6px #fff;
  }
  @media (max-width: 640px) {
    .advert-player { border-radius: 8px; }
    .advert-icon { width: 64px; height: 64px; box-shadow: 0 0 0 4px rgba(0,0,0,0.25), 0 6px 18px rgba(0,0,0,0.45); }
    .advert-icon svg { width: 20px; height: 24px; margin-left: 4px; }
    .advert-badge { right: 0.5rem; bottom: 0.5rem; font-size: 0.72rem; }
  }
</style>

<script>
  // Native controls remain the fallback without JS; with JS the poster becomes one play button.
  document.querySelectorAll<HTMLElement>('[data-advert-player]').forEach((player) => {
    const video = player.querySelector<HTMLVideoElement>('video');
    const play  = player.querySelector<HTMLButtonElement>('.advert-play');
    if (!video || !play) return;
    const showControls = () => { play.hidden = true; video.controls = true; };
    video.controls = false;
    play.hidden = false;
    play.addEventListener('click', () => {
      showControls();
      video.play().catch(() => {});
      video.focus();
    });
    video.addEventListener('play', showControls);
  });
</script>
