---
import { bmpDumbbell } from '../lib/bmpDumbbell';

interface Props {
  id: string;
  name: string;
  city?: string;
  spec?: string;
  bmpScore: number;
  revCount: number;
  recentReviewCount?: number;
  rank?: number;
  profileComplete?: boolean;
  avatarUrl?: string;
  avatarStyle?: string;
  avatarInitials?: string;
  avatarBg?: string;
  avatarColor?: string;
  isTrending?: boolean;
  coachingType?: string;
}

const {
  id,
  name,
  city = '',
  spec = '',
  bmpScore = 0,
  revCount = 0,
  recentReviewCount = 0,
  rank,
  profileComplete,
  avatarUrl,
  avatarStyle,
  avatarInitials = '?',
  avatarBg = '#0d1a0e',
  avatarColor = '#3ab54a',
  isTrending = false,
  coachingType = '',
} = Astro.props;

const coachingLabel = coachingType === 'in_person' ? 'In Person'
  : coachingType === 'online' ? 'Online'
  : coachingType === 'hybrid' ? 'Online & In Person'
  : '';

const rankStr = rank != null ? String(rank).padStart(2, '0') : '';
const metaCity = city || '';
const metaSpec = spec ? spec.split(/[,\/]/)[0].trim() : '';

const reviewsBase = revCount === 0
  ? 'Be first to review'
  : revCount + ' verified ' + (revCount === 1 ? 'review' : 'reviews');
const reviewsHot = recentReviewCount >= 1 && revCount > 0;

const bmpDisplay = revCount === 0 ? null : (bmpScore || '—');
---

<a
  class:list={['trc', isTrending && 'trc--trending']}
  href={`/trainers/${id}`}
  data-cc="card"
  data-cc-trending={isTrending ? "1" : undefined}
  style={`view-transition-name:tc-${id};`}
  data-bmp={String(bmpScore)}
  data-reviews={String(revCount)}
  data-name={name.toLowerCase()}
  data-city={city.toLowerCase()}
  data-spec={spec.toLowerCase()}
  data-coaching-type={coachingType}
>
  <div class="trc-left">
    {rankStr && <span class="trc-rank">{rankStr}</span>}

    {avatarUrl ? (
      <img
        class="trc-av"
        src={avatarUrl}
        alt={name}
        width="56"
        height="56"
        style={avatarStyle || undefined}
      />
    ) : (
      <div class="trc-av trc-av-init" style={`background:${avatarBg};color:${avatarColor};`}>
        {avatarInitials}
      </div>
    )}
  </div>

  <div class="trc-mid">
    <div class="trc-mid-top">
      <div class="trc-name-row">
        <span class="trc-name">{name}</span>
        {profileComplete && (
          <span class="trc-tick" title="Profile complete">
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none">
              <circle cx="8" cy="8" r="8" fill="#3ab54a"/>
              <path d="M4.5 8.2l2.3 2.3 4.7-4.7" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        )}
        {isTrending && (
          <div class="trend-info">
            <span class="trc-trending-pill"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 3z"/></svg> TRENDING</span>
            <div class="trend-tooltip">Trending trainers have earned 4+ verified reviews in the last 30 days, spread across at least 2 separate calendar weeks, and hold a quality score of 42 or above.</div>
          </div>
        )}
      </div>
      {(metaCity || metaSpec || coachingLabel) && (
        <div class="trc-meta">
          {metaCity && <span class="trc-meta-item"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#E85D4A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>{metaCity}</span>}
          {metaSpec && <span class="spec-pill">{metaSpec}</span>}
          {coachingLabel && <span class="coaching-pill">{coachingLabel}</span>}
        </div>
      )}
    </div>
    <div class:list={['trc-reviews', reviewsHot && 'trc-reviews--hot']}>
      {reviewsHot
        ? <><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 3z"/></svg>{recentReviewCount} verified {recentReviewCount === 1 ? 'review' : 'reviews'} in the last 30 days</>
        : reviewsBase
      }
    </div>
  </div>

  <div class="trc-bmp">
    <span class="trc-bmp-lbl">BMP</span>
    {bmpDisplay != null ? (
      <span class="trc-bmp-num">{bmpDisplay}</span>
    ) : (
      <span class="trc-bmp-first">First<br/>review</span>
    )}
    {bmpDisplay != null && (
      <div class="trc-bmp-db"><Fragment set:html={bmpDumbbell(bmpScore, 38)} /></div>
    )}
    <div class="bmp-tooltip">BMP — Body Muscle Percentage.<br/>CoachCards' verified ranking score:<br/><strong>Quality 70pts · Confidence 20pts · Momentum 10pts</strong><br/>Calculated from real, verified client reviews only.</div>
  </div>
</a>

<style is:global>
  .trc {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: rgba(4,10,5,0.97);
    border: 1px solid rgba(58,181,74,0.32);
    border-left: 3px solid rgba(58,181,74,0.7);
    border-radius: 14px;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    position: relative;
    z-index: 1;
    transition: box-shadow 0.18s ease, transform 0.18s ease, border-color 0.18s ease;
    box-shadow: 0 0 8px rgba(58,181,74,0.18), 0 0 20px rgba(58,181,74,0.07), 0 2px 12px rgba(0,0,0,0.35);
  }
  .trc:hover {
    transform: translateY(-2px);
    border-color: rgba(58,181,74,0.55);
    box-shadow: 0 4px 18px rgba(0,0,0,0.45), 0 0 14px rgba(58,181,74,0.3), 0 0 28px rgba(58,181,74,0.12);
    z-index: 10;
  }
  .trc:focus-visible { outline: 2px solid #3ab54a; outline-offset: 3px; }

  .trc--trending {
    background: rgba(20,4,4,0.96) !important;
    border: 1px solid rgba(200,0,0,0.5) !important;
    border-left: 3px solid #cc0000 !important;
    box-shadow: 0 0 8px rgba(150,0,0,0.4), 0 0 18px rgba(150,0,0,0.18), 0 2px 12px rgba(0,0,0,0.35);
  }
  .trc--trending:hover {
    border-color: rgba(220,0,0,0.7) !important;
    box-shadow: 0 4px 18px rgba(0,0,0,0.45), 0 0 14px rgba(160,0,0,0.5), 0 0 28px rgba(150,0,0,0.22) !important;
  }

  .trc-rank {
    font-family: 'Playfair Display', serif;
    font-size: 1.55rem;
    font-weight: 900;
    color: #3ab54a;
    width: 2.4rem;
    flex-shrink: 0;
    line-height: 1;
  }

  .trc-av {
    width: 56px; min-width: 56px; height: 56px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid rgba(255,255,255,0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.9rem;
    overflow: hidden;
  }

  .trc-mid { flex: 1; min-width: 0; }

  .trc-left {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .trc-name-row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    margin-bottom: 0.22rem;
  }
  .trc-name {
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    font-weight: 700;
    color: white;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 240px;
  }
  .trc-tick { display: inline-flex; align-items: center; flex-shrink: 0; }

  .trc-trending-pill {
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 1px;
    color: white;
    background: linear-gradient(135deg, #cc0000, #e81414);
    padding: 0.18rem 0.55rem;
    border-radius: 20px;
    white-space: nowrap;
    box-shadow: 0 2px 6px rgba(180,0,0,0.45);
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .trc-meta {
    font-size: 0.78rem;
    color: rgba(255,255,255,0.42);
    margin-bottom: 0.2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.22rem;
  }
  .trc-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .spec-pill {
    display: inline-block;
    background: rgba(58,181,74,0.12);
    border: 1px solid rgba(58,181,74,0.25);
    color: rgba(180,255,185,0.85);
    font-size: 0.68rem;
    font-weight: 600;
    padding: 0.22rem 0.55rem;
    border-radius: 5px;
    letter-spacing: 0.2px;
    line-height: 1.2;
  }
  .coaching-pill {
    display: inline-block;
    background: rgba(60,120,220,0.12);
    border: 1px solid rgba(60,120,220,0.25);
    color: rgba(160,200,255,0.8);
    font-size: 0.68rem;
    font-weight: 600;
    padding: 0.22rem 0.55rem;
    border-radius: 5px;
    letter-spacing: 0.2px;
    line-height: 1.2;
  }

  .trc-reviews {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.32);
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .trc-reviews--hot {
    color: rgba(220,100,60,0.9);
  }

  .trc-bmp {
    text-align: right;
    flex-shrink: 0;
    padding-left: 0.5rem;
    position: relative;
    cursor: default;
  }
  .trc-bmp .bmp-tooltip {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    width: 230px;
    background: #051a08;
    color: rgba(255,255,255,0.88);
    font-size: 0.72rem;
    padding: 0.65rem 0.85rem;
    border-radius: 8px;
    line-height: 1.6;
    text-align: left;
    z-index: 250;
    box-shadow: 0 4px 16px rgba(0,0,0,0.35);
    pointer-events: none;
    border: 1px solid rgba(58,181,74,0.2);
  }
  .trc-bmp .bmp-tooltip::after {
    content: '';
    position: absolute;
    bottom: 100%;
    right: 1rem;
    border: 6px solid transparent;
    border-bottom-color: #051a08;
  }
  .trc-bmp:hover .bmp-tooltip { display: block; }
  .trc-bmp-lbl {
    display: block;
    font-family: 'Manrope', sans-serif;
    font-size: 0.58rem;
    color: rgba(255,255,255,0.35);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 700;
  }
  .trc-bmp-num {
    font-family: 'Manrope', sans-serif;
    font-size: 1.75rem;
    font-weight: 800;
    color: #3ab54a;
    line-height: 1;
  }
  .trc-bmp-db { display: flex; justify-content: flex-end; margin-top: 0.2rem; }
  .trc-bmp-first {
    font-size: 0.68rem;
    font-weight: 700;
    color: #3ab54a;
    line-height: 1.35;
  }

  /* Trend tooltip (shared with index.astro) */
  .trend-info { position: relative; cursor: default; display: inline-flex; }
  .trend-tooltip {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    width: 230px;
    background: #1a0505;
    color: rgba(255,255,255,0.88);
    font-size: 0.72rem;
    padding: 0.65rem 0.85rem;
    border-radius: 8px;
    line-height: 1.6;
    text-align: left;
    z-index: 250;
    box-shadow: 0 4px 16px rgba(0,0,0,0.35);
    pointer-events: none;
  }
  .trend-tooltip::after {
    content: '';
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 6px solid transparent;
    border-bottom-color: #1a0505;
  }
  .trend-info:hover .trend-tooltip { display: block; }

  @media (max-width: 640px) {
    .trc {
      display: grid !important;
      grid-template-columns: auto 1fr auto;
      grid-template-areas:
        "left mid bmp"
        "rev  rev rev";
      column-gap: 0.75rem;
      row-gap: 0;
      align-items: start;
      padding: 0.875rem 0.9rem 0 !important;
    }
    .trc-left {
      grid-area: left;
      flex-direction: column !important;
      align-items: center !important;
      gap: 0.35rem;
      align-self: start;
    }
    .trc-rank { font-size: 1.05rem !important; width: auto !important; line-height: 1.1; }
    .trc-av   { width: 44px !important; min-width: 44px !important; height: 44px !important; }
    .trc-mid  { grid-area: mid; display: contents !important; }
    .trc-mid-top { grid-area: mid; min-width: 0; align-self: start; }
    .trc-bmp  { grid-area: bmp; padding-left: 0 !important; align-self: start; }
    .trc-reviews {
      grid-area: rev;
      padding: 0.55rem 0 0.875rem;
      border-top: 1px solid rgba(58,181,74,0.12);
      font-size: 0.73rem;
    }
    .trc--trending .trc-reviews { border-top-color: rgba(120,0,0,0.2); }
    .trc-name    { font-size: 0.9rem !important; max-width: none !important; }
    .trc-bmp-num { font-size: 1.35rem !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    .trc { transition: none; }
  }
</style>
