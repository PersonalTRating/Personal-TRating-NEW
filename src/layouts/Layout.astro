---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title,
  description = "CoachCards ranks the UK's personal trainers by real, verified client reviews. No algorithms. No guesswork. Just honest results.",
  ogImage = '/images/og-social.png',
  canonicalUrl = Astro.url.href,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="view-transition" content="same-origin" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="XyDWDcMIwiFxSilyoUqP71rPqTwZY7LI6si6YmkDgFY" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type"        content="profile" />
    <meta property="og:site_name"   content="CoachCards™" />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:url"         content={canonicalUrl} />

    <!-- Twitter / X -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <!-- Google Fonts: async load to avoid render-blocking -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    </noscript>

    <slot name="head" />
  </head>
  <body class="font-sans text-brand-text bg-white antialiased">
    <slot />
    <script is:inline>
    /* ── CoachCard universal open transition ── */
    (function () {
      var navigating = false;
      document.addEventListener('click', function (e) {
        var card = e.target.closest('a[data-cc="card"]');
        if (!card || navigating) return;
        var href = card.getAttribute('href');
        if (!href || href.indexOf('/trainers/') === -1) return;
        e.preventDefault();
        navigating = true;
        var isTrending = card.getAttribute('data-cc-trending') === '1';
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var av = card.querySelector('.lbc-av, .hc-av, .trc-av');
        var nm = card.querySelector('.lbc-name, .hc-name, .trc-name');
        if (av) av.style.viewTransitionName = 'trainer-avatar';
        if (nm) nm.style.viewTransitionName = 'trainer-name';
        if (reduced) { setTimeout(function () { window.location.href = href; }, 60); return; }
        card.classList.add('cc-selecting');
        if (isTrending) card.classList.add('cc-trending');
        document.querySelectorAll('a[data-cc="card"]').forEach(function (c) {
          if (c !== card) c.classList.add('cc-dimmed');
        });
        setTimeout(function () {
          card.classList.add(isTrending ? 'cc-activating-hot' : 'cc-activating');
        }, 130);
        setTimeout(function () { window.location.href = href; }, 295);
      }, true);
      document.addEventListener('touchstart', function (e) {
        var card = e.target.closest('a[data-cc="card"]');
        if (card && !navigating) card.classList.add('cc-touch');
      }, { passive: true });
      document.addEventListener('touchend', function (e) {
        var card = e.target.closest('a[data-cc="card"]');
        if (card) setTimeout(function () { card.classList.remove('cc-touch'); }, 90);
      }, { passive: true });
      document.addEventListener('touchcancel', function (e) {
        var card = e.target.closest('a[data-cc="card"]');
        if (card) card.classList.remove('cc-touch');
      }, { passive: true });
    })();
    </script>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  /* ── BMP typography system — shared tokens ── */
  .bmp-lbl {
    font-family: 'Manrope', sans-serif !important;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 700;
    color: rgba(255,255,255,0.35);
  }
  .bmp-val {
    font-family: 'Manrope', sans-serif !important;
    font-weight: 800;
    color: #3ab54a;
    line-height: 1.1;
  }
  .bmp-sub {
    font-family: 'Manrope', sans-serif !important;
    font-weight: 500;
    color: rgba(255,255,255,0.35);
  }
  /* ── CoachCard universal open transition ── */
  .cc-selecting {
    transform:translateY(-6px) scale(1.018) !important;
    z-index:5; position:relative;
    transition:transform 130ms ease, box-shadow 130ms ease !important;
    box-shadow:0 0 18px #4cd46a, 0 0 44px rgba(58,181,74,1), 0 0 88px rgba(58,181,74,0.6), 0 20px 48px rgba(0,0,0,0.18) !important;
  }
  .cc-selecting.cc-trending {
    box-shadow:0 0 18px rgba(180,0,0,0.95), 0 0 44px rgba(180,0,0,0.65), 0 0 88px rgba(180,0,0,0.38), 0 20px 48px rgba(0,0,0,0.18) !important;
  }
  .cc-dimmed {
    opacity:0.42 !important;
    filter:brightness(0.78) !important;
    transform:scale(0.99) !important;
    transition:opacity 150ms ease, filter 150ms ease, transform 150ms ease !important;
  }
  .cc-activating     { animation:cc-glow-green 230ms ease-out forwards !important; }
  .cc-activating-hot { animation:cc-glow-red   230ms ease-out forwards !important; }
  @keyframes cc-glow-green {
    0%   { transform:translateY(-6px) scale(1.018); box-shadow:0 0 18px #4cd46a, 0 0 44px rgba(58,181,74,1), 0 0 88px rgba(58,181,74,0.6), 0 20px 48px rgba(0,0,0,0.18); }
    55%  { transform:translateY(-8px) scale(1.024); box-shadow:0 0 28px #6ef086, 0 0 64px rgba(58,181,74,1), 0 0 110px rgba(58,181,74,0.65), 0 26px 58px rgba(0,0,0,0.22); }
    100% { transform:translateY(-7px) scale(1.021); box-shadow:0 0 22px #4cd46a, 0 0 52px rgba(58,181,74,1), 0 0 96px rgba(58,181,74,0.6), 0 22px 52px rgba(0,0,0,0.2); }
  }
  @keyframes cc-glow-red {
    0%   { transform:translateY(-6px) scale(1.018); box-shadow:0 0 18px rgba(180,0,0,0.95), 0 0 44px rgba(180,0,0,0.65), 0 0 88px rgba(180,0,0,0.38), 0 20px 48px rgba(0,0,0,0.18); }
    55%  { transform:translateY(-8px) scale(1.024); box-shadow:0 0 32px rgba(210,0,0,1), 0 0 64px rgba(180,0,0,0.8), 0 0 110px rgba(180,0,0,0.5), 0 26px 58px rgba(0,0,0,0.22); }
    100% { transform:translateY(-7px) scale(1.021); box-shadow:0 0 24px rgba(200,0,0,0.95), 0 0 54px rgba(180,0,0,0.7), 0 0 96px rgba(180,0,0,0.42), 0 22px 52px rgba(0,0,0,0.2); }
  }
  .cc-touch { transform:scale(0.984) !important; transition:transform 80ms ease !important; }
  @media (prefers-reduced-motion: reduce) {
    .cc-selecting          { animation:none !important; transform:none !important; }
    .cc-dimmed             { opacity:0.6 !important; filter:none !important; transform:none !important; }
    .cc-activating,
    .cc-activating-hot     { animation:none !important; }
    .cc-touch              { transform:none !important; }
  }

  html, body { overflow-x: hidden; max-width: 100%; }
  body { position: relative; }

  /* Leaflet popup overrides */
  .leaflet-popup-content-wrapper {
    border-radius: 10px !important;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.18) !important;
    padding: 0 !important;
  }
  .leaflet-popup-content {
    margin: 0 !important;
    padding: 12px 16px !important;
    font-family: 'Manrope', sans-serif !important;
  }
  .leaflet-popup-tip-container {
    margin-top: -1px;
  }
</style>
